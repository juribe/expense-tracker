# Copy this file to .kamal/secrets for a manual deployment. It contains only
# references to local environment variables, never secret values.
#
# GitHub Actions writes the same file before deploying, so both flows resolve
# the secrets from the environment.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
DATABASE_PASSWORD=$DATABASE_PASSWORD

# Every application secret declared under env.secret in config/deploy.yml also
# needs a reference here (Kamal only reads values from this file), e.g.:
#   OPENROUTER_API_KEY=$OPENROUTER_API_KEY
