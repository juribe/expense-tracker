<h1>Membresía #<%= @record.id %></h1>
<div class="pe-card">
  <p><strong>Propietario:</strong> <%= payment_engine_owner_label(@record.owner) %> (<%= @record.owner_type %> #<%= @record.owner_id %>)</p>
  <p><strong>Tipo:</strong> <%= @record.membership_type&.name %></p>
  <p><strong>Estado:</strong> <%= status_badge(@record.status) %></p>
  <p><strong>Inicio:</strong> <%= @record.starts_at %></p>
  <p><strong>Expiración:</strong> <%= @record.expires_at %></p>
  <p><strong>Origen:</strong> <%= @record.source %></p>
  <p><strong>Compra:</strong> <%= @record.purchase&.code %></p>
  <p><strong>Suscripción:</strong> <%= @record.subscription&.id %></p>
</div>

<div class="pe-card">
  <h3>Acciones</h3>
  <%= form_with url: suspend_admin_membership_path(@record), method: :post, local: true do %>
    <div class="pe-form-group"><label>Motivo</label><input type="text" name="reason" class="pe-input"></div>
    <button class="pe-btn pe-btn-danger" type="submit">Suspender</button>
  <% end %>
  <%= form_with url: reactivate_admin_membership_path(@record), method: :post, local: true do %>
    <div class="pe-form-group"><label>Motivo</label><input type="text" name="reason" class="pe-input"></div>
    <button class="pe-btn" type="submit">Reactivar</button>
  <% end %>
  <%= form_with url: extend_admin_membership_path(@record), method: :post, local: true do %>
    <div class="pe-form-group"><label>Nueva expiración</label><input type="datetime-local" name="new_expires_at" class="pe-input"></div>
    <div class="pe-form-group"><label>Motivo</label><input type="text" name="reason" class="pe-input"></div>
    <button class="pe-btn pe-btn-primary" type="submit">Extender</button>
  <% end %>
</div>
<%= link_to "Volver", admin_memberships_path, class: "pe-btn" %>
