<h1>Conceder membresía</h1>
<%= form_with url: admin_memberships_path, method: :post, local: true do %>
  <div class="pe-card">
    <div class="pe-form-group"><label>Tipo de propietario</label>
      <select name="owner_type" class="pe-select"><option value="User">User</option></select>
    </div>
    <div class="pe-form-group"><label>ID del propietario</label><input type="number" name="owner_id" class="pe-input" required></div>
    <div class="pe-form-group"><label>Tipo de membresía</label>
      <select name="membership[membership_type_id]" class="pe-select">
        <% PaymentEngine::MembershipType.active.order(:name).each do |mt| %><option value="<%= mt.id %>"><%= mt.name %></option><% end %>
      </select>
    </div>
    <div class="pe-form-group"><label>Inicio</label><input type="datetime-local" name="membership[starts_at]" class="pe-input" value="<%= Time.current.strftime('%Y-%m-%dT%H:%M') %>"></div>
    <div class="pe-form-group"><label>Expiración</label><input type="datetime-local" name="membership[expires_at]" class="pe-input"></div>
    <div class="pe-form-group"><label>Motivo</label><input type="text" name="reason" class="pe-input"></div>
    <button class="pe-btn pe-btn-primary" type="submit">Conceder</button>
    <%= link_to "Cancelar", admin_memberships_path, class: "pe-btn" %>
  </div>
<% end %>
