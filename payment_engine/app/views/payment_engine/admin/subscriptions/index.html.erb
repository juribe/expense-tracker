<h1>Suscripciones</h1>
<div class="pe-filters">
  <%= form_with url: admin_subscriptions_path, method: :get, local: true do %>
    <select name="status" class="pe-select"><option value="">Todos</option><% %w[active cancelled paused expired].each do |s| %><option value="<%= s %>" <%= 'selected' if params[:status]==s %>><%= s %></option><% end %></select>
    <select name="provider" class="pe-select"><option value="">Todos los proveedores</option><% PaymentEngine::Provider.order(:name).each do |p| %><option value="<%= p.code %>" <%= 'selected' if params[:provider]==p.code %>><%= p.name %></option><% end %></select>
    <button class="pe-btn" type="submit">Filtrar</button>
  <% end %>
</div>
<table class="pe-table">
  <thead><tr><th>ID</th><th>Propietario</th><th>Tipo</th><th>Proveedor</th><th>Precio</th><th>Estado</th><th>Próxima renovación</th><th>Acciones</th></tr></thead>
  <tbody>
    <% @records.each do |r| %>
      <tr>
        <td><%= link_to r.id, admin_subscription_path(r) %></td>
        <td><%= payment_engine_owner_label(r.owner) %></td>
        <td><%= r.payment_option&.membership_type&.name %></td>
        <td><%= r.provider_code %></td>
        <td><%= number_to_currency(r.payment_option&.price, unit: r.payment_option&.currency) %></td>
        <td><%= status_badge(r.status) %></td>
        <td><%= r.next_billing_at %></td>
        <td><%= link_to "Ver", admin_subscription_path(r), class: "pe-btn" %></td>
      </tr>
    <% end %>
    <% if @records.empty? %><tr><td colspan="8" class="pe-empty">Sin registros</td></tr><% end %>
  </tbody>
</table>
<div class="pe-pagination"><%= will_paginate @records %></div>
