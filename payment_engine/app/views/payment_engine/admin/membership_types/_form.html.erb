<%= form_with model: [:admin, record], url: record.persisted? ? admin_membership_type_path(record) : admin_membership_types_path, local: true do |f| %>
  <% if record.errors.any? %>
    <div class="pe-flash pe-flash-danger"><%= record.errors.full_messages.join(", ") %></div>
  <% end %>
  <div class="pe-card">
    <div class="pe-form-group"><%= f.label :name, "Nombre" %><%= f.text_field :name, class: "pe-input" %></div>
    <div class="pe-form-group"><%= f.label :code, "Código" %><%= f.text_field :code, class: "pe-input" %></div>
    <div class="pe-form-group"><%= f.label :description, "Descripción" %><%= f.text_area :description, class: "pe-textarea" %></div>
    <div class="pe-form-group"><%= f.label :status, "Estado" %><%= f.select :status, %w[active archived], {}, class: "pe-select" %></div>
    <div class="pe-form-group"><%= f.label :position, "Orden" %><%= f.number_field :position, class: "pe-input" %></div>
    <%= f.submit "Guardar", class: "pe-btn pe-btn-primary" %>
    <%= link_to "Cancelar", admin_membership_types_path, class: "pe-btn" %>
  </div>
<% end %>
