<h1>Identidad premium #<%= @record.id %></h1>
<div class="pe-card">
  <p><strong>Tipo:</strong> <%= @record.identity_type %></p>
  <p><strong>Fingerprint:</strong> <code><%= @record.fingerprint %></code></p>
  <p><strong>Primer usuario:</strong> <%= @record.first_user&.email || "Usuario eliminado" %> (<%= @record.first_user_id || "sin referencia" %>)</p>
  <p><strong>Membresía:</strong> <%= @record.payment_engine_membership_id || "—" %></p>
  <p><strong>Primer uso:</strong> <%= @record.first_used_at %></p>
  <p><strong>Estado:</strong> <%= @record.released? ? status_badge("cancelled") : status_badge("active") %></p>
  <% if @record.released? %>
    <p><strong>Liberada el:</strong> <%= @record.released_at %></p>
    <p><strong>Liberada por:</strong> <%= @record.released_by_user&.email || @record.released_by_user_id || "—" %></p>
    <p><strong>Motivo:</strong> <%= @record.release_reason %></p>
  <% end %>
</div>

<% unless @record.released? %>
  <div class="pe-card">
    <h3>Liberar identidad</h3>
    <p>Esta acción permite que otra cuenta vuelva a utilizar la identidad. Queda registrada en la auditoría.</p>
    <%= form_with url: release_admin_premium_identity_path(@record), method: :post, local: true do %>
      <div class="pe-form-group">
        <label>Motivo</label>
        <input type="text" name="reason" class="pe-input" required>
      </div>
      <button class="pe-btn pe-btn-danger" type="submit">Liberar identidad</button>
    <% end %>
  </div>
<% end %>

<%= link_to "Volver", admin_premium_identities_path, class: "pe-btn" %>
