<% subtitle = capture do %>
  <% if @cycle %>
    <span class="badge bg-light text-dark border" data-testid="cycle-badge">
      <i class="ti ti-calendar-plus me-1"></i><%= @cycle.label %> (<%= @cycle.range_label %>)
    </span>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("transfers.index.title"), subtitle: subtitle do %>
  <div class="d-flex gap-2">
    <%= link_to money_sources_path, class: "btn btn-outline-secondary" do %>
      <i class="ti ti-wallet me-1"></i><%= t("nav.money_sources") %>
    <% end %>
    <%= link_to new_transfer_path, class: "btn btn-primary" do %>
      <i class="ti ti-plus me-1"></i><%= t("transfers.index.new") %>
    <% end %>
  </div>
<% end %>

<div class="card mb-4">
  <div class="card-body">
    <%= form_with url: transfers_path, method: :get, class: "row g-3 align-items-end" do |f| %>
      <div class="col-6 col-md-3">
        <%= f.label :start_date, t("common.from", default: "Desde"), class: "form-label" %>
        <%= f.date_field :start_date, value: @start_date, class: "form-control" %>
      </div>
      <div class="col-6 col-md-3">
        <%= f.label :end_date, t("common.to", default: "Hasta"), class: "form-label" %>
        <%= f.date_field :end_date, value: @end_date, class: "form-control" %>
      </div>
      <div class="col-12 col-md-4 d-flex gap-2">
        <%= f.submit t("common.filter", default: "Filtrar"), class: "btn btn-outline-primary" %>
        <%= link_to t("transfers.index.back_to_current", default: "Período actual"), transfers_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<% if @transfers.any? %>
  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover ledger-table align-middle mb-0">
        <caption class="visually-hidden"><%= t("transfers.index.caption") %></caption>
        <thead class="table-light">
          <tr>
            <th scope="col"><%= t("common.date") %></th>
            <th scope="col"><%= t("transfers.new.from", default: "Desde") %></th>
            <th scope="col"><%= t("transfers.new.to", default: "Hacia") %></th>
            <th scope="col" class="text-end"><%= t("common.amount") %></th>
            <th scope="col"><%= t("transfers.new.note", default: "Nota") %></th>
            <th scope="col" class="text-end"><%= t("common.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% @transfers.each do |transfer| %>
            <tr data-testid="row" data-id="<%= transfer.id %>">
              <td class="text-nowrap"><%= l(transfer.date, format: :long) %></td>
              <td><%= transfer.from_source.name %></td>
              <td><%= transfer.to_source.name %></td>
              <td class="text-end fw-bold"><%= number_to_currency(transfer.amount) %></td>
              <td class="desc-cell" title="<%= transfer.note %>">
                <%= transfer.note.presence || "—" %>
              </td>
              <td class="text-end">
                <%= button_to transfer_path(transfer), method: :delete, class: "btn btn-sm btn-outline-danger", data: { confirm: t("transfers.index.delete_confirm") }, form: { style: "display: inline-block" } do %>
                  <i class="ti ti-trash"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="card" data-testid="empty">
    <%= render "shared/empty_state", icon: "arrows-left-right", title: t("transfers.index.empty_title"),
          text: t("transfers.index.empty_body"),
          cta: link_to(new_transfer_path, class: "btn btn-primary") { "<i class=\"ti ti-plus me-1\"></i>#{t("transfers.index.new")}".html_safe } %>
  </div>
<% end %>
