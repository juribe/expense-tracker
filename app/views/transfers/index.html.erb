<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
  <h1><i class="bi bi-arrow-left-right me-2"></i>Transfers</h1>
  <div class="d-flex gap-2">
    <%= link_to money_sources_path, class: "btn btn-outline-primary" do %>
      <i class="bi bi-wallet2 me-1"></i>Money Sources
    <% end %>
    <%= link_to new_transfer_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>New Transfer
    <% end %>
  </div>
</div>

<% if @transfers.any? %>
  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <caption class="visually-hidden">Your transfers</caption>
        <thead class="table-light">
          <tr>
            <th scope="col">Date</th>
            <th scope="col">From</th>
            <th scope="col">To</th>
            <th scope="col" class="text-end">Amount</th>
            <th scope="col">Note</th>
            <th scope="col" class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @transfers.each do |transfer| %>
            <tr data-testid="row" data-id="<%= transfer.id %>">
              <td class="text-nowrap"><%= transfer.date.strftime("%b %d, %Y") %></td>
              <td><%= transfer.from_source.name %></td>
              <td><%= transfer.to_source.name %></td>
              <td class="text-end fw-bold"><%= number_to_currency(transfer.amount) %></td>
              <td class="desc-cell" title="<%= transfer.note %>">
                <%= transfer.note.presence || "—" %>
              </td>
              <td class="text-end">
                <%= button_to transfer_path(transfer), method: :delete, class: "btn btn-sm btn-outline-danger", data: { confirm: "Delete this transfer?" }, form: { style: "display: inline-block" } do %>
                  <i class="bi bi-trash"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="card shadow-sm">
    <div class="p-5 text-center" data-testid="empty">
      <i class="bi bi-arrow-left-right display-4 text-muted mb-3 d-block"></i>
      <h4 class="mb-2">No transfers yet</h4>
      <p class="text-muted">Record transfers between your money sources.</p>
      <%= link_to new_transfer_path, class: "btn btn-primary mt-3" do %>
        <i class="bi bi-plus-lg me-1"></i>New Transfer
      <% end %>
    </div>
  </div>
<% end %>
