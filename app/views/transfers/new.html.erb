<% content_for(:back_path_path) do %><% end %>
<%= render "shared/page_header", title: t("transfers.new.title") %>
<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="card">
      <div class="card-body p-4">
        <%= form_with model: @transfer, local: true do |f| %>
          <% if @transfer.errors.any? %>
            <div class="alert alert-danger">
              <strong><%= t("transfers.new.error_prohibited", count: @transfer.errors.count) %></strong>
              <ul class="mb-0 mt-2">
                <% @transfer.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="form-section">
            <div class="form-section-title">Movimiento</div>
            <div class="row g-3">
              <div class="col-12 col-md-6">
                <%= f.label :from_source_id, t("transfers.new.from", default: "Desde"), class: "form-label" %>
                <%= f.collection_select :from_source_id, @from_sources, :id, :display_name, { include_blank: t("transfers.new.select") }, class: "form-select" %>
              </div>
              <div class="col-12 col-md-6">
                <%= f.label :to_source_id, t("transfers.new.to", default: "Hacia"), class: "form-label" %>
                <%= f.collection_select :to_source_id, @to_sources, :id, :display_name, { include_blank: t("transfers.new.select") }, class: "form-select" %>
              </div>
              <div class="col-12 col-md-6">
                <%= f.label :amount, t("common.amount"), class: "form-label" %>
                <div class="input-group">
                  <span class="input-group-text">$</span>
                  <%= f.text_field :amount,
                      value: money_field_value(@transfer.amount),
                      class: "form-control",
                      placeholder: t("transfers.new.amount_placeholder"),
                      inputmode: "decimal",
                      autocomplete: "off",
                      data: { money_input: true } %>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <%= f.label :date, class: "form-label" %>
                <%= f.date_field :date, class: "form-control" %>
              </div>
            </div>
          </div>

          <div class="form-section">
            <div class="form-section-title">Opciones</div>
            <div class="mb-2" id="assign-goal-field">
              <%= f.label :assign_goal_id, t("transfers.new.assign_to_goal", default: "Asignar a meta (opcional)"), class: "form-label" %>
              <%= f.select :assign_goal_id,
                  pocket_goal_groups(@pocket_goals),
                  { include_blank: t("transfers.new.assign_blank", default: "Solo dejar el dinero en el bolsillo") },
                  class: "form-select", id: "transfer_assign_goal_id" %>
              <div class="form-text"><%= t("transfers.new.assign_goal_hint", default: "Si eliges una meta, el dinero transferido queda reservado para ella dentro del bolsillo. No crea un gasto.") %></div>
            </div>
            <div>
              <%= f.label :note, t("transfers.new.note", default: "Nota"), class: "form-label" %>
              <%= f.text_area :note, class: "form-control", rows: 2, placeholder: t("transfers.new.note_placeholder") %>
            </div>
          </div>

          <div class="d-flex gap-2 mt-4">
            <%= f.submit t("transfers.new.submit"), class: "btn btn-primary" %>
            <%= link_to t("common.cancel", default: "Cancelar"), transfers_path, class: "btn btn-outline-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var toSelect = document.getElementById('transfer_to_source_id');
  var goalField = document.getElementById('assign-goal-field');
  var goalSelect = document.getElementById('transfer_assign_goal_id');
  if (!toSelect || !goalField || !goalSelect) return;

  function sync() {
    var pocketId = toSelect.value;
    var hasVisibleGoal = false;
    Array.prototype.forEach.call(goalSelect.options, function(option) {
      if (!option.value) return; // the blank "pocket only" choice always stays
      var visible = option.getAttribute('data-pocket-id') === pocketId;
      option.hidden = !visible;
      if (visible) hasVisibleGoal = true;
    });
    // Drop a stale selection when its goal is no longer visible.
    if (!hasVisibleGoal || goalSelect.selectedOptions[0]?.hidden) {
      goalSelect.value = "";
    }
    goalField.hidden = !hasVisibleGoal;
  }

  toSelect.addEventListener('change', sync);
  sync();
})();
</script>
