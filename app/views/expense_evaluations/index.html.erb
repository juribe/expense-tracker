<div class="container py-4" data-testid="playground-evaluation-panel">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title mb-0"><i class="ti ti-list-check me-2 text-secondary"></i><%= t("nav.evaluations") %></h1>
  </div>

  <div class="row g-4">
    <!-- Left column: form & history -->
    <div class="col-lg-5">
      <div class="card">
        <div class="card-body">
          <h5 class="mb-1"><i class="ti ti-chart-line me-2"></i><%= t("playground.evaluation_title", default: "AI Evaluation") %></h5>
          <p class="text-muted small mb-3"><%= t("evaluations.subtitle", default: "Sube un dataset CSV y evalúa el pipeline completo con un proveedor/modelo concreto.") %></p>

          <form id="pgEvalForm">
            <div class="mb-3">
              <div class="small fw-semibold mb-2">1. Dataset (CSV: message, expected_json)</div>
              <input type="file" id="pgEvalDatasetFile" accept=".csv,text/csv" class="form-control form-control-sm" data-testid="evaluation-dataset-file">
              <div class="small text-muted mt-1"><span id="pgEvalDatasetMeta"></span>A una fila por caso; se validan las filas, se rechaza cualquier vacío.</div>
            </div>
            <div class="row g-2">
              <div class="col-6">
                <div class="mb-3">
                  <div class="small fw-semibold mb-2">2. Proveedor</div>
                  <select id="pgEvalProvider" class="form-select form-select-sm" data-testid="evaluation-provider">
                    <option value="openrouter">OpenRouter</option>
                    <option value="mistral">Mistral</option>
                    <option value="flexai">FlexAI</option>
                  </select>
                </div>
              </div>
              <div class="col-6">
                <div class="mb-3">
                  <div class="small fw-semibold mb-2">3. Modelo</div>
                  <input type="text" id="pgEvalModel" class="form-control form-control-sm" placeholder="ej. mistral/mistral-small-latest" value="mistral/mistral-small-latest" data-testid="evaluation-model">
                </div>
              </div>
            </div>
            <div class="mb-3">
              <div class="small fw-semibold mb-2">4. Nombre de archivo (opcional)</div>
              <input type="text" id="pgEvalFilename" class="form-control form-control-sm" placeholder="gastos.csv" value="gastos.csv" data-testid="evaluation-filename">
            </div>
            <div class="form-check mb-3">
              <input type="checkbox" class="form-check-input" id="pgEvalForceNew" data-testid="evaluation-force-new">
              <label class="form-check-label small" for="pgEvalForceNew"><%= t("evaluations.force_new", default: "Forzar nueva ejecución (ignorar ejecuciones previas con el mismo archivo)") %></label>
            </div>

            <button type="submit" class="btn btn-primary w-100" id="pgEvalStartBtn" data-testid="evaluation-start">
              <i class="ti ti-player-play me-1"></i>Ejecutar Evaluación
            </button>
            <div class="alert alert-danger py-2 small mt-2 mb-0 d-none" id="pgEvalError"></div>
          </form>
          <div class="alert alert-info py-2 small mt-2 mb-0"><i class="ti ti-info-circle me-1"></i><%= t("evaluations.async_hint", default: "La evaluación corre en segundo fondo.<br><span class=\"text-muted\">Puedes cerrar esta página y volver más tarde.") %></div>

          <div class="mt-3">
            <div class="small fw-semibold mb-2"><i class="ti ti-history me-1"></i><%= t("evaluations.history", default: "Historial") %></div>
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead><tr><th class="small text-muted">Dataset</th><th class="small text-muted">Modelo</th><th class="small text-muted">Estado</th><th class="small text-muted text-end">Extras</th></tr></thead>
                <tbody id="pgEvalHistoryBody" data-testid="evaluation-history-body"></tbody>
              </table>
              <p class="small text-muted mb-0 d-none" id="pgEvalHistoryEmpty"><%= t("evaluations.no_history", default: "Aún no hay evaluaciones.") %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right column: results & failed cases -->
    <div class="col-lg-7">
      <div class="card d-none" id="pgEvalResults">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="mb-0"><i class="ti ti-chart-bar me-2"></i><%= t("evaluations.results", default: "Resultados de la Evaluación") %><span class="badge bg-warning-subtle text-warning ms-2" id="pgEvalRunStatus"><%= t("evaluations.in_progress", default: "En progreso") %></span></h5>
            <div class="text-end small text-muted" id="pgEvalRunMeta"></div>
          </div>
          <div class="progress mb-3" style="height: 8px;">
            <div class="progress-bar" id="pgEvalRunProgress" role="progressbar" style="width:0%"></div>
          </div>
          <div class="text-muted small mb-3" id="pgEvalRunCaption"></div>

          <div class="row g-2 mb-3">
            <div class="col-6 col-md-4 col-lg-2"><div class="border rounded p-2"><div class="small text-muted"><%= t("evaluations.total_cases", default: "Total de casos") %></div><div class="h5 mb-0" id="pgEvalTotal">—</div></div></div>
            <div class="col-6 col-md-4 col-lg-2"><div class="border rounded p-2"><div class="small text-muted"><%= t("evaluations.passed", default: "Casos exitosos") %></div><div class="h5 mb-0 text-success" id="pgEvalPassed">—</div></div></div>
            <div class="col-6 col-md-4 col-lg-2"><div class="border rounded p-2"><div class="small text-muted"><%= t("evaluations.failed", default: "Casos fallidos") %></div><div class="h5 mb-0 text-danger" id="pgEvalFailed">—</div></div></div>
            <div class="col-6 col-md-4 col-lg-2"><div class="border rounded p-2"><div class="small text-muted"><%= t("evaluations.json_valid", default: "JSON válido") %></div><div class="h5 mb-0" id="pgEvalJsonValid">—</div></div></div>
            <div class="col-6 col-md-4 col-lg-2"><div class="border rounded p-2"><div class="small text-muted"><%= t("evaluations.cost", default: "Costo") %></div><div class="h5 mb-0" id="pgEvalCost">—</div></div></div>
            <div class="col-6 col-md-4 col-lg-2"><div class="border rounded p-2"><div class="small text-muted"><%= t("evaluations.avg_latency", default: "Latencia promedio") %></div><div class="h5 mb-0" id="pgEvalLatency">—</div></div></div>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <div class="border rounded p-3">
                <div class="small fw-semibold mb-2"><%= t("evaluations.field_accuracy", default: "Precisión por campo") %></div>
                <div id="pgEvalFieldAccuracy" class="small"></div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="border rounded p-3">
                <div class="small fw-semibold mb-2"><i class="ti ti-scale me-1"></i><%= t("evaluations.compare_models", default: "Comparar Modelos") %></div>
                <div class="table-responsive">
                  <table class="table table-sm">
                    <thead><tr><th>Modelo</th><th>Accuracy</th><th>JSON válido</th><th>Latencia</th><th>Costo</th></tr></thead>
                    <tbody id="pgEvalCompareBody"></tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="card mt-3 d-none" id="pgEvalFailedWrap">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="small fw-semibold"><i class="ti ti-alert-triangle text-danger me-1"></i><%= t("evaluations.failed_cases", default: "Casos fallidos") %> <span class="badge bg-danger" id="pgEvalFailedCount">0</span></div>
            <div class="d-flex gap-2">
              <select class="form-select form-select-sm" style="width:auto" id="pgEvalFailedStatus" data-testid="evaluation-failed-status">
                <option value="failed"><%= t("evaluations.failed_status", default: "Fallidos") %></option>
                <option value="error"><%= t("evaluations.error_status", default: "Error") %></option>
                <option value="passed"><%= t("evaluations.passed_status", default: "Exitosos") %></option>
              </select>
              <input type="search" class="form-control form-control-sm" style="width:auto" placeholder="<%= t('evaluations.search_placeholder', default: 'Buscar por mensaje…') %>" id="pgEvalFailedQuery" data-testid="evaluation-failed-query">
              <button class="btn btn-sm btn-outline-secondary" id="pgEvalFailedRefresh"><%= t("evaluations.filter", default: "Filtrar") %></button>
            </div>
          </div>
          <p class="small text-muted d-none" id="pgEvalFailedHint"><%= t("evaluations.case_hint", default: "Haz clic en una fila para revisar esperado vs. recibido y decidir la categoría. El mapeo quedará guardado como conocimiento.") %></p>
          <div class="small d-flex flex-wrap gap-2 mb-2" id="pgEvalFailedSummary"></div>
          <div class="table-responsive">
            <table class="table table-sm align-middle">
              <thead><tr><th>#</th><th>Mensaje</th><th>Esperado</th><th>Actual</th><th>Campos fallidos</th><th>Latencia</th><th>Tokens</th><th>Costo</th></tr></thead>
              <tbody id="pgEvalFailedBody" data-testid="evaluation-failed-body"></tbody>
            </table>
            <p class="small text-muted mb-0 d-none" id="pgEvalFailedEmpty"><%= t("evaluations.no_matching", default: "Sin casos que coincidan.") %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<%= javascript_include_tag "expense_evaluations_index", defer: true %>

