<%= content_for :head do %>
  <%= stylesheet_link_tag :profile, "data-turbo-track": "reload" %>
  <%= javascript_include_tag "profile", defer: true %>
<% end %>

<div class="profile-page">
  <%= render "shared/page_header", title: "Mi perfil", subtitle: "Administra tu información y revisa tu membresía de Yogasto." %>

  <section class="layout">
    <div class="col-left">
      <article class="card">
        <div class="card-head">
          <h2>Información personal</h2>
        <span class="head-note">Tu cuenta</span>
      </div>
      <div class="profile-main">
        <div class="identity">
          <div class="big-avatar"><%= user_initials(current_user) %></div>
          <div>
            <h3><%= current_user.name.presence || current_user.email %></h3>
            <p>Tu espacio personal en Yogasto</p>
            <div class="verified">
              <% if current_user.confirmed_at.present? %>
                ✓ Cuenta activa
              <% else %>
                ⏳ Cuenta pendiente de confirmación
              <% end %>
            </div>
          </div>
        </div>
        <div class="details">
          <div class="field">
            <label>Nombre completo</label>
            <div><%= current_user.name.presence || "—" %></div>
          </div>
          <div class="field">
            <label>Correo electrónico</label>
            <div><%= current_user.email %></div>
          </div>
          <div class="field">
            <label>Miembro desde</label>
            <div><%= current_user.created_at.present? ? l(current_user.created_at, format: :long) : "—" %></div>
          </div>
          <div class="field">
            <label>Seguridad</label>
            <div><%= current_user.encrypted_password.present? ? "Contraseña configurada" : "Sin contraseña configurada" %></div>
          </div>
        </div>
      </div>
      <div class="actions">
        <%= link_to "Editar perfil", edit_user_registration_path, class: "btn btn-primary" %>
      </div>
      </article>

      <article class="card communications" data-testid="marketing-consent-card">
        <div class="card-head">
          <h2><%= t("profile.communications.title") %></h2>
          <span class="head-note"><%= t("profile.communications.note") %></span>
        </div>
        <div class="communications-body">
          <p class="communications-description"><%= t("profile.communications.description") %></p>

          <%= form_with url: profile_communications_path,
                        method: :patch,
                        class: "communications-form",
                        data: { testid: "marketing-consent-form" } do %>
            <%= hidden_field_tag "user[marketing_consent]", "0" %>
            <label class="communications-toggle" for="user_marketing_consent">
              <%= check_box_tag "user[marketing_consent]", "1", @marketing_consent&.granted?,
                                id: "user_marketing_consent",
                                class: "communications-check" %>
              <span><%= t("profile.communications.checkbox_label") %></span>
            </label>
            <button type="submit" class="btn btn-outline">
              <%= t("profile.communications.save") %>
            </button>
          <% end %>

          <p class="communications-meta">
            <% if @marketing_consent %>
              <%= t("profile.communications.status_label") %>:
              <strong><%= @marketing_consent.granted? ? t("profile.communications.granted") : t("profile.communications.withdrawn") %></strong>
              · <%= l(@marketing_consent.occurred_at, format: :long) %>
            <% else %>
              <%= t("profile.communications.no_record") %>
            <% end %>
          </p>
        </div>
      </article>

      <section class="card danger">
        <div>
          <h2>¿Quieres dejar Yogasto?</h2>
          <p>Si decides cancelar tu cuenta, se eliminará tu acceso y la información asociada según nuestra <a href="/eliminacion-de-datos">política de eliminación de datos</a>. Esta acción es permanente.</p>
        </div>
        <%= form_with url: registration_path(:user), method: :delete, local: true do %>
          <div class="mb-2">
            <%= label_tag :current_password, "Contraseña actual", class: "form-label" %>
            <%= password_field_tag :current_password, nil, class: "form-control",
                  required: true, autocomplete: "current-password" %>
          </div>

          <% if current_user.second_factor_enabled? %>
            <div class="mb-2">
              <%= label_tag :totp_code, "Código de verificación", class: "form-label" %>
              <%= text_field_tag :totp_code, nil, class: "form-control",
                    inputmode: "numeric", autocomplete: "one-time-code" %>
            </div>
            <div class="mb-2">
              <%= label_tag :recovery_code, "o un código de recuperación", class: "form-label" %>
              <%= text_field_tag :recovery_code, nil, class: "form-control", autocomplete: "off" %>
            </div>
          <% end %>

          <div class="mb-2">
            <%= label_tag :confirmation, "Escribe ELIMINAR para confirmar", class: "form-label" %>
            <%= text_field_tag :confirmation, nil, class: "form-control",
                  required: true, autocomplete: "off" %>
          </div>

          <%= submit_tag "Cancelar mi cuenta", class: "btn btn-danger",
                data: { turbo_confirm: "¿Estás seguro?" } %>
        <% end %>
      </section>
    </div>

    <aside class="right">
      <article class="card membership">
        <div class="card-head">
          <h2>Tu membresía</h2>
          <span class="head-note">Plan actual</span>
        </div>
        <div class="member-banner">
          <div class="member-top">
            <span class="plan-tag">
              <%= current_membership&.membership_type&.name&.upcase || "SIN MEMBRESÍA" %>
            </span>
            <span class="status">
              <i class="dot"></i>
              <% if current_membership&.active? %>
                Activa
              <% else %>
                No activa
              <% end %>
            </span>
          </div>
          <div class="plan-title">
            <%= current_membership&.membership_type&.name || "—" %>
          </div>
          <p class="plan-desc">
            <%= current_membership&.membership_type&.description.presence || "Todo lo esencial para tener tus finanzas en orden." %>
          </p>
        </div>
        <div class="member-body">
          <div class="renew-row">
            <span>Activa hasta</span>
            <strong>
              <% if current_membership&.expires_at.present? %>
                <%= l(current_membership.expires_at, format: :long) %>
              <% else %>
                —
              <% end %>
            </strong>
          </div>
          <div class="progress-label">
            <span>Tu membresía</span>
            <span><%= current_membership&.active? ? "Vigente" : "No vigente" %></span>
          </div>
          <div class="progress"><span data-progress="<%= membership_progress_percent(current_membership) %>"></span></div>
          <div class="member-actions">
            <%= link_to "Ver planes", plans_path, class: "btn btn-primary" %>
            <%= link_to "Detalles", plans_path, class: "btn btn-outline" %>
          </div>
        </div>
      </article>

      <article class="card quick-card">
        <h2>Accesos de tu cuenta</h2>
        <p>Encuentra rápidamente las opciones para administrar tu cuenta.</p>
        <a class="quick-link" href="<%= edit_user_registration_path %>">
          <span>
            <strong>Editar mis datos</strong>
            <small>Nombre, correo y contraseña</small>
          </span>
          <span class="arrow">›</span>
        </a>
        <a class="quick-link" href="<%= plans_path %>">
          <span>
            <strong>Comparar membresías</strong>
            <small>Conoce lo que incluye cada plan</small>
          </span>
          <span class="arrow">›</span>
        </a>
        <a class="quick-link" href="<%= security_settings_path %>">
          <span>
            <strong>Seguridad de la cuenta</strong>
            <small>Passkeys, verificación en dos pasos y códigos de recuperación</small>
          </span>
          <span class="arrow">›</span>
        </a>
      </article>
    </aside>
  </section>

  <div class="footer">Yogasto · Tus finanzas, más claras.</div>
</div>