<article class="card rules-card h-100 w-100 <%= "is-disabled" unless rule.enabled? %>">
  <div class="card-body">
    <div class="rules-card-head">
      <div class="min-w-0">
        <h3 class="rules-card-title"><%= rule.title %></h3>
        <span class="rules-card-status <%= "is-off" unless rule.enabled? %>" data-testid="rule-status">
          <%= rule.enabled? ? t("transaction_rules.enabled") : t("transaction_rules.disabled") %>
        </span>
      </div>

      <div class="rules-card-switch">
        <%= form_with model: rule, url: toggle_active_transaction_rule_path(rule), method: :patch, local: true do |form| %>
          <div class="form-check form-switch mb-0">
            <%= form.check_box :enabled, class: "form-check-input", role: "switch", checked: rule.enabled?, data: { auto_submit: true }, aria: { label: t("transaction_rules.toggle_aria", name: rule.title) } %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="rules-card-condition">
      <div class="rules-card-condition-label"><%= t("transaction_rules.condition_card_label") %></div>
      <div class="rules-condition-line">
        <span class="rules-condition-type">
          <i class="ti <%= rule_condition_icon(rule) %> me-1" aria-hidden="true"></i><%= rule_condition_text(rule) %>
        </span>
        <span class="rules-match-value"><%= rule_condition_value(rule) %></span>
      </div>
    </div>

    <% actions = rule_actions(rule) %>
    <% if actions.any? %>
      <div class="rules-card-results">
        <% actions.each do |action| %>
          <div class="rules-result-row">
            <span class="rules-result-label">
              <i class="ti ti-arrow-right" aria-hidden="true"></i><%= action[:label] %>
            </span>
            <span class="rules-result-pill">
              <i class="<%= action[:icon] %>" aria-hidden="true"></i><%= action[:value] %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="card-footer rules-card-actions d-flex justify-content-end gap-2">
    <%= link_to edit_transaction_rule_path(rule), class: "btn btn-sm btn-outline-primary", title: t("common.edit"), aria: { label: t("transaction_rules.edit_aria", name: rule.title) } do %>
      <i class="ti ti-pencil"></i><span class="ms-1"><%= t("transaction_rules.edit") %></span>
    <% end %>
    <%= button_to transaction_rule_path(rule), method: :delete, class: "btn btn-sm btn-outline-danger", title: t("common.delete"), aria: { label: t("transaction_rules.delete_aria", name: rule.title) }, data: { confirm: t("transaction_rules.delete_confirm") }, form: { data: { turbo: true } } do %>
      <i class="ti ti-trash"></i><span class="ms-1"><%= t("transaction_rules.delete") %></span>
    <% end %>
  </div>
</article>
