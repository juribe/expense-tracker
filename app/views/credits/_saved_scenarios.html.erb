<div class="card">
  <div class="card-body">
    <h5 class="card-title mb-3"><i class="ti ti-stack-2 me-2"></i><%= t("credits.simulators.title") %></h5>
    <% if @loan.credit_scenarios.empty? %>
      <p class="text-muted mb-0">
        <i class="ti ti-inbox me-1"></i>
        <%= t("credits.simulators.empty") %>
      </p>
    <% else %>
      <% if @loan.credit_scenarios.count >= CreditScenario::MAX_PER_CREDIT %>
        <div class="alert alert-info small py-2"><i class="ti ti-info-circle me-1"></i><%= t("credits.simulators.limit_reached") %></div>
      <% end %>
      <% @loan.credit_scenarios.order(:created_at).each do |scenario| %>
        <% results = scenario.results %>
        <div class="border rounded p-3 mb-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
              <span class="fw-bold"><%= scenario.name %></span>
              <span class="badge bg-light text-dark ms-1"><%= t("credits.scenarios.kinds.#{scenario.kind}", default: scenario.kind.humanize) %></span>
            </div>
            <%= button_to money_source_credit_scenario_path(@loan, scenario), method: :delete,
                          form_class: "d-inline", class: "btn btn-outline-danger btn-sm",
                          data: { turbo_confirm: t("credits.scenarios.delete_confirm") } do %>
              <i class="ti ti-trash"></i>
            <% end %>
          </div>

          <div class="row g-2 small">
            <div class="col-6 col-md-4">
              <div class="text-muted"><%= t("credits.simulators.results.new_payoff") %></div>
              <div class="fw-bold"><%= payoff_label(results["payoff_date"]) %></div>
            </div>
            <div class="col-6 col-md-4">
              <div class="text-muted"><%= t("credits.simulators.results.eliminated") %></div>
              <div class="fw-bold"><%= results["installments_eliminated"].to_i %></div>
            </div>
            <div class="col-6 col-md-4">
              <div class="text-muted"><%= t("credits.simulators.results.new_total") %></div>
              <div class="fw-bold">
                <% if results["new_total_payment"].present? %>
                  <%= number_to_currency(results["new_total_payment"].to_d) %>
                <% else %>
                  <%= number_to_currency(results["installment_amount"].to_d) %>
                <% end %>
              </div>
            </div>
            <div class="col-6 col-md-4">
              <div class="text-muted"><%= t("credits.simulators.results.saved") %></div>
              <div class="fw-bold text-success"><%= number_to_currency(results["interest_saved"].to_d) %></div>
            </div>
            <div class="col-6 col-md-4">
              <div class="text-muted"><%= t("credits.simulators.results.extra_cash") %></div>
              <div class="fw-bold"><%= number_to_currency(results["extra_cash"].to_d) %></div>
            </div>
            <% if scenario.kind == "prepay_installments" %>
              <div class="col-6 col-md-4">
                <div class="text-muted"><%= t("credits.simulators.results.months_without_payment") %></div>
                <div class="fw-bold"><%= results["months_without_payment"].to_i %></div>
              </div>
            <% elsif results["new_installment"].present? %>
              <div class="col-6 col-md-4">
                <div class="text-muted"><%= t("credits.simulators.results.new_installment") %></div>
                <div class="fw-bold"><%= number_to_currency(results["new_installment"].to_d) %></div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
