<%
  # Personalized results of the transient quick comparison (Credits::Comparison.quick).
  # The headline answers the goal the user picked (lower payment / finish
  # earlier / prepay installments); a bigger interest saver is only offered as
  # a secondary recommendation. Nothing here is persisted.
  result = credit_quick_result(quick, params[:goal])
  limit_reached = @loan.credit_scenarios.count >= CreditScenario::MAX_PER_CREDIT
%>
<div class="mt-4" id="quick-results" data-testid="quick-results" tabindex="-1">
  <div class="d-flex justify-content-between align-items-start gap-3">
    <span class="text-uppercase text-secondary small fw-semibold"><%= t("credits.quick.result.eyebrow") %></span>
    <span class="badge bg-primary-subtle text-primary text-nowrap"><%= result[:tag] %></span>
  </div>
  <h5 class="card-title mb-1"><%= result[:title] %></h5>
  <p class="text-muted small mb-3"><%= result[:intro] %></p>

  <div class="row g-3 mb-3" data-testid="quick-metrics">
    <div class="col-12 col-md-4">
      <div class="card h-100 border-primary" data-testid="quick-primary">
        <div class="card-body">
          <%= render "shared/stat", label: result[:primary][:label],
                                    value: result[:primary][:value],
                                    delta: result[:primary][:detail] %>
        </div>
      </div>
    </div>
    <div class="col-12 col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <%= render "shared/stat", label: result[:interest][:label],
                                    value: result[:interest][:value],
                                    tone: result[:interest][:tone],
                                    delta: result[:interest][:detail] %>
        </div>
      </div>
    </div>
    <div class="col-12 col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <%= render "shared/stat", label: result[:third][:label],
                                    value: result[:third][:value],
                                    delta: result[:third][:detail] %>
        </div>
      </div>
    </div>
  </div>

  <% if result[:recommendation] %>
    <div class="alert alert-info d-flex gap-2 align-items-start mb-3" data-testid="quick-recommendation">
      <i class="ti ti-sparkles mt-1" aria-hidden="true"></i>
      <p class="mb-0">
        <%= result[:recommendation][:text] %>
        <% if result[:recommendation][:target_goal] %>
          <button type="button" class="btn btn-link btn-sm p-0 align-baseline"
                  data-quick-goal="<%= result[:recommendation][:target_goal] %>"><%= result[:recommendation][:link] %></button>
        <% end %>
      </p>
    </div>
  <% end %>

  <div class="mb-2">
    <h6 class="section-title mb-0"><%= t("credits.quick.result.alternatives_title") %></h6>
    <span class="text-muted small"><%= t("credits.quick.result.alternatives_lead") %></span>
  </div>

  <div class="row g-3 mb-3" data-testid="quick-strategy-cards">
    <% result[:alternatives].each do |alternative| %>
      <div class="col-12 col-md-4" id="credit-strategy-<%= alternative[:key] %>">
        <div class="card h-100<%= " border-primary" if alternative[:chosen] %>">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
              <h6 class="card-title mb-0"><%= alternative[:label] %></h6>
              <div class="d-flex flex-column align-items-end gap-1">
                <% if alternative[:chosen] %><span class="badge bg-primary" data-testid="quick-chosen"><%= t("credits.quick.result.chosen_tag") %></span><% end %>
                <% if alternative[:best] %><span class="badge bg-success" data-testid="quick-best"><%= t("credits.quick.result.best_tag") %></span><% end %>
                <% unless alternative[:chosen] || alternative[:best] %><span class="badge bg-secondary"><%= t("credits.quick.result.other_tag") %></span><% end %>
              </div>
            </div>
            <% if quick.mode == "recurring" %>
              <span class="badge bg-primary align-self-start mb-2"><%= t("credits.quick.mode_recurring_badge") %></span>
            <% end %>
            <p class="text-muted small mb-3"><%= alternative[:description] %></p>

            <div class="mt-auto">
              <div class="small text-muted"><%= t("credits.quick.result.savings_line") %></div>
              <div class="fw-bold num<%= " text-success" if alternative[:best] %>"><%= alternative[:savings] %></div>
              <div class="d-flex gap-2 align-items-center mt-2">
                <% unless alternative[:chosen] %>
                  <button type="button" class="btn btn-sm btn-outline-primary"
                          data-quick-goal="<%= alternative[:key] %>">
                    <i class="ti ti-arrow-right me-1"></i><%= t("credits.quick.result.choose") %>
                  </button>
                <% end %>
                <%= button_to money_source_credit_scenarios_path(@loan),
                              method: :post,
                              form_class: "ms-auto",
                              class: "btn btn-sm btn-link text-decoration-none",
                              disabled: limit_reached,
                              params: { kind: alternative[:key], amount: quick.amount.to_s,
                                        repeat_every: (quick.mode == "recurring" ? 1 : nil) }.compact do %>
                  <i class="ti ti-bookmark me-1"></i><%= t("credits.quick.save") %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <p class="text-muted small mb-2"><%= t("credits.quick.result.fine") %></p>

  <details class="border rounded p-3" data-testid="quick-full-comparison">
    <summary class="fw-semibold"><%= t("credits.quick.full_comparison") %></summary>
    <div class="table-responsive mt-3">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th></th>
            <th class="text-end"><%= t("credits.quick.current") %></th>
            <% recurring_mode = quick.mode == "recurring" %>
            <% quick.strategies.each do |strategy| %>
              <th class="text-end">
                <span class="d-block fw-bold">
                  <%= t("credits.simulators.strategies.#{strategy["strategy"]}") %>
                  <% if recurring_mode %>
                    <span class="badge bg-primary"><%= t("credits.quick.mode_recurring_badge") %></span>
                  <% end %>
                </span>
                <span class="d-block small text-muted fw-normal"><%= t("credits.simulators.strategy_hint.#{strategy["strategy"]}") %></span>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="text-muted"><%= t("credits.comparison.metrics.extra") %></td>
            <td class="text-end">—</td>
            <% quick.strategies.each do |strategy| %>
              <td class="text-end fw-bold"><%= number_to_currency(quick.amount) %></td>
            <% end %>
          </tr>
          <tr>
            <td class="text-muted"><%= t("credits.comparison.metrics.payment") %></td>
            <td class="text-end"><%= number_to_currency(quick.current["payment"].to_d) %></td>
            <% quick.strategies.each do |strategy| %>
              <td class="text-end <%= "fw-bold text-success" if strategy["interest_saved"].to_d > 0 && strategy["payment"].to_d < quick.current["payment"].to_d %>">
                <%= number_to_currency(strategy["payment"].to_d) %>
              </td>
            <% end %>
          </tr>
          <tr>
            <td class="text-muted"><%= t("credits.comparison.metrics.installments") %></td>
            <td class="text-end"><%= quick.current["installments"] %></td>
            <% quick.strategies.each do |strategy| %>
              <td class="text-end">
                <%= strategy["installments"] %>
                <% if strategy["installments_eliminated"].to_i.positive? %>
                  <span class="badge bg-success ms-1">−<%= strategy["installments_eliminated"] %></span>
                <% end %>
              </td>
            <% end %>
          </tr>
          <tr>
            <td class="text-muted"><%= t("credits.comparison.metrics.interest") %></td>
            <td class="text-end"><%= number_to_currency(quick.current["future_interest"].to_d) %></td>
            <% quick.strategies.each do |strategy| %>
              <td class="text-end"><%= number_to_currency(strategy["future_interest"].to_d) %></td>
            <% end %>
          </tr>
          <tr class="table-light">
            <td class="fw-bold"><%= t("credits.comparison.metrics.saved") %></td>
            <td class="text-end">—</td>
            <% best_savings = quick.strategies.max_by { |s| s["interest_saved"].to_d } %>
            <% quick.strategies.each do |strategy| %>
              <td class="text-end fw-bold <%= "text-success" if strategy["interest_saved"].to_d.positive? %> <%= "table-success" if strategy == best_savings && strategy["interest_saved"].to_d.positive? %>">
                <%= strategy["interest_saved"].to_d.positive? ? number_to_currency(strategy["interest_saved"].to_d) : "—" %>
              </td>
            <% end %>
          </tr>
          <tr>
            <td class="text-muted"><%= t("credits.comparison.metrics.payoff") %></td>
            <td class="text-end"><%= payoff_label(quick.current["payoff_date"]) %></td>
            <% quick.strategies.each do |strategy| %>
              <td class="text-end"><%= payoff_label(strategy["payoff_date"]) %></td>
            <% end %>
          </tr>
          <tr>
            <td class="text-muted"><%= t("credits.comparison.metrics.without_payment") %></td>
            <td class="text-end">0</td>
            <% quick.strategies.each do |strategy| %>
              <td class="text-end">
                <% if strategy["months_without_payment"].to_i.positive? %>
                  <span class="badge bg-info text-dark"><%= strategy["months_without_payment"] %></span>
                <% else %>0<% end %>
              </td>
            <% end %>
          </tr>
        </tbody>
      </table>
    </div>
  </details>

  <p class="text-muted small mb-0 mt-3"><i class="ti ti-info-circle me-1"></i><%= t("credits.quick.disclaimer") %></p>
</div>
