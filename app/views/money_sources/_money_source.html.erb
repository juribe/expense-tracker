<div class="col-12 col-md-6 col-lg-4">
  <div class="card <%= source.debt? ? 'card-debt' : '' %> h-100 shadow-sm">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
          <h5 class="card-title mb-0">
            <i class="bi bi-<%= source_kind_icon(source.kind) %> me-1"></i>
            <%= link_to source.name, money_source_path(source), class: "text-decoration-none" %>
          </h5>
          <small class="text-muted"><%= source_kind_label(source.kind) %></small>
          <% if source.bank.present? %>
            <small class="text-muted d-block"><i class="bi bi-bank me-1"></i><%= source.bank %></small>
          <% end %>
          <% card_id_parts = [ source.card_brand, source.card_last_four ].compact_blank %>
          <% if source.credit_card? && card_id_parts.any? %>
            <span class="badge bg-light text-dark mt-1"><%= card_id_parts.join(" · ") %></span>
          <% end %>
        </div>
        <div class="btn-group btn-group-sm d-print-none" role="group" aria-label="<%= source.name %>">
          <%= link_to edit_money_source_path(source), class: "btn btn-outline-primary", title: t("common.edit"), aria: { label: t("common.edit") } do %>
            <i class="bi bi-pencil"></i>
          <% end %>
          <%= button_to money_source_path(source), method: :delete, class: "btn btn-outline-danger", title: t("common.delete"), data: { confirm: t("common.confirm") }, form: { style: "display: inline-block" } do %>
            <i class="bi bi-trash"></i>
          <% end %>
        </div>
      </div>

      <div class="mt-3">
        <% if source.credit_card? %>
          <div class="small text-muted mb-1"><%= t("money_sources.index.available_credit") %></div>
          <% if source.credit_limit.to_i > 0 %>
            <div class="fs-5 fw-bold <%= source.available_credit.to_f > source.used_credit ? 'text-success' : 'text-danger' %>">
              <%= number_to_currency(source.available_credit) %>
              <span class="text-muted fw-normal fs-6"><%= t("money_sources.index.credit_of", limit: number_to_currency(source.credit_limit)) %></span>
            </div>
            <div class="progress mt-2" role="progressbar" aria-label="<%= t("money_sources.index.used_credit") %>" aria-valuenow="<%= source.credit_utilization %>" aria-valuemin="0" aria-valuemax="100" style="height: 8px;">
              <div class="progress-bar <%= credit_utilization_class(source.credit_utilization) %>" style="width: <%= [ source.credit_utilization, 100 ].min %>%"></div>
            </div>
            <div class="d-flex justify-content-between mt-2 small">
              <span class="fw-bold text-danger"><%= t("money_sources.index.used_credit") %> <%= number_to_currency(source.used_credit) %></span>
              <span class="text-muted"><%= source.credit_utilization %>%</span>
            </div>
          <% else %>
            <div class="fs-5 fw-bold text-danger"><%= t("money_sources.index.current_debt") %> <%= number_to_currency(source.used_credit) %></div>
          <% end %>
          <div class="small text-muted d-flex flex-wrap gap-2 mt-2">
            <% if source.interest_rate.present? %>
              <span><i class="bi bi-percent me-1"></i><%= source.interest_rate_label %></span>
            <% end %>
            <% if source.statement_day.present? %>
              <span><i class="bi bi-calendar-event me-1"></i><%= t("money_sources.index.statement_day", day: source.statement_day) %></span>
            <% end %>
            <% if source.payment_due_day.present? %>
              <span><i class="bi bi-calendar-check me-1"></i><%= t("money_sources.index.payment_due_day", day: source.payment_due_day) %></span>
            <% end %>
          </div>
        <% elsif source.loan? %>
          <div class="small text-muted mb-1"><%= t("money_sources.index.outstanding_balance") %></div>
          <div class="fs-5 fw-bold text-danger"><%= number_to_currency(source.outstanding_balance) %></div>
          <% if source.principal_amount.to_i > 0 %>
            <div class="progress mt-2" role="progressbar" aria-label="<%= t("money_sources.index.outstanding_balance") %>" aria-valuenow="<%= source.repayment_progress %>" aria-valuemin="0" aria-valuemax="100" style="height: 8px;">
              <div class="progress-bar bg-success" style="width: <%= [ 100 - source.repayment_progress, 0 ].max %>%"></div>
            </div>
            <div class="d-flex justify-content-between mt-2 small">
              <span class="text-muted"><%= t("money_sources.index.original_amount") %> <%= number_to_currency(source.principal_amount) %></span>
              <span class="text-muted"><%= t("money_sources.index.repaid", pct: 100 - source.repayment_progress) %></span>
            </div>
          <% end %>
          <div class="small text-muted d-flex flex-wrap gap-2 mt-2">
            <% if source.interest_rate.present? %>
              <span><i class="bi bi-percent me-1"></i><%= source.interest_rate_label %></span>
            <% end %>
            <% if source.installment_amount.present? %>
              <span><i class="bi bi-cash-stack me-1"></i><%= number_to_currency(source.installment_amount) %><%= source.payment_frequency.present? ? "/#{t("money_sources.form.frequency.#{source.payment_frequency}")}" : "" %></span>
            <% end %>
            <% if source.remaining_installments.present? %>
              <span><i class="bi bi-arrow-repeat me-1"></i><%= t("money_sources.index.remaining_installments", count: source.remaining_installments, total: source.installment_count) %></span>
            <% end %>
          </div>
        <% else %>
          <div class="small text-muted mb-1"><%= t("money_sources.index.balance") %></div>
          <div class="fs-5 fw-bold text-success">
            <%= source.balance_label %>
          </div>
          <% if source.debit_card? && source.parent %>
            <small class="text-muted"><%= t("money_sources.index.linked_to", name: source.parent.name) %></small>
          <% end %>
        <% end %>
      </div>

      <% if source.tags.any? %>
        <div class="mt-2">
          <% source.tags.each do |tag| %>
            <span class="badge bg-light text-dark me-1">
              <%= tag.value %>
            </span>
          <% end %>
        </div>
      <% end %>

      <div class="mt-2">
        <small class="text-muted">
          <%= t("money_sources.index.transactions_count", count: source.transactions.count) %>
          <% if source.children.any? %>
            · <%= t("money_sources.index.linked_cards_count", count: source.children.count) %>
          <% end %>
        </small>
      </div>

      <% unless source.active? %>
        <span class="badge bg-secondary mt-2"><%= t("common.inactive", default: "Inactiva") %></span>
      <% end %>
    </div>
  </div>
</div>
