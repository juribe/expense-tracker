<%= render "shared/unfinished_setup_banner", setup: @setup %>

<header class="loans-header loans-toolbar d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
  <div>
    <h1 class="loans-title"><i class="bi bi-cash-coin" aria-hidden="true"></i><%= t("money_sources.index.loans_title") %></h1>
    <p class="loans-subtitle"><%= t("money_sources.loans.subtitle") %></p>
  </div>
  <div class="loans-actions flex-wrap">
    <%= link_to new_transfer_path, class: "btn btn-outline-primary" do %>
      <i class="bi bi-arrow-left-right" aria-hidden="true"></i><%= t("money_sources.index.new_transfer") %>
    <% end %>
    <%= link_to new_money_source_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg" aria-hidden="true"></i><%= t("money_sources.index.new") %>
    <% end %>
  </div>
</header>

<% if @money_sources.any? %>
  <section class="loans-grid" aria-label="<%= t("money_sources.index.loans_title") %>">
    <% @money_sources.each do |source| %>
      <%= render partial: "loan_card", locals: { source: source } %>
    <% end %>
  </section>

  <%= render "loans_summary", loans: @money_sources %>
<% else %>
  <div class="card shadow-sm">
    <div class="p-5 text-center">
      <i class="bi bi-cash-coin display-4 text-muted mb-3 d-block"></i>
      <h4 class="mb-2"><%= t("money_sources.index.loans_empty_title") %></h4>
      <p class="text-muted"><%= t("money_sources.index.loans_empty_body") %></p>
      <%= link_to new_money_source_path, class: "btn btn-primary mt-3" do %>
        <i class="bi bi-plus-lg me-1"></i><%= t("money_sources.index.new") %>
      <% end %>
    </div>
  </div>
<% end %>
