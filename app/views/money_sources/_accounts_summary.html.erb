<%# Accounts dashboard summary card. Locals: sources (array of MoneySource). %>
<%
  sources = Array(sources)
  total_balance = sources.sum { |s| s.balance.to_d }
  account_count = sources.count { |s| s.kind == "account" }
  debit_count = sources.count { |s| s.debit_card? }
  total_txns = sources.sum { |s| s.transactions.count }
  summaries = [
    { icon: "wallet2", label: t("money_sources.accounts.summary_total"), value: number_to_currency(total_balance) },
    { icon: "bank", label: t("money_sources.accounts.summary_accounts"), value: number_with_delimiter(account_count) },
    { icon: "credit-card", label: t("money_sources.accounts.summary_debit_cards"), value: number_with_delimiter(debit_count) },
    { icon: "receipt", label: t("money_sources.accounts.summary_transactions"), value: number_with_delimiter(total_txns) }
  ]
%>
<section class="loans-summary" data-testid="accounts-summary">
  <div class="loans-summary-head">
    <h2><%= t("money_sources.accounts.summary_title") %></h2>
    <p><%= t("money_sources.accounts.summary_subtitle") %></p>
  </div>
  <div class="loans-summary-metrics">
    <% summaries.each do |metric| %>
      <div class="loans-summary-metric">
        <div class="loans-summary-icon" aria-hidden="true"><i class="bi bi-<%= metric[:icon] %>"></i></div>
        <div class="loans-summary-label"><%= metric[:label] %></div>
        <div class="loans-summary-value"><%= metric[:value] %></div>
      </div>
    <% end %>
  </div>
</section>
