<%#
  "Reconocimiento de fuentes" — real implementation.
  Lists all Money Sources with their recognition status. Clicking Edit opens a
  right-side drawer (table stays visible behind) to configure keywords /
  senders+domains / subject+header patterns as removable chips. Inside each
  section the drawer distinguishes CONFIRMED chips from SUGGESTED ones
  (computed from the source name / same-institution siblings, or discovered
  by Gmail syncs and persisted as suggestions). The user accepts or ignores
  each suggestion; nothing is confirmed silently.
%>
<%
  # Only payment sources are listed here (see MoneySourcesController#recognition);
  # loans and pockets can never hold recognition.
  kind_badges = {
    "credit_card" => { label: t("kinds.credit_card"), class: "recognition-badge-type" },
    "account" => { label: t("kinds.account"), class: "recognition-badge-account" },
    "debit_card" => { label: t("kinds.debit_card"), class: "recognition-badge-account" },
    "cash" => { label: t("kinds.cash"), class: "recognition-badge-account" },
    "wallet" => { label: t("kinds.wallet"), class: "recognition-badge-account" },
    "pocket" => { label: t("kinds.pocket"), class: "recognition-badge-account" }
  }

  # Collapsed accordions: bodies are server-rendered and only shown under the
  # `expanded` class (toggled by JS), so Capybara assertions keep working.
  # Bank groups auto-expand only when the edited source/bank belongs to them;
  # the Gmail card auto-expands while a scan is running.
  gmail_expanded = @gmail_connection&.sync_running? ? true : false
  group_expanded = lambda do |group|
    Array(group[:members]).any? { |member| member == @editing } || @bank_editing == group[:key]
  end
  # Last four per source, controller-provided: identifier-less credit cards
  # resolve through @recognition_last_fours (loaded per kind) so the
  # credit_account fallback is never touched while rendering.
  confirmed_keyword_text = lambda do |source|
    values = source.recognition_identifiers
                   .select { |id| id.keyword? && id.confirmed? }
                   .sort_by(&:position).map(&:value)
    four = if source.credit_card? && source.identifier.blank?
      @recognition_last_fours[source.id]
    else
      source.last_four
    end
    values << "•••• #{four}" if four.present?
    values.join(", ").presence
  end
  status_suggestions_count = lambda do |source|
    source.recognition_identifiers.count(&:suggested?)
  end

  keywords = @editing&.recognition_identifiers&.select { |id| id.keyword? && id.confirmed? }&.sort_by(&:position) || []
  senders  = @editing&.recognition_identifiers&.select { |id| (id.sender? || id.domain?) && id.confirmed? }&.sort_by(&:position) || []
  subjects = @editing&.recognition_identifiers&.select { |id| (id.subject? || id.header?) && id.confirmed? }&.sort_by(&:position) || []
  suggestions = @suggestions || {}
  section_suggestions = {
    "keywords" => Array(suggestions[:keywords]),
    "senders"  => Array(suggestions[:senders]),
    "subjects" => Array(suggestions[:subjects])
  }
%>

<header class="recognition-header">
  <div class="recognition-header-icon" aria-hidden="true"><i class="ti ti-mail"></i></div>
  <div class="min-w-0 flex-grow-1">
    <h1 class="recognition-title"><%= t("money_sources.recognition.title") %></h1>
    <p class="recognition-subtitle"><%= t("money_sources.recognition.subtitle") %></p>
  </div>
  <div class="recognition-header-actions d-print-none">
    <button type="button" class="btn btn-outline-secondary recognition-help-btn" data-testid="recognition-help-btn"
            data-bs-toggle="modal" data-bs-target="#recognition-help-modal">
      <i class="ti ti-help" aria-hidden="true"></i><%= t("money_sources.recognition.how_it_works") %>
    </button>
  </div>
</header>

<% if @gmail_connection&.active? %>
  <%# Gmail criteria: three recognition inputs (senders / domains / subjects),
      prefilled with the saved config plus the setup-scan suggestions. Works
      as a manual editor: the user can add, edit or remove criteria without
      having scanned the mailbox at all. The rescan button lives OUTSIDE the
      form (a nested form would corrupt the outer form's CSRF token).
      Collapsed by default: the head is a summary row and the editor is
      revealed by the toggle (auto-expanded while a scan runs). %>
  <% gmail_values = @gmail_connection.criteria_form_values %>
  <% gmail_suggestions = @gmail_connection.criteria_suggestions %>
  <% gmail_scan = @gmail_connection.setup_suggestions.is_a?(Hash) ? @gmail_connection.setup_suggestions : {} %>
  <section class="recognition-table-card recognition-bank <%= "expanded" if gmail_expanded %>" data-testid="gmail-criteria-card" data-recognition-collapsible
           <%= tag.attributes(data: { sync_in_progress: true }) if @gmail_connection.sync_running? %>
           aria-label="<%= t("money_sources.recognition.criteria_title") %>">
    <div class="recognition-bank-head">
      <button type="button" class="recognition-bank-toggle" data-recognition-toggle
              aria-expanded="<%= gmail_expanded ? "true" : "false" %>" aria-controls="gmail-criteria-body">
        <span class="recognition-bank-icon tone-gmail" aria-hidden="true"><i class="ti ti-brand-gmail"></i></span>
        <span class="recognition-bank-identity">
          <span class="recognition-bank-name"><%= t("money_sources.recognition.criteria_title") %></span>
          <span class="recognition-bank-desc">
            <% if @gmail_connection.sync_running? %>
              <span class="badge bg-info text-dark" data-testid="criteria-syncing">
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                <%= t("money_sources.recognition.criteria_syncing") %>
              </span>
            <% elsif gmail_scan["scanned"].to_i.positive? %>
              <%= t("money_sources.recognition.criteria_help",
                    scanned: gmail_scan["scanned"], passed: gmail_scan["passed"]) %>
            <% else %>
              <%= t("money_sources.recognition.criteria_help_manual") %>
            <% end %>
          </span>
        </span>
        <i class="ti ti-chevron-down recognition-bank-chevron" aria-hidden="true"></i>
      </button>
      <div class="recognition-bank-actions">
        <span class="recognition-status recognition-status-ok" data-testid="gmail-connected">
          <i class="ti ti-circle-check" aria-hidden="true"></i><%= t("money_sources.recognition.gmail_connected") %>
        </span>
        <button type="button" class="btn btn-sm btn-outline-secondary recognition-manage-btn"
                data-testid="gmail-criteria-manage" data-recognition-toggle
                aria-expanded="<%= gmail_expanded ? "true" : "false" %>" aria-controls="gmail-criteria-body">
          <i class="ti ti-pencil" aria-hidden="true"></i><%= t("money_sources.recognition.criteria_manage") %>
        </button>
      </div>
    </div>
    <div class="recognition-bank-body" id="gmail-criteria-body">
    <div class="recognition-criteria">
      <%= form_with model: @gmail_connection, url: gmail_connection_path, method: :patch, scope: :search_config do |f| %>
        <input type="hidden" name="next" value="recognition">

        <div class="recognition-criteria-field">
          <%= f.label :senders, t("gmail.senders"), class: "form-label small mb-1" %>
          <%= f.text_area :senders, rows: 2, class: "form-control form-control-sm",
                          placeholder: t("money_sources.recognition.criteria_senders_placeholder"),
                          value: gmail_values[:senders] %>
        </div>
        <div class="recognition-criteria-field">
          <%= f.label :domains, t("gmail.domains"), class: "form-label small mb-1" %>
          <%= f.text_area :domains, rows: 2, class: "form-control form-control-sm",
                          placeholder: t("money_sources.recognition.criteria_domains_placeholder"),
                          value: gmail_values[:domains] %>
        </div>
        <div class="recognition-criteria-field">
          <%= f.label :subject_keywords, t("gmail.subject_keywords"), class: "form-label small mb-1" %>
          <%= f.text_area :subject_keywords, rows: 2, class: "form-control form-control-sm",
                          placeholder: t("money_sources.recognition.criteria_subjects_placeholder"),
                          value: gmail_values[:subject_keywords] %>
        </div>
        <div class="recognition-criteria-foot d-flex gap-2 align-items-center">
          <%= f.submit t("money_sources.recognition.criteria_save"), class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>

      <%# Suggestion provenance: what the scan found and how many times.
          Reviewing here never persists anything until Save is pressed. %>
      <% if gmail_suggestions.present? %>
        <div class="recognition-criteria-suggestions">
          <% gmail_suggestions.each do |entry| %>
            <span class="recognition-criteria-entry" data-testid="gmail-criteria-entry">
              <%= entry[:value] %> (<%= entry[:count] %><%= " · #{entry[:institution]}" if entry[:institution] %>)
            </span>
          <% end %>
        </div>
      <% end %>

      <%# Outside the form on purpose: nested forms corrupt the outer form's
          authenticity_token. %>
      <div class="recognition-criteria-rescan" data-testid="gmail-criteria-rescan">
        <%= button_to setup_sync_gmail_connection_path, method: :post, class: "btn btn-outline-secondary btn-sm",
              data: { sync_status_path: gmail_sync_status_path },
              form: { data: { turbo_confirm: t("gmail.setup.rescan_confirm") } } do %>
          <i class="ti ti-repeat me-1" aria-hidden="true"></i><%= t("gmail.setup.rescan") %>
        <% end %>
      </div>
    </div>
    </div>
  </section>
<% end %>

<%
  # Recognition page groups (from MoneySourcesController#recognition):
  # each group is one bank: label = entity name (attached or legacy bank
  # text), seed = the source whose recognition holds the group's bank-level
  # config (senders + subject patterns), members = the individual sources.
%>

<%# Banks section: the mockup's "Bancos y fuentes de dinero" header. %>
<section class="recognition-banks-header" data-testid="recognition-banks-header" aria-label="<%= t("money_sources.recognition.banks_title") %>">
  <div class="recognition-header-icon" aria-hidden="true"><i class="ti ti-building-bank"></i></div>
  <div class="min-w-0 flex-grow-1">
    <h2 class="recognition-title"><%= t("money_sources.recognition.banks_title") %></h2>
    <p class="recognition-subtitle"><%= t("money_sources.recognition.banks_subtitle") %></p>
  </div>
</section>

<% @bank_groups.each do |group| %>
  <%
    group_id = "recognition-group-#{group[:key].to_s.parameterize}"
    expanded = group_expanded.call(group)
    group_configured = group[:members].any?(&:recognition_configured?)
    bank_status = if group_configured
      { text: t("money_sources.recognition.group_configured"), class: "recognition-status-ok" }
    elsif group[:pending].positive?
      { text: t("money_sources.recognition.status_pending"), class: "recognition-status-pending" }
    else
      { text: t("money_sources.recognition.status_unconfigured"), class: "recognition-status-unconfigured" }
    end
  %>
  <section class="recognition-table-card recognition-bank <%= "expanded" if expanded %>" aria-label="<%= group[:label] %>"
           data-testid="recognition-bank-group" data-recognition-collapsible <%= tag.attributes(data: { group_key: group[:key] }) %>>
    <div class="recognition-bank-head">
      <button type="button" class="recognition-bank-toggle" data-testid="recognition-bank-toggle" data-recognition-toggle
              aria-expanded="<%= expanded ? "true" : "false" %>" aria-controls="<%= group_id %>">
        <span class="recognition-bank-icon <%= bank_icon_tone(group[:key]) %>" aria-hidden="true">
          <i class="ti ti-<%= group[:cash_only] ? 'cash' : 'building-bank' %>"></i>
        </span>
        <span class="recognition-bank-identity">
          <span class="recognition-bank-name"><%= group[:label] %></span>
          <span class="recognition-bank-meta">
            <span class="recognition-count-chip"><%= t("money_sources.recognition.group_sources_count", count: group[:members].size) %></span>
            <% if group[:pending].positive? %>
              <span class="recognition-count-chip recognition-chip-pending" data-testid="recognition-suggestion-count">
                <i class="ti ti-bulb" aria-hidden="true"></i><%= t("money_sources.recognition.group_pending", count: group[:pending]) %>
              </span>
            <% end %>
          </span>
        </span>
        <i class="ti ti-chevron-down recognition-bank-chevron" aria-hidden="true"></i>
      </button>
      <div class="recognition-bank-actions">
        <span class="recognition-status <%= bank_status[:class] %>" data-testid="recognition-bank-status">
          <i class="ti <%= group_configured ? 'ti-circle-check' : 'ti-circle-minus' %>" aria-hidden="true"></i><%= bank_status[:text] %>
        </span>
        <%# Bank-level drawer: edits the SEED source's recognition; the whole
            group reuses it through the matcher (no per-source copies). Cash
            groups have no bank behind them: no bank config is offered. %>
        <% unless group[:cash_only] %>
          <%= link_to money_sources_recognition_path(bank_edit: group[:key]),
                      class: "btn btn-sm btn-outline-secondary",
                      "aria-label": t("money_sources.recognition.group_configure"),
                      data: { testid: "recognition-bank-edit" } do %>
            <i class="ti ti-building-bank" aria-hidden="true"></i>
            <%= t("money_sources.recognition.group_configure") %>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="recognition-bank-body" id="<%= group_id %>">
      <table class="recognition-table">
        <thead>
          <tr>
            <th><%= t("money_sources.recognition.col_source") %></th>
            <th><%= t("money_sources.recognition.col_type") %></th>
            <th class="d-none d-md-table-cell"><%= t("money_sources.recognition.col_identifiers") %></th>
            <th><%= t("money_sources.recognition.col_status") %></th>
            <th class="text-end"><%= t("money_sources.recognition.col_actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% group[:members].each do |source| %>
            <% row_suggestions = status_suggestions_count.call(source) %>
            <tr data-testid="recognition-row" class="<%= 'recognition-row-active' if source == @editing %>">
              <td>
                <div class="recognition-source-cell">
                  <span class="recognition-row-icon" aria-hidden="true"><i class="ti ti-<%= source_kind_icon(source.kind) %>"></i></span>
                  <span class="recognition-row-name"><%= source.name %></span>
                </div>
              </td>
              <td>
                <% badge = kind_badges[source.kind] %>
                <span class="recognition-badge <%= badge[:class] %>"><%= badge[:label] %></span>
              </td>
              <td class="d-none d-md-table-cell">
                <span class="recognition-cell-muted" data-testid="recognition-identifiers"><%= confirmed_keyword_text.call(source) || "—" %></span>
              </td>
              <td>
              <% if row_suggestions.positive? %>
                <span class="recognition-status recognition-status-pending" data-testid="recognition-status">
                  <i class="ti ti-alert-triangle" aria-hidden="true"></i><%= t("money_sources.recognition.status_pending") %>
                  <span class="recognition-row-pending-count" data-testid="recognition-row-pending-count">
                    <%= t("money_sources.recognition.source_pending", count: row_suggestions) %>
                  </span>
                </span>
              <% elsif source.recognition_configured? %>
                <span class="recognition-status recognition-status-ok" data-testid="recognition-status">
                  <i class="ti ti-circle-check" aria-hidden="true"></i><%= t("money_sources.recognition.status_configured") %>
                </span>
              <% else %>
                <span class="recognition-status recognition-status-unconfigured" data-testid="recognition-status">
                  <i class="ti ti-circle-minus" aria-hidden="true"></i><%= t("money_sources.recognition.status_unconfigured") %>
                </span>
              <% end %>
            </td>
            <td class="text-end">
              <div class="recognition-row-actions d-print-none">
                <%= link_to money_sources_recognition_path(edit: source.id), class: "btn recognition-icon-btn btn-edit", title: t("common.edit"), aria: { label: t("common.edit") }, data: { testid: "edit-recognition" } do %>
                  <i class="ti ti-pencil" aria-hidden="true"></i>
                <% end %>
                <% if source.recognition_configured? %>
                  <%= button_to money_source_recognition_destroy_path(source.id), method: :delete, class: "btn recognition-icon-btn btn-delete", title: t("money_sources.recognition.delete_config"), aria: { label: t("money_sources.recognition.delete_config") }, data: { confirm: t("money_sources.recognition.delete_confirm_title") }, form: { style: "display:inline-block", data: { turbo_confirm: "#{t('money_sources.recognition.delete_confirm_title')} #{t('money_sources.recognition.delete_confirm_body')}" } } do %>
                    <i class="ti ti-trash" aria-hidden="true"></i>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="recognition-bank-foot d-print-none">
      <%= link_to new_money_source_path, class: "btn btn-sm btn-outline-primary", data: { testid: "recognition-add-source" } do %>
        <i class="ti ti-plus" aria-hidden="true"></i><%= t("money_sources.recognition.add_source") %>
      <% end %>
      <% if group[:pending].positive? %>
        <%= link_to money_sources_recognition_path(bank_edit: group[:key]),
                    class: "recognition-view-suggestions",
                    data: { testid: "recognition-view-suggestions" } do %>
          <%= t("money_sources.recognition.view_pending", count: group[:pending]) %><i class="ti ti-arrow-right" aria-hidden="true"></i>
        <% end %>
      <% end %>
    </div>
    </div>
  </section>
<% end %>

<% if @editing %>
  <%# Right-side drawer: table stays visible behind the overlay. Two modes:
      BANK drawer (@bank_editing — configures the group's bank-level signals
      on the seed source: senders/domains + subject patterns, shared by every
      member without copies) and SOURCE drawer (only product keywords +
      last-four hint; the bank signals live in the bank drawer). %>
  <div class="recognition-drawer-overlay d-print-none" data-recognition-close data-close-url="<%= money_sources_recognition_path %>"></div>
  <%= form_with url: money_source_recognition_path(@editing.id), method: :patch, class: "recognition-form", data: { unsaved_message: t("money_sources.recognition.unsaved_changes") } do %>
    <aside class="recognition-drawer d-print-none" data-testid="recognition-edit-panel"
           data-testid-mode="<%= @bank_editing ? "bank" : "source" %>"
           role="dialog" aria-modal="true"
           aria-label="<%= @bank_editing ? t("money_sources.recognition.bank_edit_title") : t("money_sources.recognition.edit_title") %>">
      <div class="recognition-drawer-head">
        <div class="recognition-edit-identity">
          <% if @bank_editing %>
            <span class="recognition-row-icon recognition-edit-icon" aria-hidden="true"><i class="ti ti-building-bank"></i></span>
            <div class="min-w-0">
              <h2 class="recognition-edit-title"><%= @editing.institution_name %></h2>
              <div class="recognition-edit-subtitle"><%= t("money_sources.recognition.bank_edit_subtitle") %></div>
            </div>
          <% else %>
            <% badge = kind_badges[@editing.kind] %>
            <span class="recognition-row-icon recognition-edit-icon" aria-hidden="true"><i class="ti ti-<%= source_kind_icon(@editing.kind) %>"></i></span>
            <div class="min-w-0">
              <h2 class="recognition-edit-title"><%= @editing.name %></h2>
              <div class="recognition-edit-subtitle"><%= badge[:label] %></div>
            </div>
          <% end %>
        </div>
        <%= link_to money_sources_recognition_path, class: "btn recognition-icon-btn", title: t("common.cancel"), aria: { label: t("common.cancel") }, data: { recognition_close: true } do %>
          <i class="ti ti-x" aria-hidden="true"></i>
        <% end %>
      </div>

      <div class="recognition-drawer-body">
        <div class="recognition-edit-grid">
          <%# A. Identificación del PRODUCTO — only in the SOURCE drawer (the
              bank drawer never carries keywords). %>
          <% unless @bank_editing %>
          <div class="recognition-section">
            <div class="recognition-section-title">
              <%= t("money_sources.recognition.section_identification") %>
              <i class="ti ti-info-circle" title="<%= t("money_sources.recognition.section_identification_hint") %>" aria-hidden="true"></i>
            </div>
            <p class="recognition-section-desc"><%= t("money_sources.recognition.section_identification_desc") %></p>
            <% if @editing.last_four.blank? %>
              <div class="recognition-lastfour-hint" data-testid="last-four-hint">
                <i class="ti ti-alert-circle" aria-hidden="true"></i>
                <span><%= t("money_sources.recognition.last_four_hint") %></span>
                <%= link_to edit_money_source_path(@editing), class: "recognition-lastfour-cta" do %>
                  <i class="ti ti-pencil" aria-hidden="true"></i><%= t("money_sources.recognition.last_four_cta") %>
                <% end %>
              </div>
            <% end %>
            <div class="recognition-chips" data-recognition-chips="keywords">
              <% if section_suggestions["keywords"].present? %>
                <div class="recognition-chips-label"><%= t("money_sources.recognition.confirmed_label") %></div>
              <% end %>
              <% keywords.each do |id| %>
                <span class="recognition-chip" data-testid="recognition-chip">
                  <%= id.value %>
                  <input type="hidden" name="keywords[]" value="<%= id.value %>">
                  <button type="button" class="recognition-chip-remove" data-recognition-remove aria-label="<%= t("money_sources.recognition.remove") %>"><i class="ti ti-x"></i></button>
                </span>
              <% end %>
              <button type="button" class="recognition-chip-add" data-recognition-add data-add-for="keywords"><i class="ti ti-plus" aria-hidden="true"></i><%= t("money_sources.recognition.add") %></button>
            </div>
            <%= render "recognition_suggested", section: "keywords", suggestions: section_suggestions["keywords"] %>
            <div class="recognition-section-foot">
              <div class="recognition-section-example"><%= t("money_sources.recognition.identification_example") %></div>
              <div class="recognition-section-count" data-recognition-count><%= t("money_sources.recognition.keywords_count", count: keywords.length) %></div>
            </div>
          </div>
          <% end %>

          <%# B + C: BANK-level signals — only in the BANK drawer. The seed's
              confirmed senders/domains/subjects are reused by every member
              of the group; a mistyped value harms only this group. %>
          <% if @bank_editing %>
          <p class="text-secondary small">
            <i class="ti ti-info-circle me-1" aria-hidden="true"></i><%= t("money_sources.recognition.bank_edit_note") %>
          </p>
          <%# B. Remitentes / Dominios %>
          <div class="recognition-section">
            <div class="recognition-section-title">
              <%= t("money_sources.recognition.section_senders") %>
              <i class="ti ti-info-circle" title="<%= t("money_sources.recognition.section_senders_hint") %>" aria-hidden="true"></i>
            </div>
            <p class="recognition-section-desc"><%= t("money_sources.recognition.section_senders_desc") %></p>
            <div class="recognition-chips" data-recognition-chips="senders">
              <% if section_suggestions["senders"].present? %>
                <div class="recognition-chips-label"><%= t("money_sources.recognition.confirmed_label") %></div>
              <% end %>
              <% senders.each do |id| %>
                <span class="recognition-chip" data-testid="recognition-chip">
                  <%= id.value %>
                  <input type="hidden" name="senders[]" value="<%= id.value %>">
                  <button type="button" class="recognition-chip-remove" data-recognition-remove aria-label="<%= t("money_sources.recognition.remove") %>"><i class="ti ti-x"></i></button>
                </span>
              <% end %>
              <button type="button" class="recognition-chip-add" data-recognition-add data-add-for="senders"><i class="ti ti-plus" aria-hidden="true"></i><%= t("money_sources.recognition.add_sender") %></button>
            </div>
            <%= render "recognition_suggested", section: "senders", suggestions: section_suggestions["senders"] %>
            <div class="recognition-section-foot">
              <div class="recognition-section-example"><%= t("money_sources.recognition.senders_example") %></div>
              <div class="recognition-section-count" data-recognition-count><%= t("money_sources.recognition.senders_count", count: senders.length) %></div>
            </div>
          </div>

          <%# C. Encabezados / Asuntos %>
          <div class="recognition-section">
            <div class="recognition-section-title">
              <%= t("money_sources.recognition.section_subjects") %>
              <i class="ti ti-info-circle" title="<%= t("money_sources.recognition.section_subjects_hint") %>" aria-hidden="true"></i>
            </div>
            <p class="recognition-section-desc"><%= t("money_sources.recognition.section_subjects_desc") %></p>
            <div class="recognition-chips" data-recognition-chips="subjects">
              <% if section_suggestions["subjects"].present? %>
                <div class="recognition-chips-label"><%= t("money_sources.recognition.confirmed_label") %></div>
              <% end %>
              <% subjects.each do |id| %>
                <span class="recognition-chip" data-testid="recognition-chip">
                  <%= id.value %>
                  <input type="hidden" name="subjects[]" value="<%= id.value %>">
                  <button type="button" class="recognition-chip-remove" data-recognition-remove aria-label="<%= t("money_sources.recognition.remove") %>"><i class="ti ti-x"></i></button>
                </span>
              <% end %>
              <button type="button" class="recognition-chip-add" data-recognition-add data-add-for="subjects"><i class="ti ti-plus" aria-hidden="true"></i><%= t("money_sources.recognition.add_pattern") %></button>
            </div>
            <%= render "recognition_suggested", section: "subjects", suggestions: section_suggestions["subjects"] %>
            <div class="recognition-section-foot">
              <div class="recognition-section-example"><%= t("money_sources.recognition.subjects_example") %></div>
              <div class="recognition-section-count" data-recognition-count><%= t("money_sources.recognition.patterns_count", count: subjects.length) %></div>
            </div>
          </div>
          <% end %>
        </div>
      </div>

      <div class="recognition-drawer-foot" data-testid="recognition-drawer-foot">
        <%= link_to t("common.cancel"), money_sources_recognition_path, class: "btn btn-outline-primary", data: { recognition_close: true } %>
        <%= submit_tag t("money_sources.recognition.save_changes"), class: "btn btn-primary", data: { testid: "recognition-save" } %>
      </div>
    </aside>
  <% end %>
<% end %>

<%= render "recognition_help_modal" %>
