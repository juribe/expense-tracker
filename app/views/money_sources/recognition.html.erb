<%#
  "Reconocimiento de fuentes" — real implementation.
  Lists all Money Sources with their recognition status. Clicking Edit opens a
  right-side drawer (table stays visible behind) to configure keywords /
  senders+domains / subject+header patterns as removable chips. First-time and
  same-institution sources get explicit (non-persisted) suggestions the user
  can accept.
%>
<%
  kind_badges = {
    "credit_card" => { label: t("kinds.credit_card"), class: "recognition-badge-type" },
    "loan" => { label: t("kinds.loan"), class: "recognition-badge-loan" },
    "account" => { label: t("kinds.account"), class: "recognition-badge-account" },
    "debit_card" => { label: t("kinds.debit_card"), class: "recognition-badge-account" },
    "cash" => { label: t("kinds.cash"), class: "recognition-badge-account" },
    "wallet" => { label: t("kinds.wallet"), class: "recognition-badge-account" }
  }

  keywords = @editing&.recognition_identifiers&.select(&:keyword?)&.sort_by(&:position) || []
  senders  = @editing&.recognition_identifiers&.select { |id| id.sender? || id.domain? }&.sort_by(&:position) || []
  subjects = @editing&.recognition_identifiers&.select { |id| id.subject? || id.header? }&.sort_by(&:position) || []
  suggestion_keys = @suggestions&.keys || []
  has_suggestions = @suggestions.present? && suggestion_keys.any? { |k| @suggestions[k].present? }
%>

<header class="recognition-header">
  <div class="recognition-header-icon" aria-hidden="true"><i class="bi bi-envelope-paper-heart"></i></div>
  <div class="min-w-0 flex-grow-1">
    <h1 class="recognition-title"><%= t("money_sources.recognition.title") %></h1>
    <p class="recognition-subtitle"><%= t("money_sources.recognition.subtitle") %></p>
  </div>
  <div class="recognition-header-actions d-print-none">
    <button type="button" class="btn btn-outline-secondary recognition-help-btn">
      <i class="bi bi-question-circle" aria-hidden="true"></i><%= t("money_sources.recognition.how_it_works") %>
    </button>
  </div>
</header>

<section class="recognition-table-card" aria-label="<%= t("money_sources.recognition.title") %>">
  <table class="recognition-table">
    <thead>
      <tr>
        <th><%= t("money_sources.recognition.col_source") %></th>
        <th><%= t("money_sources.recognition.col_type") %></th>
        <th><%= t("money_sources.recognition.col_status") %></th>
        <th class="text-end"><%= t("money_sources.recognition.col_actions") %></th>
      </tr>
    </thead>
    <tbody>
      <% @money_sources.each do |source| %>
        <tr data-testid="recognition-row" class="<%= 'recognition-row-active' if source == @editing %>">
          <td>
            <div class="recognition-source-cell">
              <span class="recognition-row-icon" aria-hidden="true"><i class="bi bi-<%= source_kind_icon(source.kind) %>"></i></span>
              <span class="recognition-row-name"><%= source.name %></span>
            </div>
          </td>
          <td>
            <% badge = kind_badges[source.kind] %>
            <span class="recognition-badge <%= badge[:class] %>"><%= badge[:label] %></span>
          </td>
          <td>
            <% if source.recognition_configured? %>
              <span class="recognition-status recognition-status-ok" data-testid="recognition-status">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i><%= t("money_sources.recognition.status_configured") %>
              </span>
            <% else %>
              <span class="recognition-status recognition-status-pending" data-testid="recognition-status">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><%= t("money_sources.recognition.status_unconfigured") %>
              </span>
            <% end %>
          </td>
          <td class="text-end">
            <div class="recognition-row-actions d-print-none">
              <%= link_to money_sources_recognition_path(edit: source.id), class: "btn recognition-icon-btn btn-edit", title: t("common.edit"), aria: { label: t("common.edit") }, data: { testid: "edit-recognition" } do %>
                <i class="bi bi-pencil" aria-hidden="true"></i>
              <% end %>
              <% if source.recognition_configured? %>
                <%= button_to money_source_recognition_destroy_path(source.id), method: :delete, class: "btn recognition-icon-btn btn-delete", title: t("money_sources.recognition.delete_config"), aria: { label: t("money_sources.recognition.delete_config") }, data: { confirm: t("money_sources.recognition.delete_confirm_title") }, form: { style: "display:inline-block", data: { turbo_confirm: "#{t('money_sources.recognition.delete_confirm_title')} #{t('money_sources.recognition.delete_confirm_body')}" } } do %>
                  <i class="bi bi-trash" aria-hidden="true"></i>
                <% end %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<% if @editing %>
  <%# Right-side drawer: table stays visible behind the overlay %>
  <div class="recognition-drawer-overlay d-print-none" data-recognition-close data-close-url="<%= money_sources_recognition_path %>"></div>
  <%= form_with url: money_source_recognition_path(@editing.id), method: :patch, class: "recognition-form", data: { unsaved_message: t("money_sources.recognition.unsaved_changes") } do %>
    <aside class="recognition-drawer d-print-none" data-testid="recognition-edit-panel" role="dialog" aria-modal="true" aria-label="<%= t("money_sources.recognition.edit_title") %>">
      <div class="recognition-drawer-head">
        <div class="recognition-edit-identity">
          <% badge = kind_badges[@editing.kind] %>
          <span class="recognition-row-icon recognition-edit-icon" aria-hidden="true"><i class="bi bi-<%= source_kind_icon(@editing.kind) %>"></i></span>
          <div class="min-w-0">
            <h2 class="recognition-edit-title"><%= @editing.name %></h2>
            <div class="recognition-edit-subtitle"><%= badge[:label] %></div>
          </div>
        </div>
        <%= link_to money_sources_recognition_path, class: "btn recognition-icon-btn", title: t("common.cancel"), aria: { label: t("common.cancel") }, data: { recognition_close: true } do %>
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        <% end %>
      </div>

      <div class="recognition-drawer-body">
        <% if has_suggestions %>
          <div class="recognition-suggestions">
            <div class="recognition-suggestions-head">
              <div class="recognition-suggestions-title">
                <h3><i class="bi bi-magic" aria-hidden="true"></i><%= t("money_sources.recognition.suggestions_title") %></h3>
                <p><%= t("money_sources.recognition.suggestions_desc") %></p>
              </div>
              <button type="button" class="recognition-chip-remove recognition-suggestions-dismiss" data-recognition-dismiss-suggestions title="<%= t("money_sources.recognition.dismiss_suggestions") %>" aria-label="<%= t("money_sources.recognition.dismiss_suggestions") %>">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
            <div class="recognition-suggestions-body">
              <% if @suggestions[:senders].present? %>
                <div class="recognition-suggestion-group">
                  <div class="recognition-suggestion-label"><%= t("money_sources.recognition.section_senders") %></div>
                  <div class="recognition-suggestion-chips">
                    <% @suggestions[:senders].each do |s| %>
                      <span class="recognition-chip recognition-chip-suggested" data-suggested-for="senders" data-suggested-value="<%= s[:value] %>">
                        <%= s[:value] %>
                        <span class="recognition-chip-provenance"><%= suggestion_provenance(s) %></span>
                      </span>
                    <% end %>
                  </div>
                </div>
              <% end %>
              <% if @suggestions[:subjects].present? %>
                <div class="recognition-suggestion-group">
                  <div class="recognition-suggestion-label"><%= t("money_sources.recognition.section_subjects") %></div>
                  <div class="recognition-suggestion-chips">
                    <% @suggestions[:subjects].each do |s| %>
                      <span class="recognition-chip recognition-chip-suggested" data-suggested-for="subjects" data-suggested-value="<%= s[:value] %>">
                        <%= s[:value] %>
                        <span class="recognition-chip-provenance"><%= suggestion_provenance(s) %></span>
                      </span>
                    <% end %>
                  </div>
                </div>
              <% end %>
              <% if @suggestions[:keywords].present? %>
                <div class="recognition-suggestion-group">
                  <div class="recognition-suggestion-label"><%= t("money_sources.recognition.section_identification") %></div>
                  <div class="recognition-suggestion-chips">
                    <% @suggestions[:keywords].each do |s| %>
                      <span class="recognition-chip recognition-chip-suggested" data-suggested-for="keywords" data-suggested-value="<%= s[:value] %>">
                        <%= s[:value] %>
                        <span class="recognition-chip-provenance"><%= suggestion_provenance(s) %></span>
                      </span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
            <div class="recognition-suggestions-actions">
              <button type="button" class="btn btn-sm btn-primary" data-recognition-accept-suggestions>
                <i class="bi bi-plus-lg" aria-hidden="true"></i><%= t("money_sources.recognition.add_suggestions") %>
              </button>
            </div>
          </div>
        <% end %>

        <div class="recognition-edit-grid">
          <%# A. Identificación %>
          <div class="recognition-section">
            <div class="recognition-section-title">
              <%= t("money_sources.recognition.section_identification") %>
              <i class="bi bi-info-circle" title="<%= t("money_sources.recognition.section_identification_hint") %>" aria-hidden="true"></i>
            </div>
            <p class="recognition-section-desc"><%= t("money_sources.recognition.section_identification_desc") %></p>
            <% if @editing.last_four.blank? %>
              <div class="recognition-lastfour-hint" data-testid="last-four-hint">
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                <span><%= t("money_sources.recognition.last_four_hint") %></span>
                <%= link_to edit_money_source_path(@editing), class: "recognition-lastfour-cta" do %>
                  <i class="bi bi-pencil" aria-hidden="true"></i><%= t("money_sources.recognition.last_four_cta") %>
                <% end %>
              </div>
            <% end %>
            <div class="recognition-chips" data-recognition-chips="keywords">
              <% keywords.each do |id| %>
                <span class="recognition-chip" data-testid="recognition-chip">
                  <%= id.value %>
                  <input type="hidden" name="keywords[]" value="<%= id.value %>">
                  <button type="button" class="recognition-chip-remove" data-recognition-remove aria-label="<%= t("money_sources.recognition.remove") %>"><i class="bi bi-x"></i></button>
                </span>
              <% end %>
              <button type="button" class="recognition-chip-add" data-recognition-add data-add-for="keywords"><i class="bi bi-plus-lg" aria-hidden="true"></i><%= t("money_sources.recognition.add") %></button>
            </div>
            <div class="recognition-section-foot">
              <div class="recognition-section-example"><%= t("money_sources.recognition.identification_example") %></div>
              <div class="recognition-section-count" data-recognition-count><%= t("money_sources.recognition.keywords_count", count: keywords.length) %></div>
            </div>
          </div>

          <%# B. Remitentes / Dominios %>
          <div class="recognition-section">
            <div class="recognition-section-title">
              <%= t("money_sources.recognition.section_senders") %>
              <i class="bi bi-info-circle" title="<%= t("money_sources.recognition.section_senders_hint") %>" aria-hidden="true"></i>
            </div>
            <p class="recognition-section-desc"><%= t("money_sources.recognition.section_senders_desc") %></p>
            <div class="recognition-chips" data-recognition-chips="senders">
              <% senders.each do |id| %>
                <span class="recognition-chip" data-testid="recognition-chip">
                  <%= id.value %>
                  <input type="hidden" name="senders[]" value="<%= id.value %>">
                  <button type="button" class="recognition-chip-remove" data-recognition-remove aria-label="<%= t("money_sources.recognition.remove") %>"><i class="bi bi-x"></i></button>
                </span>
              <% end %>
              <button type="button" class="recognition-chip-add" data-recognition-add data-add-for="senders"><i class="bi bi-plus-lg" aria-hidden="true"></i><%= t("money_sources.recognition.add_sender") %></button>
            </div>
            <div class="recognition-section-foot">
              <div class="recognition-section-example"><%= t("money_sources.recognition.senders_example") %></div>
              <div class="recognition-section-count" data-recognition-count><%= t("money_sources.recognition.senders_count", count: senders.length) %></div>
            </div>
          </div>

          <%# C. Encabezados / Asuntos %>
          <div class="recognition-section">
            <div class="recognition-section-title">
              <%= t("money_sources.recognition.section_subjects") %>
              <i class="bi bi-info-circle" title="<%= t("money_sources.recognition.section_subjects_hint") %>" aria-hidden="true"></i>
            </div>
            <p class="recognition-section-desc"><%= t("money_sources.recognition.section_subjects_desc") %></p>
            <div class="recognition-chips" data-recognition-chips="subjects">
              <% subjects.each do |id| %>
                <span class="recognition-chip" data-testid="recognition-chip">
                  <%= id.value %>
                  <input type="hidden" name="subjects[]" value="<%= id.value %>">
                  <button type="button" class="recognition-chip-remove" data-recognition-remove aria-label="<%= t("money_sources.recognition.remove") %>"><i class="bi bi-x"></i></button>
                </span>
              <% end %>
              <button type="button" class="recognition-chip-add" data-recognition-add data-add-for="subjects"><i class="bi bi-plus-lg" aria-hidden="true"></i><%= t("money_sources.recognition.add_pattern") %></button>
            </div>
            <div class="recognition-section-foot">
              <div class="recognition-section-example"><%= t("money_sources.recognition.subjects_example") %></div>
              <div class="recognition-section-count" data-recognition-count><%= t("money_sources.recognition.patterns_count", count: subjects.length) %></div>
            </div>
          </div>
        </div>
      </div>

      <div class="recognition-drawer-foot" data-testid="recognition-drawer-foot">
        <%= link_to t("common.cancel"), money_sources_recognition_path, class: "btn btn-outline-primary", data: { recognition_close: true } %>
        <%= submit_tag t("money_sources.recognition.save_changes"), class: "btn btn-primary", data: { testid: "recognition-save" } %>
      </div>
    </aside>
  <% end %>
<% end %>
