<%= render "shared/unfinished_setup_banner", setup: @setup %>

<header class="loans-header loans-toolbar d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
  <div>
    <h1 class="loans-title"><i class="ti ti-pig-money" aria-hidden="true"></i><%= t("money_sources.index.pockets_title", default: "Bolsillos") %></h1>
    <p class="loans-subtitle"><%= t("money_sources.index.pockets_subtitle", default: "Dinero asignado a un propósito, aunque siga dentro de tu cuenta. Asignar a un bolsillo no es un gasto.") %></p>
  </div>
  <div class="loans-actions flex-wrap">
    <%= link_to new_transfer_path, class: "btn btn-outline-primary" do %>
      <i class="ti ti-arrows-left-right" aria-hidden="true"></i><%= t("money_sources.index.new_transfer") %>
    <% end %>
    <%= link_to new_money_source_path(kind: "pocket"), class: "btn btn-primary" do %>
      <i class="ti ti-plus" aria-hidden="true"></i><%= t("money_sources.index.new_pocket", default: "Crear bolsillo") %>
    <% end %>
  </div>
</header>

<% if @money_sources.any? %>
  <div class="row g-3">
    <% @money_sources.each do |source| %>
      <%= render partial: "money_source", locals: { source: source } %>
    <% end %>
  </div>
<% else %>
  <div class="card">
    <div class="p-5 text-center">
      <i class="ti ti-pig-money display-4 text-muted mb-3 d-block"></i>
      <h4 class="mb-2"><%= t("money_sources.index.pockets_empty_title", default: "Aún no tienes bolsillos") %></h4>
      <p class="text-muted"><%= t("money_sources.index.pockets_empty_body", default: "Crea un bolsillo para separar dinero: Viaje, Emergencias, Impuestos...") %></p>
      <%= link_to new_money_source_path(kind: "pocket"), class: "btn btn-primary mt-3" do %>
        <i class="ti ti-plus me-1"></i><%= t("money_sources.index.new_pocket", default: "Crear bolsillo") %>
      <% end %>
    </div>
  </div>
<% end %>
