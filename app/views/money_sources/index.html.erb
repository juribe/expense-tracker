<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
  <h1><i class="bi bi-wallet2 me-2"></i><%= t("nav.money_sources") %></h1>
  <div class="d-flex gap-2">
    <%= link_to new_transfer_path, class: "btn btn-outline-primary" do %>
      <i class="bi bi-arrow-left-right me-1"></i><%= t("money_sources.index.new_transfer") %>
    <% end %>
    <%= link_to new_money_source_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i><%= t("money_sources.index.new") %>
    <% end %>
  </div>
</div>

<% if @money_sources.any? %>
  <% assets = @money_sources.reject(&:debt?) %>
  <% debts = @money_sources.select(&:debt?) %>

  <% if assets.any? %>
    <h6 class="fw-bold text-uppercase mb-3 mt-2"><%= t("money_sources.index.assets_section") %></h6>
    <div class="row g-3 mb-4">
      <% assets.each do |source| %>
        <%= render partial: "money_source", locals: { source: source } %>
      <% end %>
    </div>
  <% end %>

  <% if debts.any? %>
    <h6 class="fw-bold text-uppercase text-danger mb-1 mt-4"><%= t("money_sources.index.debts_section") %></h6>
    <p class="text-muted small mb-3"><%= t("money_sources.index.debts_caption") %></p>
    <div class="row g-3">
      <% debts.each do |source| %>
        <%= render partial: "money_source", locals: { source: source } %>
      <% end %>
    </div>
  <% end %>
<% else %>
  <div class="card shadow-sm">
    <div class="p-5 text-center">
      <i class="bi bi-wallet2 display-4 text-muted mb-3 d-block"></i>
      <h4 class="mb-2"><%= t("money_sources.index.empty_title") %></h4>
      <p class="text-muted"><%= t("money_sources.index.empty_body") %></p>
      <%= link_to new_money_source_path, class: "btn btn-primary mt-3" do %>
        <i class="bi bi-plus-lg me-1"></i><%= t("money_sources.index.new") %>
      <% end %>
    </div>
  </div>
<% end %>
