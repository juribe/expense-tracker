<%= render "shared/unfinished_setup_banner", setup: @setup %>

<%= render "money_sources/quick_transfer_modal" %>

<header class="loans-header loans-toolbar d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
  <div>
    <h1 class="loans-title"><i class="ti ti-cash" aria-hidden="true"></i><%= t("money_sources.index.cash_title") %></h1>
    <p class="loans-subtitle"><%= t("money_sources.accounts.subtitle") %></p>
  </div>
  <div class="loans-actions flex-wrap">
    <%= render "money_sources/new_cash_source_menu" %>
  </div>
</header>

<% if @money_sources.any? %>
  <section class="loans-grid" aria-label="<%= t("money_sources.index.cash_title") %>">
    <% @money_sources.each do |source| %>
      <%= render partial: "account_card", locals: { source: source } %>
    <% end %>
  </section>

  <%= render "accounts_summary", sources: @money_sources %>
<% else %>
  <div class="card">
    <div class="p-5 text-center">
      <i class="ti ti-cash display-4 text-muted mb-3 d-block"></i>
      <h4 class="mb-2"><%= t("money_sources.index.cash_empty_title") %></h4>
      <p class="text-muted"><%= t("money_sources.index.cash_empty_body") %></p>
      <div class="d-flex justify-content-center mt-3">
        <%= render "money_sources/new_cash_source_menu" %>
      </div>
    </div>
  </div>
<% end %>
