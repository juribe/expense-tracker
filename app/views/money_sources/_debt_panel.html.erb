<div class="card card-debt shadow-sm">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
      <div>
        <span class="badge bg-danger mb-2"><%= source_kind_label(source.kind) %></span>
        <% if source.credit_card? %>
          <span class="badge bg-light text-dark"><%= [ source.card_brand, source.card_last_four ].compact_blank.join(" · ") %></span>
        <% elsif source.bank.present? %>
          <span class="badge bg-light text-dark"><%= source.bank %></span>
        <% end %>
      </div>
      <div class="text-end">
        <div class="small text-muted"><%= source.credit_card? ? t("money_sources.index.current_debt") : t("money_sources.index.outstanding_balance") %></div>
        <div class="fs-4 fw-bold text-danger"><%= number_to_currency(source.credit_card? ? source.used_credit : source.outstanding_balance) %></div>
      </div>
    </div>

    <% if source.credit_card? %>
      <div class="row text-center g-0 mt-3">
        <div class="col-4">
          <div class="fs-5 fw-bold"><%= number_to_currency(source.credit_limit) %></div>
          <div class="small text-muted"><%= t("money_sources.show.approved") %></div>
        </div>
        <div class="col-4 border-start">
          <div class="fs-5 fw-bold text-danger"><%= number_to_currency(source.used_credit) %></div>
          <div class="small text-muted"><%= t("money_sources.show.used") %></div>
        </div>
        <div class="col-4 border-start">
          <div class="fs-5 fw-bold text-success"><%= number_to_currency(source.available_credit) %></div>
          <div class="small text-muted"><%= t("money_sources.show.available") %></div>
        </div>
      </div>
      <div class="progress mt-3" role="progressbar" aria-label="<%= t("money_sources.index.credit_utilization", pct: source.credit_utilization) %>" aria-valuenow="<%= source.credit_utilization %>" aria-valuemin="0" aria-valuemax="100" style="height: 10px;">
        <div class="progress-bar <%= credit_utilization_class(source.credit_utilization) %>" style="width: <%= [ source.credit_utilization, 100 ].min %>%"></div>
      </div>
      <div class="small text-muted mt-2"><%= t("money_sources.index.credit_utilization", pct: source.credit_utilization) %></div>

      <% if source.statement_day.present? && source.payment_due_day.present? %>
        <div class="alert alert-warning py-2 px-3 small mt-3 mb-0">
          <i class="bi bi-info-circle me-1"></i><%= t("money_sources.show.statement_alert", statement: source.statement_day, due: source.payment_due_day) %>
        </div>
      <% end %>

      <dl class="row mb-0 mt-3">
        <dt class="col-sm-5"><%= t("common.type", default: "Tipo") %></dt>
        <dd class="col-sm-7"><%= source_kind_label(source.kind) %></dd>
        <% if source.bank.present? %>
          <dt class="col-sm-5"><%= t("money_sources.form.bank_issuer") %></dt>
          <dd class="col-sm-7"><%= source.bank %></dd>
        <% end %>
        <% if source.card_brand.present? %>
          <dt class="col-sm-5"><%= t("money_sources.form.card_brand") %></dt>
          <dd class="col-sm-7"><%= t("money_sources.form.card_brand_options.#{source.card_brand}") %></dd>
        <% end %>
        <% if source.card_last_four.present? %>
          <dt class="col-sm-5"><%= t("money_sources.form.last_four") %></dt>
          <dd class="col-sm-7"><%= source.card_last_four %></dd>
        <% end %>
        <% if source.interest_rate.present? %>
          <dt class="col-sm-5"><%= t("money_sources.form.interest_rate") %></dt>
          <dd class="col-sm-7"><span class="badge bg-primary"><%= source.interest_rate_label %></span></dd>
        <% end %>
        <% if source.statement_day.present? %>
          <dt class="col-sm-5"><%= t("money_sources.form.statement_day") %></dt>
          <dd class="col-sm-7"><%= source.statement_day %></dd>
        <% end %>
        <% if source.payment_due_day.present? %>
          <dt class="col-sm-5"><%= t("money_sources.form.payment_due_day") %></dt>
          <dd class="col-sm-7"><%= source.payment_due_day %></dd>
        <% end %>
      </dl>
    <% else %>
      <div class="row text-center g-0 mt-3">
        <div class="col-6">
          <div class="fs-5 fw-bold"><%= number_to_currency(source.principal_amount) %></div>
          <div class="small text-muted"><%= t("money_sources.index.original_amount") %></div>
        </div>
        <div class="col-6 border-start">
          <div class="fs-5 fw-bold"><%= number_to_currency(source.installment_amount) %></div>
          <div class="small text-muted"><%= t("money_sources.index.installment_amount") %></div>
        </div>
      </div>
      <div class="progress mt-3" role="progressbar" aria-label="<%= t("money_sources.index.repaid", pct: 100 - source.repayment_progress) %>" aria-valuenow="<%= 100 - source.repayment_progress %>" aria-valuemin="0" aria-valuemax="100" style="height: 10px;">
        <div class="progress-bar bg-success" style="width: <%= [ 100 - source.repayment_progress, 0 ].max %>%"></div>
      </div>
      <div class="small text-muted mt-2">
        <%= t("money_sources.index.repaid", pct: 100 - source.repayment_progress) %>
        <% if source.remaining_installments.present? %>
          · <%= t("money_sources.index.remaining_installments", count: source.remaining_installments, total: source.installment_count) %>
        <% end %>
      </div>

      <div class="alert alert-warning py-2 px-3 small mt-3 mb-0">
        <i class="bi bi-info-circle me-1"></i><%= t("money_sources.show.loan_debt_alert") %>
      </div>

      <dl class="row mb-0 mt-3">
        <dt class="col-sm-5"><%= t("common.type", default: "Tipo") %></dt>
        <dd class="col-sm-7"><%= source_kind_label(source.kind) %></dd>
        <% if source.bank.present? %>
          <dt class="col-sm-5"><%= t("money_sources.form.lender") %></dt>
          <dd class="col-sm-7"><%= source.bank %></dd>
        <% end %>
        <% if source.interest_rate.present? %>
          <dt class="col-sm-5"><%= t("money_sources.form.interest_rate") %></dt>
          <dd class="col-sm-7"><span class="badge bg-primary"><%= source.interest_rate_label %></span></dd>
        <% end %>
        <% if source.installment_amount.present? %>
          <dt class="col-sm-5"><%= t("money_sources.form.installment_amount") %></dt>
          <dd class="col-sm-7"><%= number_to_currency(source.installment_amount) %></dd>
        <% end %>
        <% if source.installment_count.present? %>
          <dt class="col-sm-5"><%= t("money_sources.form.installment_count") %></dt>
          <dd class="col-sm-7"><%= source.installment_count %></dd>
        <% end %>
        <% if source.payment_frequency.present? %>
          <dt class="col-sm-5"><%= t("money_sources.form.payment_frequency") %></dt>
          <dd class="col-sm-7"><i class="bi bi-calendar-week me-1"></i><%= t("money_sources.form.frequency.#{source.payment_frequency}") %></dd>
        <% end %>
        <% if source.start_date.present? %>
          <dt class="col-sm-5"><%= t("money_sources.form.start_date") %></dt>
          <dd class="col-sm-7"><%= l(source.start_date, format: :short) %></dd>
        <% end %>
        <% if source.end_date.present? %>
          <dt class="col-sm-5"><%= t("money_sources.form.end_date") %></dt>
          <dd class="col-sm-7"><%= l(source.end_date, format: :short) %></dd>
        <% end %>
        <% if source.remaining_installments.present? %>
          <dt class="col-sm-5"><%= t("money_sources.show.remaining") %></dt>
          <dd class="col-sm-7"><%= source.remaining_installments %></dd>
        <% end %>
      </dl>
    <% end %>
  </div>
</div>
