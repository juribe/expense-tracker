<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <%# A new source opened from a section arrives with its kind set by
          URL: the type is fixed (hidden) and only its panel is shown. %>
      <% fixed_kind = @money_source.new_record? && @money_source.kind.present? %>
      <%= form_with model: @money_source, local: true, data: { money_source_form: true } do |f| %>
        <div class="card">
          <%= render "shared/form_card_header",
                     title: money_source_form_title(@money_source),
                     subtitle: money_source_form_subtitle(@money_source),
                     icon: source_kind_icon(@money_source.kind),
                     tone: "blue" %>
          <div class="card-body">
            <% if @money_source.errors.any? %>
              <div class="alert alert-danger">
                <h6><%= t("money_sources.form.error_prohibited", count: @money_source.errors.count) %></h6>
                <ul>
                  <% @money_source.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="row">
              <div class="<%= fixed_kind ? "col-12" : "col-md-6" %> mb-3">
                <%= f.label :name, class: "form-label" %>
                <%= f.text_field :name, class: "form-control #{field_class(f.object, :name)}", placeholder: money_source_name_placeholder(@money_source) %>
                <div class="invalid-feedback"><%= field_error(f.object, :name) %></div>
              </div>
              <% unless fixed_kind %>
                <div class="col-md-6 mb-3">
                  <%= f.label :kind, t("common.type", default: "Tipo"), class: "form-label" %>
                  <%= f.select :kind,
                      options_for_select(
                        source_kind_options,
                        @money_source.kind
                      ),
                      {},
                      class: "form-select",
                      id: "money_source_kind" %>
                </div>
              <% else %>
                <%# Kind was preselected by the section that opened this form
                    (e.g. Nueva tarjeta de crédito). Keep the same id so the panel script below
                    still finds the value and disables the other panels. %>
                <%= f.hidden_field :kind, id: "money_source_kind" %>
              <% end %>
            </div>

            <div data-kind-panel="account wallet">
              <div class="row">
                <%= render "institution_select", f: f %>
                <div class="col-md-6 mb-3">
                  <%= f.label :starting_balance, t("money_sources.form.starting_balance", default: "Saldo inicial"), class: "form-label" %>
                  <div class="input-group">
                    <span class="input-group-text">$</span>
                    <%= f.text_field :starting_balance,
                        value: money_field_value(@money_source.starting_balance),
                        class: "form-control",
                        placeholder: t("money_sources.form.placeholder_balance"),
                        inputmode: "decimal",
                        autocomplete: "off",
                        data: { money_input: true } %>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-12 mb-3">
                  <div class="form-check form-switch">
                    <%= f.check_box :gmf_exempt, class: "form-check-input", role: "switch" %>
                    <%= f.label :gmf_exempt, "Cuenta exenta del 4x1.000", class: "form-check-label" %>
                    <div class="form-text">Indica si esta cuenta está marcada como exenta del GMF en tu banco. Solo puedes tener una cuenta exenta.</div>
                  </div>
                  <% existing = MoneySource.gmf_exempt_for(current_user) %>
                  <% if existing && existing.id != @money_source.id %>
                    <div class="alert alert-warning mt-2">
                      Actualmente la cuenta exenta es: <%= existing.name %>. Si activas esta opción, la cuenta anterior dejará de tenerla.
                    </div>
                  <% end %>
                </div>
              </div>
              <div class="row">
                <div class="col-md-6 mb-3">
                  <%= f.label :identifier, t("money_sources.form.account_number_last4"), class: "form-label" %>
                  <%= f.text_field :identifier,
                      value: @money_source.identifier.to_s.gsub(/\D/, ""),
                      class: "form-control",
                      maxlength: 4,
                      inputmode: "numeric",
                      placeholder: t("money_sources.form.last_four_hint") %>
                  <div class="form-text"><%= t("money_sources.form.account_last4_hint") %></div>
                </div>
              </div>
            </div>

            <%# Cash has no bank or account number: only the starting balance. %>
            <div data-kind-panel="cash">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <%= f.label :starting_balance, t("money_sources.form.starting_balance", default: "Saldo inicial"), class: "form-label" %>
                  <div class="input-group">
                    <span class="input-group-text">$</span>
                    <%= f.text_field :starting_balance,
                        value: money_field_value(@money_source.starting_balance),
                        class: "form-control",
                        placeholder: t("money_sources.form.placeholder_balance"),
                        inputmode: "decimal",
                        autocomplete: "off",
                        data: { money_input: true } %>
                  </div>
                </div>
              </div>
            </div>

            <div data-kind-panel="pocket">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <%= f.label :starting_balance, t("money_sources.form.starting_balance", default: "Saldo inicial"), class: "form-label" %>
                  <div class="input-group">
                    <span class="input-group-text">$</span>
                    <%= f.text_field :starting_balance,
                        value: money_field_value(@money_source.starting_balance),
                        class: "form-control",
                        placeholder: t("money_sources.form.placeholder_balance"),
                        inputmode: "decimal",
                        autocomplete: "off",
                        data: { money_input: true } %>
                  </div>
                  <div class="form-text"><%= t("money_sources.form.pocket_balance_hint", default: "Déjalo en 0 y usa \"Asignar dinero\" para mover el dinero desde tu cuenta. Usa un saldo inicial solo si ya tenías ese dinero separado.") %></div>
                </div>
              </div>
            </div>

            <div data-kind-panel="debit_card">
              <div class="row">
                <%= render "institution_select", f: f %>
                <div class="col-md-6 mb-3">
                  <%= f.label :parent_id, t("money_sources.form.linked_to"), class: "form-label" %>
                  <%= f.collection_select :parent_id,
                      current_user.money_sources.where(kind: %w[account wallet]).where.not(id: @money_source.id).includes(:credit_account),
                      :id, :display_name,
                      { include_blank: t("money_sources.form.none") },
                      class: "form-select" %>
                </div>
              </div>
            </div>

            <% ca = @money_source.credit_account || @money_source.build_credit_account %>
            <%= f.fields_for :credit_account, ca do |ca_f| %>
              <div data-kind-panel="credit_card">
                <div class="row">
                  <%= render "institution_select", f: f, label_text: t("money_sources.form.bank_issuer") %>
                  <div class="col-md-6 mb-3">
                    <%= ca_f.label :card_brand, t("money_sources.form.card_brand"), class: "form-label" %>
                    <%= ca_f.select :card_brand,
                        options_for_select(CreditAccount::CARD_BRANDS.map { |b| [ t("money_sources.form.card_brand_options.#{b}"), b ] }, ca.card_brand),
                        { include_blank: true },
                        class: "form-select" %>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <%= ca_f.label :card_last_four, t("money_sources.form.last_four"), class: "form-label" %>
                    <%= ca_f.text_field :card_last_four, class: "form-control", maxlength: 4, inputmode: "numeric" %>
                    <div class="form-text"><%= t("money_sources.form.last_four_hint") %></div>
                  </div>
                  <div class="col-md-6 mb-3">
                    <%= ca_f.label :credit_limit, t("money_sources.form.credit_limit"), class: "form-label" %>
                    <div class="input-group">
                      <span class="input-group-text">$</span>
                      <%= ca_f.text_field :credit_limit, value: money_field_value(ca.credit_limit), class: "form-control", data: { money_input: true } %>
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <%= ca_f.label :interest_rate, t("money_sources.form.interest_rate"), class: "form-label" %>
                    <div class="input-group">
                      <%= ca_f.text_field :interest_rate, value: money_field_value(ca.interest_rate), class: "form-control", inputmode: "decimal" %>
                      <span class="input-group-text">%</span>
                    </div>
                  </div>
                  <div class="col-md-6 mb-3">
                    <%= ca_f.label :interest_rate_type, t("money_sources.form.interest_rate_type"), class: "form-label" %>
                    <%= ca_f.select :interest_rate_type,
                        options_for_select(CreditAccount::INTEREST_RATE_TYPES.values.map { |t| [ t("money_sources.form.rate_type.#{t}"), t ] }, ca.interest_rate_type),
                        { include_blank: true },
                        class: "form-select" %>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <%= ca_f.label :statement_day, t("money_sources.form.statement_day"), class: "form-label" %>
                    <%= ca_f.number_field :statement_day, class: "form-control", min: 1, max: 31 %>
                  </div>
                  <div class="col-md-6 mb-3">
                    <%= ca_f.label :payment_due_day, t("money_sources.form.payment_due_day"), class: "form-label" %>
                    <%= ca_f.number_field :payment_due_day, class: "form-control", min: 1, max: 31 %>
                  </div>
                </div>
                <div class="form-text mb-2"><%= t("money_sources.form.day_hint") %></div>
              </div>

              <div data-kind-panel="loan">
                <div class="row">
                  <%= render "institution_select", f: f, label_text: t("money_sources.form.lender") %>
                  <div class="col-md-6 mb-3">
                    <%= f.label :sub_kind, t("money_sources.form.loan_type"), class: "form-label" %>
                    <%= f.select :sub_kind,
                        options_for_select(loan_sub_kind_options, @money_source.sub_kind),
                        {},
                        class: "form-select" %>
                    <div class="form-text"><%= t("money_sources.form.loan_type_hint") %></div>
                  </div>
                  <div class="col-md-6 mb-3">
                    <%= f.label :identifier, t("money_sources.form.contract_number_last4"), class: "form-label" %>
                    <%= f.text_field :identifier,
                        value: @money_source.identifier.to_s.gsub(/\D/, ""),
                        class: "form-control",
                        maxlength: 4,
                        inputmode: "numeric",
                        placeholder: t("money_sources.form.last_four_hint") %>
                    <div class="form-text"><%= t("money_sources.form.contract_last4_hint") %></div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <%= ca_f.label :principal_amount, t("money_sources.form.original_principal"), class: "form-label" %>
                    <div class="input-group">
                      <span class="input-group-text">$</span>
                      <%= ca_f.text_field :principal_amount, value: money_field_value(ca.principal_amount), class: "form-control", data: { money_input: true } %>
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <%= ca_f.label :interest_rate, t("money_sources.form.interest_rate"), class: "form-label" %>
                    <div class="input-group">
                      <%= ca_f.text_field :interest_rate, value: money_field_value(ca.interest_rate), class: "form-control", inputmode: "decimal" %>
                      <span class="input-group-text">%</span>
                    </div>
                  </div>
                  <div class="col-md-6 mb-3">
                    <%= ca_f.label :interest_rate_type, t("money_sources.form.interest_rate_type"), class: "form-label" %>
                    <%= ca_f.select :interest_rate_type,
                        options_for_select(CreditAccount::INTEREST_RATE_TYPES.values.map { |t| [ t("money_sources.form.rate_type.#{t}"), t ] }, ca.interest_rate_type),
                        { include_blank: true },
                        class: "form-select" %>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <%= ca_f.label :installment_amount, t("money_sources.form.installment_amount"), class: "form-label" %>
                    <div class="input-group">
                      <span class="input-group-text">$</span>
                      <%= ca_f.text_field :installment_amount, value: money_field_value(ca.installment_amount), class: "form-control", data: { money_input: true } %>
                    </div>
                  </div>
                  <div class="col-md-6 mb-3">
                    <%= ca_f.label :installment_count, t("money_sources.form.installment_count"), class: "form-label" %>
                    <%= ca_f.number_field :installment_count, class: "form-control", min: 1 %>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <%= ca_f.label :payment_frequency, t("money_sources.form.payment_frequency"), class: "form-label" %>
                    <%= ca_f.select :payment_frequency,
                        options_for_select(CreditAccount::PAYMENT_FREQUENCIES.map { |t| [ t("money_sources.form.frequency.#{t}"), t ] }, ca.payment_frequency),
                        { include_blank: true },
                        class: "form-select" %>
                  </div>
                  <div class="col-md-6 mb-3">
                    <div class="row">
                      <div class="col-6">
                        <%= ca_f.label :start_date, t("money_sources.form.start_date"), class: "form-label" %>
                        <%= ca_f.date_field :start_date, class: "form-control" %>
                      </div>
                      <div class="col-6">
                        <%= ca_f.label :end_date, t("money_sources.form.end_date"), class: "form-label" %>
                        <%= ca_f.date_field :end_date, class: "form-control" %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>

            <div class="money-source-status">
              <div class="form-check form-switch mb-0">
                <%= f.check_box :active, class: "form-check-input", role: "switch" %>
                <%= f.label(:active, class: "form-check-label") do %>
                  <span class="money-source-status-on"><%= money_source_status_label(@money_source, active: true) %></span>
                  <span class="money-source-status-off"><%= money_source_status_label(@money_source, active: false) %></span>
                <% end %>
              </div>
            </div>

            <%# Recognition only applies to payment sources (see MoneySourceRecognition):
                loans and pockets never hold recognition. %>
            <% if @money_source.payment_source? %>
              <div class="money-source-recognition">
                <span class="icon-chip icon-chip-blue" aria-hidden="true">
                  <i class="ti ti-mail"></i>
                </span>
                <div class="money-source-recognition-copy">
                  <h6 class="money-source-recognition-title"><%= t("money_sources.form.recognition_title") %></h6>
                  <p class="money-source-recognition-hint"><%= t("money_sources.form.recognition_hint") %></p>
                  <%= link_to money_sources_recognition_path, class: "btn btn-sm money-source-recognition-btn" do %>
                    <i class="ti ti-mail me-1"></i><%= t("money_sources.form.recognition_link") %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>

          <%= render "shared/form_actions", cancel_path: money_sources_section_path(@money_source) do %>
            <%= f.submit money_source_submit_label(@money_source), class: "btn btn-primary" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
