<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0"><%= @money_source.new_record? ? t("money_sources.form.title_new") : t("money_sources.form.title_edit") %></h4>
        </div>
        <div class="card-body">
          <%= form_with model: @money_source, local: true do |f| %>
            <% if @money_source.errors.any? %>
              <div class="alert alert-danger">
                <h6><%= t("money_sources.form.error_prohibited", count: @money_source.errors.count) %></h6>
                <ul>
                  <% @money_source.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :name, class: "form-label" %>
                <%= f.text_field :name, class: "form-control", placeholder: t("money_sources.form.placeholder_name") %>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :kind, t("common.type", default: "Tipo"), class: "form-label" %>
                <%= f.select :kind,
                    options_for_select(
                      source_kind_options,
                      @money_source.kind
                    ),
                    {},
                    class: "form-select" %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :bank, t("money_sources.form.bank", default: "Banco"), class: "form-label" %>
                <%= f.text_field :bank, class: "form-control", placeholder: t("money_sources.form.placeholder_bank") %>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :parent_id, t("money_sources.form.linked_to"), class: "form-label" %>
                <%= f.collection_select :parent_id,
                    current_user.money_sources.where(kind: %w[account wallet]).where.not(id: @money_source.id),
                    :id, :display_name,
                    { include_blank: t("money_sources.form.none") },
                    class: "form-select" %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :starting_balance, t("money_sources.form.starting_balance", default: "Saldo inicial"), class: "form-label" %>
                <div class="input-group">
                  <span class="input-group-text">$</span>
                  <%= f.text_field :starting_balance,
                      value: money_field_value(@money_source.starting_balance),
                      class: "form-control",
                      placeholder: t("money_sources.form.placeholder_balance"),
                      inputmode: "decimal",
                      autocomplete: "off",
                      data: { money_input: true } %>
                </div>
              </div>
              <div class="col-md-6 mb-3">
                <div class="form-check mt-4 pt-2">
                  <%= f.check_box :active, class: "form-check-input" %>
                  <%= f.label :active, t("common.active"), class: "form-check-label" %>
                </div>
              </div>
            </div>

            <hr>
            <h6 class="mb-3"><%= t("money_sources.form.tags_title") %></h6>
            <div id="tags">
              <% blank_tag = Struct.new(:value).new("") %>
              <% tag_list = @tag_values || @money_source.tags %>
              <% (tag_list.presence || [ blank_tag ]).each_with_index do |tag, idx| %>
                <div class="row mb-2 tag-row">
                  <div class="col-md-7">
                    <input type="text" name="tags[<%= idx %>][value]" class="form-control form-control-sm"
                           placeholder="<%= t("money_sources.form.placeholder_tag_value") %>" value="<%= tag.respond_to?(:value) ? tag.value : tag %>">
                  </div>
                  <div class="col-md-1">
                    <button type="button" class="btn btn-sm btn-outline-danger remove-tag" title="<%= t("money_sources.form.remove_tag") %>">
                      <i class="bi bi-x-lg"></i>
                    </button>
                  </div>
                </div>
              <% end %>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary mb-3" id="addTag">
              <i class="bi bi-plus-lg me-1"></i><%= t("money_sources.form.add_tag") %>
            </button>

            <div class="d-grid mt-3">
              <%= f.submit class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var idx = document.querySelectorAll('.tag-row').length;
  document.getElementById('addTag').addEventListener('click', function() {
    var container = document.getElementById('tags');
    var row = document.createElement('div');
    row.className = 'row mb-2 tag-row';
    row.innerHTML =
      '<div class="col-md-7">' +
      '<input type="text" name="tags[' + idx + '][value]" class="form-control form-control-sm" placeholder="<%= t("money_sources.form.placeholder_tag_value") %>">' +
      '</div>' +
      '<div class="col-md-1">' +
      '<button type="button" class="btn btn-sm btn-outline-danger remove-tag" title="<%= t("money_sources.form.remove_tag") %>"><i class="bi bi-x-lg"></i></button>' +
      '</div>';
    container.appendChild(row);
    idx++;
  });

  document.getElementById('tags').addEventListener('click', function(e) {
    var btn = e.target.closest('.remove-tag');
    if (btn) btn.closest('.tag-row').remove();
  });
})();
</script>
