<%# Credit card card for the credit cards dashboard. Locals: source (MoneySource credit_card). %>
<%
  utilization = source.credit_utilization
  card_id_parts = [ source.card_brand, source.card_last_four ].compact_blank
%>
<article class="credit-card-card" data-testid="credit-card-card">
  <div class="cc-card-head">
    <div class="cc-identity">
      <span class="cc-icon accent-blue" aria-hidden="true"><i class="ti ti-credit-card"></i></span>
      <div class="min-w-0">
        <h3 class="cc-name"><%= link_to source.name, money_source_path(source), class: "text-decoration-none text-inherit" %></h3>
        <div class="cc-meta">
          <span><%= t("money_sources.credit_cards.type") %></span>
          <% if source.bank.present? %>
            <span class="ms-2"><i class="ti ti-building-bank" aria-hidden="true"></i><%= source.bank %></span>
          <% end %>
          <% if card_id_parts.any? %>
            <span class="ms-2"><%= card_id_parts.join(" · ") %></span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="cc-actions d-print-none">
      <% # Same Spike-style card menu as the account cards: card actions
         # collapse behind a "..." toggle so the title keeps its full width.
         # Credit cards are debts: no quick transfers, only payments/edit.
      %>
      <div class="dropdown">
        <button type="button" class="card-more-btn" data-bs-toggle="dropdown" aria-expanded="false"
                data-testid="card-actions-toggle" aria-label="<%= t("common.actions") %>">
          <i class="ti ti-dots" aria-hidden="true"></i>
        </button>
        <div class="dropdown-menu dropdown-menu-end">
          <%= link_to money_source_path(source, anchor: "payments"), class: "dropdown-item d-flex align-items-center gap-2" do %>
            <i class="ti ti-coin me-2" aria-hidden="true"></i><span><%= t("payments.index_button") %></span>
          <% end %>
          <div class="dropdown-divider"></div>
          <%= link_to edit_money_source_path(source), class: "dropdown-item d-flex align-items-center gap-2" do %>
            <i class="ti ti-pencil me-2" aria-hidden="true"></i><span><%= t("common.edit") %></span>
          <% end %>
          <%= button_to money_source_path(source), method: :delete, class: "dropdown-item d-flex align-items-center gap-2", title: t("common.delete"), data: { confirm: t("common.confirm") }, form: { style: "display:block" } do %>
            <i class="ti ti-trash me-2" aria-hidden="true"></i><span><%= t("common.delete") %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="cc-balance">
    <div class="cc-balance-label"><%= t("money_sources.credit_cards.current_debt") %></div>
    <div class="cc-balance-amount"><%= number_to_currency(source.used_credit) %></div>
  </div>

  <% if source.credit_limit.to_i > 0 %>
    <div class="cc-progress">
      <div class="cc-progress-head">
        <span class="cc-progress-label"><%= t("money_sources.credit_cards.utilization") %></span>
        <span class="cc-progress-pct"><%= utilization %>%</span>
      </div>
      <div class="progress" role="progressbar" aria-label="<%= t("money_sources.credit_cards.utilization") %>" aria-valuenow="<%= utilization %>" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar <%= credit_utilization_class(utilization) %>" style="width: <%= [ utilization, 100 ].min %>%"></div>
      </div>
    </div>
  <% end %>

  <div class="cc-metrics">
    <div class="cc-meter">
      <div class="cc-meter-label"><%= t("money_sources.credit_cards.credit_limit") %></div>
      <div class="cc-meter-value"><%= source.credit_limit.present? ? number_to_currency(source.credit_limit) : "—" %></div>
    </div>
    <div class="cc-meter">
      <div class="cc-meter-label"><%= t("money_sources.credit_cards.available") %></div>
      <div class="cc-meter-value"><%= source.available_credit.present? ? number_to_currency(source.available_credit) : "—" %></div>
    </div>
    <div class="cc-meter">
      <div class="cc-meter-label"><%= t("money_sources.credit_cards.rate") %></div>
      <div class="cc-meter-value"><%= source.interest_rate_label || "—" %></div>
    </div>
  </div>

  <div class="cc-card-foot">
    <% if source.statement_day.present? %>
      <span class="cc-foot-item"><i class="ti ti-calendar-event" aria-hidden="true"></i><span><%= t("money_sources.credit_cards.statement_day") %></span><strong><%= source.statement_day %></strong></span>
    <% end %>
    <% if source.payment_due_day.present? %>
      <% if source.statement_day.present? %>
        <span class="cc-foot-divider" aria-hidden="true"></span>
      <% end %>
      <span class="cc-foot-item"><i class="ti ti-calendar-event" aria-hidden="true"></i><span><%= t("money_sources.credit_cards.payment_due_day") %></span><strong><%= source.payment_due_day %></strong></span>
    <% end %>
    <% if source.transactions_count.to_i.positive? %>
      <% if source.statement_day.present? || source.payment_due_day.present? %>
        <span class="cc-foot-divider" aria-hidden="true"></span>
      <% end %>
      <span class="cc-foot-item"><i class="ti ti-receipt" aria-hidden="true"></i><span><%= t("money_sources.index.transactions_count", count: source.transactions_count.to_i) %></span></span>
    <% end %>
  </div>
</article>
