<%# Shared quick-transfer modal shell. The modal body is filled on demand:
    the contextual buttons carry the form URL (data-src) and on open a plain
    fetch loads the compact form (no Turbo in this app — vanilla JS only).
    Submission is intercepted with the same vanilla fetch so a validation
    error re-renders the fragment inside the modal, while a server redirect
    (impossible to fetch-read) closes the modal and lets the browser navigate
    to the return page, preserving its flash notice. %>
<div class="modal fade" id="quick-transfer-modal" tabindex="-1" aria-labelledby="quick-transfer-modal-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" data-testid="quick-transfer-modal">
      <div class="modal-header">
        <h5 class="modal-title" id="quick-transfer-modal-title">
          <i class="ti ti-arrows-left-right me-2" aria-hidden="true"></i><span id="quick-transfer-modal-title-text"></span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("common.close") %>"></button>
      </div>
      <div class="modal-body">
        <div id="quick_transfer_body"></div>
      </div>
    </div>
  </div>
</div>

<%= javascript_include_tag "quick_transfer_modal", defer: true %>

