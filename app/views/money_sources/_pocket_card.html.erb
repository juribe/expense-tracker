<%# Pocket list card. Locals: card with source, total, allocated, unallocated,
    goals_count and movements_count computed by the controller. %>
<%
  source = card[:source]
  total = card[:total]
  allocated = card[:allocated]
  unallocated = card[:unallocated]
  allocated_percentage = total.positive? ? money_share_percentage(allocated, total) : 0
  unallocated_percentage = total.positive? ? 100 - allocated_percentage : 0
  status_badge_class = source.active? ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis"
%>
<article class="pocket-card" data-testid="pocket-card">
  <div class="pocket-card-head">
    <span class="pocket-card-icon" aria-hidden="true"><i class="ti ti-<%= source_kind_icon(source.kind) %>"></i></span>

    <div class="min-w-0">
      <h3 class="pocket-card-name" data-testid="pocket-card-name">
        <%= link_to source.name, money_source_path(source, tab: "resumen") %>
      </h3>
      <div class="pocket-card-meta">
        <span><%= source_kind_label(source.kind) %></span>
        <% if source.institution_name.present? %>
          <span><i class="ti ti-building-bank" aria-hidden="true"></i><%= source.institution_name %></span>
        <% end %>
      </div>
    </div>

    <div class="dropdown pocket-card-menu d-print-none">
      <button type="button" class="card-more-btn" data-bs-toggle="dropdown" aria-expanded="false"
              data-testid="card-actions-toggle" aria-label="<%= t("common.actions") %>">
        <i class="ti ti-dots" aria-hidden="true"></i>
      </button>
      <div class="dropdown-menu dropdown-menu-end">
        <%= link_to money_source_path(source, tab: "resumen"), class: "dropdown-item d-flex align-items-center gap-2" do %>
          <i class="ti ti-eye me-2" aria-hidden="true"></i><span><%= t("money_sources.pocket_list.menu_detail", default: "Ver detalle") %></span>
        <% end %>

        <%= render "money_sources/quick_transfer_actions", source: source, menu: true, with_text: true %>
        <% if quick_transfer_actions(source).any? %>
          <div class="dropdown-divider"></div>
        <% end %>

        <%= link_to edit_money_source_path(source), class: "dropdown-item d-flex align-items-center gap-2" do %>
          <i class="ti ti-pencil me-2" aria-hidden="true"></i><span><%= t("money_sources.pocket_list.menu_edit", default: "Editar bolsillo") %></span>
        <% end %>

        <%= button_to toggle_active_money_source_path(source), method: :patch,
                      class: "dropdown-item d-flex align-items-center gap-2",
                      form: { class: "d-block" } do %>
          <i class="ti ti-<%= source.active? ? "toggle-left" : "toggle-right" %> me-2" aria-hidden="true"></i>
          <span><%= source.active? ? t("money_sources.pocket_list.menu_deactivate", default: "Desactivar bolsillo") : t("money_sources.pocket_list.menu_activate", default: "Activar bolsillo") %></span>
        <% end %>

        <div class="dropdown-divider"></div>
        <%= button_to money_source_path(source), method: :delete,
                      class: "dropdown-item d-flex align-items-center gap-2 text-danger",
                      title: t("money_sources.pocket_list.menu_delete", default: "Eliminar bolsillo"),
                      data: { confirm: t("common.confirm") },
                      form: { class: "d-block" } do %>
          <i class="ti ti-trash me-2" aria-hidden="true"></i><span><%= t("money_sources.pocket_list.menu_delete", default: "Eliminar bolsillo") %></span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="pocket-card-balance">
    <div class="pocket-card-balance-label"><%= t("money_sources.pocket_list.balance_label", default: "Saldo total") %></div>
    <div class="pocket-card-balance-value" data-testid="pocket-card-total"><%= number_to_currency(total) %></div>
  </div>

  <div class="pocket-card-distribution">
    <div class="pocket-card-amounts">
      <div class="pocket-card-amount">
        <span class="pocket-card-amount-label"><%= t("money_sources.pocket_list.allocated", default: "Asignado a metas") %></span>
        <strong class="pocket-card-amount-value is-allocated" data-testid="pocket-card-allocated"><%= number_to_currency(allocated) %></strong>
      </div>
      <div class="pocket-card-amount text-end">
        <span class="pocket-card-amount-label"><%= t("money_sources.pocket_list.unallocated", default: "Sin asignar") %></span>
        <strong class="pocket-card-amount-value is-free" data-testid="pocket-card-unallocated"><%= number_to_currency(unallocated) %></strong>
      </div>
    </div>

    <div class="pocket-card-bar" role="img"
         aria-label="<%= t("money_sources.pocket_list.distribution_label", default: "Distribución del dinero entre metas y saldo libre") %>">
      <span class="pocket-card-bar-allocated et-w-<%= allocated_percentage %>"
            data-testid="pocket-card-allocated-bar"></span>
      <span class="pocket-card-bar-free et-w-<%= unallocated_percentage %>"
            data-testid="pocket-card-free-bar"></span>
    </div>

    <div class="pocket-card-legend">
      <span class="pocket-card-legend-item">
        <i class="pocket-card-legend-dot is-allocated" aria-hidden="true"></i>
        <span data-testid="pocket-card-allocated-share"><%= t("money_sources.pocket_list.assigned_share", percentage: allocated_percentage, default: "Asignado #{allocated_percentage}%") %></span>
      </span>
      <span class="pocket-card-legend-item">
        <i class="pocket-card-legend-dot is-free" aria-hidden="true"></i>
        <span data-testid="pocket-card-unallocated-share"><%= t("money_sources.pocket_list.free_share", percentage: unallocated_percentage, default: "Libre #{unallocated_percentage}%") %></span>
      </span>
    </div>
  </div>

  <div class="pocket-card-stats">
    <span class="pocket-card-stat" data-testid="pocket-card-goals-count">
      <i class="ti ti-target" aria-hidden="true"></i><%= t("money_sources.pocket_list.goals_count", count: card[:goals_count]) %>
    </span>
    <span class="pocket-card-stat" data-testid="pocket-card-movements-count">
      <i class="ti ti-receipt" aria-hidden="true"></i><%= t("money_sources.pocket_list.movements_count", count: card[:movements_count]) %>
    </span>
    <span class="badge rounded-pill pocket-card-status <%= status_badge_class %>">
      <%= source.active? ? t("common.active") : t("common.inactive") %>
    </span>
  </div>

  <div class="pocket-card-footer d-print-none">
    <%= link_to money_source_path(source, tab: "resumen"), class: "btn btn-primary" do %>
      <span><%= t("money_sources.pocket_list.view", default: "Ver bolsillo") %></span>
      <i class="ti ti-arrow-right" aria-hidden="true"></i>
    <% end %>
    <%= render "money_sources/quick_assign_action", source: source,
               button_class: "btn btn-outline-primary",
               text: t("money_sources.pocket_list.assign", default: "Asignar") %>
  </div>
</article>
