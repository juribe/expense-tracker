<%# Destination-anchored quick-assign trigger for a pocket. Opens the shared
    quick-transfer modal with this pocket fixed as the destination
    (mode assign), so the compact form only asks for the origin — the
    counterpart of the origin-anchored "Enviar a bolsillo" action.
    Locals: source (MoneySource pocket), button_class (optional CSS classes),
    text (optional label; omitted renders the icon only). %>
<%
  button_css = local_assigns.fetch(:button_class, "btn btn-outline-primary")
  label = local_assigns.fetch(:text, nil)
  assign_title = t("transfers.quick.assign", default: "Asignar a bolsillo")
%>
<button type="button"
        class="<%= button_css %>"
        data-bs-toggle="modal"
        data-bs-target="#quick-transfer-modal"
        data-src="<%= quick_new_transfers_path(to_source_id: source.id, mode: "assign", return_to: request.path) %>"
        data-title="<%= assign_title %>"
        data-testid="quick-action-assign"
        title="<%= assign_title %>"
        aria-label="<%= assign_title %>">
  <i class="ti ti-pig-money" aria-hidden="true"></i><% if label %><span class="ms-1"><%= label %></span><% end %>
</button>
