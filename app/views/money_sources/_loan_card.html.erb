<%# Loan card for the loans dashboard. Locals: source (MoneySource loan). %>
<%
  identity = loan_identity(source)
  paid_pct = source.loan? ? [ (100 - source.repayment_progress).round(1), 0 ].max : 0
  next_payment = source.loan? ? next_payment_date(source) : nil
%>
<article class="loan-card" data-testid="loan-card">
  <div class="loan-card-head">
    <div class="loan-identity">
      <span class="loan-icon <%= identity[:accent] %>" aria-hidden="true"><i class="ti ti-<%= identity[:icon] %>"></i></span>
      <div class="min-w-0">
        <h3 class="loan-name"><%= link_to source.name, money_source_path(source), class: "text-decoration-none text-inherit" %></h3>
        <div class="loan-meta">
          <span><%= t("money_sources.loans.type") %></span>
          <% if source.bank.present? %>
            <span class="ms-2"><i class="ti ti-building-bank" aria-hidden="true"></i><%= source.bank %></span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="loan-actions d-print-none">
      <% # Same Spike-style card menu as the account cards: card actions
         # collapse behind a "..." toggle so the title keeps its full width.
         # Loans are debts: no quick transfers, only payments/edit.
      %>
      <div class="dropdown">
        <button type="button" class="card-more-btn" data-bs-toggle="dropdown" aria-expanded="false"
                data-testid="card-actions-toggle" aria-label="<%= t("common.actions") %>">
          <i class="ti ti-dots" aria-hidden="true"></i>
        </button>
        <div class="dropdown-menu dropdown-menu-end">
          <%= link_to money_source_path(source, anchor: "payments"), class: "dropdown-item d-flex align-items-center gap-2" do %>
            <i class="ti ti-coin me-2" aria-hidden="true"></i><span><%= t("payments.index_button") %></span>
          <% end %>
          <div class="dropdown-divider"></div>
          <%= link_to edit_money_source_path(source), class: "dropdown-item d-flex align-items-center gap-2" do %>
            <i class="ti ti-pencil me-2" aria-hidden="true"></i><span><%= t("common.edit") %></span>
          <% end %>
          <%= button_to money_source_path(source), method: :delete, class: "dropdown-item d-flex align-items-center gap-2", title: t("common.delete"), data: { confirm: t("common.confirm") }, form: { style: "display:block" } do %>
            <i class="ti ti-trash me-2" aria-hidden="true"></i><span><%= t("common.delete") %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="loan-balance">
    <div class="loan-balance-label"><%= t("money_sources.loans.outstanding_balance") %></div>
    <div class="loan-balance-amount"><%= number_to_currency(source.outstanding_balance) %></div>
  </div>

  <% if source.principal_amount.to_i > 0 %>
    <div class="loan-progress">
      <div class="loan-progress-head">
        <span class="loan-progress-label"><%= t("money_sources.loans.progress_label") %></span>
        <span class="loan-progress-pct"><%= t("money_sources.loans.repaid", pct: paid_pct) %></span>
      </div>
      <div class="progress" role="progressbar" aria-label="<%= t("money_sources.loans.repaid", pct: paid_pct) %>" aria-valuenow="<%= paid_pct %>" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar" style="width: <%= [ paid_pct, 100 ].min %>%"></div>
      </div>
    </div>
  <% end %>

  <div class="loan-metrics">
    <div class="loan-meter">
      <div class="loan-meter-label"><%= t("money_sources.loans.original") %></div>
      <div class="loan-meter-value"><%= number_to_currency(source.principal_amount) %></div>
    </div>
    <div class="loan-meter">
      <div class="loan-meter-label"><%= t("money_sources.loans.rate") %></div>
      <div class="loan-meter-value"><%= source.interest_rate_label || "—" %></div>
    </div>
    <div class="loan-meter">
      <div class="loan-meter-label"><%= t("money_sources.loans.remaining_installments") %></div>
      <div class="loan-meter-value">
        <% if source.remaining_installments.present? && source.installment_count.present? %>
          <%= number_with_delimiter(source.remaining_installments) %> <span class="text-muted">de <%= number_with_delimiter(source.installment_count) %></span>
        <% else %>
          —
        <% end %>
      </div>
    </div>
  </div>

  <% if source.installment_amount.present? %>
    <div class="loan-payment">
      <i class="ti ti-cash" aria-hidden="true"></i>
      <span class="loan-payment-label"><%= t("money_sources.loans.monthly_payment") %></span>
      <span class="loan-payment-value"><%= number_to_currency(source.installment_amount) %></span>
    </div>
  <% end %>

  <div class="loan-card-foot">
    <span class="loan-foot-item"><i class="ti ti-calendar-event" aria-hidden="true"></i><span><%= t("money_sources.loans.next_payment") %></span><strong><%= next_payment ? l(next_payment, format: :short) : t("money_sources.loans.no_next_payment") %></strong></span>
    <% if source.transactions_count.to_i.positive? %>
      <span class="loan-foot-divider" aria-hidden="true"></span>
      <span class="loan-foot-item"><i class="ti ti-receipt" aria-hidden="true"></i><span><%= t("money_sources.loans.transactions_count", count: source.transactions_count.to_i) %></span></span>
    <% end %>
  </div>
</article>
