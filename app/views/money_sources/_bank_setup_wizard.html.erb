<%#
  Visual bank configuration wizard.
  Renders one step per non-cash bank group generated by
  SourceRecognition::BankSetupWizard. Each step edits the group's SEED source
  through the existing PATCH recognition endpoint (form posts JSON via
  bank_setup_wizard.js), so senders/domains and subject/header patterns keep
  using the current classification, validations and sweep rules. The mail
  filter step is informational and is never reported as verified.
%>
<% wizard_steps = wizard.steps %>
<% initial_key = wizard_steps.first&.key || "empty" %>
<div class="modal fade bank-wizard-modal" id="bank-setup-wizard" tabindex="-1"
     role="dialog" aria-labelledby="bank-wizard-title" aria-hidden="true"
     data-bank-wizard
     data-auto-open="true"
     data-user-id="<%= current_user.id %>"
     data-finish-url="<%= money_sources_recognition_path %>"
     data-initial-key="<%= initial_key %>"
     data-state-in-progress="<%= t("money_sources.recognition.wizard.state_in_progress") %>"
     data-state-pending="<%= t("money_sources.recognition.wizard.state_pending") %>"
     data-state-configured="<%= t("money_sources.recognition.wizard.state_configured") %>"
     data-state-skipped="<%= t("money_sources.recognition.wizard.state_skipped") %>"
     data-state-reviewed="<%= t("money_sources.recognition.wizard.state_reviewed") %>"
     data-label-save="<%= t("money_sources.recognition.wizard.save_continue") %>"
     data-label-finish="<%= t("money_sources.recognition.wizard.finish") %>"
     data-label-saving="<%= t("money_sources.recognition.wizard.saving") %>"
     data-label-counter="<%= t("money_sources.recognition.wizard.counter", current: "%{current}", total: "%{total}") %>"
     data-label-progress="<%= t("money_sources.recognition.wizard.progress", reviewed: "%{reviewed}", total: "%{total}") %>"
     data-label-remove="<%= t("money_sources.recognition.remove") %>"
     data-error-network="<%= t("money_sources.recognition.wizard.save_error") %>"
     data-error-generic="<%= t("money_sources.recognition.wizard.save_error_generic") %>"
     data-unsaved-message="<%= t("money_sources.recognition.wizard.unsaved_finish") %>"
     data-status-skipped-hint="<%= t("money_sources.recognition.wizard.status_skipped_hint") %>"
     data-status-configured-hint="<%= t("money_sources.recognition.wizard.status_configured_hint") %>"
     data-testid="bank-setup-wizard">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content bank-wizard-shell">
      <header class="bank-wizard-head">
        <div class="bank-wizard-head-main">
          <span class="bank-wizard-head-icon" aria-hidden="true"><i class="ti ti-building-bank"></i></span>
          <div class="min-w-0">
            <h2 class="bank-wizard-title" id="bank-wizard-title"><%= t("money_sources.recognition.wizard.title") %></h2>
            <p class="bank-wizard-subtitle"><%= t("money_sources.recognition.wizard.subtitle") %></p>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"
                aria-label="<%= t("common.close") %>" data-testid="bank-wizard-close"></button>
      </header>

      <div class="bank-wizard-body">
        <nav class="bank-wizard-nav" aria-label="<%= t("money_sources.recognition.wizard.nav_label") %>">
          <% if wizard_steps.any? %>
            <p class="bank-wizard-nav-title"><%= t("money_sources.recognition.wizard.nav_title") %></p>
          <% end %>
          <% wizard_steps.each_with_index do |bank, index| %>
            <button type="button" class="bank-wizard-nav-item <%= "is-active" if index.zero? %>"
                    data-bank-wizard-go="<%= bank.key %>"
                    data-bank-wizard-nav-item
                    data-bank-configured="<%= bank.configured %>"
                    data-testid="bank-wizard-nav-item">
              <span class="bank-wizard-nav-num" data-bank-wizard-nav-num><%= index + 1 %></span>
              <span class="bank-wizard-nav-copy">
                <span class="bank-wizard-nav-label"><%= bank.label %></span>
                <span class="bank-wizard-nav-state" data-bank-wizard-nav-state>
                  <%= bank.configured ? t("money_sources.recognition.wizard.state_configured") : t("money_sources.recognition.wizard.state_pending") %>
                </span>
              </span>
            </button>
          <% end %>
          <button type="button" class="bank-wizard-nav-item bank-wizard-nav-item-important"
                  data-bank-wizard-go="filters"
                  data-testid="bank-wizard-filter-nav">
            <span class="bank-wizard-nav-num" aria-hidden="true"><i class="ti ti-flag"></i></span>
            <span class="bank-wizard-nav-copy">
              <span class="bank-wizard-nav-label"><%= t("money_sources.recognition.wizard.filters_nav") %></span>
              <span class="bank-wizard-nav-state"><%= t("money_sources.recognition.wizard.filters_nav_state") %></span>
            </span>
          </button>
        </nav>

        <div class="bank-wizard-content">
          <div class="bank-wizard-progress-wrap">
            <div class="bank-wizard-progress" role="progressbar"
                 aria-valuemin="0" aria-valuemax="<%= wizard_steps.size %>"
                 aria-valuenow="<%= wizard_steps.count(&:configured) %>"
                 aria-label="<%= t("money_sources.recognition.wizard.progress", reviewed: wizard_steps.count(&:configured), total: wizard_steps.size) %>"
                 data-bank-wizard-progress>
              <span class="bank-wizard-progress-bar" data-bank-wizard-progress-bar></span>
            </div>
            <p class="bank-wizard-progress-text" data-bank-wizard-progress-text>
              <%= t("money_sources.recognition.wizard.progress", reviewed: wizard_steps.count(&:configured), total: wizard_steps.size) %>
            </p>
          </div>

          <% if wizard_steps.empty? %>
            <section class="bank-wizard-panel is-active" data-bank-wizard-panel="empty"
                     data-bank-wizard-bank data-bank-configured="false">
              <div class="bank-wizard-empty">
                <i class="ti ti-building-bank" aria-hidden="true"></i>
                <h3><%= t("money_sources.recognition.wizard.empty_title") %></h3>
                <p><%= t("money_sources.recognition.wizard.empty_body") %></p>
              </div>
            </section>
          <% end %>

          <% wizard_steps.each_with_index do |bank, index| %>
            <% visual_sender = bank.senders.first || bank.suggestions[:senders].first&.dig(:value) || t("money_sources.recognition.wizard.sender_example") %>
            <% visual_subject = bank.subjects.first || bank.suggestions[:subjects].first&.dig(:value) || t("money_sources.recognition.wizard.subject_example") %>
            <section class="bank-wizard-panel <%= "is-active" if index.zero? %>"
                     data-bank-wizard-panel="<%= bank.key %>"
                     data-bank-wizard-bank
                     data-bank-configured="<%= bank.configured %>"
                     data-bank-label="<%= bank.label %>"
                     data-testid="bank-wizard-bank-step"
                     <%= "hidden" unless index.zero? %>>
              <header class="bank-wizard-bank-head">
                <div class="bank-wizard-bank-identity">
                  <span class="bank-wizard-bank-logo" aria-hidden="true"><%= bank.label.to_s[0].to_s.upcase %></span>
                  <div class="min-w-0">
                    <h3 class="bank-wizard-bank-title"><%= bank.label %></h3>
                    <p class="bank-wizard-bank-desc"><%= t("money_sources.recognition.wizard.bank_description") %></p>
                  </div>
                </div>
                <div class="bank-wizard-bank-meta">
                  <span class="bank-wizard-counter" data-bank-wizard-counter>
                    <%= t("money_sources.recognition.wizard.counter", current: index + 1, total: wizard_steps.size) %>
                  </span>
                  <span class="recognition-status recognition-status-pending" data-bank-wizard-status
                        role="status" aria-label="<%= t("money_sources.recognition.wizard.status_aria") %>">
                    <i class="ti ti-circle-minus" aria-hidden="true"></i>
                    <span data-bank-wizard-status-text><%= bank.configured ? t("money_sources.recognition.wizard.state_configured") : t("money_sources.recognition.wizard.state_pending") %></span>
                  </span>
                </div>
              </header>

              <%= form_with url: money_source_recognition_path(bank.source_id), method: :patch,
                            local: true, class: "bank-wizard-form", data: { bank_wizard_form: true } do %>
                <%# Always present, even when every chip was removed, so the
                    existing endpoint receives the section and can clear it. %>
                <input type="hidden" name="senders[]" value="">
                <input type="hidden" name="subjects[]" value="">

                <div class="bank-wizard-fields">
                  <section class="bank-wizard-field recognition-section" data-recognition-panel>
                    <h4 class="bank-wizard-field-title"><%= t("money_sources.recognition.wizard.sender_title") %></h4>
                    <p class="bank-wizard-help"><%= t("money_sources.recognition.wizard.sender_help") %></p>

                    <div class="bank-wizard-mail" data-testid="bank-wizard-mail-sender" aria-hidden="true">
                      <div class="bank-wizard-mail-toolbar">
                        <span class="bank-wizard-mail-brand"><i class="ti ti-brand-gmail"></i> Gmail</span>
                        <span class="bank-wizard-mail-search"><i class="ti ti-search"></i></span>
                      </div>
                      <div class="bank-wizard-mail-body">
                        <div class="bank-wizard-mail-row">
                          <span class="bank-wizard-mail-avatar"><%= bank.label.to_s[0].to_s.upcase %></span>
                          <strong><%= bank.label %></strong>
                          <span class="bank-wizard-mail-muted">para mí</span>
                          <span class="bank-wizard-mail-annotation"><i class="ti ti-arrow-left" aria-hidden="true"></i> <%= t("money_sources.recognition.wizard.sender_annotation") %></span>
                        </div>
                        <div class="bank-wizard-mail-highlight">&lt;<%= visual_sender %>&gt;</div>
                        <div class="bank-wizard-mail-subject-line"><%= visual_subject %></div>
                      </div>
                    </div>

                    <p class="bank-wizard-field-label"><%= t("money_sources.recognition.wizard.sender_field") %></p>
                    <p class="bank-wizard-field-desc"><%= t("money_sources.recognition.wizard.sender_desc") %></p>
                    <div class="bank-wizard-input-row">
                      <input type="text" class="form-control form-control-sm"
                             data-bank-wizard-new-value="senders"
                             placeholder="<%= t("money_sources.recognition.wizard.sender_placeholder") %>"
                             aria-label="<%= t("money_sources.recognition.add_sender") %>">
                      <button type="button" class="btn btn-sm btn-outline-primary" data-bank-wizard-add="senders">
                        <i class="ti ti-plus" aria-hidden="true"></i><%= t("common.add") %>
                      </button>
                    </div>
                    <div class="recognition-chips" data-recognition-chips="senders">
                      <% bank.senders.each do |value| %>
                        <span class="recognition-chip" data-testid="bank-wizard-chip">
                          <%= value %>
                          <input type="hidden" name="senders[]" value="<%= value %>">
                          <button type="button" class="recognition-chip-remove" data-recognition-remove
                                  aria-label="<%= t("money_sources.recognition.remove") %>"><i class="ti ti-x"></i></button>
                        </span>
                      <% end %>
                    </div>
                    <%= render "recognition_suggested", section: "senders", suggestions: bank.suggestions[:senders] %>
                    <p class="bank-wizard-field-example"><%= t("money_sources.recognition.wizard.sender_placeholder") %></p>
                  </section>

                  <section class="bank-wizard-field recognition-section" data-recognition-panel>
                    <h4 class="bank-wizard-field-title"><%= t("money_sources.recognition.wizard.subject_title") %></h4>
                    <p class="bank-wizard-help"><%= t("money_sources.recognition.wizard.subject_help") %></p>

                    <div class="bank-wizard-mail" data-testid="bank-wizard-mail-subject" aria-hidden="true">
                      <div class="bank-wizard-mail-toolbar">
                        <span class="bank-wizard-mail-brand"><i class="ti ti-brand-gmail"></i> Gmail</span>
                        <span class="bank-wizard-mail-search"><i class="ti ti-search"></i></span>
                      </div>
                      <div class="bank-wizard-mail-body">
                        <div class="bank-wizard-mail-row">
                          <span class="bank-wizard-mail-avatar"><%= bank.label.to_s[0].to_s.upcase %></span>
                          <strong><%= bank.label %></strong>
                          <span class="bank-wizard-mail-muted">&lt;<%= bank.senders.first || t("money_sources.recognition.wizard.sender_example") %>&gt;</span>
                        </div>
                        <div class="bank-wizard-mail-highlight"><%= visual_subject %>
                          <span class="bank-wizard-mail-annotation"><i class="ti ti-arrow-left" aria-hidden="true"></i> <%= t("money_sources.recognition.wizard.subject_annotation") %></span>
                        </div>
                      </div>
                    </div>

                    <p class="bank-wizard-field-label"><%= t("money_sources.recognition.wizard.subject_field") %></p>
                    <p class="bank-wizard-field-desc"><%= t("money_sources.recognition.wizard.subject_desc") %></p>
                    <div class="bank-wizard-input-row">
                      <input type="text" class="form-control form-control-sm"
                             data-bank-wizard-new-value="subjects"
                             placeholder="<%= t("money_sources.recognition.wizard.subject_placeholder") %>"
                             aria-label="<%= t("money_sources.recognition.add_pattern") %>">
                      <button type="button" class="btn btn-sm btn-outline-primary" data-bank-wizard-add="subjects">
                        <i class="ti ti-plus" aria-hidden="true"></i><%= t("common.add") %>
                      </button>
                    </div>
                    <div class="recognition-chips" data-recognition-chips="subjects">
                      <% bank.subjects.each do |value| %>
                        <span class="recognition-chip" data-testid="bank-wizard-chip">
                          <%= value %>
                          <input type="hidden" name="subjects[]" value="<%= value %>">
                          <button type="button" class="recognition-chip-remove" data-recognition-remove
                                  aria-label="<%= t("money_sources.recognition.remove") %>"><i class="ti ti-x"></i></button>
                        </span>
                      <% end %>
                    </div>
                    <%= render "recognition_suggested", section: "subjects", suggestions: bank.suggestions[:subjects] %>
                    <p class="bank-wizard-field-example"><%= t("money_sources.recognition.wizard.subject_placeholder") %></p>
                  </section>
                </div>

                <div class="bank-wizard-callout" role="note">
                  <span class="bank-wizard-callout-icon" aria-hidden="true"><i class="ti ti-alert-triangle"></i></span>
                  <div class="bank-wizard-callout-copy">
                    <strong><%= t("money_sources.recognition.wizard.filter_callout_title") %></strong>
                    <p><%= t("money_sources.recognition.wizard.filter_callout_body") %></p>
                  </div>
                  <button type="button" class="btn btn-sm btn-outline-secondary" data-bank-wizard-go="filters">
                    <i class="ti ti-external-link" aria-hidden="true"></i><%= t("money_sources.recognition.wizard.filter_callout_link") %>
                  </button>
                </div>
              <% end %>

              <div class="bank-wizard-error" data-bank-wizard-error role="alert" hidden></div>
            </section>
          <% end %>

          <section class="bank-wizard-panel bank-wizard-filter-panel" data-bank-wizard-panel="filters"
                   data-testid="bank-wizard-filter-step" hidden>
            <header class="bank-wizard-bank-head">
              <div class="bank-wizard-bank-identity">
                <span class="bank-wizard-bank-logo is-important" aria-hidden="true"><i class="ti ti-flag"></i></span>
                <div class="min-w-0">
                  <h3 class="bank-wizard-bank-title"><%= t("money_sources.recognition.wizard.filters_title") %></h3>
                  <p class="bank-wizard-bank-desc"><%= t("money_sources.recognition.wizard.filters_subtitle") %></p>
                </div>
              </div>
              <span class="bank-wizard-counter"><%= t("money_sources.recognition.wizard.filters_nav_state") %></span>
            </header>

            <div class="bank-wizard-filter-card">
              <strong class="bank-wizard-filter-heading"><%= t("money_sources.recognition.wizard.filters_heading") %></strong>
              <p><%= t("money_sources.recognition.wizard.filters_body") %></p>

              <h4><%= t("money_sources.recognition.wizard.filters_why_title") %></h4>
              <p><%= t("money_sources.recognition.wizard.filters_why_body") %></p>

              <div class="bank-wizard-filter-steps">
                <% (1..3).each do |step| %>
                  <div class="bank-wizard-filter-step">
                    <span class="bank-wizard-filter-step-num" aria-hidden="true"><%= step %></span>
                    <div>
                      <strong><%= t("money_sources.recognition.wizard.filters_step#{step}_title") %></strong>
                      <p><%= t("money_sources.recognition.wizard.filters_step#{step}_body") %></p>
                    </div>
                  </div>
                <% end %>
              </div>

              <div class="bank-wizard-filter-note" data-testid="bank-wizard-filter-unverifiable">
                <i class="ti ti-info-circle" aria-hidden="true"></i>
                <span><%= t("money_sources.recognition.wizard.filters_unverifiable") %></span>
              </div>
              <p class="bank-wizard-filter-limitation" data-testid="bank-wizard-filter-limitation">
                <%= t("money_sources.recognition.wizard.filters_limitation") %>
              </p>

              <div class="bank-wizard-filter-actions">
                <a href="https://support.google.com/mail/answer/6579?hl=es" target="_blank" rel="noopener"
                   class="btn btn-outline-secondary btn-sm">
                  <i class="ti ti-external-link" aria-hidden="true"></i><%= t("money_sources.recognition.wizard.filters_help_link") %>
                </a>
                <button type="button" class="btn btn-outline-primary btn-sm" data-bank-wizard-back>
                  <i class="ti ti-arrow-left" aria-hidden="true"></i><%= t("money_sources.recognition.wizard.filters_back_to_banks") %>
                </button>
              </div>
            </div>
          </section>
        </div>
      </div>

      <footer class="bank-wizard-foot">
        <button type="button" class="btn btn-link bank-wizard-skip" data-bank-wizard-skip>
          <i class="ti ti-circle-slash" aria-hidden="true"></i><%= t("money_sources.recognition.wizard.skip") %>
        </button>
        <div class="bank-wizard-foot-actions">
          <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal" data-testid="bank-wizard-cancel">
            <%= t("money_sources.recognition.wizard.cancel") %>
          </button>
          <button type="button" class="btn btn-primary" data-bank-wizard-next data-testid="bank-wizard-next">
            <span class="spinner-border spinner-border-sm d-none" aria-hidden="true" data-bank-wizard-spinner></span>
            <span data-bank-wizard-next-label><%= t("money_sources.recognition.wizard.save_continue") %></span>
          </button>
        </div>
      </footer>
    </div>
  </div>
</div>
