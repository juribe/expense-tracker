<% source_actions = capture do %>
    <div class="d-flex gap-2 flex-wrap">
      <% if @money_source.payment_source? %>
        <%= render "money_sources/quick_transfer_actions", source: @money_source, with_text: true %>
      <% end %>
      <% if @money_source.pocket? %>
        <%= link_to new_transfer_path(to_source_id: @money_source.id), class: "btn btn-primary" do %>
          <i class="ti ti-pig-money me-1"></i><%= t("goals.assign_money", default: "Asignar dinero") %>
        <% end %>
      <% end %>
      <% if @money_source.loan? %>
        <%= link_to money_source_credits_path(@money_source), class: "btn btn-primary" do %>
          <i class="ti ti-trending-up me-1"></i><%= t("credits.index_button") %>
        <% end %>
      <% end %>
      <%= link_to edit_money_source_path(@money_source), class: "btn btn-outline-primary" do %>
        <i class="ti ti-pencil me-1"></i><%= t("common.edit") %>
      <% end %>
      <%= link_to money_sources_path, class: "btn btn-outline-secondary" do %>
        <i class="ti ti-arrow-left me-1"></i><%= t("common.back") %>
      <% end %>
    </div>
<% end %>
<%= render "shared/page_header", title: (@money_source.name.presence || @money_source.display_name), actions: source_actions %>

  <div class="row g-4">
    <div class="col-lg-7">
      <% if @money_source.debt? %>
        <%= render "debt_panel", source: @money_source %>
        <%= render "payments" %>
      <% elsif @money_source.pocket? %>
        <%= render "pocket_breakdown" %>
      <% else %>
        <div class="card">
          <div class="card-body">
            <h5 class="card-title"><%= t("money_sources.show.current_balance") %></h5>
            <div class="fs-4 fw-bold text-success"><%= @money_source.balance_label %></div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="col-lg-5">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title"><%= t("money_sources.show.details") %></h5>
          <dl class="row mb-0">
            <dt class="col-sm-5"><%= t("common.type", default: "Tipo") %></dt>
            <dd class="col-sm-7"><%= source_kind_label(@money_source.kind) %></dd>
            <dt class="col-sm-5"><%= t("money_sources.form.bank", default: "Banco") %></dt>
            <dd class="col-sm-7"><%= @money_source.bank.presence || "—" %></dd>
            <% if @money_source.debt? %>
              <dt class="col-sm-5"><%= t("money_sources.show.current_balance") %></dt>
              <dd class="col-sm-7 fw-bold text-danger">
                <%= number_to_currency(@money_source.loan? ? @money_source.outstanding_balance : @money_source.used_credit) %>
              </dd>
            <% else %>
              <dt class="col-sm-5"><%= t("money_sources.form.starting_balance", default: "Saldo inicial") %></dt>
              <dd class="col-sm-7"><%= number_to_currency(@money_source.starting_balance) %></dd>
              <dt class="col-sm-5"><%= t("money_sources.show.current_balance") %></dt>
              <dd class="col-sm-7 fw-bold text-success">
                <%= @money_source.balance_label %>
              </dd>
            <% end %>
            <dt class="col-sm-5"><%= t("money_sources.show.status") %></dt>
            <dd class="col-sm-7"><%= @money_source.active? ? t("common.active") : t("common.inactive", default: "Inactiva") %></dd>
            <% if @money_source.balance_offset.to_d.nonzero? %>
              <dt class="col-sm-5"><%= t("money_sources.show.manual_adjustment") %></dt>
              <dd class="col-sm-7">
                <div>
                  <span class="fw-semibold <%= @money_source.balance_offset.to_d.positive? ? "text-success" : "text-danger" %>">
                    <%= reconciliation_signed_money(@money_source.balance_offset) %>
                  </span>
                  <% if @money_source.balance_offset_at %>
                    <span class="text-secondary small">— <%= I18n.l(@money_source.balance_offset_at.to_date, format: :long) %></span>
                  <% end %>
                </div>
                <% if @money_source.balance_offset_note.present? %>
                  <div class="text-secondary small"><i class="ti ti-message-circle me-1"></i><%= @money_source.balance_offset_note %></div>
                <% end %>
                <%= button_to reset_adjustment_money_source_path(@money_source),
                              method: :post,
                              form_class: "d-inline",
                              class: "btn btn-outline-secondary btn-sm mt-1",
                              data: { turbo: false, confirm: t("money_sources.show.reset_adjustment_confirm") } do %>
                  <i class="ti ti-rotate-2 me-1"></i><%= t("money_sources.show.reset_adjustment") %>
                <% end %>
              </dd>
            <% end %>
          </dl>
        </div>
      </div>

      <%# Recognition only applies to payment sources: loans have no
          available money and a revolving line's usage lives on the account
          its money moves to. %>
      <% if @money_source.payment_source? %>
        <div class="card mt-4">
          <div class="card-body">
            <h5 class="card-title"><%= t("money_sources.show.recognition") %></h5>
            <% recognition_keywords = @money_source.recognition_identifiers.select(&:keyword?).map(&:value) %>
            <% if recognition_keywords.any? %>
              <% recognition_keywords.each do |keyword| %>
                <span class="badge bg-light text-dark me-1 mb-1">
                  <%= keyword %>
                </span>
              <% end %>
            <% else %>
              <p class="text-secondary mb-0"><%= t("money_sources.recognition.status_unconfigured") %></p>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @money_source.loan? || @money_source.credit_card? %>
        <%= render "extra_payments", source: @money_source,
                   simple: @money_source.credit_card? || @money_source.revolving?,
                   funding_sources: current_user.money_sources.payment_sources.order(:kind, :name).where.not(id: @money_source.id) %>
      <% end %>
    </div>
  </div>

<%= render "money_sources/quick_transfer_modal" %>
