<% source_actions = capture do %>
    <div class="d-flex gap-2 flex-wrap">
      <% if @money_source.payment_source? %>
        <%= render "money_sources/quick_transfer_actions", source: @money_source, with_text: true %>
      <% end %>
      <% if @money_source.pocket? %>
        <%= render "money_sources/quick_assign_action", source: @money_source,
              button_class: "btn btn-primary", text: t("goals.assign_money", default: "Asignar dinero") %>
      <% end %>
      <% if @money_source.debt? %>
        <%= link_to money_source_credits_path(@money_source), class: "btn btn-primary" do %>
          <i class="ti ti-pig-money me-1"></i><%= t("credits.index_button") %>
        <% end %>
      <% end %>
      <%= link_to edit_money_source_path(@money_source), class: "btn btn-outline-primary" do %>
        <i class="ti ti-pencil me-1"></i><%= t("common.edit") %>
      <% end %>
      <%= link_to money_sources_section_path(@money_source), class: "btn btn-outline-secondary" do %>
        <i class="ti ti-arrow-left me-1"></i><%= t("common.back") %>
      <% end %>
    </div>
<% end %>
<%= render "shared/page_header", title: (@money_source.name.presence || @money_source.display_name), actions: source_actions %>

<% if @money_source.debt? %>
  <%
    tabs = [
      { slug: "resumen", label: t("money_sources.show.tabs.summary"), icon: "ti-layout-dashboard" }
    ]
    tabs << { slug: "pagos", label: t("money_sources.show.tabs.payments"), icon: "ti-coin" } if @money_source.debt?
    tabs << { slug: "abonos", label: t("money_sources.show.tabs.extras"), icon: "ti-notebook" } if @money_source.loan? || @money_source.credit_card?
    tabs << { slug: "reconocimiento", label: t("money_sources.show.tabs.recognition"), icon: "ti-scan" } if @money_source.payment_source?
  %>

  <div data-source-tabs="<%= @money_source.id %>">
    <ul class="nav nav-tabs" role="tablist">
      <% tabs.each_with_index do |tab, index| %>
        <li class="nav-item" role="presentation">
          <button class="nav-link<%= " active" if index.zero? %>"
                  id="source-tab-<%= tab[:slug] %>-btn"
                  data-bs-toggle="tab"
                  data-bs-target="#source-tab-<%= tab[:slug] %>"
                  data-tab-slug="<%= tab[:slug] %>"
                  type="button"
                  role="tab"
                  aria-controls="source-tab-<%= tab[:slug] %>"
                  aria-selected="<%= index.zero? %>">
            <i class="ti <%= tab[:icon] %> me-1"></i><%= tab[:label] %>
          </button>
        </li>
      <% end %>
    </ul>

    <div class="tab-content">
      <div class="tab-pane fade show active" id="source-tab-resumen" role="tabpanel" aria-labelledby="source-tab-resumen-btn" tabindex="0">
        <div class="row g-4 pt-4">
          <div class="col-lg-7">
            <% if @money_source.debt? %>
              <%= render "debt_panel", source: @money_source %>
            <% else %>
              <div class="card">
                <div class="card-body">
                  <h5 class="card-title"><%= t("money_sources.show.current_balance") %></h5>
                  <div class="fs-4 fw-bold text-success"><%= @money_source.balance_label %></div>
                  <% if @money_source.negative_balance_warning? %>
                    <span class="badge text-bg-warning mt-2" data-testid="negative-balance-warning">
                      <i class="ti ti-alert-triangle me-1"></i><%= t("money_sources.negative_balance_warning") %>
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
          <div class="col-lg-5">
            <%= render "details" %>
          </div>
        </div>
      </div>

      <% if @money_source.debt? %>
        <div class="tab-pane fade" id="source-tab-pagos" role="tabpanel" aria-labelledby="source-tab-pagos-btn" tabindex="0">
          <%= render "payments" %>
        </div>
      <% end %>

      <% if @money_source.loan? || @money_source.credit_card? %>
        <div class="tab-pane fade" id="source-tab-abonos" role="tabpanel" aria-labelledby="source-tab-abonos-btn" tabindex="0">
          <%= render "extra_payments", source: @money_source,
                     simple: @money_source.credit_card? || @money_source.revolving?,
                     funding_sources: current_user.money_sources.payment_sources.order(:kind, :name).where.not(id: @money_source.id) %>
        </div>
      <% end %>

      <% if @money_source.payment_source? %>
        <div class="tab-pane fade" id="source-tab-reconocimiento" role="tabpanel" aria-labelledby="source-tab-reconocimiento-btn" tabindex="0">
          <div class="card mt-4">
            <div class="card-body">
              <h5 class="card-title"><%= t("money_sources.show.recognition") %></h5>
              <% recognition_keywords = @money_source.recognition_identifiers.select(&:keyword?).map(&:value) %>
              <% if recognition_keywords.any? %>
                <% recognition_keywords.each do |keyword| %>
                  <span class="badge bg-light text-dark me-1 mb-1">
                    <%= keyword %>
                  </span>
                <% end %>
              <% else %>
                <p class="text-secondary mb-0"><%= t("money_sources.recognition.status_unconfigured") %></p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div data-source-tabs="<%= @money_source.id %>">
    <ul class="nav nav-tabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link<%= " active" unless @active_tab == "movimientos" %>"
                id="source-tab-resumen-btn"
                data-bs-toggle="tab"
                data-bs-target="#source-tab-resumen"
                data-tab-slug="resumen"
                type="button"
                role="tab"
                aria-controls="source-tab-resumen"
                aria-selected="<%= @active_tab != "movimientos" %>">
          <i class="ti ti-layout-dashboard me-1"></i><%= t("money_sources.show.tabs.summary") %>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link<%= " active" if @active_tab == "movimientos" %>"
                id="source-tab-movimientos-btn"
                data-bs-toggle="tab"
                data-bs-target="#source-tab-movimientos"
                data-tab-slug="movimientos"
                type="button"
                role="tab"
                aria-controls="source-tab-movimientos"
                aria-selected="<%= @active_tab == "movimientos" %>">
          <i class="ti ti-list me-1"></i><%= t("money_sources.show.tabs.movements", default: "Movimientos") %>
        </button>
      </li>
    </ul>

    <div class="tab-content">
      <div class="tab-pane fade <%= "show active" unless @active_tab == "movimientos" %>" id="source-tab-resumen" role="tabpanel" aria-labelledby="source-tab-resumen-btn" tabindex="0">
        <div class="row g-4 pt-4">
          <% if @money_source.pocket? %>
            <div class="col-lg-7">
              <%= render "pocket_breakdown" %>
            </div>
            <div class="col-lg-5">
              <%= render "details" %>
            </div>
          <% else %>
            <div class="col-lg-7">
              <div class="card">
                <div class="card-body">
                  <h5 class="card-title"><%= t("money_sources.show.current_balance") %></h5>
                  <div class="fs-4 fw-bold text-success"><%= @money_source.balance_label %></div>
                  <% if @money_source.negative_balance_warning? %>
                    <span class="badge text-bg-warning mt-2" data-testid="negative-balance-warning">
                      <i class="ti ti-alert-triangle me-1"></i><%= t("money_sources.negative_balance_warning") %>
                    </span>
                  <% end %>
                </div>
              </div>
              <% if @money_source.payment_source? %>
                <div class="card mt-3">
                  <div class="card-body">
                    <h5 class="card-title"><%= t("money_sources.show.recognition") %></h5>
                    <% recognition_keywords = @money_source.recognition_identifiers.select(&:keyword?).map(&:value) %>
                    <% if recognition_keywords.any? %>
                      <% recognition_keywords.each do |keyword| %>
                        <span class="badge bg-light text-dark me-1 mb-1">
                          <%= keyword %>
                        </span>
                      <% end %>
                    <% else %>
                      <p class="text-secondary mb-0"><%= t("money_sources.recognition.status_unconfigured") %></p>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
            <div class="col-lg-5">
              <%= render "details" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="tab-pane fade <%= "show active" if @active_tab == "movimientos" %>" id="source-tab-movimientos" role="tabpanel" aria-labelledby="source-tab-movimientos-btn" tabindex="0">
        <%= render "statement", source: @money_source, statement: @statement %>
      </div>
    </div>
  </div>
<% end %>

<%= render "money_sources/quick_transfer_modal" %>