<% source_actions = capture do %>
    <div class="d-flex gap-2 flex-wrap">
      <% if @money_source.payment_source? %>
        <%= render "money_sources/quick_transfer_actions", source: @money_source, with_text: true %>
      <% end %>
      <% if @money_source.pocket? %>
        <%= render "money_sources/quick_assign_action", source: @money_source,
              button_class: "btn btn-primary", text: t("goals.assign_money", default: "Asignar dinero") %>
      <% end %>
      <% if @money_source.debt? %>
        <%= link_to money_source_credits_path(@money_source), class: "btn btn-primary" do %>
          <i class="ti ti-pig-money me-1"></i><%= t("credits.index_button") %>
        <% end %>
      <% end %>
      <%= link_to edit_money_source_path(@money_source), class: "btn btn-outline-primary" do %>
        <i class="ti ti-pencil me-1"></i><%= t("common.edit") %>
      <% end %>
      <%= link_to money_sources_section_path(@money_source), class: "btn btn-outline-secondary" do %>
        <i class="ti ti-arrow-left me-1"></i><%= t("common.back") %>
      <% end %>
    </div>
<% end %>
<%= render "shared/page_header", title: (@money_source.name.presence || @money_source.display_name), actions: source_actions %>

<% if @money_source.debt? %>
  <%
    tabs = [
      { slug: "resumen", label: t("money_sources.show.tabs.summary"), icon: "ti-layout-dashboard" },
      { slug: "movimientos", label: t("money_sources.show.tabs.movements", default: "Movimientos"), icon: "ti-list" }
    ]
    tabs << { slug: "pagos", label: t("money_sources.show.tabs.payments"), icon: "ti-coin" } if @money_source.debt?
    tabs << { slug: "abonos", label: t("money_sources.show.tabs.extras"), icon: "ti-notebook" } if @money_source.loan? || @money_source.credit_card?
    tabs << { slug: "reconocimiento", label: t("money_sources.show.tabs.recognition"), icon: "ti-scan" } if @money_source.payment_source?
  %>

  <div data-source-tabs="<%= @money_source.id %>" <% if @active_tab == "movimientos" %>data-source-tabs-force="movimientos"<% end %>>
    <ul class="nav nav-tabs" role="tablist">
      <% tabs.each do |tab| %>
        <li class="nav-item" role="presentation">
          <% if tab[:slug] == "movimientos" %>
            <%= link_to extractos_money_source_path(@money_source),
                        class: "nav-link#{' active' if @active_tab == 'movimientos'}",
                        id: "source-tab-movimientos-btn",
                        data: { tab_slug: "movimientos" },
                        role: "tab",
                        aria: { controls: "source-tab-movimientos", selected: @active_tab == "movimientos" } do %>
              <i class="ti <%= tab[:icon] %> me-1"></i><%= tab[:label] %>
            <% end %>
          <% else %>
            <button class="nav-link<%= " active" if tab[:slug] == @active_tab %>"
                    id="source-tab-<%= tab[:slug] %>-btn"
                    data-bs-toggle="tab"
                    data-bs-target="#source-tab-<%= tab[:slug] %>"
                    data-tab-slug="<%= tab[:slug] %>"
                    type="button"
                    role="tab"
                    aria-controls="source-tab-<%= tab[:slug] %>"
                    aria-selected="<%= tab[:slug] == @active_tab %>">
              <i class="ti <%= tab[:icon] %> me-1"></i><%= tab[:label] %>
            </button>
          <% end %>
        </li>
      <% end %>
    </ul>

    <div class="tab-content">
      <div class="tab-pane fade <%= "show active" if @active_tab != "movimientos" %>" id="source-tab-resumen" role="tabpanel" aria-labelledby="source-tab-resumen-btn" tabindex="0">
        <div class="row g-4 pt-4">
          <div class="col-lg-7">
            <% if @money_source.debt? %>
              <%= render "money_sources/debt_panel", source: @money_source %>
            <% else %>
              <div class="card">
                <div class="card-body">
                  <h5 class="card-title"><%= t("money_sources.show.current_balance") %></h5>
                  <div class="stat-value text-success mb-2"><%= @money_source.balance_label %></div>
                  <% if @money_source.negative_balance_warning? %>
                    <span class="badge text-bg-warning mt-2" data-testid="negative-balance-warning">
                      <i class="ti ti-alert-triangle me-1"></i><%= t("money_sources.negative_balance_warning") %>
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
          <div class="col-lg-5">
            <%= render "money_sources/details" %>
          </div>
        </div>
      </div>

      <% if @statement.present? %>
        <div class="tab-pane fade <%= "show active" if @active_tab == "movimientos" %>" id="source-tab-movimientos" role="tabpanel" aria-labelledby="source-tab-movimientos-btn" tabindex="0">
          <%= render "money_sources/statement", source: @money_source, statement: @statement %>
        </div>
      <% end %>

      <% if @money_source.debt? %>
        <div class="tab-pane fade" id="source-tab-pagos" role="tabpanel" aria-labelledby="source-tab-pagos-btn" tabindex="0">
          <%= render "money_sources/payments" %>
        </div>
      <% end %>

      <% if @money_source.loan? || @money_source.credit_card? %>
        <div class="tab-pane fade" id="source-tab-abonos" role="tabpanel" aria-labelledby="source-tab-abonos-btn" tabindex="0">
          <%= render "money_sources/extra_payments", source: @money_source,
                     simple: @money_source.credit_card? || @money_source.revolving?,
                     funding_sources: current_user.money_sources.payment_sources.order(:kind, :name).where.not(id: @money_source.id) %>
        </div>
      <% end %>

      <% if @money_source.payment_source? %>
        <div class="tab-pane fade" id="source-tab-reconocimiento" role="tabpanel" aria-labelledby="source-tab-reconocimiento-btn" tabindex="0">
          <div class="card mt-4">
            <div class="card-body">
              <h5 class="card-title"><%= t("money_sources.show.recognition") %></h5>
              <% recognition_keywords = @money_source.recognition_identifiers.select(&:keyword?).map(&:value) %>
              <% if recognition_keywords.any? %>
                <% recognition_keywords.each do |keyword| %>
                  <span class="badge bg-light text-dark me-1 mb-1">
                    <%= keyword %>
                  </span>
                <% end %>
              <% else %>
                <p class="text-secondary mb-0"><%= t("money_sources.recognition.status_unconfigured") %></p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div data-source-tabs="<%= @money_source.id %>" <% if @active_tab == "movimientos" %>data-source-tabs-force="movimientos"<% end %>>
    <ul class="nav nav-tabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link<%= " active" unless @active_tab == "movimientos" %>"
                id="source-tab-resumen-btn"
                data-bs-toggle="tab"
                data-bs-target="#source-tab-resumen"
                data-tab-slug="resumen"
                type="button"
                role="tab"
                aria-controls="source-tab-resumen"
                aria-selected="<%= @active_tab != "movimientos" %>">
          <i class="ti ti-layout-dashboard me-1"></i><%= t("money_sources.show.tabs.summary") %>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <%= link_to extractos_money_source_path(@money_source),
                    class: "nav-link#{' active' if @active_tab == 'movimientos'}",
                    id: "source-tab-movimientos-btn",
                    data: { tab_slug: "movimientos" },
                    role: "tab",
                    aria: { controls: "source-tab-movimientos", selected: @active_tab == "movimientos" } do %>
          <i class="ti ti-list me-1"></i><%= t("money_sources.show.tabs.movements", default: "Movimientos") %>
        <% end %>
      </li>
    </ul>

    <div class="tab-content">
      <div class="tab-pane fade <%= "show active" unless @active_tab == "movimientos" %>" id="source-tab-resumen" role="tabpanel" aria-labelledby="source-tab-resumen-btn" tabindex="0">
        <div class="row g-4 pt-4">
          <% if @money_source.pocket? %>
            <div class="col-lg-7">
              <%= render "money_sources/pocket_breakdown" %>
            </div>
            <div class="col-lg-5">
              <%= render "money_sources/details" %>
            </div>
          <% else %>
            <div class="col-lg-7">
              <div class="card">
                <div class="card-body">
                  <h5 class="card-title"><%= t("money_sources.show.current_balance") %></h5>
                  <div class="stat-value text-success mb-2"><%= @money_source.balance_label %></div>
                  <% if @money_source.negative_balance_warning? %>
                    <span class="badge text-bg-warning mt-2" data-testid="negative-balance-warning">
                      <i class="ti ti-alert-triangle me-1"></i><%= t("money_sources.negative_balance_warning") %>
                    </span>
                  <% end %>
                </div>
              </div>
              <% if @money_source.payment_source? %>
                <div class="card mt-3">
                  <div class="card-body">
                    <h5 class="card-title"><%= t("money_sources.show.recognition") %></h5>
                    <% recognition_keywords = @money_source.recognition_identifiers.select(&:keyword?).map(&:value) %>
                    <% if recognition_keywords.any? %>
                      <% recognition_keywords.each do |keyword| %>
                        <span class="badge bg-light text-dark me-1 mb-1">
                          <%= keyword %>
                        </span>
                      <% end %>
                    <% else %>
                      <p class="text-secondary mb-0"><%= t("money_sources.recognition.status_unconfigured") %></p>
                    <% end %>
                  </div>
                </div>
              <% end %>
              <% if @money_source.kind == "account" %>
                <% gmf_acc = GmfMonthlyAccumulator.find_by(user_id: current_user.id, money_source_id: @money_source.id, year: Date.current.year, month: Date.current.month) %>
                <% gmf_limit = Gmf::Uvt.exemption_limit(Date.current.year) rescue 0 %>
                <% gmf_debits = gmf_acc&.total_debits || 0 %>
                <% gmf_covered = gmf_acc&.covered_by_exemption || 0 %>
                <% gmf_gmf = gmf_acc&.gmf_generated || 0 %>
                <% gmf_pct = gmf_limit.to_d.positive? ? (gmf_debits.to_d / gmf_limit.to_d * 100) : 0 %>
                <div class="card mt-3">
                  <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                      <h5 class="card-title mb-0">Control del GMF 4×1.000</h5>
                      <span class="badge bg-light text-dark"><%= I18n.l(Date.current, format: "%B %Y") %></span>
                    </div>
                    <div class="row g-3">
                      <div class="col-6">
                        <div class="text-muted small">Débitos que consumen exención</div>
                        <div class="fs-5 fw-bold"><%= number_to_currency(gmf_debits) %></div>
                      </div>
                      <div class="col-6 text-end">
                        <div class="text-muted small">GMF cobrado</div>
                        <div class="fs-5 fw-bold text-warning"><%= number_to_currency(gmf_gmf) %></div>
                      </div>
                    </div>
                    <div class="mt-3">
                      <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Consumo del límite mensual</span>
                        <strong><%= number_to_percentage(gmf_pct, precision: 2) %></strong>
                      </div>
                      <div class="progress" role="progressbar" aria-valuenow="<%= gmf_pct.round(2) %>" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar bg-success et-w-<%= [gmf_pct, 100].min.round %>"></div>
                      </div>
                    </div>
                    <div class="row g-2 mt-3 pt-3 border-top">
                      <div class="col-4">
                        <div class="text-muted small">Límite mensual</div>
                        <div class="fw-semibold"><%= number_to_currency(gmf_limit) %></div>
                      </div>
                      <div class="col-4">
                        <div class="text-muted small">Disponible</div>
                        <div class="fw-semibold"><%= number_to_currency([gmf_limit - gmf_covered, 0].max) %></div>
                      </div>
                      <div class="col-4">
                        <div class="text-muted small">Exenta 4×1.000</div>
                        <div class="fw-semibold"><%= @money_source.gmf_exempt? ? "Sí" : "No" %></div>
                      </div>
                    </div>
                    <small class="text-muted d-block mt-3">El seguimiento corresponde al mes calendario y se reinicia el primer día de cada mes.</small>
                  </div>
                </div>
              <% end %>
            </div>
            <div class="col-lg-5">
              <%= render "money_sources/details" %>
            </div>
          <% end %>
        </div>
      </div>

      <% if @statement.present? %>
        <div class="tab-pane fade <%= "show active" if @active_tab == "movimientos" %>" id="source-tab-movimientos" role="tabpanel" aria-labelledby="source-tab-movimientos-btn" tabindex="0">
          <%= render "money_sources/statement", source: @money_source, statement: @statement %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%= render "money_sources/quick_transfer_modal" %>