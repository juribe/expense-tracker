<%# Account/cash card for the accounts dashboard. Locals: source (MoneySource). %>
<%
  icon = source_kind_icon(source.kind)
  kind_label = source_kind_label(source.kind)
  balance = source.balance
  # Touch parent unconditionally so Bullet sees the association accessed even
  # when the source is not a debit card (nil parent_id loads nothing).
  linked_parent = source.parent
  is_debit_linked = source.debit_card? && linked_parent
%>
<article class="account-card" data-testid="account-card">
  <div class="account-card-head">
    <div class="account-identity">
      <span class="account-icon accent-teal" aria-hidden="true"><i class="ti ti-<%= icon %>"></i></span>
      <div class="min-w-0">
        <h3 class="account-name"><%= link_to source.name, money_source_path(source), class: "text-decoration-none text-inherit" %></h3>
        <div class="account-meta">
          <span><%= kind_label %></span>
          <% if source.bank.present? %>
            <span class="ms-2"><i class="ti ti-building-bank" aria-hidden="true"></i><%= source.bank %></span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="account-actions d-print-none">
      <% # Spike-style card menu: one "..." toggle in the card corner; every
         # action (quick transfers, edit, delete) lives in its dropdown, so
         # the title keeps the full row width.
      %>
      <div class="dropdown">
        <button type="button" class="card-more-btn" data-bs-toggle="dropdown" aria-expanded="false"
                data-testid="card-actions-toggle" aria-label="<%= t("common.actions") %>">
          <i class="ti ti-dots" aria-hidden="true"></i>
        </button>
        <div class="dropdown-menu dropdown-menu-end">
          <%= render "money_sources/quick_transfer_actions", source: source, menu: true, with_text: true %>
          <% if quick_transfer_actions(source).any? %>
            <div class="dropdown-divider"></div>
          <% end %>
          <%= link_to edit_money_source_path(source), class: "dropdown-item d-flex align-items-center gap-2", href: edit_money_source_path(source) do %>
            <i class="ti ti-pencil me-2" aria-hidden="true"></i><span><%= t("common.edit") %></span>
          <% end %>
          <%= button_to money_source_path(source), method: :delete, class: "dropdown-item d-flex align-items-center gap-2", title: t("common.delete"), data: { confirm: t("common.confirm") }, form: { style: "display:block" } do %>
            <i class="ti ti-trash me-2" aria-hidden="true"></i><span><%= t("common.delete") %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="account-balance">
    <div class="account-balance-label"><%= t("money_sources.accounts.balance") %></div>
    <div class="account-balance-amount <%= balance >= 0 ? 'text-success' : 'text-danger' %>"><%= number_to_currency(balance) %></div>
  </div>

  <% if is_debit_linked %>
    <div class="account-linked">
      <i class="ti ti-link" aria-hidden="true"></i>
      <span><%= t("money_sources.accounts.linked_to", name: linked_parent.name) %></span>
    </div>
  <% end %>

  <div class="account-metrics">
    <% recognition_keywords = source.recognition_identifiers.select(&:keyword?).map(&:value) %>
    <% if recognition_keywords.any? %>
      <div class="account-meter">
        <div class="account-meter-label"><%= t("money_sources.accounts.recognition") %></div>
        <div class="account-meter-value">
          <% recognition_keywords.each do |keyword| %>
            <span class="badge bg-light text-dark me-1"><%= keyword %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="account-card-foot">
    <% if source.transactions_count.to_i.positive? %>
      <span class="account-foot-item"><i class="ti ti-receipt" aria-hidden="true"></i><span><%= t("money_sources.index.transactions_count", count: source.transactions_count.to_i) %></span></span>
    <% end %>
    <% if source.children.any? %>
      <span class="account-foot-divider" aria-hidden="true"></span>
      <span class="account-foot-item"><i class="ti ti-credit-card" aria-hidden="true"></i><span><%= t("money_sources.index.linked_cards_count", count: source.children.count) %></span></span>
    <% end %>
    <% unless source.active? %>
      <span class="account-foot-divider" aria-hidden="true"></span>
      <span class="account-foot-item"><span class="badge bg-secondary"><%= t("common.inactive", default: "Inactiva") %></span></span>
    <% end %>
  </div>
</article>
