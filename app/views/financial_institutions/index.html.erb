<%#
  "Mis entidades" — the user's own financial entities ONLY ("Otra entidad").
  A custom entity can be renamed or deleted; deleting one that still backs
  money sources is blocked at the controller. The shared global catalog is
  NOT listed here: it surfaces inline in the money-source form's institution
  autocomplete, and its data is never editable by users.
%>
<%= render "shared/page_header", title: t("financial_institutions.title"),
                                subtitle: t("financial_institutions.subtitle") do %>
  <%= link_to new_custom_financial_institution_path, class: "btn btn-primary" do %>
    <i class="ti ti-plus me-1" aria-hidden="true"></i><%= t("financial_institutions.new_custom") %>
  <% end %>
<% end %>

<div class="category-toolbar">
  <div class="category-search">
    <i class="ti ti-search" aria-hidden="true"></i>
    <%= search_field_tag :entity_search, nil,
                         id: "financial-institution-search",
                         class: "form-control",
                         placeholder: t("financial_institutions.search_placeholder"),
                         autocomplete: "off",
                         aria: { label: t("financial_institutions.search_placeholder") },
                         data: { financial_institution_search: true } %>
  </div>
  <span class="small text-secondary"><%= t("financial_institutions.search_hint") %></span>
</div>

<% if @custom_institutions.empty? %>
  <div class="card page-section">
    <div class="card-body">
      <%= render "shared/empty_state",
                 icon: "user-plus",
                 title: t("financial_institutions.no_custom"),
                 text: t("financial_institutions.no_custom_hint"),
                 cta: link_to(t("financial_institutions.new_custom"), new_custom_financial_institution_path, class: "btn btn-primary") %>
    </div>
  </div>
<% else %>
  <div class="row g-3" data-financial-institutions-grid>
    <% @custom_institutions.each do |institution| %>
      <div class="col-12 col-md-6 col-lg-4"
           data-financial-institution-card
           data-entity-name="<%= institution.display_name %>">
        <%= render "financial_institutions/entity_card", institution: institution %>
      </div>
    <% end %>
  </div>

  <div class="empty-state mt-4" data-financial-institutions-no-results hidden>
    <i class="ti ti-search-off" aria-hidden="true"></i>
    <p class="mb-0"><%= t("financial_institutions.no_results") %></p>
  </div>
<% end %>

<aside class="category-note mt-4">
  <i class="ti ti-info-circle" aria-hidden="true"></i>
  <div>
    <strong><%= t("financial_institutions.note_title") %></strong>
    <p class="mb-0"><%= t("financial_institutions.note_body") %></p>
  </div>
</aside>

<%= javascript_include_tag "financial_institutions_index", defer: true %>
