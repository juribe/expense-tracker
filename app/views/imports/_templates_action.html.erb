<%# Page action for importing recurring templates. Free users keep the button
    visible but locked; it opens imports/premium_lock_modal. %>
<% if import_templates_locked? %>
  <%= render "shared/premium_locked_action",
             modal_id: "importPremiumModal",
             label: t("monthly_incomes.import_templates"),
             testid: "import-templates-locked",
             aria_label: t("imports.premium_lock.button_aria") %>
<% else %>
  <%= link_to new_import_path, class: "btn btn-outline-secondary", data: { turbo: false } do %>
    <i class="ti ti-upload me-1" aria-hidden="true"></i><%= t("monthly_incomes.import_templates") %>
  <% end %>
<% end %>
