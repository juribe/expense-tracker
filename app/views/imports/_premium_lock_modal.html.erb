<%# Premium upsell shown when importing templates is locked. %>
<% if import_templates_locked? %>
  <%= render "shared/premium_upsell_modal",
             id: "importPremiumModal",
             testid: "import-premium-modal",
             title: t("imports.premium_lock.title"),
             description: t("imports.premium_lock.description"),
             cta: t("imports.premium_lock.cta"),
             dismiss: t("imports.premium_lock.dismiss") %>
<% end %>
