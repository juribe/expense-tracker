<div class="container-fluid py-4 import-recurring-templates et-maxw-800">
  <%= form_with(url: import_upload_path, local: true, html: { multipart: true }) do |form| %>
    <div class="card border-0">
      <div class="card-header">
        <h4 class="mb-0">
          <i class="ti ti-upload me-2"></i><%= t("imports.title", default: "Importar plantillas recurrentes") %>
        </h4>
      </div>

      <div class="card-body">
        <div class="alert alert-info" role="alert">
          <h6 class="alert-heading mb-2">
            <i class="ti ti-info-circle me-1"></i><%= t("imports.csv_format", default: "Formato CSV") %>
          </h6>
          <p class="mb-2"><%= t("imports.download_template", default: "Descarga y usa esta plantilla:") %></p>
          <code class="bg-white p-2 rounded"><%= t("imports.csv_template", default: "categoría,tipo,monto,descripción,día de pago,activo") %></code>
          <div class="mt-2">
            <small class="text-muted">
              <%= t("common.required") %>: <strong><%= t("imports.fields.category", default: "categoría") %></strong><br>
              <%= t("common.optional") %>:
              <strong><%= t("imports.fields.kind", default: "tipo") %></strong> (<%= t("imports.value_hints.kind", default: "ingreso/gasto") %>),
              <strong><%= t("imports.fields.amount", default: "monto") %></strong>,
              <strong><%= t("imports.fields.description", default: "descripción") %></strong>,
              <strong><%= t("imports.fields.payment_day", default: "día de pago") %></strong>,
              <strong><%= t("imports.fields.active", default: "activo") %></strong> (<%= t("imports.value_hints.active", default: "verdadero/falso") %>)
            </small>
          </div>
        </div>

        <div class="mb-3">
          <label for="file" class="form-label"><%= t("imports.csv_file", default: "Archivo CSV") %> <span class="text-danger">*</span></label>
          <input type="file" id="file" name="file" accept=".csv,text/csv" class="form-control" required>
          <div class="form-text"><%= t("imports.select_file", default: "Selecciona un archivo CSV con datos de plantillas recurrentes.") %></div>
        </div>

        <% if @categories.any? %>
          <div class="mb-3">
            <%= category_picker form, :default_category_id, @categories,
                                label: t("imports.default_category", default: "Categoría por defecto (opcional)"),
                                prompt: t("imports.category_from_csv", default: "Usar la categoría del CSV"),
                                id: "import_category",
                                testid: "import-category-picker" %>
            <div class="form-text"><%= t("imports.default_category_help", default: "Si una fila no logra resolverse con las categorías del CSV, se usará esta categoría (si su tipo coincide).") %></div>
          </div>
        <% else %>
          <div class="alert alert-warning" role="alert">
            <i class="ti ti-alert-triangle me-2"></i><%= t("imports.no_categories", default: "No se encontraron categorías. Crea primero una categoría.") %>
          </div>
        <% end %>
      </div>

      <div class="card-footer d-flex justify-content-end gap-2">
        <%= link_to categories_path, class: "btn btn-outline-secondary" do %>
          <i class="ti ti-x me-1"></i><%= t("common.cancel") %>
        <% end %>
        <%= form.submit t("imports.review_button", default: "Revisar importación"), class: "btn btn-primary", id: "import-btn" %>
      </div>
    </div>
  <% end %>
</div>
