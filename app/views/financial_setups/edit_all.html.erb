<% @step_key = @step.key.to_s %>
<%= render "stepper", step_key: @step_key %>

<div class="card shadow">
  <div class="card-body p-4">
    <h3 class="fw-bold text-primary mb-1"><%= t("wizard.edit_all.title", kind: t(@step.label_key).downcase) %></h3>
    <p class="text-muted mb-4"><%= t("wizard.edit_all.hint") %></p>

    <%= form_with url: financial_setup_save_edits_path, method: :post, local: true, data: { turbo: false } do %>
      <%= hidden_field_tag :step, @step_key %>

      <div id="manualRows">
        <% @rows.each_with_index do |row, idx| %>
          <%= render "manual_row", row: row, idx: idx, kind: @step.kind %>
        <% end %>
      </div>

      <button type="button" class="btn btn-outline-primary mb-4" id="addAnotherRow">
        <i class="bi bi-plus-lg me-1"></i><%= t("wizard.manual.add_another") %>
      </button>

       <div class="d-flex justify-content-between">
         <div class="d-flex gap-2">
           <%= link_to financial_setup_step_path(step: @step_key), class: "btn btn-outline-secondary" do %>
             <i class="bi bi-x-lg me-1"></i><%= t("wizard.cancel") %>
           <% end %>
           <% unless @step.kind == "cash" %>
             <%= link_to financial_setup_upload_screen_path(step: @step_key), class: "btn btn-outline-primary" do %>
               <i class="bi bi-cloud-upload me-1"></i><%= t("wizard.select.import") %>
             <% end %>
           <% end %>
         </div>
         <div>
           <%= link_to t("wizard.exit_resume"), dashboard_path, class: "btn btn-link text-muted me-2" %>
           <%= submit_tag t("wizard.save_changes"), class: "btn btn-primary" %>
         </div>
       </div>
    <% end %>
  </div>
</div>

<template id="manualRowTemplate">
  <%= render "manual_row", row: { "name" => "", "bank" => "", "origin" => "manual" }, idx: "{IDX}", kind: @step.kind %>
</template>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var container = document.getElementById('manualRows');
  var addBtn = document.getElementById('addAnotherRow');
  if (!container || !addBtn) return;
  var idx = container.querySelectorAll('.manual-row').length;

  addBtn.addEventListener('click', function() {
    var template = document.getElementById('manualRowTemplate');
    var html = template.innerHTML.replaceAll('{IDX}', idx);
    container.insertAdjacentHTML('beforeend', html);
    idx++;
    // Bind money formatting (and the available-credit readout) to the new row.
    if (window.MoneyInputs) MoneyInputs.init();
  });

  container.addEventListener('click', function(e) {
    var btn = e.target.closest('.remove-row');
    if (btn) {
      btn.closest('.manual-row').remove();
    }
  });
});
</script>