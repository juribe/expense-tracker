<%# Stepper showing wizard progress across steps. %>
<% step_idx = FinancialSetupWizard.step_keys.index(@step_key.to_sym) %>
<nav class="d-none d-lg-flex flex-wrap align-items-center gap-2 mb-3" aria-label="<%= t("wizard.steps_title") %>">
  <% FinancialSetupWizard.steps.each_with_index do |setup_step, idx| %>
    <% done = idx < step_idx.to_i %>
    <% current = idx == step_idx.to_i %>
    <span       class="d-inline-flex align-items-center justify-content-center rounded-circle fw-bold et-chip-32
      <%= done ? 'bg-success text-white' : (current ? 'bg-primary text-white' : 'bg-light text-muted border') %>"
      >
      <% if done %><i class="ti ti-check"></i><% else %><%= idx + 1 %><% end %>
    </span>
    <span class="<%= current ? 'fw-bold' : 'text-muted' %>"><%= t(setup_step.label_key) %></span>
    <% if idx < FinancialSetupWizard.steps.length - 1 %>
      <span class="d-inline-block <%= done ? 'bg-success' : 'bg-secondary' %> et-stepper-bar"></span>
    <% end %>
  <% end %>
  <span class="ms-auto">
    <%= form_with url: financial_setup_reset_path, method: :post, data: { turbo: false } do %>
      <button type="submit" class="btn btn-sm btn-link text-muted text-decoration-none"
              data-reset-confirm="<%= t('wizard.reset.confirm') %>" title="<%= t("wizard.reset.button") %>">
        <i class="ti ti-rotate-2 me-1"></i><%= t("wizard.reset.button") %>
      </button>
    <% end %>
  </span>
</nav>
<div class="d-lg-none mb-3 d-flex justify-content-between align-items-center">
  <span class="text-muted"><%= t("wizard.step_of", current: step_idx.to_i + 1, total: FinancialSetupWizard.steps.length) %></span>
  <%= form_with url: financial_setup_reset_path, method: :post, data: { turbo: false } do %>
    <button type="submit" class="btn btn-sm btn-link text-muted text-decoration-none"
            data-reset-confirm="<%= t('wizard.reset.confirm') %>" title="<%= t("wizard.reset.button") %>">
      <i class="ti ti-rotate-2"></i>
    </button>
  <% end %>
</div>
