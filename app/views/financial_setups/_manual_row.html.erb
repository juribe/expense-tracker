<%# Single manual-entry row within the wizard. Field names use sources[INDEX][field]. %>
<div class="card mb-3 manual-row">
  <div class="card-header d-flex justify-content-between align-items-center bg-light">
    <span class="fw-bold"><%= row["name"].presence || t("wizard.manual.row_name") %></span>
    <span class="btn-group btn-group-sm">
      <button type="button" class="btn btn-outline-secondary edit-row" title="<%= t("wizard.manual.edit") %>"><i class="bi bi-pencil"></i></button>
      <button type="button" class="btn btn-outline-danger remove-row" title="<%= t("wizard.manual.remove") %>"><i class="bi bi-trash"></i></button>
    </span>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <% index = idx.is_a?(Integer) ? idx : "{IDX}" %>

      <div class="col-md-6">
        <label class="form-label"><%= t("wizard.manual.name") %></label>
        <input type="text" name="sources[<%= index %>][name]" value="<%= row["name"] %>" class="form-control">
      </div>
      <div class="col-md-6">
        <label class="form-label"><%= kind == "loan" ? t("wizard.manual.lender") : t("wizard.manual.bank") %></label>
        <input type="text" name="sources[<%= index %>][bank]" value="<%= row["bank"] %>" class="form-control">
      </div>

      <% if %w[account credit_card].include?(kind) %>
        <div class="col-md-6">
          <label class="form-label"><%= kind == "credit_card" ? t("wizard.manual.current_balance") : t("wizard.manual.starting_balance") %></label>
          <div class="input-group">
            <span class="input-group-text">$</span>
            <input type="text" name="sources[<%= index %>][balance]" value="<%= money_field_value(row["balance"]) %>" class="form-control" data-money-input="true">
          </div>
        </div>
      <% end %>
      <% if kind == "credit_card" %>
        <div class="col-md-6">
          <label class="form-label"><%= t("wizard.manual.credit_limit") %></label>
          <div class="input-group">
            <span class="input-group-text">$</span>
            <input type="text" name="sources[<%= index %>][credit_limit]" value="<%= money_field_value(row["credit_limit"]) %>" class="form-control" data-money-input="true">
          </div>
        </div>
        <div class="col-md-6">
          <label class="form-label"><%= t("wizard.manual.card_last_four") %></label>
          <input type="text" name="sources[<%= index %>][card_last_four]" value="<%= row["card_last_four"] %>" maxlength="4" class="form-control" inputmode="numeric">
        </div>
        <div class="col-md-6">
          <label class="form-label"><%= t("wizard.manual.interest_rate") %></label>
          <div class="input-group">
            <input type="text" name="sources[<%= index %>][interest_rate]" value="<%= row["interest_rate"] %>" class="form-control" inputmode="decimal">
            <span class="input-group-text">%</span>
          </div>
        </div>
        <div class="col-md-6">
          <label class="form-label"><%= t("wizard.manual.interest_rate_type") %></label>
          <select name="sources[<%= index %>][interest_rate_type]" class="form-select">
            <%= options_for_select(CreditAccount::INTEREST_RATE_TYPES.values, row["interest_rate_type"]) %>
          </select>
        </div>
      <% end %>

      <% if kind == "loan" %>
        <div class="col-md-6">
          <label class="form-label"><%= t("wizard.manual.outstanding_balance") %></label>
          <div class="input-group">
            <span class="input-group-text">$</span>
            <input type="text" name="sources[<%= index %>][outstanding_balance]" value="<%= money_field_value(row["outstanding_balance"]) %>" class="form-control" data-money-input="true">
          </div>
        </div>
        <div class="col-md-6">
          <label class="form-label"><%= t("wizard.manual.monthly_payment") %></label>
          <div class="input-group">
            <span class="input-group-text">$</span>
            <input type="text" name="sources[<%= index %>][monthly_payment]" value="<%= money_field_value(row["monthly_payment"]) %>" class="form-control" data-money-input="true">
          </div>
        </div>
        <div class="col-md-6">
          <label class="form-label"><%= t("wizard.manual.interest_rate") %></label>
          <div class="input-group">
            <input type="text" name="sources[<%= index %>][interest_rate]" value="<%= row["interest_rate"] %>" class="form-control" inputmode="decimal">
            <span class="input-group-text">%</span>
          </div>
        </div>
        <div class="col-md-6">
          <label class="form-label"><%= t("wizard.manual.interest_rate_type") %></label>
          <select name="sources[<%= index %>][interest_rate_type]" class="form-select">
            <%= options_for_select(CreditAccount::INTEREST_RATE_TYPES.values, row["interest_rate_type"]) %>
          </select>
        </div>
      <% end %>

      <input type="hidden" name="sources[<%= index %>][kind]" value="<%= kind %>">
    </div>
  </div>
</div>
