<%# Selectable wizard choice card.
    Locals: value (radio value), icon, icon_color, title, hint, col_class. %>
<div class="col-12 <%= col_class %>">
  <label class="card choice-card h-100 p-3 d-block" role="radio" aria-checked="false" tabindex="0">
    <input type="radio" name="choice" value="<%= value %>" class="visually-hidden">
    <div class="d-flex align-items-center gap-3">
      <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary flex-shrink-0 et-chip-48">
        <i class="ti ti-<%= icon %> fs-4"></i>
      </span>
      <span class="flex-grow-1 min-w-0">
        <span class="fw-bold d-block"><%= title %></span>
        <span class="small text-muted d-block"><%= hint %></span>
      </span>
      <i class="ti ti-chevron-right text-muted flex-shrink-0"></i>
    </div>
  </label>
</div>
