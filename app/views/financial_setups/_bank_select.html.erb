<%#
  Bank autocomplete for the financial-setup wizard: a searchable input backed by
  a <datalist> of the shared catalog banks, keeping the row's current value even
  when it is not part of the catalog (legacy free-text banks from imports).
  Writing the chosen value into sources[INDEX][bank] keeps the legacy free-text
  column populated, same as before.
  Locals: index (Integer|String), value (String), kind (String), col_class,
  compact (optional)
%>
<% col_class ||= "col-md-6" %>
<% compact = local_assigns.fetch(:compact, false) %>
<% label_class = compact ? "form-label small text-muted mb-1" : "form-label" %>
<% label = kind == "loan" ? t("wizard.manual.lender") : t("wizard.manual.bank") %>
<% options = bank_dropdown_options %>
<% options = options | [ value ] if value.present? %>
<% list_id = "bank-options-#{index}" %>
<div class="<%= col_class %>">
  <label class="<%= label_class %>"><%= label %></label>
  <input type="text" name="sources[<%= index %>][bank]" value="<%= value %>"
         class="form-control" list="<%= list_id %>"
         placeholder="<%= t("wizard.manual.bank_placeholder") %>" autocomplete="off">
  <datalist id="<%= list_id %>">
    <% options.each do |bank| %>
      <option value="<%= bank %>"></option>
    <% end %>
  </datalist>
</div>
