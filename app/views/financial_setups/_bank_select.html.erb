<%#
  Institution combobox for the financial-setup wizard: searchable list of the
  active catalog entities plus the user's own entities. The chosen polymorphic
  reference ("FinancialInstitution:ID") travels in institution_ref and is
  attached to the created source by FinancialSetups::Completer. The legacy
  free-text bank is kept as a hidden field so imported rows never lose it.
  Starts empty on purpose: the user always picks the entity explicitly.
  Locals: index (Integer|String), value (legacy bank text), kind (String),
  col_class, compact (optional), institution_ref (optional previous choice).
%>
<% col_class ||= "col-md-6" %>
<% compact = local_assigns.fetch(:compact, false) %>
<% selected_ref = local_assigns.fetch(:institution_ref, "") %>
<% label_class = compact ? "form-label small text-muted mb-1" : "form-label" %>
<% label = kind == "loan" ? t("wizard.manual.lender") : t("wizard.manual.bank") %>
<div class="<%= col_class %> mb-3">
  <label class="<%= label_class %>"><%= label %></label>
  <input type="hidden" name="sources[<%= index %>][bank]" value="<%= value %>">
  <input type="hidden" name="sources[<%= index %>][institution_ref]" value="<%= selected_ref %>">
  <div class="category-picker" data-institution-combobox data-options="<%= institution_autocomplete_data(selected_ref).to_json %>">
    <div class="input-group">
      <span class="input-group-text"><i class="ti ti-search" aria-hidden="true"></i></span>
      <input type="text" class="form-control"
             data-institution-search
             placeholder="<%= t('wizard.manual.bank_placeholder') %>"
             autocomplete="off" spellcheck="false"
             role="combobox" aria-autocomplete="list" aria-expanded="false"
             aria-haspopup="listbox" aria-label="<%= label %>">
      <button type="button" class="btn btn-outline-secondary" data-institution-clear
              aria-label="<%= t('money_sources.form.institution_none') %>" hidden>
        <i class="ti ti-x" aria-hidden="true"></i>
      </button>
    </div>
    <div class="institution-autocomplete category-picker__list" data-institution-list hidden></div>
  </div>
</div>
