<% @step_key = @step.key.to_s %>
<%= render "stepper", step_key: @step_key %>

<div class="card shadow">
  <div class="card-body p-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
      <h3 class="fw-bold text-primary mb-0"><%= t("wizard.manual.title", kind: t(@step.label_key).downcase) %></h3>
      <button type="button" class="btn btn-sm btn-outline-primary" id="addAnotherRow">
        <i class="bi bi-plus-lg me-1"></i><%= t("wizard.manual.add_another") %>
      </button>
    </div>
    <p class="text-muted mb-4"><%= t("wizard.manual.hint") %></p>

    <%= form_with url: financial_setup_manual_path, method: :post, local: true, data: { turbo: false } do %>
      <%= hidden_field_tag :step, @step_key %>

      <div id="manualRows">
        <% @rows.each_with_index do |row, idx| %>
          <%= render "manual_row", row: row, idx: idx, kind: @step.kind %>
        <% end %>
      </div>

       <div class="d-flex justify-content-between">
         <div class="d-flex gap-2">
           <%= link_to financial_setup_step_path(step: @step_key), class: "btn btn-outline-secondary" do %>
             <i class="bi bi-x-lg me-1"></i><%= t("wizard.cancel") %>
           <% end %>
         </div>
         <div>
           <%= link_to t("wizard.exit_resume"), dashboard_path, class: "btn btn-link text-muted me-2" %>
           <%= submit_tag t("wizard.continue"), class: "btn btn-primary" %>
         </div>
       </div>
    <% end %>
  </div>
</div>

<template id="manualRowTemplate">
  <%= render "manual_row", row: { "name" => "", "bank" => "" }, idx: "{IDX}", kind: @step.kind %>
</template>

<script>
(function () {
  if (window.__manualRowsBound) return;
  window.__manualRowsBound = true;

  // Delegated on document so the buttons keep working after Turbo renders.
  document.addEventListener('click', function (e) {
    var addBtn = e.target.closest('#addAnotherRow');
    if (addBtn) {
      var container = document.getElementById('manualRows');
      var template = document.getElementById('manualRowTemplate');
      if (!container || !template) return;
      var idx = container.querySelectorAll('.manual-row').length;
      var html = template.innerHTML.replaceAll('{IDX}', idx);
      container.insertAdjacentHTML('beforeend', html);
      if (window.MoneyInputs) MoneyInputs.init();
      return;
    }

    var removeBtn = e.target.closest('.remove-row');
    if (removeBtn) {
      var rows = document.querySelectorAll('#manualRows .manual-row');
      if (rows.length > 1) removeBtn.closest('.manual-row').remove();
    }
  });
})();
</script>
