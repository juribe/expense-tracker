<% @step_key = @step.key.to_s %>
<%= render "stepper", step_key: @step_key %>

<div class="card shadow">
  <div class="card-body p-4">
    <h3 class="fw-bold text-primary mb-1"><%= t("wizard.upload.title") %></h3>
    <p class="text-muted mb-4"><%= t("wizard.upload.hint") %></p>

    <% if alert %>
      <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i><%= alert %>
        <div class="mt-2">
          <button type="button" class="btn btn-outline-danger btn-sm" onclick="document.getElementById('statementFile').click()">
            <i class="bi bi-arrow-clockwise me-1"></i><%= t("wizard.upload.retry") %>
          </button>
        </div>
      </div>
    <% end %>

    <div class="card password-card d-none mb-4">
      <div class="card-body">
        <h6 class="fw-bold"><i class="bi bi-lock me-1"></i><%= t("wizard.upload.password_title") %></h6>
        <p class="text-muted small mb-3"><%= t("wizard.upload.password_hint") %></p>
        <label class="form-label" for="statementPassword"><%= t("wizard.upload.password_label") %></label>
        <div class="input-group">
          <input type="password" id="statementPassword" class="form-control" autocomplete="off">
          <button type="button" class="btn btn-primary" id="unlockBtn"><%= t("wizard.upload.unlock") %></button>
        </div>
        <div class="invalid-feedback d-block text-danger password-error d-none"><%= t("wizard.upload.password_error") %></div>
      </div>
    </div>

    <%= form_with url: financial_setup_upload_path, method: :post, local: true, data: { turbo: false }, html: { id: "statementForm" } do %>
      <%= hidden_field_tag :step, @step_key %>
      <input type="hidden" name="password" id="statementPasswordHidden">

      <div class="border border-2 border-dashed rounded p-5 text-center" id="dropzone">
        <i class="bi bi-cloud-arrow-up display-4 text-primary d-block mb-3"></i>
        <p class="mb-1"><%= t("wizard.upload.drop") %></p>
        <button type="button" class="btn btn-sm btn-primary" id="browseBtn"><%= t("wizard.upload.browse") %></button>
        <input type="file" id="statementFile" name="file" accept=".pdf,.csv,.xlsx" class="d-none">
        <div class="mt-3 text-muted small"><%= t("wizard.upload.supported") %></div>
      </div>

      <div id="fileChip" class="d-none mt-3">
        <span class="badge bg-light text-dark border px-3 py-2">
          <i class="bi bi-file-earmark me-1"></i><span id="fileName"></span>
          <span id="fileSize" class="text-muted ms-1"></span>
        </span>
      </div>

      <div id="uploadProgress" class="progress d-none mt-3" style="height: 8px;">
        <div class="progress-bar progress-bar-striped progress-bar-animated" id="uploadProgressBar" style="width: 0%"></div>
      </div>

      <div class="d-flex justify-content-between mt-4">
        <div>
          <%= link_to financial_setup_step_path(step: @step_key), class: "btn btn-outline-secondary" do %>
            <i class="bi bi-arrow-left me-1"></i><%= t("wizard.back") %>
          <% end %>
        </div>
        <div>
          <%= link_to t("wizard.exit_resume"), dashboard_path, class: "btn btn-link text-muted me-2" %>
          <%= submit_tag t("wizard.upload.upload"), class: "btn btn-primary", disabled: true, id: "uploadBtn" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var dropzone = document.getElementById('dropzone');
  var fileInput = document.getElementById('statementFile');
  var browseBtn = document.getElementById('browseBtn');
  var fileName = document.getElementById('fileName');
  var fileSize = document.getElementById('fileSize');
  var fileChip = document.getElementById('fileChip');
  var uploadBtn = document.getElementById('uploadBtn');
  var form = document.getElementById('statementForm');
  var progressBar = document.getElementById('uploadProgressBar');
  var uploadProgress = document.getElementById('uploadProgress');
  var fileNameEl = document.getElementById('fileName');

  browseBtn.addEventListener('click', function() { fileInput.click(); });
  dropzone.addEventListener('click', function() { fileInput.click(); });

  ['dragover', 'dragenter'].forEach(function(ev) {
    dropzone.addEventListener(ev, function(e) { e.preventDefault(); dropzone.classList.add('bg-primary-subtle'); });
  });
  ['dragleave', 'drop'].forEach(function(ev) {
    dropzone.addEventListener(ev, function(e) { e.preventDefault(); dropzone.classList.remove('bg-primary-subtle'); });
  });
  dropzone.addEventListener('drop', function(e) {
    if (e.dataTransfer.files.length) fileInput.files = e.dataTransfer.files;
    handleFile();
  });
  fileInput.addEventListener('change', handleFile);

  function handleFile() {
    var file = fileInput.files[0];
    if (!file) return;
    fileName.textContent = file.name;
    fileSize.textContent = file.size ? '(' + formatSize(file.size) + ')' : '';
    fileChip.classList.remove('d-none');
    uploadBtn.disabled = false;
  }

  function formatSize(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(1) + ' MB';
  }

  form.addEventListener('submit', function(e) {
    var pwd = document.getElementById('statementPassword').value;
    document.getElementById('statementPasswordHidden').value = pwd;
    if (pwd) {
      e.preventDefault();
      uploadProgress.classList.remove('d-none');
      progressBar.style.width = '100%';
      setTimeout(function() { form.submit(); }, 300);
    } else {
      uploadProgress.classList.remove('d-none');
      progressBar.style.width = '50%';
    }
  });
});
</script>
