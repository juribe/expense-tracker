<%# "Added" summary for a wizard step: deduplicated manual + import rows.
    Locals: presenter (FinancialSetups::StepPresenter), step_key. %>
<div class="mt-4">
  <div class="d-flex align-items-center justify-content-between mb-2">
    <h6 class="fw-bold mb-0">
      <i class="ti ti-list-check me-1"></i><%= t("wizard.select.added", count: presenter.added_count) %>
    </h6>
    <% if presenter.has_added? %>
      <%= link_to financial_setup_edit_all_path(step: step_key), class: "btn btn-sm btn-outline-primary" do %>
        <i class="ti ti-pencil me-1"></i><%= t("wizard.select.edit") %>
      <% end %>
    <% end %>
  </div>

  <% if presenter.has_added? %>
    <div class="wizard-added-list">
      <% presenter.added_sources.each_with_index do |source, idx| %>
        <div class="wizard-card-row d-flex align-items-center gap-3 p-3 border rounded-3 mb-2 bg-body">
          <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary flex-shrink-0 et-chip-44">
            <i class="ti ti-<%= source_kind_icon(source["kind"]) %> fs-4"></i>
          </span>
          <div class="flex-grow-1 min-w-0">
            <div class="fw-bold text-truncate"><%= source["name"] %></div>
            <% last4 = presenter.masked_last_four(source) %>
            <% if last4.present? %>
              <span class="badge bg-light text-dark border">••••<%= last4 %></span>
            <% end %>
            <div class="small text-muted"><%= source_kind_label(source["kind"]) %></div>
          </div>
          <% amount = presenter.display_amount(source) %>
          <% if amount.present? %>
            <div class="text-end flex-shrink-0">
              <div class="small text-muted"><%= presenter.display_label(source) %></div>
              <div class="fw-bold"><%= number_to_currency(amount) %></div>
            </div>
          <% end %>
          <%= button_to financial_setup_remove_source_path, params: { step: step_key, idx: idx },
                        method: :post,
                        class: "btn btn-link text-danger p-0 card-more-btn",
                        data: { turbo: false, confirm: "Remove this account?" } do %>
            <i class="ti ti-trash"></i>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted small mb-0"><%= t("wizard.select.none_added") %></p>
  <% end %>
</div>
