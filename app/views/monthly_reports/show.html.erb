<div class="container mt-4">
  <h1>Monthly Report: <%= @month %></h1>
  
  <div class="row mt-4">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h5>Expenses</h5>
        </div>
        <div class="card-body">
          <% if @expenses.any? %>
            <table class="table">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Description</th>
                  <th>Category</th>
                  <th>Amount</th>
                </tr>
              </thead>
              <tbody>
                <% @expenses.each do |expense| %>
                  <tr>
                    <td><%= expense.date %></td>
                    <td><%= expense.description %></td>
                    <td><%= expense.category&.name || "Uncategorized" %></td>
                    <td><%= number_to_currency(expense.amount) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p>No expenses for this month.</p>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5>Summary</h5>
        </div>
        <div class="card-body">
          <p><strong>Total:</strong> <%= number_to_currency(@total) %></p>
          
          <% if @by_category.any? %>
            <h6>By Category:</h6>
            <ul class="list-unstyled">
              <% @by_category.each do |category, amount| %>
                <li><%= category %>: <%= number_to_currency(amount) %></li>
              <% end %>
            </ul>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  
  <%= link_to "Back to Monthly Reports", monthly_reports_path, class: "btn btn-secondary mt-3" %>
</div>
