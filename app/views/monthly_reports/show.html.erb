<%= render "shared/page_header",
           title: t("reports.monthly_balance", default: "Balance del ciclo"),
           subtitle: "#{l(@range.begin, format: :long)} – #{l(@range.end, format: :long)}" %>

<div class="row mt-4">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header bg-white">
        <h5 class="mb-0"><%= t("reports.transactions.title", default: "Transacciones") %></h5>
      </div>
      <div class="card-body">
        <% if @transactions.any? %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0"
                   data-sortable-table
                   data-testid="monthly-balance-transactions-table">
              <thead class="table-light">
                <tr>
                  <th scope="col" aria-sort="descending">
                    <button type="button" class="report-sort-button" data-sort-key="date" data-sort-type="date">
                      <%= t("common.date") %>
                      <i class="ti ti-sort-descending" data-sort-icon aria-hidden="true"></i>
                    </button>
                  </th>
                  <th scope="col" aria-sort="none">
                    <button type="button" class="report-sort-button" data-sort-key="type" data-sort-type="text">
                      <%= t("common.type", default: "Tipo") %>
                      <i class="ti ti-arrows-sort" data-sort-icon aria-hidden="true"></i>
                    </button>
                  </th>
                  <th scope="col" aria-sort="none">
                    <button type="button" class="report-sort-button" data-sort-key="description" data-sort-type="text">
                      <%= t("common.description") %>
                      <i class="ti ti-arrows-sort" data-sort-icon aria-hidden="true"></i>
                    </button>
                  </th>
                  <th scope="col" aria-sort="none">
                    <button type="button" class="report-sort-button" data-sort-key="category" data-sort-type="text">
                      <%= t("common.category") %>
                      <i class="ti ti-arrows-sort" data-sort-icon aria-hidden="true"></i>
                    </button>
                  </th>
                  <th scope="col" class="text-end" aria-sort="none">
                    <button type="button" class="report-sort-button" data-sort-key="amount" data-sort-type="number">
                      <%= t("common.amount") %>
                      <i class="ti ti-arrows-sort" data-sort-icon aria-hidden="true"></i>
                    </button>
                  </th>
                </tr>
              </thead>
              <tbody>
                <% @transactions.each do |transaction| %>
                  <% type_label = transaction.is_a?(Income) ? t("types.income") : t("types.expense") %>
                  <tr>
                    <td data-sort-value="<%= transaction.date.iso8601 %>"><%= l(transaction.date, format: :long) %></td>
                    <td data-sort-value="<%= type_label %>">
                      <span class="badge <%= transaction.is_a?(Income) ? 'bg-success' : 'bg-danger' %>">
                        <%= type_label %>
                      </span>
                    </td>
                    <td data-sort-value="<%= transaction.description.to_s %>"><%= transaction.description.presence || "—" %></td>
                    <td data-sort-value="<%= transaction.category&.name.to_s %>"><%= transaction.category&.name || t("common.uncategorized", default: "Sin categoría") %></td>
                    <td class="text-end fw-bold <%= transaction.amount.negative? ? 'text-danger' : 'text-success' %>"
                        data-sort-value="<%= transaction.amount.to_s %>">
                      <%= number_to_currency(transaction.amount) %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p><%= t("reports.no_month_transactions", default: "No hay transacciones para este ciclo.") %></p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-header bg-white">
        <h5 class="mb-0"><%= t("reports.summary", default: "Resumen") %></h5>
      </div>
      <div class="card-body">
        <p><strong><%= t("types.income") %>:</strong> <%= number_to_currency(@income_total) %></p>
        <p><strong><%= t("types.expense_plural") %>:</strong> <%= number_to_currency(@expense_total) %></p>
        <p>
          <strong><%= t("reports.net", default: "Neto") %>:</strong>
          <span class="fw-bold <%= @net_total.negative? ? 'text-danger' : 'text-success' %>">
            <%= number_to_currency(@net_total) %>
          </span>
        </p>
      </div>
    </div>
  </div>
</div>

<%= link_to t("reports.back", default: "Volver al balance del ciclo"), monthly_reports_path(filter_params_for), class: "btn btn-secondary mt-3" %>
