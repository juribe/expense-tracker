<div class="container mt-4">
  <h1>Monthly Balance: <%= @month %></h1>

  <div class="row mt-4">
    <div class="col-md-8">
      <div class="card shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">Transactions</h5>
        </div>
        <div class="card-body">
          <% if @transactions.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Type</th>
                    <th scope="col">Description</th>
                    <th scope="col">Category</th>
                    <th scope="col" class="text-end">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  <% @transactions.each do |transaction| %>
                    <tr>
                      <td><%= transaction.date.strftime("%b %d, %Y") %></td>
                      <td>
                        <span class="badge <%= transaction.is_a?(Income) ? 'bg-success' : 'bg-danger' %>">
                          <%= transaction.is_a?(Income) ? "Income" : "Expense" %>
                        </span>
                      </td>
                      <td><%= transaction.description.presence || "—" %></td>
                      <td><%= transaction.category&.name || "Uncategorized" %></td>
                      <td class="text-end fw-bold <%= transaction.amount.negative? ? 'text-danger' : 'text-success' %>">
                        <%= number_to_currency(transaction.amount) %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p>No transactions for this month.</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">Summary</h5>
        </div>
        <div class="card-body">
          <p><strong>Income:</strong> <%= number_to_currency(@income_total) %></p>
          <p><strong>Expenses:</strong> <%= number_to_currency(@expense_total) %></p>
          <p>
            <strong>Net:</strong>
            <span class="fw-bold <%= @net_total.negative? ? 'text-danger' : 'text-success' %>">
              <%= number_to_currency(@net_total) %>
            </span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <%= link_to "Back to Monthly Reports", monthly_reports_path, class: "btn btn-secondary mt-3" %>
</div>
