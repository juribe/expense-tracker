<div class="container mt-4">
  <h1><%= t("reports.monthly_balance", default: "Balance mensual") %></h1>

  <div class="row mt-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0"><%= t("reports.income_vs_expense", default: "Ingresos y gastos por mes") %></h5>
        </div>
        <div class="card-body">
          <% if @monthly_summary.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead class="table-light">
                  <tr>
                    <th scope="col"><%= t("reports.month") %></th>
                    <th scope="col" class="text-end"><%= t("types.income_plural") %></th>
                    <th scope="col" class="text-end"><%= t("types.expense_plural") %></th>
                    <th scope="col" class="text-end"><%= t("reports.net", default: "Neto") %></th>
                    <th scope="col" class="text-end"><%= t("reports.transactions", default: "Transacciones") %></th>
                    <th scope="col"><%= t("common.actions") %></th>
                  </tr>
                </thead>
                <tbody>
                  <% @monthly_summary.each do |report| %>
                    <tr>
                      <td><%= report[:month] %></td>
                      <td class="text-end text-success"><%= number_to_currency(report[:income_total]) %></td>
                      <td class="text-end text-danger"><%= number_to_currency(report[:expense_total]) %></td>
                      <td class="text-end fw-bold <%= report[:net_total].negative? ? 'text-danger' : 'text-success' %>">
                        <%= number_to_currency(report[:net_total]) %>
                      </td>
                      <td class="text-end"><%= report[:count] %></td>
                      <td>
                        <%= link_to t("reports.view_details", default: "Ver detalles"), monthly_report_path(report[:month]), class: "btn btn-sm btn-primary" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p><%= t("reports.no_transactions", default: "Aún no hay transacciones registradas.") %></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
