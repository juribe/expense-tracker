<div class="container mt-4">
  <h1>Monthly Balance</h1>

  <div class="row mt-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">Income vs Expense by Month</h5>
        </div>
        <div class="card-body">
          <% if @monthly_summary.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead class="table-light">
                  <tr>
                    <th scope="col">Month</th>
                    <th scope="col" class="text-end">Income</th>
                    <th scope="col" class="text-end">Expenses</th>
                    <th scope="col" class="text-end">Net</th>
                    <th scope="col" class="text-end">Transactions</th>
                    <th scope="col">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @monthly_summary.each do |report| %>
                    <tr>
                      <td><%= report[:month] %></td>
                      <td class="text-end text-success"><%= number_to_currency(report[:income_total]) %></td>
                      <td class="text-end text-danger"><%= number_to_currency(report[:expense_total]) %></td>
                      <td class="text-end fw-bold <%= report[:net_total].negative? ? 'text-danger' : 'text-success' %>">
                        <%= number_to_currency(report[:net_total]) %>
                      </td>
                      <td class="text-end"><%= report[:count] %></td>
                      <td>
                        <%= link_to "View Details", monthly_report_path(report[:month]), class: "btn btn-sm btn-primary" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p>No transactions recorded yet.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
