<div class="container mt-4" id="statement-import-root" data-statement-import-root="true">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title"><i class="ti ti-file-upload me-2 text-secondary"></i><%= t("statement_imports.new_title") %></h5>
        </div>
        <div class="card-body">
          <p class="text-muted mb-3"><%= t("statement_imports.new_hint") %></p>

          <div id="statementImportError" class="alert alert-danger d-none" role="alert" data-testid="statement-import-error"></div>

          <div id="statementImportProgress" class="d-none mb-3" data-testid="statement-import-progress">
            <ul class="list-unstyled mb-2" data-statement-import-steps>
              <li class="d-flex align-items-center gap-2" data-step="upload">
                <span class="spinner-border spinner-border-sm text-primary d-none" data-step-spinner role="status" aria-hidden="true"></span>
                <i class="ti ti-circle-check text-success d-none" data-step-done aria-hidden="true"></i>
                <i class="ti ti-file-arrow-up text-muted" data-step-idle aria-hidden="true"></i>
                <span data-step-label><%= t("statement_imports.step_upload") %></span>
                <span class="text-muted small ms-auto" data-step-percent></span>
              </li>
              <li class="d-flex align-items-center gap-2" data-step="analyze">
                <span class="spinner-border spinner-border-sm text-primary d-none" data-step-spinner role="status" aria-hidden="true"></span>
                <i class="ti ti-circle-check text-success d-none" data-step-done aria-hidden="true"></i>
                <i class="ti ti-cpu text-muted" data-step-idle aria-hidden="true"></i>
                <span data-step-label><%= t("statement_imports.step_analyzing") %></span>
              </li>
            </ul>
            <div class="progress" style="height: 6px;">
              <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar"
                   style="width: 0%" aria-valuemin="0" aria-valuemax="100" data-step-bar></div>
            </div>
          </div>

          <%= form_with url: money_source_statement_imports_path(@money_source),
                        local: true, multipart: true,
                        html: { id: "statementImportForm",
                                data: { upload_form: true,
                                        upload_failed: t("statement_imports.upload_failed") } } do |f| %>
            <% if flash[:alert].present? %>
              <div class="alert alert-danger"><%= flash[:alert] %></div>
            <% end %>

            <div class="mb-3">
              <%= f.label :file, t("statement_imports.file_label"), for: "statement_file", class: "form-label" %>
              <%= file_field_tag :file, accept: ".pdf,.csv,.xlsx,.xls",
                    class: "form-control", required: true, id: "statement_file" %>
              <div class="form-text"><%= t("statement_imports.file_hint") %></div>
            </div>

            <div class="mb-3">
              <%= f.label :password, t("statement_imports.password_label"), for: "statement_password", class: "form-label" %>
              <%= password_field_tag :password, nil, class: "form-control",
                    autocomplete: "off", id: "statement_password" %>
              <div class="form-text"><%= t("statement_imports.password_hint") %></div>
            </div>

            <div class="d-flex gap-2 justify-content-end">
              <%= link_to money_source_path(@money_source), class: "btn btn-outline-secondary" do %>
                <%= t("statement_imports.back") %>
              <% end %>
              <%= f.submit t("statement_imports.submit"), class: "btn btn-primary", id: "statementImportSubmit" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
