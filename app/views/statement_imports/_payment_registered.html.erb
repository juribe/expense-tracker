<div class="card border-success h-100" data-testid="payment-registered-card">
  <div class="card-body">
    <h5 class="card-title">
      <i class="ti ti-circle-check me-2 text-success"></i><%= t("statement_imports.payment_registered_title") %>
    </h5>
    <p class="text-muted small mb-0">
      <%= t("statement_imports.payment_registered_body",
            amount: number_to_currency(@registered_payment[:amount]),
            date: l(@registered_payment[:date]),
            target: @money_source.name) %>
    </p>
  </div>
</div>
