<!DOCTYPE html>
<html lang="es">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>yogasto</title>
  </head>
  <body style="margin:0;padding:0;background-color:#F5F6FC;font-family:Arial,Helvetica,sans-serif;color:#252746;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#F5F6FC" style="background-color:#F5F6FC;">
      <tr>
        <td align="center" style="padding:48px 20px;background-color:#F5F6FC;">
          <table role="presentation" width="580" cellpadding="0" cellspacing="0" border="0" align="center" bgcolor="#ffffff" style="width:580px;max-width:100%;background-color:#ffffff;border:1px solid #E8E8F4;border-radius:22px;">
            <tr>
              <td align="center" style="padding:34px 28px 27px;background-color:#ffffff;">
                <img src="<%= "#{root_url}brand/yogasto-logo-claro.png" %>" alt="Yogasto" width="200" style="display:block;max-width:100%;height:auto;margin:0 auto;border:0;">
                <div align="center" style="margin-top:7px;color:#9295AE;font-size:12px;letter-spacing:0.025em;font-family:Arial,Helvetica,sans-serif;">
                  Tus finanzas, más claras.
                </div>
              </td>
            </tr>
            <tr>
              <td style="padding:0;background-color:#ffffff;">
                <div style="height:1px;margin:0 34px;background-color:#E8E8F4;"></div>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:34px 42px 36px;text-align:center;background-color:#ffffff;font-family:Arial,Helvetica,sans-serif;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="padding:0;background-color:#ffffff;">
                <div style="height:1px;margin:0 34px;background-color:#E8E8F4;"></div>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:23px 25px 28px;text-align:center;background-color:#FCFCFF;font-family:Arial,Helvetica,sans-serif;">
                <p align="center" style="margin:0 0 7px;text-align:center;color:#777B98;font-size:12px;font-family:Arial,Helvetica,sans-serif;">
                  © <%= Date.current.year %> yogasto · Tus finanzas, más claras.
                </p>
                <p align="center" style="margin:0;text-align:center;color:#A0A2B7;font-size:11px;line-height:1.7;font-family:Arial,Helvetica,sans-serif;">
                  Este es un correo automático; por favor, no respondas a este mensaje.
                </p>
                <p align="center" style="margin:9px 0 0;text-align:center;font-size:11px;font-family:Arial,Helvetica,sans-serif;">
                  <a href="https://yogasto.co" style="color:#6654D6;text-decoration:none;">yogasto.co</a>
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>