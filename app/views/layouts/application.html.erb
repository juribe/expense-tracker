<!DOCTYPE html>
<html lang="es" data-bs-theme="light" data-color-theme="Blue_Theme" data-layout="vertical">
  <head>
    <title><%= content_for(:title) || t("layout.app_title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <script>
      /* Back-paint the stored theme before CSS to avoid a light flash. */
      try {
        var t = localStorage.getItem("etTheme");
        if (t) document.documentElement.setAttribute("data-bs-theme", t);
      } catch (e) { /* noop */ }
    </script>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "themes/spike", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :theme, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :expenses, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :dashboard, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :playground, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :financial_chat, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :reports, "data-turbo-track": "reload" %>
  </head>

  <body>
    <% if user_signed_in? %>
      <div id="main-wrapper">
        <%= render "shared/sidebar" %>

        <div class="page-wrapper">
          <%= render "shared/topbar" %>

          <div class="body-wrapper">
            <div class="app-container content-wrapper py-4">
              <% if notice %>
                <div class="alert alert-success alert-dismissible fade show" role="alert" data-testid="flash-notice">
                  <%= notice %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              <% end %>
              <% if alert %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert" data-testid="flash-alert">
                  <%= alert %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              <% end %>

              <%= yield %>
            </div>

            <footer class="text-center py-3 mt-4">
              <small class="text-secondary"><%= t("layout.footer", year: Date.today.year) %></small>
            </footer>
          </div>
        </div>
      </div>

      <div class="dark-transparent sidebartoggler"></div>
    <% else %>
      <div class="auth-wrapper">
        <div class="auth-content">
          <% if notice %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
              <%= notice %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>
          <% if alert %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <%= alert %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>

          <%= yield %>
        </div>
      </div>
    <% end %>

    <%= javascript_include_tag "Chart.bundle", defer: true %>
    <%= javascript_include_tag "chartkick", defer: true %>
    <%= javascript_include_tag "reports", defer: true %>
    <%= javascript_include_tag "application", defer: true %>
    <%= javascript_include_tag "payments", defer: true %>
    <%= javascript_include_tag "extras", defer: true %>
    <%= javascript_include_tag "shell", defer: true %>
    <%= javascript_include_tag "actioncable", defer: true %>
    <%= javascript_include_tag "financial_chat", defer: true %>
    <%= javascript_include_tag "reconciliation", defer: true %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
