<%# Period control: calendar icon + preset select, styled as one rounded box.
    Custom range fields appear when the custom preset is active.
    locals: path %>
<%= form_with url: path, method: :get, local: true do %>
  <% %w[category_id money_source_id kind].each do |key| %>
    <%= hidden_field_tag key, params[key] if params[key].present? %>
  <% end %>

  <div class="input-group">
    <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
    <%= select_tag :period,
          options_for_select(period_presets, params[:period] || "this_month"),
          class: "form-select", id: "report-period-select",
          onchange: "this.form.submit()" %>
    <%= submit_tag t("common.apply", default: "Aplicar"), class: "btn btn-light" %>
  </div>

  <% if params[:period] == "custom" %>
    <div class="d-flex gap-2 custom-range">
      <%= date_field_tag :start_date, params[:start_date], class: "form-control form-control-sm" %>
      <%= date_field_tag :end_date, params[:end_date], class: "form-control form-control-sm" %>
    </div>
  <% end %>
<% end %>
