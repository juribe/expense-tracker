<%# Shared page header: big title + subtitle on the left, period control on
    the right, optional filters bar below.
    locals: path (current page path), title, subtitle (optional),
    icon (optional, defaults to ti-chart-line),
    filters (optional, defaults to true),
    category_filter (optional, defaults to true),
    money_source_filter (optional, defaults to true) %>
<div class="reports-header">
  <div class="d-flex align-items-start">
    <i class="ti <%= local_assigns.fetch(:icon, "ti-chart-line") %> reports-header-icon me-3 d-none d-sm-inline"></i>
    <div>
      <h1 class="reports-title"><%= local_assigns[:title].presence || t("reports.title") %></h1>
      <% if local_assigns[:subtitle].present? %>
        <p class="reports-subtitle"><%= subtitle %></p>
      <% end %>
    </div>
  </div>

  <div class="period-control">
    <%= render "reports/period_picker", path: path %>
  </div>
</div>

<% if local_assigns.fetch(:filters, true) %>
  <%= render "reports/filters", path: path,
             category_filter: local_assigns.fetch(:category_filter, true),
             money_source_filter: local_assigns.fetch(:money_source_filter, true) %>
<% end %>
