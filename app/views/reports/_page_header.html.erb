<%# Shared page header: title, period picker and filters form.
    locals: title, path (current page path), form_id %>
<div class="d-flex justify-content-between align-items-center mb-3 d-print-none">
  <h1><i class="bi bi-bar-chart me-2"></i><%= t("reports.title") %></h1>
</div>

<%= render "reports/section_nav" %>

<div class="row g-3 align-items-end mb-4">
  <div class="col-12 col-lg-5">
    <%= render "reports/period_picker", path: path %>
  </div>
  <div class="col-12 col-lg-7">
    <%= render "reports/filters", path: path %>
  </div>
</div>
