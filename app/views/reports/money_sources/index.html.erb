<%= render "reports/page_header",
      title: t("reports.money_sources.title"),
      subtitle: t("reports.money_sources.subtitle"),
      path: reports_money_sources_path,
      filters: false %>

<div class="money-sources-report" data-testid="money-sources-report" data-money-sources-report>
  <%= render "reports/money_sources/filters", path: reports_money_sources_path %>

  <% if @money_sources_error %>
    <section class="card report-panel money-sources-state" data-testid="money-source-error">
      <div class="report-panel-body">
        <%= render "shared/empty_state",
              icon: "alert-triangle",
              title: t("reports.money_sources.errors.title"),
              text: t("reports.money_sources.errors.body"),
              cta: link_to(t("reports.money_sources.errors.retry"), request.fullpath,
                           class: "btn btn-sm btn-primary") %>
      </div>
    </section>
  <% elsif @money_sources[:total].zero? %>
    <% filtered = params[:source_kind].present? %>
    <section class="card report-panel money-sources-state"
             data-testid="<%= filtered ? "money-source-empty-filtered" : "money-source-empty" %>">
      <div class="report-panel-body">
        <%= render "shared/empty_state",
              icon: filtered ? "filter-off" : "wallet-off",
              title: filtered ? t("reports.money_sources.empty_filtered") : t("reports.money_sources.empty"),
              text: filtered ? nil : t("reports.money_sources.empty_hint"),
              cta: filtered ? link_to(t("reports.money_sources.clear_filters"),
                                      reports_money_sources_path(report_clear_params),
                                      class: "btn btn-sm btn-primary") : nil %>
      </div>
    </section>
  <% else %>
    <%= render "reports/money_sources/summary", report: @money_sources %>
    <%= render "reports/money_sources/distribution", report: @money_sources %>
    <%= render "reports/money_sources/detail", report: @money_sources %>
  <% end %>
</div>

<%= javascript_include_tag "reports_money_sources", defer: true %>
