<%# Section navigation chips for the Reports pages. locals: none (uses helpers) %>
<div class="mb-3 d-flex flex-wrap gap-2">
  <% sections = [
       [ t("reports.nav.overview"), reports_overview_path ],
       [ t("reports.nav.by_category"), reports_by_category_path ],
       [ t("reports.nav.trends"), reports_trends_path ],
       [ t("reports.nav.budgets"), reports_budgets_path ],
       [ t("reports.nav.credit_cards"), reports_credit_cards_path ],
       [ t("reports.nav.loans"), reports_loans_path ],
       [ t("reports.nav.recurring"), reports_recurring_path ],
       [ t("reports.nav.money_sources"), reports_money_sources_path ],
       [ t("reports.nav.transfers"), reports_transfers_path ],
       [ t("reports.nav.insights"), reports_insights_path ]
     ] %>
  <% sections.each do |label, path| %>
    <%= link_to label, path, class: "btn btn-sm #{current_page?(path) ? 'btn-primary' : 'btn-outline-secondary'}" %>
  <% end %>
</div>
