<%# Compact KPI card shared by report pages. Locals: label, value, tone, icon,
    icon_tone, note (optional html), testid, variant (income | expense | debt | net) %>
<div class="col-6 col-lg-3">
  <div class="card report-kpi report-kpi-<%= variant %> h-100">
    <div class="card-body">
      <%= render "shared/stat",
            label: label,
            value: value,
            tone: tone,
            icon: icon,
            icon_tone: icon_tone,
            delta: note,
            testid: testid %>
    </div>
  </div>
</div>
