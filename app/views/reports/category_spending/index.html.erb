<%= render "reports/page_header",
      title: t("reports.categories.title"),
      subtitle: t("reports.categories.subtitle"),
      path: reports_by_category_path %>

<div class="row g-3 mb-3 report-metrics" data-testid="category-summary">
  <%= render "reports/metric",
        label: t("reports.categories.summary.total"),
        value: money_amount(@category_spending[:summary][:total]),
        tone: :negative,
        icon: "receipt-2",
        icon_tone: "red",
        note: t("reports.categories.summary.total_hint"),
        testid: "category-total",
        variant: "expense" %>

  <%= render "reports/metric",
        label: t("reports.categories.summary.categories"),
        value: number_with_delimiter(@category_spending[:summary][:category_count]),
        tone: :balance,
        icon: "tags",
        icon_tone: "blue",
        note: t("reports.categories.summary.categories_hint"),
        testid: "category-count",
        variant: "neutral" %>

  <%= render "reports/metric",
        label: t("reports.categories.summary.transactions"),
        value: number_with_delimiter(@category_spending[:summary][:transaction_count]),
        tone: nil,
        icon: "list-check",
        icon_tone: "amber",
        note: t("reports.categories.summary.transactions_hint"),
        testid: "category-transactions",
        variant: "neutral" %>

  <%= render "reports/metric",
        label: t("reports.categories.summary.average"),
        value: money_amount(@category_spending[:summary][:average]),
        tone: :negative,
        icon: "calculator",
        icon_tone: "blue",
        note: t("reports.categories.summary.average_hint"),
        testid: "category-average",
        variant: "neutral" %>
</div>

<section class="card report-panel mb-3" data-testid="category-distribution">
  <div class="report-panel-head">
    <div>
      <h2 class="report-panel-title"><%= t("reports.categories.distribution.title") %></h2>
      <p class="report-panel-subtitle"><%= t("reports.categories.distribution.subtitle") %></p>
    </div>
  </div>

  <div class="report-panel-body">
    <% if @category_spending[:categories].any? %>
      <div class="row g-4">
        <div class="col-12 col-xl-5">
          <div class="category-distribution-chart">
            <div class="category-distribution-head">
              <h3><%= t("reports.categories.distribution.top_title") %></h3>
              <p><%= t("reports.categories.distribution.top_hint") %></p>
            </div>

            <div class="category-distribution-list">
              <% @category_spending[:distribution][:rows].each_with_index do |row, index| %>
                <% if row[:others] %>
                  <div class="category-distribution-row is-others">
                    <span class="category-distribution-name"><%= row[:name] %></span>
                    <span class="category-distribution-track">
                      <span class="category-distribution-fill is-others <%= report_progress_class(row[:share_pct]) %>"></span>
                    </span>
                    <span class="category-distribution-value"><%= money_amount(row[:total]) %></span>
                  </div>
                <% else %>
                  <% detail_path = category_spending_detail_path(row) %>
                  <%= link_to detail_path,
                        class: "category-distribution-row",
                        data: { transactions_modal_url: detail_path },
                        title: "#{row[:name]} — #{t('reports.categories.drill_down')}" do %>
                    <span class="category-distribution-name"><%= row[:name] %></span>
                    <span class="category-distribution-track">
                      <span class="category-distribution-fill <%= report_category_swatch_class(index) %> <%= report_progress_class(row[:share_pct]) %>"></span>
                    </span>
                    <span class="category-distribution-value"><%= money_amount(row[:total]) %></span>
                  <% end %>
                <% end %>
              <% end %>
            </div>

            <div class="category-distribution-foot">
              <span><%= t("reports.categories.distribution.top_foot", count: @category_spending[:distribution][:top_count]) %></span>
              <% if @category_spending[:distribution][:others_total].positive? %>
                <span><%= t("reports.categories.distribution.others_total",
                             amount: money_amount(@category_spending[:distribution][:others_total])) %></span>
              <% else %>
                <span><%= t("reports.categories.distribution.no_others") %></span>
              <% end %>
            </div>
          </div>
        </div>

        <div class="col-12 col-xl-7">
          <div class="category-distribution-head">
            <h3><%= t("reports.categories.distribution.table_title") %></h3>
            <p><%= t("reports.categories.distribution.table_hint") %></p>
          </div>

          <div class="table-responsive category-table-wrap">
            <table class="table table-hover report-table category-table mb-0" data-testid="category-table">
              <thead>
                <tr>
                  <th scope="col"><%= t("common.category") %></th>
                  <th scope="col" class="text-end"><%= t("reports.categories.total") %></th>
                  <th scope="col" class="text-end"><%= t("reports.categories.share") %></th>
                  <th scope="col" class="text-end"><%= t("reports.categories.count") %></th>
                  <th scope="col" class="text-end"><%= t("reports.categories.variation") %></th>
                </tr>
              </thead>
              <tbody>
                <% @category_spending[:categories].each_with_index do |category, index| %>
                  <% detail_path = category_spending_detail_path(category) %>
                  <tr class="report-category-row-link"
                      data-transactions-modal-url="<%= detail_path %>"
                      data-testid="category-row">
                    <td>
                      <%= link_to detail_path,
                            class: "category-cell-link",
                            aria: { label: "#{t('reports.categories.drill_down')}: #{category[:name]}" } do %>
                        <span class="category-swatch <%= report_category_swatch_class(index) %>" aria-hidden="true">
                          <i class="ti <%= budget_category_icon(category[:icon]) %>"></i>
                        </span>
                        <span class="category-identity">
                          <span class="category-name"><%= category[:name] %></span>
                          <span class="progress et-progress-8 category-progress" role="progressbar"
                                aria-valuenow="<%= category[:share_pct].to_f.round %>"
                                aria-valuemin="0" aria-valuemax="100">
                            <span class="progress-bar <%= report_category_swatch_class(index) %> <%= report_progress_class(category[:share_pct]) %>"></span>
                          </span>
                        </span>
                      <% end %>
                    </td>
                    <td class="text-end" data-label="<%= t("reports.categories.total") %>">
                      <span class="amount-negative"><%= money_amount(category[:total]) %></span>
                    </td>
                    <td class="text-end category-share" data-label="<%= t("reports.categories.share") %>">
                      <%= number_to_percentage(category[:share_pct], precision: 1) if category[:share_pct] %>
                    </td>
                    <td class="text-end" data-label="<%= t("reports.categories.count") %>">
                      <%= number_with_delimiter(category[:count]) %>
                    </td>
                    <td class="text-end" data-label="<%= t("reports.categories.variation") %>">
                      <%= category_delta_label(category[:delta_pct]) %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot>
                <tr class="total-row">
                  <td><%= t("reports.categories.total") %></td>
                  <td class="text-end" data-label="<%= t("reports.categories.total") %>">
                    <%= money_amount(@category_spending[:summary][:total]) %>
                  </td>
                  <td class="text-end" data-label="<%= t("reports.categories.share") %>">
                    <%= number_to_percentage(100, precision: 0) %>
                  </td>
                  <td class="text-end" data-label="<%= t("reports.categories.count") %>">
                    <%= number_with_delimiter(@category_spending[:summary][:transaction_count]) %>
                  </td>
                  <td class="text-end text-muted" data-label="<%= t("reports.categories.variation") %>">—</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    <% else %>
      <div data-testid="category-distribution-empty">
        <%= render "shared/empty_state", icon: "chart-pie", title: t("reports.categories.empty") %>
      </div>
    <% end %>
  </div>
</section>

<div class="category-report-note">
  <i class="ti ti-info-circle" aria-hidden="true"></i>
  <div>
    <strong><%= t("reports.categories.distribution.note_title") %></strong>
    <p><%= t("reports.categories.distribution.note_body") %></p>
  </div>
</div>

<%= render "reports/transactions/modal_container" %>
