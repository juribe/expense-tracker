<%# Filters card: title block + two-row chip grid + actions, composable with
    the period. locals: path, category_filter (optional, defaults to true),
    money_source_filter (optional, defaults to true) %>
<% show_category = local_assigns.fetch(:category_filter, true) %>
<% show_money_source = local_assigns.fetch(:money_source_filter, true) %>
<%= form_with url: path, method: :get, local: true do |form| %>
  <%= hidden_field_tag :period, selected_period_preset %>
  <%= hidden_field_tag :uncategorized, params[:uncategorized] if params[:uncategorized].present? %>
  <% if params[:period] == "custom" %>
    <%= hidden_field_tag :start_date, params[:start_date] %>
    <%= hidden_field_tag :end_date, params[:end_date] %>
  <% end %>

  <div class="filters-card">
    <div class="filters-title-block">
      <div class="filters-heading">
        <i class="ti ti-filter"></i><%= t("reports.filters.title", default: "Filtros") %>
      </div>
      <p class="filters-description"><%= t("reports.filters.description", default: "Selecciona los criterios para actualizar el reporte.") %></p>
    </div>

    <div class="filters-grid<%= " filters-grid-single" if [show_category, show_money_source].count(true) == 1 %>">
      <% if show_category %>
        <div class="filter-chip">
          <i class="ti ti-tag"></i>
          <div class="flex-grow-1 min-w-0">
            <div class="chip-label"><%= t("common.category") %></div>
            <%= category_picker form, :category_id, user_expense_categories,
                                value: params[:category_id],
                                include_blank: t("reports.filters.all_f", default: "Todas"),
                                label: nil,
                                id: "category_id",
                                testid: "reports-category-picker" %>
          </div>
        </div>
      <% end %>

      <% if show_money_source %>
        <div class="filter-chip">
          <i class="ti ti-wallet"></i>
          <div class="flex-grow-1 min-w-0">
            <div class="chip-label"><%= t("money_sources.title", default: "Fuentes") %></div>
            <%= select_tag :money_source_id,
                  options_for_select(money_source_options, params[:money_source_id]),
                  include_blank: t("reports.filters.all_f", default: "Todas"),
                  class: "form-select" %>
          </div>
          <i class="ti ti-chevron-down text-muted et-fs-07"></i>
        </div>
      <% end %>
    </div>

    <div class="filters-actions">
      <%= link_to path, class: "btn btn-outline-secondary" do %>
        <i class="ti ti-eraser"></i> <%= t("common.clear", default: "Limpiar") %>
      <% end %>
      <%= button_tag type: "submit", class: "btn btn-primary" do %>
        <i class="ti ti-filter"></i> <%= t("common.filter", default: "Filtrar") %>
      <% end %>
    </div>
  </div>
<% end %>
