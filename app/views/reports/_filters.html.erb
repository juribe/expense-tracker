<%# Filters card: title block + two-row chip grid + actions, composable with
    the period. locals: path %>
<%= form_with url: path, method: :get, local: true do %>
  <%= hidden_field_tag :period, params[:period] || "this_month" %>
  <% if params[:period] == "custom" %>
    <%= hidden_field_tag :start_date, params[:start_date] %>
    <%= hidden_field_tag :end_date, params[:end_date] %>
  <% end %>

  <div class="filters-card">
    <div class="filters-title-block">
      <div class="filters-heading">
        <i class="bi bi-funnel"></i><%= t("reports.filters.title", default: "Filtros") %>
      </div>
      <p class="filters-description"><%= t("reports.filters.description", default: "Selecciona los criterios para actualizar el reporte.") %></p>
    </div>

    <div class="filters-grid">
      <div class="filter-chip">
        <i class="bi bi-tag"></i>
        <div class="flex-grow-1 min-w-0">
          <div class="chip-label"><%= t("common.category") %></div>
          <%= select_tag :category_id,
                options_for_select(category_options, params[:category_id]),
                include_blank: t("reports.filters.all_f", default: "Todas"),
                class: "form-select" %>
        </div>
        <i class="bi bi-chevron-down text-muted" style="font-size: 0.7rem;"></i>
      </div>

      <div class="filter-chip">
        <i class="bi bi-wallet2"></i>
        <div class="flex-grow-1 min-w-0">
          <div class="chip-label"><%= t("money_sources.title", default: "Fuentes") %></div>
          <%= select_tag :money_source_id,
                options_for_select(money_source_options, params[:money_source_id]),
                include_blank: t("reports.filters.all_f", default: "Todas"),
                class: "form-select" %>
        </div>
        <i class="bi bi-chevron-down text-muted" style="font-size: 0.7rem;"></i>
      </div>

      <div class="filter-chip">
        <i class="bi bi-grid"></i>
        <div class="flex-grow-1 min-w-0">
          <div class="chip-label"><%= t("reports.filters.kind", default: "Resumen") %></div>
          <%= select_tag :kind,
                options_for_select(kind_options, params[:kind]),
                include_blank: t("reports.filters.all_f", default: "Todas"),
                class: "form-select" %>
        </div>
        <i class="bi bi-chevron-down text-muted" style="font-size: 0.7rem;"></i>
      </div>
    </div>

    <div class="filters-actions">
      <%= link_to path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-eraser"></i> <%= t("common.clear", default: "Limpiar") %>
      <% end %>
      <%= button_tag type: "submit", class: "btn btn-primary" do %>
        <i class="bi bi-funnel"></i> <%= t("common.filter", default: "Filtrar") %>
      <% end %>
    </div>
  </div>
<% end %>
