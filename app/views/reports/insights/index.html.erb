<%= render "reports/page_header", title: t("reports.insights.title"), subtitle: t("reports.insights.subtitle"), path: reports_insights_path %>

<section class="card report-panel" data-testid="insights-panel">
  <div class="report-panel-head">
    <div>
      <h2 class="report-panel-title"><%= t("reports.insights.title") %></h2>
      <p class="report-panel-subtitle"><%= t("reports.insights.subtitle") %></p>
    </div>
    <span class="report-analysis-icon" aria-hidden="true"><i class="ti ti-wand"></i></span>
  </div>
  <div class="report-panel-body">
    <% if @insights.any? %>
      <div class="report-alert-list">
        <% @insights.each do |insight| %>
          <div class="report-alert is-<%= analysis_alert_tone(insight[:kind]) %>" data-testid="insight">
            <i class="ti ti-<%= analysis_alert_icon(insight[:kind]) %>" aria-hidden="true"></i>
            <span><%= insight[:message] %></span>
          </div>
        <% end %>
      </div>
    <% elsif @insights_insufficient_data %>
      <div class="report-analysis-empty" data-testid="insights-insufficient-data">
        <span class="report-analysis-empty-icon" aria-hidden="true"><i class="ti ti-chart-line"></i></span>
        <h3><%= t("reports.insights.insufficient_data_title") %></h3>
        <p><%= t("reports.insights.insufficient_data_help") %></p>
      </div>
    <% else %>
      <div class="report-analysis-empty" data-testid="insights-empty">
        <span class="report-analysis-empty-icon" aria-hidden="true"><i class="ti ti-circle-check"></i></span>
        <h3><%= t("reports.insights.empty") %></h3>
      </div>
    <% end %>
  </div>
</section>
