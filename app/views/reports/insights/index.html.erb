<%= render "reports/page_header",
      title: t("reports.perspectives.title"),
      subtitle: t("reports.perspectives.subtitle"),
      path: reports_insights_path,
      icon: "chart-dots" %>

<% perspectives = @perspectives %>

<% if perspectives[:available] %>
  <%= render "reports/insights/summary", perspectives: perspectives %>

  <div class="row g-3 perspectives-columns">
    <div class="col-12 col-xl-8">
      <%= render "reports/insights/findings", perspectives: perspectives %>
    </div>
    <div class="col-12 col-xl-4">
      <%= render "reports/insights/recommendations", perspectives: perspectives %>
    </div>
  </div>

  <%= render "reports/insights/evolution", perspectives: perspectives %>
<% else %>
  <section class="card report-panel" data-testid="perspectives-empty">
    <div class="report-panel-body">
      <div class="report-analysis-empty">
        <span class="report-analysis-empty-icon" aria-hidden="true"><i class="ti ti-chart-dots"></i></span>
        <h2 class="report-panel-title"><%= t("reports.perspectives.empty_title") %></h2>
        <p><%= t("reports.perspectives.empty_body") %></p>
      </div>
    </div>
  </section>
<% end %>

<%= render "reports/transactions/modal_container" %>
