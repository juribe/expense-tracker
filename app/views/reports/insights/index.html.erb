<%= render "reports/page_header", title: t("reports.insights.title"), subtitle: t("reports.insights.subtitle"), path: reports_insights_path %>

<div class="card">
  <div class="card-header bg-white">
    <h5 class="mb-0"><%= t("reports.insights.title") %></h5>
  </div>
  <div class="card-body">
    <% if @insights.any? %>
      <% @insights.each do |insight| %>
        <div class="d-flex align-items-start mb-3" data-testid="insight">
          <i class="ti ti-bolt text-warning me-2 mt-1"></i>
          <div><%= insight[:message] %></div>
        </div>
      <% end %>
    <% elsif @insights_insufficient_data %>
      <div data-testid="insights-insufficient-data">
        <p class="fw-semibold mb-1"><%= t("reports.insights.insufficient_data_title") %></p>
        <p class="text-muted mb-0"><%= t("reports.insights.insufficient_data_help") %></p>
      </div>
    <% else %>
      <p class="text-muted mb-0"><%= t("reports.insights.empty") %></p>
    <% end %>
  </div>
</div>
