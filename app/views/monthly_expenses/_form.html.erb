<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0"><%= @monthly_expense.new_record? ? "New" : "Edit" %> Monthly Expense</h4>
        </div>
        <div class="card-body">
          <%= form_with model: @monthly_expense, local: true do |f| %>
            <% if @monthly_expense.errors.any? %>
              <div class="alert alert-danger">
                <h6><%= pluralize(@monthly_expense.errors.count, "error") %> prohibited this monthly expense from being saved:</h6>
                <ul>
                  <% @monthly_expense.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= f.label :category_id, "Category", class: "form-label" %>
              <%= f.collection_select :category_id, @categories, :id, :name,
                                      { prompt: "Select a category" }, class: "form-select" %>
            </div>

            <div class="mb-3">
              <%= f.label :description, class: "form-label" %>
              <%= f.text_field :description, class: "form-control", placeholder: "e.g. Car Loan" %>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :amount, "Monthly Amount", class: "form-label" %>
                <div class="input-group">
                  <span class="input-group-text">$</span>
                  <%= f.number_field :amount, step: 0.01, min: 0, class: "form-control", placeholder: "0.00" %>
                </div>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :payment_day, "Payment Day (1-31)", class: "form-label" %>
                <%= f.number_field :payment_day, min: 1, max: 31, class: "form-control",
                                   placeholder: "Day of the month this expense is due" %>
                <div class="form-text">Months with fewer days use the last day of the month.</div>
              </div>
            </div>

            <div class="form-check form-switch mb-3">
              <%= f.check_box :active, class: "form-check-input", role: "switch", id: "monthly_expense_active" %>
              <%= f.label :active, "Active", class: "form-check-label", for: "monthly_expense_active" %>
            </div>

            <div class="d-flex gap-2">
              <%= f.submit "Save", class: "btn btn-primary" %>
              <%= link_to "Cancel", monthly_expenses_path, class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
