<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="mb-0"><i class="bi bi-arrow-repeat me-2"></i>Monthly Recurring Expenses</h1>
    <%= link_to new_monthly_expense_path, class: "btn btn-primary", data: { testid: "add-monthly-expense" } do %>
      <i class="bi bi-plus-lg me-1"></i> Add Expense
    <% end %>
  </div>

  <% if @monthly_expenses.empty? %>
    <div class="alert alert-info text-center" data-testid="empty">
      No recurring expenses yet. Click &ldquo;Add Expense&rdquo; to get started.
    </div>
  <% else %>
    <div class="card shadow-sm" data-testid="table">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="monthlyExpenseTable">
          <caption class="visually-hidden">Your monthly recurring expenses</caption>
          <thead class="table-light">
            <tr>
              <th scope="col">Category</th>
              <th scope="col">Description</th>
              <th scope="col" class="text-end">Monthly Amount</th>
              <th scope="col" class="text-center">Payment Day</th>
              <th scope="col" class="text-center">Last Payment</th>
              <th scope="col" class="text-center">Status</th>
              <th scope="col" class="text-center"><span class="visually-hidden">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @monthly_expenses.each do |monthly_expense| %>
              <% status = monthly_expense.status_for(@today) %>
              <% last_payment = monthly_expense.last_payment %>
              <tr data-testid="row" data-id="<%= monthly_expense.id %>">
                <td><%= category_badge(monthly_expense.category) %></td>
                <td class="desc-cell" title="<%= monthly_expense.description %>">
                  <% if monthly_expense.description.present? %>
                    <%= monthly_expense.description %>
                  <% else %>
                    <span class="text-muted">No description</span>
                  <% end %>
                </td>
                <td class="text-end fw-medium amount"><%= number_to_currency(monthly_expense.amount) %></td>
                <td class="text-center"><%= monthly_expense.payment_day.presence || "&mdash;".html_safe %></td>
                <td class="text-center" data-testid="last-payment">
                  <% if last_payment %>
                    <%= last_payment.payment_date.strftime("%b %d, %Y") %>
                  <% else %>
                    <span class="text-muted">&mdash;</span>
                  <% end %>
                </td>
                <td class="text-center" data-testid="status">
                  <% if status == :paid %>
                    <span class="badge bg-success" role="status"
                          title="Paid on <%= last_payment.payment_date.strftime('%b %d, %Y') %>"
                          data-bs-toggle="tooltip">Paid</span>
                  <% else %>
                    <span class="badge bg-warning text-dark" role="status"
                          title="Due this month" data-bs-toggle="tooltip">Pending</span>
                  <% end %>
                </td>
                <td class="text-center text-nowrap" data-stop="1">
                  <%= link_to edit_monthly_expense_path(monthly_expense),
                              class: "btn btn-sm btn-outline-secondary me-1",
                              aria: { label: "Edit #{monthly_expense.description.presence || 'monthly expense'}" } do %>
                    <i class="bi bi-pencil"></i>
                  <% end %>
                  <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-delete
                          data-delete-url="<%= monthly_expense_path(monthly_expense) %>"
                          aria-label="Delete <%= monthly_expense.description.presence || 'monthly expense' %>">
                    <i class="bi bi-trash text-danger"></i>
                  </button>
                  <% if status == :pending && monthly_expense.active? %>
                    <button type="button" class="btn btn-sm btn-success" data-pay
                            data-pay-url="<%= pay_monthly_expense_path(monthly_expense) %>"
                            data-pay-category="<%= monthly_expense.category.name %>"
                            data-pay-description="<%= monthly_expense.description %>"
                            data-pay-amount="<%= monthly_expense.amount %>"
                            data-pay-date="<%= monthly_expense.suggested_payment_date(@today) %>"
                            aria-label="Pay <%= monthly_expense.description.presence || 'monthly expense' %>">
                      <i class="bi bi-credit-card me-1"></i>Pay
                    </button>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>

<!-- Delete confirmation modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title h5" id="deleteTitle">Delete monthly expense?</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">This will remove the recurring configuration. Payments already recorded are kept. This cannot be undone.</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmDelete">Delete</button>
      </div>
    </div>
  </div>
</div>

<%= form_with url: "#", method: :post, id: "deleteForm", class: "d-none", authenticity_token: false do %>
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <input type="hidden" name="_method" value="delete">
<% end %>

<!-- Pay confirmation modal -->
<div class="modal fade" id="payModal" tabindex="-1" aria-labelledby="payTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title h5" id="payTitle">Confirm Payment</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with url: "#", scope: :monthly_expense_payment, method: :post, id: "payForm", local: true, authenticity_token: false do |f| %>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <div class="modal-body">
          <p class="mb-3" id="paySubtitle"></p>
          <div class="mb-3">
            <%= f.label :payment_date, "Payment Date", class: "form-label" %>
            <%= f.date_field :payment_date, value: Date.current, required: true, class: "form-control", id: "payPaymentDate" %>
          </div>
          <div class="mb-3">
            <%= f.label :amount, "Amount", class: "form-label" %>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <%= f.number_field :amount, value: nil, step: 0.01, min: 0, placeholder: "0.00",
                                 class: "form-control", id: "payAmount" %>
            </div>
            <div class="form-text">Defaults to the configured monthly amount; adjust it for this payment only.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success"><i class="bi bi-credit-card me-1"></i>Confirm Payment</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
(function () {
  if (window.__monthlyExpensesInit) return;
  window.__monthlyExpensesInit = true;

  var deleteModal = null;
  var payModal = null;

  function openDelete(url) {
    document.getElementById("deleteForm").action = url;
    (deleteModal || (deleteModal = bootstrap.Modal.getOrCreateInstance("#deleteModal"))).show();
  }

  function openPay(button) {
    var form = document.getElementById("payForm");
    form.action = button.dataset.payUrl;
    document.getElementById("payTitle").textContent =
      "Confirm Payment \u2013 " + button.dataset.payCategory;
    document.getElementById("paySubtitle").textContent =
      button.dataset.payDescription || button.dataset.payCategory;
    document.getElementById("payPaymentDate").value = button.dataset.payDate;
    document.getElementById("payAmount").value = button.dataset.payAmount;
    (payModal || (payModal = bootstrap.Modal.getOrCreateInstance("#payModal"))).show();
  }

  document.addEventListener("click", function (e) {
    var delBtn = e.target.closest("[data-delete]");
    if (delBtn) {
      openDelete(delBtn.dataset.deleteUrl);
      return;
    }
    if (e.target.id === "confirmDelete") {
      var form = document.getElementById("deleteForm");
      bootstrap.Modal.getInstance("#deleteModal").hide();
      form.requestSubmit();
      return;
    }
    var payBtn = e.target.closest("[data-pay]");
    if (payBtn) openPay(payBtn);
  });
})();
</script>
