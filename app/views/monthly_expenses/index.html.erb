<% page_attrs = @open_form_modal ? { data: { auto_open_form_modal: (@recurring_template.persisted? ? "edit" : "create") } } : {} %>
<div data-testid="monthly-expenses-page"<%= tag.attributes(page_attrs) %>>
<%= tag.div class: "d-none", data: { monthly_expenses_ui_payload: {
  create_url: monthly_expenses_path,
  delete_title: t("monthly_expenses.delete_title", default: "¿Eliminar gasto recurrente?"),
  delete_body: t("monthly_incomes.delete_confirmation_body")
} } %>
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-3">
      <li class="breadcrumb-item"><%= link_to t("nav.dashboard"), dashboard_path %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= t("nav.recurring_expenses") %></li>
    </ol>
  </nav>

  <%= render "shared/page_header",
             title: t("nav.recurring_expenses"),
             subtitle: t("monthly_expenses.subtitle", default: "Organiza tus compromisos y controla los pagos de cada ciclo.") do %>
    <%= link_to new_import_path, class: "btn btn-outline-secondary", data: { turbo: false } do %>
      <i class="ti ti-upload me-1"></i><%= t("monthly_incomes.import_templates") %>
    <% end %>
    <button type="button" class="btn btn-primary" data-testid="add-recurring"
            data-rt-action="create">
      <i class="ti ti-plus me-1"></i><%= t("expenses.add_expense") %>
    </button>
<% end %>

  <% next_due = @recurring_summary[:next_due] %>
  <div class="row g-3 mb-4 recurring-summary" data-testid="recurring-summary">
    <div class="col-6 col-lg-3">
      <div class="card h-100 recurring-summary-card" data-testid="summary-monthly-commitment">
        <div class="card-body">
          <%= render "shared/stat",
                     label: t("monthly_expenses.summary.monthly_commitment", default: "Compromisos mensuales"),
                     value: number_to_currency(@recurring_summary[:monthly_commitment]),
                     icon: "repeat", icon_tone: "blue",
                     delta: t("monthly_expenses.summary.active_count", count: @recurring_summary[:active_count]) %>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card h-100 recurring-summary-card" data-testid="summary-pending">
        <div class="card-body">
          <%= render "shared/stat",
                     label: t("monthly_expenses.summary.pending", default: "Pagos pendientes del ciclo"),
                     value: t("monthly_expenses.summary.pending_count", count: @recurring_summary[:pending_count]),
                     icon: "clock", icon_tone: "amber",
                     delta: t("monthly_expenses.summary.pending_total", amount: number_to_currency(@recurring_summary[:pending_total])) %>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card h-100 recurring-summary-card" data-testid="summary-paid">
        <div class="card-body">
          <%= render "shared/stat",
                     label: t("monthly_expenses.summary.paid", default: "Pagados este ciclo"),
                     value: t("monthly_expenses.summary.paid_progress",
                              paid: @recurring_summary[:paid_count],
                              expected: @recurring_summary[:expected_count]),
                     icon: "circle-check", icon_tone: "green",
                     delta: t("monthly_expenses.summary.completion", percentage: @recurring_summary[:completion_percentage]) %>
          <div class="progress mt-2 recurring-summary-progress" role="progressbar"
               aria-label="<%= t("monthly_expenses.summary.completion", percentage: @recurring_summary[:completion_percentage]) %>"
               aria-valuenow="<%= @recurring_summary[:completion_percentage] %>"
               aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar bg-success et-w-<%= @recurring_summary[:completion_percentage] %>"></div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card h-100 recurring-summary-card" data-testid="summary-next-due">
        <div class="card-body">
          <%= render "shared/stat",
                     label: t("monthly_expenses.summary.next_due", default: "Próximo vencimiento"),
                     value: next_due ? l(next_due[:date], format: "%d %b") : t("monthly_expenses.summary.none", default: "—"),
                     icon: "calendar-event", icon_tone: "blue",
                     delta: if next_due
                              "#{next_due[:description]} · #{number_to_currency(next_due[:amount])}"
                            elsif @recurring_summary[:pending_count].positive?
                              t("monthly_expenses.summary.no_date", default: "Sin fecha definida")
                            else
                              t("monthly_expenses.summary.no_pending", default: "Sin pagos pendientes")
                            end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter -->
  <div class="card mb-4">
    <div class="card-body">
      <%= form_with url: monthly_expenses_path, method: :get, class: "row g-3 align-items-end", data: { testid: "filter-form" } do |f| %>
        <%= f.hidden_field :sort, value: @sort %>
        <%= f.hidden_field :dir, value: @direction %>
        <div class="col-12 col-sm-6 col-lg-2">
          <%= f.label :status, t("common.status"), class: "form-label" %>
          <%= f.select :status, options_for_select([[t("common.all"), "all"], [t("monthly_expenses.paid", default: "Pagados"), "completed"], [t("statuses.pending"), "pending"]], @status_filter), {}, class: "form-select" %>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
          <%= f.label :category_id, t("recurring.filter_category", default: "Categoría"), class: "form-label" %>
          <%= f.select :category_id,
                       options_from_collection_for_select(@filter_categories, :id, :name, params[:category_id]),
                       { include_blank: t("common.all") },
                       class: "form-select", "data-testid": "category-filter" %>
        </div>
        <div class="col-12 col-lg-4">
          <%= f.label :query, t("recurring.filter_description", default: "Descripción"), class: "form-label" %>
          <%= f.text_field :query, value: params[:query], class: "form-control",
                                   placeholder: t("recurring.filter_description_hint", default: "Buscar en la descripción…"),
                                   "data-testid": "description-filter", autocomplete: "off" %>
        </div>
        <div class="col-12 col-lg-3 d-flex flex-column flex-sm-row gap-2">
          <%= f.submit t("common.filter"), class: "btn btn-primary flex-grow-1" %>
          <%= link_to t("common.clear"), monthly_expenses_path, class: "btn btn-outline-secondary flex-grow-1" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div>
      <h2 class="h5 mb-1"><%= t("monthly_expenses.list_title", default: "Compromisos registrados") %></h2>
      <p class="results-meta mb-0" data-testid="results-meta">
        <%= t("monthly_expenses.results_count", count: @total_count, amount: number_to_currency(@filtered_total.abs), default: "%{count} gastos recurrentes · %{amount}") %>
      </p>
    </div>
  </div>

  <div class="card" data-testid="recurring-card">
    <% if @recurring_templates.empty? %>
      <div class="text-center py-5" data-testid="empty-state">
        <i class="ti ti-arrow-up-circle display-4 text-muted d-block mb-3"></i>
        <% if @status_filter != "all" %>
          <h5><%= t("monthly_incomes.empty.no_matching") %></h5>
          <p class="text-secondary"><%= t("monthly_incomes.empty.filter_hint") %></p>
        <% else %>
          <h5><%= t("monthly_expenses.empty.title", default: "Aún no hay plantillas de gastos mensuales") %></h5>
          <p class="text-secondary"><%= t("monthly_expenses.empty.body", default: "Configura un pago recurrente para registrarlo aquí.") %></p>
          <button type="button" class="btn btn-primary" data-rt-action="create">
            <%= t("monthly_incomes.empty.add_first") %>
          </button>
        <% end %>
      </div>
    <% else %>
      <div class="table-responsive recurring-table-wrap">
        <table class="table table-hover ledger-table align-middle mb-0 recurring-table" data-testid="recurring-table">
          <thead>
            <tr>
              <th scope="col"><%= recurring_sort_link("category", @sort, @direction) { t("common.category") } %></th>
              <th scope="col"><%= recurring_sort_link("description", @sort, @direction) { t("common.description") } %></th>
              <th scope="col" class="text-end"><%= recurring_sort_link("amount", @sort, @direction) { t("monthly_incomes.columns.monthly_amount") } %></th>
              <th scope="col" class="d-none d-md-table-cell"><%= recurring_sort_link("payment_day", @sort, @direction) { t("recurring.expected_payment_day") } %></th>
              <th scope="col"><%= recurring_sort_link("status", @sort, @direction) { t("common.status") } %></th>
              <th scope="col" class="text-end"><%= t("common.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @recurring_templates.each do |rt| %>
              <% status = rt.status_for(@current_period) %>
              <% expected_date = recurring_expected_date(rt, @current_period) %>
              <tr data-testid="recurring-row"
                  data-id="<%= rt.id %>"
                  data-category-id="<%= rt.category_id %>"
                  data-category-name="<%= rt.category&.name %>"
                  data-description="<%= rt.description %>"
                  data-amount="<%= rt.amount %>"
                  data-paid-amount="<%= rt.paid_amount_for_period(@current_period) %>"
                  data-payment-day="<%= rt.payment_day %>"
                  data-active="<%= rt.active? %>"
                  data-status="<%= status %>"
                  data-type="<%= rt.kind %>"
                  data-edit-url="<%= monthly_expense_path(rt) %>"
                  data-delete-url="<%= monthly_expense_path(rt) %>"
                  data-toggle-url="<%= toggle_active_monthly_expense_path(rt) %>"
                  data-process-url="<%= process_transaction_monthly_expense_path(rt) %>">
                <td class="recurring-cat"><%= category_badge(rt.category) %></td>
                <td class="recurring-desc">
                  <span class="cell-strong"><%= rt.description.presence || content_tag(:span, t("recurring.no_description"), class: "text-muted") %></span>
                  <small class="cell-muted d-block">
                    <% if rt.payment_day.present? %>
                      <%= t("monthly_expenses.monthly_hint", day: rt.payment_day, default: "Mensual · Día %{day}") %>
                    <% else %>
                      <%= t("monthly_expenses.no_payment_day", default: "Sin día definido") %>
                    <% end %>
                  </small>
                </td>
                <td class="text-end cell-amount recurring-amount"><%= number_to_currency(rt.signed_amount) %></td>
                <td class="recurring-day d-none d-md-table-cell">
                  <% if expected_date %>
                    <span class="fw-semibold num"><%= l(expected_date, format: "%d %b") %></span>
                    <small class="cell-muted d-block"><%= t("monthly_expenses.summary.expected_date", default: "Fecha esperada") %></small>
                  <% else %>
                    <span class="text-secondary">&mdash;</span>
                  <% end %>
                </td>
                <td data-testid="status" class="recurring-status-cell"><%= recurring_status_badge(status) %></td>
                <td class="text-end recurring-actions-cell">
                  <div class="recurring-row-actions">
                    <% if status == :pending %>
                      <button type="button" class="btn btn-primary btn-sm" data-testid="process"
                              aria-label="<%= t("monthly_expenses.pay", default: "Pagar") %>"
                              title="<%= t("monthly_expenses.pay", default: "Pagar") %>"
                              data-rt-action="process">
                        <i class="ti ti-coin me-1"></i><%= t("monthly_expenses.pay", default: "Pagar") %>
                      </button>
                    <% end %>
                    <div class="dropdown">
                      <button type="button" class="btn btn-outline-secondary btn-sm recurring-actions-toggle"
                              data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false"
                              data-testid="row-actions"
                              aria-label="<%= t("monthly_expenses.row_actions", default: "Más acciones") %>">
                        <i class="ti ti-dots"></i>
                      </button>
                      <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                          <button type="button" class="dropdown-item d-flex align-items-center gap-2"
                                  data-testid="edit" data-rt-action="edit">
                            <i class="ti ti-pencil"></i><%= t("common.edit") %>
                          </button>
                        </li>
                        <li>
                          <button type="button" class="dropdown-item d-flex align-items-center gap-2"
                                  data-testid="deactivate" data-rt-action="toggle">
                            <i class="ti ti-power"></i><%= rt.active? ? t("recurring.deactivate") : t("recurring.activate") %>
                          </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                          <button type="button" class="dropdown-item d-flex align-items-center gap-2 text-danger"
                                  data-testid="delete" data-rt-action="delete">
                            <i class="ti ti-trash"></i><%= t("common.delete") %>
                          </button>
                        </li>
                      </ul>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>

<!-- Create / Edit modal -->
<div class="modal fade" id="recurringFormModal" tabindex="-1" aria-labelledby="recurringFormTitle" aria-hidden="true"
     data-testid="form-modal">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <%= form_with model: @recurring_template, local: true, id: "recurringForm" do |f| %>
        <div class="modal-header">
          <h5 class="modal-title" id="recurringFormTitle"><%= t("monthly_expenses.form.add_title", default: "Agregar gasto mensual") %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <%= category_picker f, :category_id, @categories,
                                  label: t("common.category"),
                                  prompt: t("recurring.select_category"),
                                  required: true,
                                  class: field_class(@recurring_template, :category_id),
                                  testid: "recurring-template-category-picker" %>
              <div class="invalid-feedback"><%= field_error(@recurring_template, :category_id) %></div>
            </div>
            <div class="col-md-6">
              <%= f.label :description, t("common.description"), class: "form-label" %>
              <%= f.text_field :description, class: "form-control #{field_class(@recurring_template, :description)}",
                               maxlength: 255, placeholder: "e.g. Netflix Subscription" %>
              <div class="invalid-feedback"><%= field_error(@recurring_template, :description) %></div>
            </div>
            <div class="col-md-6">
              <%= f.label :amount, t("monthly_incomes.columns.monthly_amount"), class: "form-label" %>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <%= f.text_field :amount,
                                 value: money_field_value(@recurring_template.amount),
                                 class: "form-control #{field_class(@recurring_template, :amount)}",
                                 required: true,
                                 placeholder: t("expenses.placeholder_amount"),
                                 inputmode: "decimal",
                                 autocomplete: "off",
                                 data: { money_input: true } %>
              </div>
              <div class="invalid-feedback"><%= field_error(@recurring_template, :amount) %></div>
            </div>
            <div class="col-md-6">
              <%= f.label :payment_day, t("recurring.expected_payment_day"), class: "form-label" %>
              <%= f.number_field :payment_day, class: "form-control #{field_class(@recurring_template, :payment_day)}",
                                 min: 1, max: 31, required: true, placeholder: "1-31" %>
              <div class="invalid-feedback"><%= field_error(@recurring_template, :payment_day) %></div>
            </div>
            <div class="col-md-6 d-flex align-items-end">
              <div class="form-check form-switch">
                <%= f.check_box :active, class: "form-check-input", role: "switch", id: "recurring_active_switch" %>
                <%= f.label :active, "Active", class: "form-check-label", for: "recurring_active_switch" %>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("common.cancel") %></button>
          <%= f.submit t("common.save"), class: "btn btn-primary", data: { testid: "save-recurring" } %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Pay confirmation modal -->
<div class="modal fade" id="processModal" tabindex="-1" aria-labelledby="processTitle" aria-hidden="true"
     data-testid="process-modal">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="processForm" method="post" data-turbo="false">
        <div class="modal-header">
          <h5 class="modal-title" id="processTitle"><%= t("monthly_expenses.confirm_pay", default: "Confirmar pago") %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-1">
            <label class="form-label text-muted small mb-0"><%= t("common.category") %></label>
            <p class="form-control-plaintext fw-bold" id="processCategory"></p>
          </div>
          <div class="mb-1">
            <label class="form-label text-muted small mb-0"><%= t("common.description") %></label>
            <p class="form-control-plaintext" id="processDescription"></p>
          </div>
          <div class="mb-1">
            <label class="form-label text-muted small mb-0"><%= t("recurring.configured_amount") %></label>
            <p class="form-control-plaintext" id="processConfiguredAmount"></p>
          </div>
          <div class="mb-1">
            <label for="processMoneySource" class="form-label"><%= t("recurring.process_money_source") %></label>
            <select class="form-select" id="processMoneySource" name="money_source_id">
              <option value=""><%= t("recurring.process_money_source_default") %></option>
              <% @payment_sources.each do |source| %>
                <option value="<%= source.id %>"><%= source.display_name %></option>
              <% end %>
            </select>
            <div class="form-text"><%= t("recurring.process_money_source_hint") %></div>
          </div>
          <div class="mb-1">
            <label for="processDate" class="form-label"><%= t("recurring.transaction_date") %></label>
            <input type="date" class="form-control" id="processDate" name="date" value="<%= Date.current %>" required>
          </div>
           <div class="mb-1">
            <label for="processAmount" class="form-label"><%= t("common.amount") %></label>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <input type="text" class="form-control" id="processAmount" name="amount"
                     inputmode="decimal" autocomplete="off" data-money-input="true" required>
            </div>
            <div class="form-text"><%= t("recurring.amount_hint") %></div>
          </div>
          <div class="mb-1">
            <label class="form-label text-muted small mb-0"><%= t("recurring.paid_so_far", default: "Pagado hasta ahora") %></label>
            <p class="form-control-plaintext" id="processPaidSoFar">$0</p>
          </div>
          <div class="form-check mb-1">
            <input class="form-check-input" type="checkbox" id="processMarkAsPaid" name="mark_as_paid" value="1">
            <label class="form-check-label small" for="processMarkAsPaid"><%= t("recurring.mark_as_paid", default: "Marcar como pagado") %></label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t("recurring.back") %></button>
          <button type="submit" class="btn btn-success" id="processConfirm" data-testid="confirm-process"><%= t("monthly_expenses.pay", default: "Pagar") %></button>
        </div>
      </form>
    </div>
  </div>
</div>


<% if @open_form_modal %>
  <% end %>

<%= javascript_include_tag "monthly_expenses_ui", defer: true %>

