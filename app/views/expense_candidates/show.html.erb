<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
  <h1><i class="bi bi-inbox me-2"></i><%= t("expense_candidates.review", default: "Review Candidate") %></h1>
  <div class="d-flex gap-2">
    <%= link_to expense_candidates_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left me-1"></i><%= t("common.back", default: "Back") %>
    <% end %>
  </div>
</div>

<div class="row g-4">
  <div class="col-12 col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i><%= t("expense_candidates.edit_fields", default: "Edit Fields") %></h5>
        <%= status_badge(@candidate.status) %>
      </div>
      <div class="card-body">
        <%= form_with model: @candidate, url: expense_candidate_path(@candidate), method: :patch, local: true do |f| %>
          <div class="row g-3">
            <!-- Amount -->
            <div class="col-12 col-md-6">
              <div class="mb-3">
                <%= f.label :amount, t("common.amount"), class: "form-label" %>
                <div class="input-group">
                  <span class="input-group-text">$</span>
                  <%= f.text_field :amount,
                                   value: money_field_value(@candidate.amount&.abs),
                                   class: "form-control #{field_class(@candidate, :amount)}",
                                   placeholder: t("expenses.placeholder_amount"),
                                   inputmode: "decimal",
                                   autocomplete: "off",
                                   data: { money_input: true } %>
                </div>
                <%= field_error(@candidate, :amount) %>
              </div>
            </div>

            <!-- Date -->
            <div class="col-12 col-md-6">
              <div class="mb-3">
                <%= f.label :date, t("common.date"), class: "form-label" %>
                <%= f.date_field :date, class: "form-control #{field_class(@candidate, :date)}", value: @candidate.date %>
                <%= field_error(@candidate, :date) %>
              </div>
            </div>

            <!-- Description -->
            <div class="col-12">
              <div class="mb-3">
                <%= f.label :description, t("common.description"), class: "form-label" %>
                <%= f.text_field :description, class: "form-control", placeholder: t("expenses.description_placeholder") %>
              </div>
            </div>

            <!-- Category -->
            <div class="col-12 col-md-6">
              <div class="mb-3">
                <%= f.label :category_id, t("common.category"), class: "form-label" %>
                <% if @candidate.category_id.nil? %>
                  <span class="badge bg-warning text-dark mb-2"><i class="bi bi-exclamation-triangle me-1"></i><%= t("expense_candidates.missing", default: "Missing") %></span>
                <% end %>
                <%= f.collection_select :category_id, @categories, :id, :name,
                                        { include_blank: t("expense_candidates.select_category", default: "Select category...") },
                                        class: "form-select" %>
              </div>
            </div>

            <!-- Money Source -->
            <div class="col-12 col-md-6">
              <div class="mb-3">
                <%= f.label :money_source_id, t("common.money_source", default: "Money Source"), class: "form-label" %>
                <% if @candidate.money_source_id.nil? %>
                  <span class="badge bg-warning text-dark mb-2"><i class="bi bi-exclamation-triangle me-1"></i><%= t("expense_candidates.missing", default: "Missing") %></span>
                <% end %>
                <%= f.collection_select :money_source_id, @money_sources, :id, :display_name,
                                        { include_blank: t("expense_candidates.select_source", default: "Select money source...") },
                                        class: "form-select" %>
              </div>
            </div>
          </div>

          <div class="d-flex gap-2 mt-3">
            <%= f.submit t("expense_candidates.save_changes", default: "Save Changes"), class: "btn btn-primary" %>
            <%= link_to expense_candidate_path(@candidate), class: "btn btn-outline-secondary" do %>
              <i class="bi bi-arrow-counterclockwise me-1"></i><%= t("common.reset", default: "Reset") %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Original input -->
    <% if @candidate.original_input.present? %>
      <div class="card shadow-sm mt-3">
        <div class="card-header bg-white">
          <h6 class="mb-0"><i class="bi bi-chat-left-text me-2"></i><%= t("expense_candidates.original_input", default: "Original Input") %></h6>
        </div>
        <div class="card-body">
          <blockquote class="blockquote mb-0">
            <p class="mb-0 text-muted fst-italic">"<%= @candidate.original_input %>"</p>
          </blockquote>
          <% if @candidate.original_text.present? && @candidate.original_text != @candidate.original_input %>
            <hr>
            <small class="text-muted">
              <strong><%= t("expense_candidates.extracted_text", default: "Extracted text:") %></strong>
              "<%= @candidate.original_text %>"
            </small>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Sidebar -->
  <div class="col-12 col-lg-4">
    <!-- Confidence -->
    <% if @candidate.confidence %>
      <div class="card shadow-sm mb-3">
        <div class="card-header bg-white">
          <h6 class="mb-0"><i class="bi bi-speedometer me-2"></i><%= t("expense_candidates.confidence", default: "Confidence") %></h6>
        </div>
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="progress flex-grow-1 me-3" style="height: 8px;">
              <div class="progress-bar <%= @candidate.confidence >= 0.8 ? 'bg-success' : @candidate.confidence >= 0.5 ? 'bg-warning' : 'bg-danger' %>"
                   style="width: <%= (@candidate.confidence * 100).round %>%"></div>
            </div>
            <span class="fw-bold"><%= (@candidate.confidence * 100).round %>%</span>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Missing fields -->
    <% if @candidate.missing_fields.any? %>
      <div class="card shadow-sm mb-3 border-warning">
        <div class="card-header bg-warning bg-opacity-10 text-warning">
          <h6 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i><%= t("expense_candidates.missing_fields_title", default: "Missing Fields") %></h6>
        </div>
        <div class="card-body">
          <ul class="list-unstyled mb-0">
            <% @candidate.missing_fields.each do |field| %>
              <li class="mb-1">
                <i class="bi bi-circle-fill text-warning me-2" style="font-size: 0.5rem;"></i>
                <%= field.titleize %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <!-- Actions -->
    <div class="card shadow-sm mb-3">
      <div class="card-header bg-white">
        <h6 class="mb-0"><i class="bi bi-lightning me-2"></i><%= t("common.actions", default: "Actions") %></h6>
      </div>
      <div class="card-body">
        <% if @candidate.missing_fields.empty? && !@candidate.confirmed? %>
          <%= button_to confirm_expense_candidate_path(@candidate),
                        method: :post,
                        class: "btn btn-success w-100 mb-2",
                        data: { confirm: t("expense_candidates.confirm_confirm", default: "Create the final expense from this candidate?") } do %>
            <i class="bi bi-check-circle me-1"></i><%= t("expense_candidates.save_expense", default: "Save Expense") %>
          <% end %>
        <% elsif @candidate.missing_fields.any? %>
          <div class="alert alert-warning mb-2 py-2">
            <i class="bi bi-info-circle me-1"></i>
            <%= t("expense_candidates.complete_fields_first", default: "Complete all missing fields before saving.") %>
          </div>
        <% end %>

        <% unless @candidate.confirmed? || @candidate.discarded? %>
          <%= button_to discard_expense_candidate_path(@candidate),
                        method: :post,
                        class: "btn btn-outline-danger w-100",
                        data: { confirm: t("expense_candidates.discard_confirm", default: "Discard this candidate?") } do %>
            <i class="bi bi-trash me-1"></i><%= t("expense_candidates.discard", default: "Discard") %>
          <% end %>
        <% end %>

        <% if @candidate.confirmed? %>
          <div class="alert alert-success mb-0 py-2">
            <i class="bi bi-check-circle me-1"></i>
            <%= t("expense_candidates.already_confirmed_message", default: "This candidate was confirmed.") %>
          </div>
        <% elsif @candidate.discarded? %>
          <div class="alert alert-secondary mb-0 py-2">
            <i class="bi bi-trash me-1"></i>
            <%= t("expense_candidates.already_discarded_message", default: "This candidate was discarded.") %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Metadata -->
    <div class="card shadow-sm">
      <div class="card-header bg-white">
        <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i><%= t("common.details", default: "Details") %></h6>
      </div>
      <div class="card-body">
        <dl class="mb-0">
          <dt class="small text-muted"><%= t("common.source") %></dt>
          <dd class="mb-2"><span class="badge bg-light text-dark"><i class="bi bi-<%= source_icon(@candidate.source) %> me-1"></i><%= @candidate.source.titleize %></span></dd>

          <dt class="small text-muted"><%= t("common.created_at", default: "Created") %></dt>
          <dd class="mb-2"><%= l(@candidate.created_at, format: :long) if @candidate.created_at %></dd>

          <% if @candidate.confirmed_at %>
            <dt class="small text-muted"><%= t("common.confirmed_at", default: "Confirmed") %></dt>
            <dd class="mb-2"><%= l(@candidate.confirmed_at, format: :long) %></dd>
          <% end %>

          <% if @candidate.expense %>
            <dt class="small text-muted"><%= t("expense_candidates.linked_expense", default: "Linked Expense") %></dt>
            <dd class="mb-0">
              <%= link_to expense_path(@candidate.expense), class: "text-decoration-none" do %>
                <i class="bi bi-link-45deg me-1"></i><%= t("expense_candidates.view_expense", default: "View Expense") %>
              <% end %>
            </dd>
          <% end %>
        </dl>
      </div>
    </div>
  </div>
</div>
