<div class="container mt-4">
  <h1>QA Validation - Dashboard & Reports</h1>
  
  <div class="row mt-4">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h5>Validation Status</h5>
        </div>
        <div class="card-body">
          <table class="table">
            <thead>
              <tr>
                <th>Check</th>
                <th>Status</th>
                <th>Details</th>
              </tr>
            </thead>
            <tbody>
              <% @validations.each do |name, validation| %>
                <tr>
                  <td><%= name.to_s.titleize %></td>
                  <td>
                    <% if validation[:status] == "PASS" %>
                      <span class="badge bg-success">PASS</span>
                    <% else %>
                      <span class="badge bg-danger">FAIL</span>
                    <% end %>
                  </td>
                  <td><%= validation[:details] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          
          <div class="mt-3">
            <%= link_to "Run All Validations (JSON)", qa_validate_run_all_path(format: :json), class: "btn btn-primary", target: "_blank" %>
            <%= link_to "Dashboard Check", qa_validate_dashboard_path, class: "btn btn-secondary" %>
            <%= link_to "Reports Check", qa_validate_reports_path, class: "btn btn-secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
