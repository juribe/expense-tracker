<% content_for :title, t("mcp.settings.title") %>

<%= render "shared/page_header",
           title: t("mcp.settings.title"),
           subtitle: t("mcp.settings.intro") do %>
<% end %>

<div class="mcp-layout">
  <main class="card mcp-main">
    <h2 class="mcp-card-title"><%= t("mcp.settings.prepare_title") %></h2>
    <p class="mcp-card-sub"><%= t("mcp.settings.prepare_sub") %></p>

    <div class="mcp-steps">
      <div class="mcp-step">
        <div class="mcp-step-num">1</div>
        <div>
          <strong><%= t("mcp.settings.step1_title") %></strong>
          <span><%= t("mcp.settings.step1_desc") %></span>
        </div>
      </div>
      <div class="mcp-step">
        <div class="mcp-step-num">2</div>
        <div>
          <strong><%= t("mcp.settings.step2_title") %></strong>
          <span><%= t("mcp.settings.step2_desc") %></span>
        </div>
      </div>
      <div class="mcp-step">
        <div class="mcp-step-num">3</div>
        <div>
          <strong><%= t("mcp.settings.step3_title") %></strong>
          <span><%= t("mcp.settings.step3_desc") %></span>
        </div>
      </div>
    </div>

    <div class="mcp-section">
      <label class="mcp-section-label"><%= t("mcp.settings.address_label") %></label>
      <div class="mcp-field" data-testid="mcp-endpoint">
        <code><%= mcp_endpoint_url %></code>
        <button type="button" class="mcp-mini mcp-copy"
                data-copy-value="<%= mcp_endpoint_url %>"
                data-copied-label="<%= t("mcp.settings.copied") %>"
                data-copy-failed-label="<%= t("mcp.settings.copy_failed") %>">
          <%= t("mcp.settings.copy") %>
        </button>
      </div>
    </div>

    <div class="mcp-section">
      <label class="mcp-section-label"><%= t("mcp.settings.key_title") %></label>
      <p class="mcp-card-sub"><%= t("mcp.settings.key_desc") %></p>

      <div class="mcp-keybox" data-key="<%= @plain_token || "" %>">
        <div class="mcp-keytop">
          <strong id="keyTitle">
            <%= @tokens.any? ? t("mcp.settings.key_created") : t("mcp.settings.key_none_title") %>
          </strong>
          <span class="mcp-status" id="keyStatus">
            <%= @tokens.any? ? "● #{t("mcp.settings.key_active")}" : "● #{t("mcp.settings.key_none")}" %>
          </span>
        </div>

        <div class="mcp-keyrow">
          <code id="keyValue"><%= @plain_token.present? ? @plain_token : "••••••••••••••••••••••••" %></code>
          <div class="mcp-keyactions">
            <button type="button" class="mcp-btn" id="reveal"
                    data-action="reveal"
                    data-reveal-label="<%= t("mcp.settings.reveal") %>"
                    data-hide-label="<%= t("mcp.settings.hide") %>"
                    data-revealed="<%= @plain_token.present? %>"
                    <%= "disabled" unless @plain_token %>>
              <%= @plain_token.present? ? t("mcp.settings.hide") : t("mcp.settings.reveal") %>
            </button>
            <button type="button" class="mcp-btn" id="copyKey" data-action="copy-key"
                    data-copied-label="<%= t("mcp.settings.copied") %>"
                    data-copy-failed-label="<%= t("mcp.settings.copy_failed") %>"
                    <%= "disabled" unless @plain_token %>>
              <%= t("mcp.settings.copy_key") %>
            </button>
          </div>
        </div>

        <% if @tokens.any? %>
          <p class="mcp-keymeta">
            <%= t("mcp.settings.key_created_on", date: l(@tokens.first.created_at.to_date, format: :long)) %>
            <% if @tokens.first.last_used_at %>
              · <%= t("mcp.settings.key_last_used", date: l(@tokens.first.last_used_at, format: :short)) %>
            <% end %>
          </p>
        <% end %>

        <%= form_with url: mcp_settings_path, scope: :mcp_token, local: true,
                      html: { id: "keyForm" },
                      data: (@tokens.any? ? { turbo_confirm: t("mcp.settings.key_replace_confirm") } : {}) do |form| %>
          <%= form.hidden_field :name, value: "Mi asistente" %>
          <button type="submit" class="mcp-primary" id="generate">
            ＋ <%= t("mcp.settings.generate_key") %>
          </button>
        <% end %>

        <% if @plain_token.present? %>
          <p class="mcp-keynote" id="keyNote"><%= t("mcp.settings.key_note") %></p>
        <% elsif @tokens.any? %>
          <p class="mcp-keynote" id="keyNote"><%= t("mcp.settings.key_already_shown") %></p>
        <% else %>
          <p class="mcp-keynote" id="keyNote"><%= t("mcp.settings.key_note") %></p>
        <% end %>
      </div>

      <div class="mcp-warn">
        🔒 <span><%= t("mcp.settings.key_warn") %></span>
      </div>
    </div>

    <div class="mcp-section">
      <label class="mcp-section-label"><%= t("mcp.settings.prompt_title") %></label>
      <p class="mcp-card-sub" style="margin-bottom:10px"><%= t("mcp.settings.prompt_desc") %></p>

      <div class="mcp-promptbox">
        <div class="mcp-prompthead">
          <strong><%= t("mcp.settings.prompt_ready") %></strong>
          <span><%= t("mcp.settings.prompt_complete") %></span>
        </div>
        <div id="prompt" data-testid="mcp-prompt">
          <% if @plain_token.present? %>
            <%= mcp_prompt_text(mcp_endpoint_url, @plain_token) %>
          <% elsif @tokens.any? %>
            <%= t("mcp.settings.key_already_shown") %>
          <% else %>
            <%= t("mcp.settings.prompt_placeholder") %>
          <% end %>
        </div>
      </div>

      <button type="button" class="mcp-copyall" id="copyPrompt"
              data-copy-target="prompt"
              data-copied-label="<%= t("mcp.settings.copied") %>"
              data-copy-failed-label="<%= t("mcp.settings.copy_failed") %>"
              <%= "disabled" unless @plain_token %>>
        <%= t("mcp.settings.copy_prompt") %>
      </button>
      <p class="mcp-hint"><%= t("mcp.settings.prompt_hint") %></p>
    </div>
  </main>

  <aside class="mcp-side">
    <section class="card mcp-side-card">
      <h2><%= t("mcp.settings.other_title") %></h2>
      <p class="mcp-card-sub"><%= t("mcp.settings.other_desc") %></p>

      <div class="mcp-other">
        <div class="mcp-ico">✳</div>
        <div>
          <strong>Claude</strong>
          <span><%= t("mcp.settings.claude_desc") %></span>
        </div>
        <a href="#" data-info><%= t("mcp.settings.how_to_connect") %></a>
      </div>
      <div class="mcp-other">
        <div class="mcp-ico">⌘</div>
        <div>
          <strong>OpenCode</strong>
          <span><%= t("mcp.settings.opencode_desc") %></span>
        </div>
        <a href="#" data-info><%= t("mcp.settings.how_to_connect") %></a>
      </div>
      <div class="mcp-other">
        <div class="mcp-ico">＋</div>
        <div>
          <strong><%= t("mcp.settings.other_assistants") %></strong>
          <span><%= t("mcp.settings.compatible_tools") %></span>
        </div>
        <a href="#" data-info><%= t("mcp.settings.how_to_connect") %></a>
      </div>
    </section>

    <section class="card mcp-side-card">
      <div class="mcp-safe">
        <b><%= t("mcp.settings.security_title") %></b>
        <%= t("mcp.settings.security_body") %>
      </div>
    </section>
  </aside>
</div>

