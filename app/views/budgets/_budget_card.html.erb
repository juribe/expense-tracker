<% data = budget_progress_data(budget, period) %>
<% pct = data[:percentage] %>
<% state = budget_display_state(pct) %>
<% remaining = budget.remaining_for(period) %>
<% exceeded = remaining.negative? %>
<% amount = budget.amount_for(period) %>

<article class="card budget-card budget-card--<%= state.to_s.dasherize %> h-100" data-testid="budget-card">
  <div class="card-body d-flex flex-column">
    <div class="budget-card-head">
      <div class="budget-category">
        <span class="icon-chip icon-chip-blue" aria-hidden="true">
          <i class="ti <%= budget_category_icon(budget.category.icon) %>"></i>
        </span>
        <div class="budget-category-copy">
          <%= link_to budget.category.name, category_path(budget.category), class: "budget-category-name" %>
          <% unless budget.active %>
            <span class="badge bg-secondary mt-1"><%= t("budgets.inactive") %></span>
          <% end %>
        </div>
      </div>

      <div class="budget-card-actions d-inline-flex align-items-center gap-2 d-print-none" role="group" aria-label="<%= budget.category.name %>">
        <%= link_to edit_budget_path(budget), class: "btn btn-sm btn-outline-primary", title: t("common.edit"), aria: { label: t("budgets.edit_aria", name: budget.category.name) } do %>
          <i class="ti ti-pencil" aria-hidden="true"></i>
        <% end %>
        <%= button_to budget_path(budget), method: :delete, class: "btn btn-sm btn-outline-danger", title: t("common.delete"), aria: { label: t("budgets.delete_aria", name: budget.category.name) }, data: { confirm: t("common.confirm") }, form: { data: { turbo: true } } do %>
          <i class="ti ti-trash" aria-hidden="true"></i>
        <% end %>
      </div>
    </div>

    <div class="budget-available">
      <span class="budget-available-label"><%= t("budgets.remaining") %></span>
      <strong class="budget-available-value" data-testid="budget-available-amount"><%= number_to_currency(remaining) %></strong>
      <% if exceeded %>
        <span class="budget-available-hint" data-testid="budget-exceeded-hint">
          <%= t("budgets.exceeded_hint", amount: number_to_currency(remaining.abs)) %>
        </span>
      <% elsif remaining.zero? && state == :over_budget %>
        <span class="budget-available-hint" data-testid="budget-exhausted-hint"><%= t("budgets.exhausted_hint") %></span>
      <% else %>
        <span class="budget-available-hint"><%= t("budgets.available_hint", amount: number_to_currency(amount)) %></span>
      <% end %>
    </div>

    <div class="budget-numbers">
      <div>
        <span class="budget-number-label"><%= t("budgets.spent") %></span>
        <span class="budget-number-value budget-number-value--spent budget-amount" data-testid="budget-spent-amount">
          <%= number_to_currency(data[:spent]) %>
        </span>
      </div>
      <div class="text-end">
        <span class="budget-number-label"><%= t("budgets.budget") %></span>
        <span class="budget-number-value budget-amount" data-testid="budget-budget-amount"><%= number_to_currency(amount) %></span>
      </div>
    </div>

    <div class="budget-usage">
      <div class="budget-usage-head">
        <span><%= t("budgets.usage") %></span>
        <b data-testid="budget-usage"><%= number_to_percentage(pct, precision: 0) %></b>
      </div>
      <div class="progress budget-progress"
           role="progressbar"
           data-testid="budget-progress"
           aria-label="<%= t("budgets.progress_aria", name: budget.category.name) %>"
           aria-valuenow="<%= pct.round %>"
           aria-valuemin="0"
           aria-valuemax="100">
        <div class="progress-bar budget-progress-bar et-w-<%= [ pct, 100 ].min.round %>"></div>
      </div>
    </div>

    <div class="budget-card-foot mt-auto">
      <div class="budget-card-status">
        <span class="budget-state" data-testid="budget-status">
          <i class="ti <%= budget_display_icon(state) %>" aria-hidden="true"></i><%= budget_display_label(state) %>
        </span>
        <span class="budget-card-usage"><%= t("budgets.percentage_used", pct: number_to_percentage(pct, precision: 0)) %></span>
      </div>

      <%= link_to budget_analysis_path(budget, period), class: "budget-analysis-link", data: { testid: "budget-analysis" } do %>
        <%= t("budgets.analysis") %> <i class="ti ti-arrow-right" aria-hidden="true"></i>
      <% end %>
    </div>
  </div>
</article>
