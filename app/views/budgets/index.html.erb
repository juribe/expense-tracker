<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 d-print-none">
  <h1><i class="bi bi-bullseye me-2"></i><%= t("budgets.title") %></h1>
  <%= link_to new_budget_path, class: "btn btn-primary" do %>
    <i class="bi bi-plus-lg me-1"></i><%= t("budgets.new") %>
  <% end %>
</div>

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
  <%= link_to budgets_path(month: @month.prev_month), class: "btn btn-outline-secondary btn-sm", aria: { label: t("budgets.month_previous_aria") } do %>
    <i class="bi bi-chevron-left"></i>
  <% end %>
  <h5 class="mb-0"><%= l(@month, format: :month_year) %></h5>
  <%= link_to budgets_path(month: @month.next_month), class: "btn btn-outline-secondary btn-sm", aria: { label: t("budgets.month_next_aria") } do %>
    <i class="bi bi-chevron-right"></i>
  <% end %>
</div>

<div class="text-center mb-4">
  <% if @month.beginning_of_month == Time.zone.today.beginning_of_month %>
    <span class="badge bg-light text-dark border"><i class="bi bi-calendar-month me-1"></i><%= t("budgets.current_month_badge") %></span>
  <% else %>
    <%= link_to budgets_path, class: "small" do %>
      <i class="bi bi-arrow-left me-1"></i><%= t("budgets.back_to_current_month") %>
    <% end %>
  <% end %>
</div>

<% if @budgets.any? %>
  <% counts = budget_summary_counts(@budgets, @month) %>
  <p class="text-muted small mb-4">
    <%= t("budgets.summary", count: counts[:total], near_limit: counts[:near_limit], over_budget: counts[:over_budget]) %>
  </p>

  <div class="row g-3">
    <% @budgets.each do |budget| %>
      <div class="col-12 col-md-6 col-lg-4">
        <%= render "budget_card", budget: budget, month: @month %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="card shadow-sm">
    <div class="p-5 text-center">
      <i class="bi bi-bullseye display-4 text-muted mb-3 d-block"></i>
      <h4 class="mb-2"><%= t("budgets.empty_title") %></h4>
      <p class="text-muted"><%= t("budgets.empty_body") %></p>
      <%= link_to new_budget_path, class: "btn btn-primary mt-3" do %>
        <i class="bi bi-plus-lg me-1"></i><%= t("budgets.new") %>
      <% end %>
    </div>
  </div>
<% end %>