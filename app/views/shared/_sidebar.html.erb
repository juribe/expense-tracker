<%# Sidebar Navigation %>
<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <%= link_to dashboard_path, class: "sidebar-brand" do %>
      <i class="bi bi-wallet2"></i>
      <span><%= t("layout.app_title") %></span>
    <% end %>
  </div>

  <nav class="sidebar-nav">
    <div class="sidebar-section">
      <div class="sidebar-section-title"><%= t("nav.overview") %></div>
      <%= link_to dashboard_path, class: "sidebar-link #{active_class('dashboard')}" do %>
        <i class="bi bi-grid-1x2"></i>
        <span><%= t("nav.dashboard") %></span>
      <% end %>
      <% unless financial_setup_completed? %>
        <%= link_to financial_setup_path, class: "sidebar-link #{active_class('financial_setups')}" do %>
          <i class="bi bi-magic"></i>
          <span><%= t("nav.setup_wizard") %></span>
        <% end %>
      <% end %>
    </div>

    <div class="sidebar-section">
      <div class="sidebar-section-title"><%= t("nav.transactions") %></div>
      <%= link_to expenses_path, class: "sidebar-link #{active_class('expenses')}" do %>
        <i class="bi bi-credit-card"></i>
        <span><%= t("nav.expenses") %></span>
      <% end %>
      <%= link_to incomes_path, class: "sidebar-link #{active_class('incomes')}" do %>
        <i class="bi bi-wallet2"></i>
        <span><%= t("nav.incomes") %></span>
      <% end %>
    </div>

    <div class="sidebar-section">
      <div class="sidebar-section-title"><%= t("nav.recurring") %></div>
      <%= link_to monthly_incomes_path, class: "sidebar-link #{active_class('monthly_incomes')}" do %>
        <i class="bi bi-arrow-repeat"></i>
        <span><%= t("nav.recurring_incomes") %></span>
      <% end %>
      <%= link_to monthly_expenses_path, class: "sidebar-link #{active_class('monthly_expenses')}" do %>
        <i class="bi bi-arrow-clockwise"></i>
        <span><%= t("nav.recurring_expenses") %></span>
      <% end %>
    </div>

    <div class="sidebar-section">
      <div class="sidebar-section-title"><%= t("nav.reports") %></div>
      <%= link_to monthly_reports_path, class: "sidebar-link #{active_class('monthly_reports')}" do %>
        <i class="bi bi-graph-up"></i>
        <span><%= t("nav.reports_title") %></span>
      <% end %>
    </div>

    <div class="sidebar-section sidebar-settings">
      <div class="sidebar-section-title"><%= t("nav.settings") %></div>
      <%= link_to categories_path, class: "sidebar-link #{active_class('categories')}" do %>
        <i class="bi bi-tags"></i>
        <span><%= t("nav.categories") %></span>
      <% end %>
      <%= link_to money_sources_cash_path, class: "sidebar-link #{money_source_filter_active?('cash')}" do %>
        <i class="bi bi-cash-stack"></i>
        <span><%= t("nav.money_sources_cash") %></span>
      <% end %>
      <%= link_to money_sources_credit_cards_path, class: "sidebar-link #{money_source_filter_active?('credit_cards')}" do %>
        <i class="bi bi-credit-card-2-front"></i>
        <span><%= t("nav.money_sources_credit_cards") %></span>
      <% end %>
      <%= link_to money_sources_loans_path, class: "sidebar-link #{money_source_filter_active?('loans')}" do %>
        <i class="bi bi-cash-coin"></i>
        <span><%= t("nav.money_sources_loans") %></span>
      <% end %>
      <%= link_to gmail_connection_path, class: "sidebar-link #{active_class('gmail_connections')}" do %>
        <i class="bi bi-envelope-at"></i>
        <span><%= t("nav.gmail") %></span>
      <% end %>
      <%= link_to money_sources_recognition_path, class: "sidebar-link #{'active' if controller_name == 'money_sources' && action_name == 'recognition'}" do %>
        <i class="bi bi-envelope-paper-heart"></i>
        <span><%= t("nav.source_recognition") %></span>
      <% end %>
    </div>
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-user">
      <i class="bi bi-person-circle"></i>
      <span><%= current_user.email %></span>
    </div>
    <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "sidebar-link" do %>
      <i class="bi bi-box-arrow-right"></i>
      <span><%= t("nav.sign_out") %></span>
    <% end %>
  </div>
</aside>
