<%# Page header: title (+ subtitle) on the left, actions on the right.
    Locals: title (string), subtitle (optional). Actions may come either as
    an `actions` local or as a captured content block. %>
<div class="page-header">
  <div>
    <h1 class="page-title"><%= title %></h1>
    <% if local_assigns[:subtitle] %>
      <div class="page-subtitle"><%= subtitle %></div>
    <% end %>
  </div>
  <div class="page-actions">
    <%= actions if local_assigns[:actions] %>
    <%= yield %>
  </div>
</div>
