<%# Current membership status with a shortcut to the plans page. %>
<section class="card mb-4" data-testid="membership-status">
  <div class="card-body d-flex flex-column align-items-center gap-3">
    <div>
      <h5 class="card-title mb-1 text-center">Tu membresía</h5>
      <p class="mb-0 text-secondary text-center">
        <% membership = current_membership %>
        <% if membership&.active? %>
          <%= membership.membership_type.name %>
          <span class="text-muted">
            <% if membership.expires_at.present? %>
              activa hasta <%= l(membership.expires_at, format: :long) %>
            <% else %>
              activa
            <% end %>
          </span>
        <% else %>
          No tienes una membresía activa.
        <% end %>
      </p>
    </div>
    <%= link_to "Ir a planes", plans_path, class: "btn btn-primary", data: { testid: "membership-plans-link" } %>
  </div>
</section>