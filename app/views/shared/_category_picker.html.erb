<% if field.label.present? %>
  <label class="<%= field.label_class %>" for="<%= field.search_id %>"><%= field.label %></label>
<% end %>

<div class="category-picker"
     data-category-picker
     data-testid="<%= field.testid %>"
     data-required="<%= field.required %>">
  <div class="input-group">
    <span class="input-group-text"><i class="bi bi-search"></i></span>
    <input <%= tag.attributes(field.search_html_options) %>>
    <button class="btn btn-outline-secondary" type="button" tabindex="-1"
            data-category-picker-toggle
            aria-label="<%= field.toggle_label %>"<%= " disabled" if field.disabled %>>
      <i class="bi bi-chevron-down"></i>
    </button>
  </div>

  <% if field.required %>
    <div class="invalid-feedback d-block category-picker__feedback" role="alert" hidden
         data-required-message="<%= field.required_message %>">
      <i class="bi bi-exclamation-circle me-1"></i><%= field.required_message %>
    </div>
  <% end %>

  <ul class="category-picker__list" id="<%= field.listbox_id %>" role="listbox"
      aria-label="<%= field.accessible_name %>" hidden>
    <% if field.blank_option %>
      <li class="category-picker__option category-picker__option--blank" role="option"
          id="<%= field.listbox_id %>_option_blank"
          data-value="" data-search="" aria-selected="<%= field.selected?(nil) %>">
        <span class="category-picker__label"><%= field.blank_option[:label] %></span>
      </li>
    <% end %>

    <% field.options.each do |item| %>
      <li class="category-picker__option list-group-item list-group-item-action"
          id="<%= field.listbox_id %>_option_<%= item.id %>"
          role="option"
          data-value="<%= item.id %>"
          data-search="<%= item.search_text %>"
          aria-selected="<%= field.selected?(item.id) %>">
        <span class="category-picker__label"><%= item.label %></span>
      </li>
    <% end %>

    <% unless field.empty? %>
      <li class="category-picker__empty" role="presentation" hidden
          data-no-results="<%= field.no_results_label %>">
        <i class="bi bi-search me-1"></i><%= field.no_results_label %>
      </li>
    <% end %>
  </ul>

  <%= field.select %>
</div>
