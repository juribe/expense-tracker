<div class="container-fluid py-4" data-testid="recurring-page">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-3">
      <li class="breadcrumb-item"><%= link_to t("nav.dashboard"), dashboard_path %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= t("nav.recurring") %></li>
    </ol>
  </nav>

  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h4 class="text-primary mb-0"><i class="bi bi-arrow-repeat me-2"></i><%= t("nav.recurring") %></h4>
    <%= link_to new_import_path, class: "btn btn-outline-secondary", data: { turbo: false } do %>
      <i class="bi bi-upload me-1"></i><%= t("monthly_incomes.import_templates") %>
    <% end %>
    <button type="button" class="btn btn-success ms-auto" data-testid="add-recurring"
            onclick="RecurringUI.openFormModal('create')">
      <i class="bi bi-plus-lg me-1"></i><%= t("monthly_incomes.add_income", default: "Agregar recurrente") %>
    </button>
  </div>

  <!-- Income / Expense tabs -->
  <ul class="nav nav-tabs mb-4">
    <li class="nav-item">
      <%= link_to recurring_templates_path(kind: "income"),
                  class: "nav-link #{'active' if @kind == 'income'}" do %>
        <i class="bi bi-arrow-down-circle me-1"></i><%= t("types.income_plural") %>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to recurring_templates_path(kind: "expense"),
                  class: "nav-link #{'active' if @kind == 'expense'}" do %>
        <i class="bi bi-arrow-up-circle me-1"></i><%= t("types.expense_plural") %>
      <% end %>
    </li>
  </ul>

  <!-- Filter -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <%= form_with url: recurring_templates_path(kind: @kind), method: :get, class: "row g-3 align-items-end", data: { testid: "filter-form" } do |f| %>
        <div class="col-12 col-md-4 col-lg-2">
          <%= f.label :status, t("common.status"), class: "form-label" %>
          <%= f.select :status, options_for_select([[t("common.all"), "all"], [t("statuses.completed"), "completed"], [t("statuses.pending"), "pending"]], @status_filter), {}, class: "form-select" %>
        </div>
        <div class="col-12 d-flex gap-2">
          <%= f.submit t("common.filter"), class: "btn btn-outline-primary" %>
          <%= link_to t("common.clear"), recurring_templates_path(kind: @kind), class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Totals -->
  <div class="d-flex justify-content-between align-items-baseline mb-2">
    <p class="results-meta mb-0" data-testid="results-meta">
      <%= t("recurring.results_count", count: @total_count, amount: number_to_currency(@filtered_total), default: "%{count} plantillas recurrentes · %{amount}") %>
    </p>
  </div>

  <div class="card shadow-sm" data-testid="recurring-card">
    <% if @recurring_templates.empty? %>
      <div class="text-center py-5" data-testid="empty-state">
        <i class="bi bi-arrow-repeat display-4 text-muted d-block mb-3"></i>
        <% if @status_filter != "all" %>
          <h5><%= t("monthly_incomes.empty.no_matching") %></h5>
          <p class="text-muted"><%= t("monthly_incomes.empty.filter_hint") %></p>
        <% else %>
          <h5><%= t("recurring.empty_title", default: "Aún no hay plantillas recurrentes") %></h5>
          <p class="text-muted"><%= t("recurring.empty_body", default: "Configura un ingreso o pago mensual para registrarlo aquí.") %></p>
          <button type="button" class="btn btn-outline-primary" onclick="RecurringUI.openFormModal('create')">
            <%= t("monthly_incomes.empty.add_first") %>
          </button>
        <% end %>
      </div>
    <% else %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" data-testid="recurring-table">
          <thead class="table-light">
            <tr>
              <th scope="col"><%= t("common.category") %></th>
              <th scope="col"><%= t("common.description") %></th>
              <th scope="col" class="text-end"><%= t("monthly_incomes.columns.monthly_amount") %></th>
              <th scope="col" class="d-none d-md-table-cell"><%= t("recurring.expected_payment_day") %></th>
              <th scope="col" class="d-none d-md-table-cell"><%= @recurring_templates.first&.past_action_label || t("recurring.last_received") %></th>
              <th scope="col"><%= t("common.status") %></th>
              <th scope="col" class="text-end"><%= t("common.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @recurring_templates.each do |rt| %>
              <% status = rt.status_for(@current_period) %>
              <tr data-testid="recurring-row"
                  data-id="<%= rt.id %>"
                  data-category-id="<%= rt.category_id %>"
                  data-description="<%= rt.description %>"
                  data-amount="<%= rt.amount %>"
                  data-payment-day="<%= rt.payment_day %>"
                  data-money-source-id="<%= rt.money_source_id %>"
                  data-active="<%= rt.active? %>"
                  data-type="<%= rt.kind %>"
                  data-edit-url="<%= recurring_template_path(rt) %>"
                  data-delete-url="<%= recurring_template_path(rt) %>"
                  data-toggle-url="<%= toggle_active_recurring_template_path(rt) %>"
                  data-process-url="<%= process_transaction_recurring_template_path(rt) %>">
                <td><%= category_badge(rt.category) %></td>
                <td><%= rt.description.presence || content_tag(:span, t("recurring.no_description"), class: "text-muted") %></td>
                <td class="text-end amount"><%= number_to_currency(rt.signed_amount) %></td>
                <td class="d-none d-md-table-cell"><%= rt.payment_day %></td>
                <td class="d-none d-md-table-cell">
                  <% if (last = rt.last_occurrence) %>
                    <%= l(last.date, format: :long) %>
                  <% else %>
                    <span class="text-muted">&mdash;</span>
                  <% end %>
                </td>
                <td data-testid="status">
                  <% case status %>
                  <% when :pending %>
                    <span class="badge bg-success"><%= t("statuses.pending") %></span>
                  <% when :completed %>
                    <span class="badge bg-secondary"><%= t("statuses.completed") %></span>
                  <% else %>
                    <span class="badge bg-danger"><%= t("statuses.inactive") %></span>
                  <% end %>
                </td>
                <td class="text-end text-nowrap">
                  <button type="button" class="btn btn-outline-primary btn-sm me-1" data-testid="edit"
                          aria-label="<%= t("recurring.edit_action", name: rt.description.presence || t("nav.recurring")) %>"
                          onclick="RecurringUI.openFormModal('edit', this.closest('tr'))">
                    <i class="bi bi-pencil"></i>
                  </button>
                  <button type="button" class="btn btn-outline-danger btn-sm me-1" data-testid="deactivate"
                          aria-label="<%= rt.active? ? t("recurring.deactivate_action", name: rt.description.presence || t("nav.recurring")) : t("recurring.activate_action", name: rt.description.presence || t("nav.recurring")) %>"
                          title="<%= rt.active? ? t("recurring.deactivate") : t("recurring.activate") %>"
                          onclick="RecurringUI.toggleActive(this)">
                    <i class="bi bi-power"></i>
                  </button>
                  <button type="button" class="btn btn-outline-danger btn-sm me-1" data-testid="delete"
                          aria-label="<%= t("recurring.delete_action", name: rt.description.presence || t("nav.recurring")) %>"
                          onclick="RecurringUI.confirmDelete(this)">
                    <i class="bi bi-trash"></i>
                  </button>
                  <% if status == :pending %>
                    <button type="button" class="btn btn-primary btn-sm" data-testid="process"
                            onclick="RecurringUI.openProcessModal(this.closest('tr'))">
                      <i class="bi bi-cash-coin me-1"></i><%= rt.action_label %>
                    </button>
                  <% elsif status == :completed %>
                    <button type="button" class="btn btn-outline-secondary btn-sm disabled" data-testid="process-disabled"
                            data-bs-toggle="tooltip" data-bs-placement="top"
                            title="<%= t("monthly_incomes.received_tooltip") %>" tabindex="-1" aria-disabled="true">
                      <i class="bi bi-check-lg me-1"></i><%= rt.action_label %>
                    </button>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>

<!-- Create / Edit modal -->
<div class="modal fade" id="recurringFormModal" tabindex="-1" aria-labelledby="recurringFormTitle" aria-hidden="true"
     data-testid="form-modal">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <%= form_with model: @recurring_template, local: true, id: "recurringForm" do |f| %>
        <div class="modal-header">
          <h5 class="modal-title" id="recurringFormTitle"><%= t("monthly_incomes.form.add_title") %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("common.close") %>"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <%= f.label :category_id, t("common.category"), class: "form-label" %>
              <%= f.collection_select :category_id, @categories, :id, :name,
                                      { prompt: t("recurring.select_category") },
                                      class: "form-select #{field_class(@recurring_template, :category_id)}", required: true %>
              <div class="invalid-feedback"><%= field_error(@recurring_template, :category_id) %></div>
            </div>
            <div class="col-md-6" id="typeField">
              <%= f.label :kind, t("common.type"), class: "form-label" %>
              <%= f.select :kind,
                           options_for_select(RecurringTemplate::TRANSACTION_TYPES.map { |t| [t.humanize, t] }, @kind),
                           { prompt: t("categories.select_type") },
                           class: "form-select #{field_class(@recurring_template, :kind)}", required: true %>
              <div class="invalid-feedback"><%= field_error(@recurring_template, :kind) %></div>
            </div>
            <div class="col-md-6">
              <%= f.label :description, t("common.description"), class: "form-label" %>
              <%= f.text_field :description, class: "form-control #{field_class(@recurring_template, :description)}",
                               maxlength: 255, placeholder: "e.g. Freelance Job" %>
              <div class="invalid-feedback"><%= field_error(@recurring_template, :description) %></div>
            </div>
            <div class="col-md-6">
              <%= f.label :amount, t("monthly_incomes.columns.monthly_amount"), class: "form-label" %>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <%= f.text_field :amount,
                                 value: money_field_value(@recurring_template.amount),
                                 class: "form-control #{field_class(@recurring_template, :amount)}",
                                 required: true,
                                 placeholder: t("expenses.placeholder_amount"),
                                 inputmode: "decimal",
                                 autocomplete: "off",
                                 data: { money_input: true } %>
              </div>
              <div class="invalid-feedback"><%= field_error(@recurring_template, :amount) %></div>
            </div>
            <div class="col-md-6">
              <%= f.label :payment_day, t("recurring.expected_payment_day"), class: "form-label" %>
              <%= f.number_field :payment_day, class: "form-control #{field_class(@recurring_template, :payment_day)}",
                                 min: 1, max: 31, required: true, placeholder: "1-31" %>
              <div class="invalid-feedback"><%= field_error(@recurring_template, :payment_day) %></div>
            </div>
            <div class="col-md-6">
              <%= f.label :money_source_id, t("nav.money_sources"), class: "form-label" %>
              <%= f.collection_select :money_source_id, @money_sources, :id, :display_name,
                                      { include_blank: t("common.none") },
                                      class: "form-select" %>
            </div>
            <div class="col-md-6 d-flex align-items-end">
              <div class="form-check form-switch">
                <%= f.check_box :active, class: "form-check-input", role: "switch", id: "recurring_active_switch" %>
                <%= f.label :active, t("common.active"), class: "form-check-label", for: "recurring_active_switch" %>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("common.cancel") %></button>
          <%= f.submit t("common.save"), class: "btn btn-primary", data: { testid: "save-recurring" } %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Receive / Pay confirmation modal -->
<div class="modal fade" id="processModal" tabindex="-1" aria-labelledby="processTitle" aria-hidden="true"
     data-testid="process-modal">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <form id="processForm" method="post" data-turbo="false">
        <div class="modal-header">
          <h5 class="modal-title" id="processTitle"><%= t("recurring.confirm_receive") %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("common.close") %>"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label text-muted small mb-0"><%= t("common.category") %></label>
            <p class="form-control-plaintext fw-bold" id="processCategory"></p>
          </div>
          <div class="mb-3">
            <label class="form-label text-muted small mb-0"><%= t("common.description") %></label>
            <p class="form-control-plaintext" id="processDescription"></p>
          </div>
          <div class="mb-3">
            <label class="form-label text-muted small mb-0"><%= t("recurring.configured_amount") %></label>
            <p class="form-control-plaintext" id="processConfiguredAmount"></p>
          </div>
          <div class="mb-3">
            <label for="processDate" class="form-label"><%= t("recurring.transaction_date") %></label>
            <input type="date" class="form-control" id="processDate" name="date" required>
          </div>
          <div class="mb-3">
            <label for="processAmount" class="form-label"><%= t("common.amount") %></label>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <input type="text" class="form-control" id="processAmount" name="amount"
                     inputmode="decimal" autocomplete="off" data-money-input="true" required>
            </div>
            <div class="form-text"><%= t("recurring.amount_hint") %></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t("recurring.back") %></button>
          <button type="submit" class="btn btn-success" id="processConfirm" data-testid="confirm-process"><%= t("common.confirm") %></button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Delete confirmation modal -->
<div class="modal fade" id="deleteRtModal" tabindex="-1" aria-labelledby="deleteRtTitle" aria-hidden="true">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteRtTitle"><%= t("monthly_incomes.delete_confirmation_title") %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("common.close") %>"></button>
      </div>
      <div class="modal-body"><%= t("monthly_incomes.delete_confirmation_body") %></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t("common.cancel") %></button>
        <button type="button" class="btn btn-danger" id="confirmDeleteRt" data-testid="confirm-delete"><%= t("common.delete") %></button>
      </div>
    </div>
  </div>
</div>

<% if @open_form_modal %>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      RecurringUI.openFormModal(<%= @recurring_template.persisted? ? "'edit'" : "'create'" %>);
    });
  </script>
<% end %>

<script>
(function () {
  if (window.RecurringUI) return;

  var formModal, processModal, deleteModal;
  var currentRow = null;

  function $(sel) { return document.querySelector(sel); }

  function initModals() {
    formModal = bootstrap.Modal.getOrCreateInstance("#recurringFormModal");
    processModal = bootstrap.Modal.getOrCreateInstance("#processModal");
    deleteModal = bootstrap.Modal.getOrCreateInstance("#deleteRtModal");
  }

  function setFormMode(mode, row) {
    var isEdit = mode === "edit";
    var form = $("#recurringForm");
    var typeSelect = $("#recurring_template_kind");

    $("#recurringFormTitle").textContent = isEdit ? <%= t("monthly_incomes.form.edit_title").to_json %> : <%= t("monthly_incomes.form.add_title").to_json %>;

    // A hand-pointed form needs an explicit _method override for updates.
    var methodInput = form.querySelector('input[name="_method"]');
    if (isEdit) {
      if (!methodInput) {
        methodInput = document.createElement("input");
        methodInput.type = "hidden";
        methodInput.name = "_method";
        form.appendChild(methodInput);
      }
      methodInput.value = "patch";
    } else if (methodInput) {
      methodInput.remove();
    }

    if (isEdit && row) {
      form.action = row.dataset.editUrl;
      $("#recurring_template_category_id").value = row.dataset.categoryId;
      typeSelect.value = row.dataset.type;
      typeSelect.disabled = true; // type is immutable after creation
      $("#recurring_template_description").value = row.dataset.description || "";
      $("#recurring_template_amount").value = row.dataset.amount;
      if (window.MoneyInputs) window.MoneyInputs.formatField($("#recurring_template_amount"), true);
      $("#recurring_template_payment_day").value = row.dataset.paymentDay;
      $("#recurring_template_money_source_id").value = row.dataset.moneySourceId || "";
      $("#recurring_active_switch").checked = row.dataset.active === "true";
    } else if (!isEdit) {
      form.action = "<%= recurring_templates_path %>";
      form.reset();
      typeSelect.disabled = false;
      typeSelect.value = "<%= j @kind %>";
      $("#recurring_template_money_source_id").value = "";
      $("#recurring_active_switch").checked = true;
    }
  }

  window.RecurringUI = {
    openFormModal: function (mode, row) {
      initModals();
      setFormMode(mode, row);
      formModal.show();
    },

    openProcessModal: function (row) {
      initModals();
      currentRow = row;
      var isIncome = row.dataset.type === "income";

      $("#processTitle").textContent = isIncome ? <%= t("recurring.confirm_receive").to_json %> : <%= t("recurring.confirm_pay", default: "Confirmar pago").to_json %>;
      $("#processConfirm").textContent = isIncome ? <%= t("monthly_incomes.receive").to_json %> : <%= t("monthly_expenses.pay", default: "Pagar").to_json %>;
      $("#processCategory").textContent =
        row.querySelector("td .badge").textContent;
      $("#processDescription").textContent = row.cells[1].textContent.trim();
      $("#processConfiguredAmount").textContent = row.cells[2].textContent.trim();

      var today = new Date();
      var pad = function (n) { return String(n).padStart(2, "0"); };
      $("#processDate").value = today.getFullYear() + "-" + pad(today.getMonth() + 1) + "-" + pad(today.getDate());
      $("#processAmount").value = parseFloat(row.dataset.amount).toFixed(2);
      if (window.MoneyInputs) window.MoneyInputs.formatField($("#processAmount"), true);

      var form = $("#processForm");
      form.action = row.dataset.processUrl;

      // Rails needs the authenticity token on this hand-built form.
      if (!form.querySelector('input[name="authenticity_token"]')) {
        var token = document.querySelector('meta[name="csrf-token"]');
        var input = document.createElement("input");
        input.type = "hidden";
        input.name = "authenticity_token";
        input.value = token ? token.content : "";
        form.appendChild(input);
      }

      processModal.show();
    },

    confirmDelete: function (button) {
      initModals();
      currentRow = button.closest("tr");
      deleteModal.show();
    },

    toggleActive: function (button) {
      var row = button.closest("tr");
      var form = document.createElement("form");
      form.method = "post";
      form.action = row.dataset.toggleUrl;
      form.innerHTML =
        '<input type="hidden" name="_method" value="patch">' +
        '<input type="hidden" name="authenticity_token" value="' +
        (document.querySelector('meta[name="csrf-token"]') || {}).content + '">';
      document.body.appendChild(form);
      form.submit();
    }
  };

  document.addEventListener("click", function (e) {
    if (e.target.id !== "confirmDeleteRt" || !currentRow) return;
    var form = document.createElement("form");
    form.method = "post";
    form.action = currentRow.dataset.deleteUrl;
    form.innerHTML =
      '<input type="hidden" name="_method" value="delete">' +
      '<input type="hidden" name="authenticity_token" value="' +
      (document.querySelector('meta[name="csrf-token"]') || {}).content + '">';
    document.body.appendChild(form);
    deleteModal.hide();
    form.submit();
  });

  document.addEventListener("DOMContentLoaded", function () {
    var tooltips = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltips.forEach(function (el) { new bootstrap.Tooltip(el); });
  });
})();
</script>
