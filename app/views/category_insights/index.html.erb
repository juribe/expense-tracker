<%= render "shared/page_header", title: "Insight de ahorro" do %>
  <%= link_to categories_path, class: "btn btn-outline-secondary" do %>
    <i class="ti ti-arrow-left me-1"></i>Categorías
  <% end %>
<% end %>

<div class="card border-0">
  <div class="card-body">
    <% if @categories.any? %>
      <ul class="list-group list-group-flush">
        <% @categories.each do |row| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <strong><%= row[:category].name %></strong>
              <small class="text-muted d-block">
                Potencial: <%= row[:category].savings_potential %> ·
                Gasto promedio: <%= MoneyFormat.currency(row[:average]) %>
              </small>
            </div>
            <%= link_to "Ver insight", category_insight_path(row[:category]), class: "btn btn-outline-primary btn-sm" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-muted mb-0">No hay categorías con oportunidad de ahorro configurada.</p>
    <% end %>
  </div>
</div>
