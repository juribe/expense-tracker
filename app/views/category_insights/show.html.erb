<div class="container-fluid py-4" style="max-width: 960px; margin: 0 auto;">
  <div class="card border-0 mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h4 class="mb-0"><i class="ti ti-bulb me-2"></i>Oportunidad de ahorro</h4>
      <%= link_to categories_path, class: "btn btn-outline-secondary btn-sm" do %>
        <i class="ti ti-arrow-left me-1"></i>Volver
      <% end %>
    </div>
    <div class="card-body">
      <h5 class="mb-3"><%= @category.name %></h5>
      <dl class="row mb-0">
        <dt class="col-sm-4">Potencial de ahorro</dt>
        <dd class="col-sm-8"><%= savings_potential_label(@category.savings_potential).presence || "—" %></dd>

        <dt class="col-sm-4">Gasto promedio</dt>
        <dd class="col-sm-8">
          <% if @insight[:average_spending].present? %>
            <%= MoneyFormat.currency(@insight[:average_spending]) %> por ciclo financiero
          <% else %>
            Sin historial suficiente
          <% end %>
        </dd>

        <dt class="col-sm-4">Reducción sugerida</dt>
        <dd class="col-sm-8">
          <% if @insight[:suggested_rate].present? %>
            <%= @insight[:suggested_rate].to_i %>%
          <% else %>
            No configurada
          <% end %>
        </dd>

        <dt class="col-sm-4">Ahorro estimado</dt>
        <dd class="col-sm-8">
          <% if @insight[:estimated_savings].present? %>
            <%= MoneyFormat.currency(@insight[:estimated_savings]) %> por ciclo
          <% else %>
            —
          <% end %>
        </dd>
      </dl>
      <p class="text-muted small mt-3 mb-0">
        El ahorro estimado se calcula multiplicando el gasto promedio de los últimos
        <%= @insight[:completed_cycles] %> ciclos financieros completos por la reducción sugerida.
        Es una estimación, no una garantía de ahorro.
      </p>
    </div>
  </div>

  <div class="card border-0">
    <div class="card-header">
      <h5 class="mb-0"><i class="ti ti-message me-2"></i>Consejos de ahorro</h5>
    </div>
    <div class="card-body">
      <% if @insight[:tips].any? %>
        <ul class="mb-0">
          <% @insight[:tips].each do |tip| %>
            <li class="mb-2">
              <strong><%= tip.title %></strong>
              <br>
              <span class="text-muted"><%= tip.body %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-muted mb-0">No hay consejos configurados para esta subcategoría.</p>
      <% end %>
    </div>
  </div>
</div>
