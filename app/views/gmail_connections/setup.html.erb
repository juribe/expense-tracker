<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><i class="bi bi-magic me-2"></i><%= t("gmail.setup.title") %></h1>
  <%= link_to gmail_connection_path, class: "btn btn-outline-secondary btn-sm" do %>
    <i class="bi bi-arrow-left me-1"></i><%= t("gmail.setup.back") %>
  <% end %>
</div>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card mb-4">
      <div class="card-body">
        <h2 class="h5 card-title"><i class="bi bi-sliders me-1"></i><%= t("gmail.setup.criteria_title") %></h2>
        <p class="text-muted small">
          <%= t("gmail.setup.criteria_help",
                scanned: @suggestions["scanned"].to_i, passed: @suggestions["passed"].to_i) %>
        </p>

        <%= form_with model: @connection, url: gmail_connection_path, method: :patch, scope: :search_config do |f| %>
          <input type="hidden" name="next" value="recognition">

          <div class="mb-3">
            <%= f.label :senders, t("gmail.senders"), class: "form-label small mb-1" %>
            <%= f.text_area :senders, rows: 2, class: "form-control form-control-sm",
                  placeholder: "notifications@bancolombia.com.co",
                  value: values_from(@suggestions, "senders").join(", ") %>
            <div class="form-text small">
              <%= t("gmail.setup.senders_hint", count: values_from(@suggestions, "senders").size) %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :domains, t("gmail.domains"), class: "form-label small mb-1" %>
            <%= f.text_area :domains, rows: 2, class: "form-control form-control-sm",
                  placeholder: "bancolombia.com.co",
                  value: values_from(@suggestions, "domains").join(", ") %>
          </div>

          <div class="mb-3">
            <%= f.label :subject_keywords, t("gmail.subject_keywords"), class: "form-label small mb-1" %>
            <%= f.text_area :subject_keywords, rows: 2, class: "form-control form-control-sm",
                  placeholder: "compra, transacción, pago",
                  value: values_from(@suggestions, "subject_keywords").join(", ") %>
            <div class="form-text small"><%= t("gmail.setup.keywords_hint") %></div>
          </div>

          <div class="d-flex gap-2">
            <%= f.submit t("gmail.setup.apply"), class: "btn btn-primary" %>
          </div>
        <% end %>

        <%# IMPORTANT: rendered OUTSIDE the form above — a nested form is
            invalid HTML, and its hidden CSRF token would corrupt the outer
            form's authenticity_token. %>
        <%= button_to setup_sync_gmail_connection_path, method: :post, class: "btn btn-outline-secondary btn-sm",
              form: { data: { turbo_confirm: t("gmail.setup.rescan_confirm") } } do %>
          <i class="bi bi-arrow-repeat me-1"></i><%= t("gmail.setup.rescan") %>
        <% end %>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <h2 class="h5 card-title"><i class="bi bi-1-circle me-1"></i><%= t("gmail.setup.step1_title") %></h2>
        <p class="text-muted small mb-0">
          <%= t("gmail.setup.step1_help") %>
        </p>
      </div>
    </div>
  </div>
</div>
