<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><i class="bi bi-envelope-paper me-2"></i><%= t("gmail.title") %></h1>
  <% if @connection&.active? %>
    <%= button_to sync_gmail_connection_path, method: :post, class: "btn btn-outline-primary",
          form: { data: { turbo_confirm: t("gmail.fetch_confirm") } },
          data: { turbo_submits_with: "<span class='spinner-border spinner-border-sm me-1'></span>#{t('gmail.syncing')}",
                  sync_status_path: gmail_sync_status_path } do %>
      <i class="bi bi-arrow-repeat me-1"></i><%= t("gmail.sync_now") %>
    <% end %>
  <% end %>
</div>

<% unless @configured %>
  <div class="alert alert-warning">
    <strong><%= t("gmail.oauth_missing") %></strong>
    Set <code>GOOGLE_CLIENT_ID</code> and <code>GOOGLE_CLIENT_SECRET</code> (Google Cloud console,
    Gmail API enabled, redirect URI <code>&lt;app-url&gt;/auth/google/callback</code>) to enable connections.
  </div>
<% end %>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="card mb-4">
      <div class="card-body">
        <h2 class="h5 card-title"><i class="bi bi-link-45deg me-1"></i><%= t("gmail.connection") %></h2>
        <% if @connection %>
          <p class="mb-1">
            <i class="bi bi-envelope-check me-1 text-success"></i>
            <strong><%= @connection.email %></strong>
            <span class="badge bg-<%= @connection.active? ? 'success' : 'secondary' %>">
              <%= @connection.active? ? t("gmail.active") : t("gmail.paused") %>
            </span>
          </p>
          <p class="text-muted small mb-3">
            <%= t("gmail.last_synced") %>:
            <%= @connection.last_synced_at ? l(@connection.last_synced_at, format: :long) : t("gmail.never") %>
          </p>
          <div class="d-flex gap-2">
            <%= button_to t("gmail.disconnect"), gmail_connection_path, method: :delete,
                  class: "btn btn-outline-danger btn-sm",
                  form: { data: { turbo_confirm: t("gmail.disconnect_confirm", email: @connection.email) } } %>
          </div>
        <% else %>
          <p class="text-muted"><%= t("gmail.connect_help") %></p>
          <%= button_to start_gmail_auth_path, method: :post, class: "btn btn-primary",
                disabled: !@configured do %>
            <i class="bi bi-google me-1"></i><%= t("gmail.connect") %>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if @connection %>
      <div class="card">
        <div class="card-body">
          <h2 class="h5 card-title"><i class="bi bi-sliders me-1"></i><%= t("gmail.criteria") %></h2>
          <p class="text-muted small">
            <%= t("gmail.criteria_help") %>
          </p>
          <%= form_with model: @connection, url: gmail_connection_path, method: :patch, scope: :search_config do |f| %>
            <div class="mb-2">
              <%= f.label :senders, t("gmail.senders"), class: "form-label small mb-1" %>
              <%= f.text_area :senders, rows: 2, class: "form-control form-control-sm",
                    placeholder: "notifications@bancolombia.com.co, alerts@nequi.co",
                    value: @connection.search_config_hash[:senders].join(", ") %>
            </div>
            <div class="mb-2">
              <%= f.label :domains, t("gmail.domains"), class: "form-label small mb-1" %>
              <%= f.text_area :domains, rows: 2, class: "form-control form-control-sm",
                    placeholder: "bank.com, creditcard.bank.com",
                    value: @connection.search_config_hash[:domains].join(", ") %>
            </div>
            <div class="mb-3">
              <%= f.label :subject_keywords, t("gmail.subject_keywords"), class: "form-label small mb-1" %>
              <%= f.text_area :subject_keywords, rows: 2, class: "form-control form-control-sm",
                    placeholder: "compra, transacción, pago",
                    value: @connection.search_config_hash[:subject_keywords].join(", ") %>
            </div>
            <%= f.submit t("gmail.save_criteria"), class: "btn btn-sm btn-primary" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="col-lg-7">
    <% if @pending_reviews.any? %>
      <div class="card mb-4 border-warning">
        <div class="card-body">
          <h2 class="h5 card-title"><i class="bi bi-eye me-1"></i><%= t("gmail.pending_review") %>
            <span class="badge bg-warning text-dark"><%= @pending_reviews.size %></span></h2>
          <p class="text-muted small"><%= t("gmail.pending_help") %></p>
          <div class="table-responsive">
            <table class="table table-sm align-middle" data-testid="review-table">
              <thead>
                <tr><th><%= t("gmail.merchant") %></th><th><%= t("common.amount") %></th><th><%= t("common.date") %></th><th><%= t("gmail.confidence") %></th><th><%= t("gmail.card_bank") %></th><th></th></tr>
              </thead>
              <tbody>
                <% @pending_reviews.each do |review| %>
                  <% (review.payload_data["transactions"] || []).each do |t| %>
                    <% candidate_sources = Array(MoneySources::Match.call(user: current_user, card_last_four: t["card_last_four"], bank: t["bank"])) %>
                    <tr data-testid="review-row">
                      <td><%= t["merchant"] %> <span class="badge bg-light text-dark"><%= t["type"] %></span></td>
                      <td><%= number_to_currency(t["amount"].to_f, unit: "$ ", delimiter: ",", separator: ".") %></td>
                      <td><%= t["occurred_at"]&.to_s&.first(10) %></td>
                      <td><%= "#{(t['confidence'].to_f * 100).round}%".html_safe %></td>
                      <td>
                        <% if t["card_last_four"].present? %>
                          <span class="badge bg-light text-dark"><i class="bi bi-credit-card me-1"></i>****<%= t["card_last_four"] %></span>
                        <% end %>
                        <% if t["bank"].present? %>
                          <span class="badge bg-light text-dark"><i class="bi bi-bank me-1"></i><%= t["bank"] %></span>
                        <% end %>
                        <% if candidate_sources.one? %>
                          <div class="small text-success mt-1"><i class="bi bi-check-circle me-1"></i><%= candidate_sources.first.display_name %></div>
                        <% elsif candidate_sources.many? %>
                          <div class="small text-warning mt-1"><i class="bi bi-exclamation-triangle me-1"></i><%= t("gmail.ambiguous_match", default: "Ambiguous match") %>: <%= candidate_sources.map(&:display_name).join(", ") %></div>
                        <% end %>
                      </td>
                      <td class="text-end">
                        <%= button_to t("gmail.approve"), approve_gmail_review_path(review.id), method: :post,
                              class: "btn btn-success btn-sm me-1" %>
                        <%= button_to t("gmail.discard"), reject_gmail_review_path(review.id), method: :post,
                              class: "btn btn-outline-secondary btn-sm",
                              form: { data: { turbo_confirm: t("gmail.discard_confirm") } } %>
                      </td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% end %>

    <div class="card mb-4">
      <div class="card-body">
        <h2 class="h5 card-title"><i class="bi bi-clock-history me-1"></i><%= t("gmail.recent_imports") %></h2>
        <% if @recent_imports.any? %>
          <ul class="list-group list-group-flush" data-testid="recent-imports">
            <% @recent_imports.each do |expense| %>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>
                  <%= link_to expense.description.presence || t("gmail.no_description"), expense_path(expense) %>
                  <small class="text-muted d-block"><%= expense.date %></small>
                </span>
                <strong><%= number_to_currency(expense.amount.to_f, unit: "$ ", delimiter: ",", separator: ".") %></strong>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-muted mb-0" data-testid="no-imports"><%= t("gmail.no_imports") %></p>
        <% end %>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <h2 class="h5 card-title"><i class="bi bi-gear me-1"></i><%= t("gmail.how_it_works") %></h2>
        <ol class="text-muted small mb-2">
          <li>Your Gmail account is linked with Google OAuth (read-only scope).</li>
          <li>A background job polls the account every <%= @polling_interval %> minute(s)
              (<code>GMAIL_SYNC_INTERVAL_MINUTES</code>) searching transaction notifications.</li>
          <li>An AI model extracts amount, merchant, date and category from each candidate email.</li>
          <li>High-confidence purchases create expenses automatically; anything uncertain is queued above.</li>
          <li>Every email is tracked by message ID, so nothing is ever imported twice.</li>
        </ol>
      </div>
    </div>
  </div>
</div>
