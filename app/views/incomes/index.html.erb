<% subtitle = capture do %>
  <%= t("incomes.index.subtitle") %>
  <% if @cycle_filter %>
    <span class="badge bg-light text-dark border ms-2" data-testid="cycle-badge">
      <i class="ti ti-calendar-plus me-1"></i><%= @cycle_filter.label %> (<%= @cycle_filter.range_label %>)
    </span>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("incomes.index.title"), subtitle: subtitle do %>
  <div class="d-flex gap-2">
    <%= link_to monthly_incomes_path, class: "btn btn-outline-secondary" do %>
      <i class="ti ti-arrow-down-circle me-1"></i> <%= t("incomes.index.monthly_income") %>
    <% end %>
    <%= link_to new_income_path, class: "btn btn-primary" do %>
      <i class="ti ti-plus me-1"></i> <%= t("incomes.index.add_income") %>
    <% end %>
  </div>
<% end %>
  <div class="d-flex justify-content-between align-items-baseline mb-3">
    <p class="results-meta mb-0" id="resultsMeta" aria-live="polite">
      <%= t("incomes.count", count: @incomes.count) %>
    </p>
    <span class="small text-muted d-none d-md-inline"><%= t("incomes.index.recent") %></span>
  </div>

  <% if @incomes.any? %>
    <div class="card">
      <div class="table-responsive">
        <table class="table table-hover ledger-table align-middle mb-0" id="incomeTable">
          <caption class="visually-hidden"><%= t("incomes.index.caption") %></caption>
          <thead class="table-light">
            <tr>
              <th scope="col"><%= t("incomes.index.columns.date") %></th>
              <th scope="col"><%= t("incomes.index.columns.category") %></th>
               <th scope="col"><%= t("incomes.index.columns.description") %></th>
               <th scope="col" class="text-end"><%= t("incomes.index.columns.amount") %></th>
               <th scope="col" class="text-end"><%= t("common.actions") %></th>
             </tr>
          </thead>
          <tbody>
            <% @incomes.each do |income| %>
              <tr data-testid="row" data-id="<%= income.id %>">
                <td class="text-nowrap"><%= l(income.date, format: :short) %></td>
                <td><%= category_badge(income.category) %></td>
                <td class="desc-cell" title="<%= income.description %>">
                  <% if income.description.present? %>
                    <%= income.description %>
                  <% else %>
                    <span class="text-muted"><%= t("incomes.index.no_description") %></span>
                  <% end %>
                </td>
                 <td class="text-end fw-bold amount text-success"><%= number_to_currency(income.amount) %></td>
                 <td class="text-end text-nowrap">
                   <%= link_to edit_income_path(income), class: "btn btn-sm btn-outline-primary me-1" do %>
                     <i class="ti ti-pencil"></i>
                   <% end %>
                   <%= button_to income_path(income), method: :delete, class: "btn btn-sm btn-outline-danger",
                                 data: { turbo_confirm: t("incomes.delete_confirm", default: "¿Eliminar este ingreso?") },
                                 form: { class: "d-inline", data: { turbo: true } } do %>
                     <i class="ti ti-trash"></i>
                   <% end %>
                 </td>
               </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="card">
      <div class="p-5 text-center" data-testid="empty">
        <i class="ti ti-cash display-4 text-muted mb-3 d-block"></i>
        <h4 class="mb-2"><%= t("incomes.index.empty.title") %></h4>
        <p class="text-muted mb-0"><%= t("incomes.index.empty.body") %></p>
        <%= link_to new_income_path, class: "btn btn-primary mt-3" do %>
          <i class="ti ti-plus me-1"></i><%= t("incomes.index.add_income") %>
        <% end %>
      </div>
    </div>
  <% end %>

<%= render "shared/process_recurring_modal",
           modal_id: "incomeProcessModal",
           title_id: "incomeProcessTitle",
           title: t("recurring.confirm_receive", default: "Confirmar Recibo"),
           form_id: "incomeProcessForm",
           category_id: "incomeProcessCategory",
           description_id: "incomeProcessDescription",
           configured_amount_id: "incomeProcessConfiguredAmount",
           date_input_id: "incomeProcessDate",
           amount_input_id: "incomeProcessAmount",
           confirm_id: "incomeProcessConfirm",
           confirm_testid: "confirm-income-process",
            confirm_label: t("recurring.confirm_receive"),
            confirm_class: "btn-primary",
           back_label: t("recurring.back"),
           amount_hint: t("recurring.amount_hint"),
           testid: "income-process-modal" %>

<%= tag.div class: "d-none", data: { income_process_payload: {
      no_description: t("incomes.index.no_description"),
      confirm_title: t("recurring.confirm_receive", default: "Confirmar Recibo"),
      today: Date.current.strftime("%F")
} } %>
<%= javascript_include_tag "income_process_modal", defer: true %>

