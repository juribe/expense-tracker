<%= form_with model: @income, local: true do |f| %>
  <% if @income.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@income.errors.count, "error") %> prohibited this income from being saved:</h2>

      <ul>
        <% @income.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :amount, "Amount *", class: "form-label" %>
    <%= f.number_field :amount, step: "0.01", min: 0.01, class: "form-control", placeholder: "0.01" %>
  </div>

  <div class="mb-3">
    <%= f.label :description, "Description" , class: "form-label" %>
    <%= f.text_field :description, class: "form-control", placeholder: "e.g. Salary, Freelance project" %>
  </div>

  <div class="mb-3">
    <%= f.label :date, "Date *", class: "form-label" %>
    <%= f.date_field :date, value: Date.current, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :category_id, "Category" , class: "form-label" %>
    <%= f.collection_select :category_id, Category.all, :id, :name, include_blank: true, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :frequency, "Frequency" , class: "form-label" %>
    <%= f.select :frequency, [["One time", "one_time"], ["Monthly", "monthly"], ["Weekly", "weekly"]], { include_blank: true }, class: "form-select" %>
  </div>

  <div class="d-grid gap-2 d-md-flex justify-content-md-end">
    <%= f.submit "Create Income", class: "btn btn-primary" %>
    <%= link_to "Cancel", incomes_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>