<% content_for :title, "#{t("auth.forgot_password")} | #{t("layout.app_title")}" %>

<% if @success_notice %>
  <div class="auth-heading">
    <h1><%= t("devise.passwords.check_inbox_title", default: "Revisa tu bandeja de entrada") %></h1>
    <p><%= t("devise.passwords.check_inbox_subtitle", default: "Te enviamos las instrucciones para recuperar tu cuenta.") %></p>
  </div>

  <div class="alert alert-success auth-alert" role="alert">
    <i class="ti ti-mail-opened" aria-hidden="true"></i>
    <%= @success_notice %>
  </div>

  <p class="auth-footer-link">
    <%= link_to t("auth.back_to_sign_in"), new_session_path(resource_name) %>
  </p>
<% else %>
  <div class="auth-heading">
    <h1><%= t("auth.forgot_password") %></h1>
    <p><%= t("auth.forgot_password_subtitle") %></p>
  </div>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="auth-field">
      <%= f.label :email, class: "auth-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth-input", placeholder: t("auth.email_placeholder") %>
    </div>

    <button type="submit" class="auth-submit">
      <span><%= t("devise.passwords.send_reset", default: "Enviar enlace de restablecimiento") %></span>
      <i class="ti ti-arrow-right" aria-hidden="true"></i>
    </button>
  <% end %>

  <p class="auth-footer-link">
    <%= t("devise.passwords.remembered", default: "¿Ya la recordaste?") %>
    <%= link_to t("auth.back_to_sign_in"), new_session_path(resource_name) %>
  </p>
<% end %>
