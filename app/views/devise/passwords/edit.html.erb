<% content_for :title, "#{t("devise.passwords.reset_title", default: "Restablece tu contraseña")} | #{AppName.current}" %>

<% if @success_notice %>
  <div class="auth-heading">
    <h1><%= t("devise.passwords.updated_title", default: "Contraseña actualizada") %></h1>
    <p><%= t("devise.passwords.updated_subtitle", default: "Ya puedes volver a usar tu cuenta.") %></p>
  </div>

  <div class="alert alert-success auth-alert" role="alert" data-auto-redirect-to="<%= root_path %>">
    <i class="ti ti-circle-check" aria-hidden="true"></i>
    <%= @success_notice %>
  </div>

  <p class="auth-redirect-note"><%= t("devise.passwords.redirecting", default: "Te redirigimos a tu panel…") %></p>
<% else %>
  <div class="auth-heading">
    <h1><%= t("devise.passwords.reset_title", default: "Restablece tu contraseña") %></h1>
    <p><%= t("auth.reset_password_subtitle") %></p>
  </div>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="auth-field">
      <div class="auth-label-row">
        <%= f.label :password, t("auth.new_password_label"), class: "auth-label" %>
        <% if @minimum_password_length %>
          <span class="auth-hint"><%= t("auth.minimum_password", count: @minimum_password_length) %></span>
        <% end %>
      </div>
      <div class="auth-input-wrap">
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "auth-input auth-input-password", placeholder: t("auth.new_password_placeholder") %>
        <button type="button" class="auth-toggle" data-toggle-pw-target="#user_password"
                aria-label="<%= t('auth.show_password') %>" title="<%= t('auth.show_password') %>">
          <i class="ti ti-eye"></i>
        </button>
      </div>
    </div>

    <div class="auth-field">
      <%= f.label :password_confirmation, t("auth.password_confirmation_label"), class: "auth-label" %>
      <div class="auth-input-wrap">
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth-input auth-input-password", placeholder: t("auth.password_repeat_placeholder") %>
        <button type="button" class="auth-toggle" data-toggle-pw-target="#user_password_confirmation"
                aria-label="<%= t('auth.show_password') %>" title="<%= t('auth.show_password') %>">
          <i class="ti ti-eye"></i>
        </button>
      </div>
    </div>

    <button type="submit" class="auth-submit">
      <span><%= t("devise.passwords.reset_button", default: "Restablecer contraseña") %></span>
      <i class="ti ti-arrow-right" aria-hidden="true"></i>
    </button>
  <% end %>

  <p class="auth-footer-link">
    <%= t("devise.passwords.remembered", default: "¿Ya la recordaste?") %>
    <%= link_to t("auth.back_to_sign_in"), new_session_path(resource_name) %>
  </p>
<% end %>
