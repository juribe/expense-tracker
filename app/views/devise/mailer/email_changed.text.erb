Correo electrónico cambiado

¡Hola, <%= MailerHelper.greeting_name(@resource) %>!

<% if @resource.try(:unconfirmed_email?) %>
<%= t("devise.mailer.email_changing", email: @resource.unconfirmed_email, default: "Te avisamos que tu correo se está cambiando a %{email}.") %>
<% else %>
<%= t("devise.mailer.email_changed", email: @resource.email, default: "Te avisamos que tu correo ha sido cambiado a %{email}.") %>
<% end %>