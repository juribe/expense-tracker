<p><%= t("devise.mailer.greeting", email: @resource.email, default: "¡Hola %{email}!") %></p>

<p><%= t("devise.mailer.reset_body", default: "Alguien solicitó un enlace para cambiar tu contraseña. Puedes hacerlo desde el enlace de abajo.") %></p>

<p><%= link_to t("devise.mailer.change_password", default: "Cambiar mi contraseña"), edit_password_url(@resource, reset_password_token: @token) %></p>

<p><%= t("devise.mailer.reset_ignore", default: "Si no solicitaste esto, ignora este correo.") %></p>
<p><%= t("devise.mailer.reset_note", default: "Tu contraseña no cambiará hasta que abras el enlace de arriba y crees una nueva.") %></p>
