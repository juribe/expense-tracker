<p><%= t("devise.mailer.greeting", email: @resource.email, default: "¡Hola %{email}!") %></p>

<p><%= t("devise.mailer.unlock_body", default: "Tu cuenta se bloqueó debido a demasiados intentos fallidos de acceso.") %></p>

<p><%= t("devise.mailer.unlock_prompt", default: "Haz clic en el enlace de abajo para desbloquear tu cuenta:") %></p>

<p><%= link_to t("devise.mailer.unlock_account", default: "Desbloquear mi cuenta"), unlock_url(@resource, unlock_token: @token) %></p>
