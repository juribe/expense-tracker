<p><%= t("devise.mailer.greeting", email: @email, default: "¡Hola %{email}!") %></p>

<% if @resource.try(:unconfirmed_email?) %>
  <p><%= t("devise.mailer.email_changing", email: @resource.unconfirmed_email, default: "Te avisamos que tu correo se está cambiando a %{email}.") %></p>
<% else %>
  <p><%= t("devise.mailer.email_changed", email: @resource.email, default: "Te avisamos que tu correo ha sido cambiado a %{email}.") %></p>
<% end %>
