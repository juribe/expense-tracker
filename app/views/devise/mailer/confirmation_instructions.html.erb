<p><%= t("devise.mailer.greeting", email: @email, default: "¡Hola %{email}!") %></p>

<p><%= t("devise.mailer.confirmation_body", default: "Puedes confirmar el correo de tu cuenta con el enlace de abajo:") %></p>

<p><%= link_to t("devise.mailer.confirm_account", default: "Confirmar mi cuenta"), confirmation_url(@resource, confirmation_token: @token) %></p>
