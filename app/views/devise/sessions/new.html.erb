<div class="row justify-content-center">
  <div class="col-12 col-md-6 col-lg-4">
    <div class="card shadow-sm my-5">
      <div class="card-body p-4 p-md-5">
        <h1 class="h3 mb-1 text-center fw-bold">Welcome back</h1>
        <p class="text-muted text-center mb-4">Sign in to your account to continue</p>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mb-3">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-lg", placeholder: "you@example.com" %>
          </div>

          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <%= f.label :password, class: "form-label mb-0" %>
              <%= link_to "Forgot password?", new_password_path(resource_name), class: "link-primary small text-decoration-none" %>
            </div>
            <div class="position-relative">
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control form-control-lg password-field", placeholder: "••••••••" %>
              <button type="button" class="btn btn-link position-absolute top-50 end-0 translate-middle-y toggle-pw"
                      data-toggle-pw-target="#user_password" aria-label="Show password">
                <i class="bi bi-eye"></i>
              </button>
            </div>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="form-check mb-3">
              <%= f.check_box :remember_me, class: "form-check-input" %>
              <%= f.label :remember_me, class: "form-check-label" %>
            </div>
          <% end %>

          <button type="submit" class="btn btn-primary btn-lg w-100">Sign In</button>
        <% end %>

        <p class="text-center mt-3 mb-0">
          Don't have an account? <%= link_to "Sign up", new_registration_path(resource_name), class: "link-secondary" %>
        </p>
      </div>
    </div>
  </div>
</div>

<%= render "devise/shared/auth_scripts" %>