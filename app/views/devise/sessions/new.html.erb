<% content_for :title, "#{t("auth.sign_in")} | #{AppName.current}" %>
<% content_for :head do %>
  <%= javascript_include_tag "devise/webauthn", type: "module" %>
  <%= javascript_include_tag "webauthn_ui", defer: true %>
  <%= stylesheet_link_tag :auth_webauthn, "data-turbo-track": "reload" %>
<% end %>

<div class="auth-heading">
  <h1><%= t("auth.sign_in") %></h1>
  <p><%= t("auth.sign_in_subtitle") %></p>
</div>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="auth-field">
    <%= f.label :email, class: "auth-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth-input", placeholder: t("auth.email_placeholder") %>
  </div>

  <div class="auth-field">
    <div class="auth-label-row">
      <%= f.label :password, class: "auth-label" %>
      <%= link_to t("auth.forgot_password"), new_password_path(resource_name), class: "auth-inline-link" %>
    </div>
    <div class="auth-input-wrap">
      <%= f.password_field :password, autocomplete: "current-password", class: "auth-input auth-input-password", placeholder: "••••••••" %>
      <button type="button" class="auth-toggle" data-toggle-pw-target="#user_password"
              aria-label="<%= t('auth.show_password') %>" title="<%= t('auth.show_password') %>">
        <i class="ti ti-eye"></i>
      </button>
    </div>
  </div>

  <% if devise_mapping.rememberable? %>
    <label class="auth-check">
      <%= f.check_box :remember_me, class: "auth-check-input" %>
      <span><%= t("auth.remember_me", default: "Recuérdame") %></span>
    </label>
  <% end %>

  <button type="submit" class="auth-submit">
    <span><%= t("auth.sign_in") %></span>
    <i class="ti ti-arrow-right" aria-hidden="true"></i>
  </button>
<% end %>

<div class="auth-divider auth-divider-labeled" data-testid="auth-divider">
  <span><%= t("auth.or_continue_other_way", default: "O continúa de otra manera") %></span>
</div>

<%= login_with_passkey_form_for(resource_name, data: { testid: "passkey-login-form" }) do |form| %>
  <%= form.button nil, type: "submit", class: "auth-passkey", data: { testid: "passkey-login" } do %>
    <i class="ti ti-fingerprint" aria-hidden="true"></i>
    <span><%= t("auth.continue_with_passkey", default: "Continuar con Passkey") %></span>
  <% end %>
<% end %>
<p class="auth-passkey-help"><%= t("auth.passkey_help", default: "Usa la huella, el rostro o el PIN de este dispositivo.") %></p>

<div class="auth-privacy">
  <i class="ti ti-shield-check" aria-hidden="true"></i>
  <span><%= t("auth.privacy") %></span>
</div>

<p class="auth-footer-link">
  <%= t("auth.sign_up_prompt") %>
  <%= link_to t("auth.sign_up"), new_registration_path(resource_name) %>
</p>
