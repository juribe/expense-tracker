<%- if controller_name != 'sessions' %>
  <p class="text-center mb-2">
    <%= link_to t("auth.log_in"), new_session_path(resource_name), class: "link-secondary" %>
  </p>
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <p class="text-center mb-2">
    <%= link_to t("auth.sign_up"), new_registration_path(resource_name), class: "link-secondary" %>
  </p>
<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <p class="text-center mb-2">
    <%= link_to t("auth.forgot_password"), new_password_path(resource_name), class: "link-primary small text-decoration-none" %>
  </p>
<% end %>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <p class="text-center mb-2">
    <%= link_to t("auth.resend_confirmation"), new_confirmation_path(resource_name), class: "link-secondary" %>
  </p>
<% end %>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <p class="text-center mb-2">
    <%= link_to t("auth.resend_unlock"), new_unlock_path(resource_name), class: "link-secondary" %>
  </p>
<% end %>

<%- if devise_mapping.omniauthable? %>
  <%- resource_class.omniauth_providers.each do |provider| %>
    <p class="text-center mb-2">
      <%= button_to t("auth.sign_in_with_provider", provider: OmniAuth::Utils.camelize(provider)), omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "btn btn-outline-secondary w-100" %>
    </p>
  <% end %>
<% end %>
