<% content_for :title, "#{t("auth.resend_confirmation")} | #{AppName.current}" %>

<div class="auth-heading">
  <h1><%= t("auth.resend_confirmation") %></h1>
  <p><%= t("auth.confirmation_prompt", default: "Te enviaremos nuevas instrucciones a tu correo.") %></p>
</div>

<%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="auth-field">
    <%= f.label :email, class: "auth-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth-input", placeholder: t("auth.email_placeholder"), value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email) %>
  </div>

  <button type="submit" class="auth-submit">
    <span><%= t("auth.resend_confirmation") %></span>
    <i class="ti ti-arrow-right" aria-hidden="true"></i>
  </button>
<% end %>

<div class="auth-links">
  <%= render "devise/shared/links" %>
</div>
