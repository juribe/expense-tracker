<% content_for :title, "#{t("auth.sign_up")} | #{AppName.current}" %>

<div class="auth-heading">
  <h1><%= t("auth.sign_up") %></h1>
  <p><%= t("auth.sign_up_subtitle") %></p>
</div>

<% if params[:trial].present? || session[:trial_intent] %>
  <div class="auth-field"><p>Estás creando tu cuenta para comenzar la prueba gratuita de <%= PaymentEngine::Configuration.free_trial_duration_days %> días.</p></div>
<% elsif params[:payment_option_id].present? || session[:pending_payment_option_id] %>
  <% po = PaymentEngine::PaymentOption.find_by(id: (params[:payment_option_id] || session[:pending_payment_option_id])) %>
  <% if po %><div class="auth-field"><p>Tu selección: <%= po.name %> — $<%= number_with_delimiter(po.price.to_i, delimiter: ".") %> <%= po.currency %></p></div><% end %>
<% end %>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
  <%= hidden_field_tag :trial, (params[:trial] || session[:trial_intent]) %>
  <%= hidden_field_tag :payment_option_id, (params[:payment_option_id] || session[:pending_payment_option_id]) %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="auth-field">
    <%= f.label :name, class: "auth-label" %>
    <%= f.text_field :name, autofocus: true, autocomplete: "name",
                     required: true, maxlength: User::NAME_MAX_LENGTH,
                     class: "auth-input", placeholder: t("auth.name_placeholder") %>
  </div>

  <div class="auth-field">
    <%= f.label :email, class: "auth-label" %>
    <%= f.email_field :email, autocomplete: "email", class: "auth-input", placeholder: t("auth.email_placeholder") %>
  </div>

  <div class="auth-field">
    <div class="auth-label-row">
      <%= f.label :password, class: "auth-label" %>
      <% if @minimum_password_length %>
        <span class="auth-hint"><%= t("auth.minimum_password", count: @minimum_password_length) %></span>
      <% end %>
    </div>
    <div class="auth-input-wrap">
      <%= f.password_field :password, autocomplete: "new-password", class: "auth-input auth-input-password", placeholder: t("auth.password_placeholder") %>
      <button type="button" class="auth-toggle" data-toggle-pw-target="#user_password"
              aria-label="<%= t('auth.show_password') %>" title="<%= t('auth.show_password') %>">
        <i class="ti ti-eye"></i>
      </button>
    </div>
  </div>

  <div class="auth-field">
    <%= f.label :password_confirmation, class: "auth-label" %>
    <div class="auth-input-wrap">
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth-input auth-input-password", placeholder: t("auth.password_repeat_placeholder") %>
      <button type="button" class="auth-toggle" data-toggle-pw-target="#user_password_confirmation"
              aria-label="<%= t('auth.show_password') %>" title="<%= t('auth.show_password') %>">
        <i class="ti ti-eye"></i>
      </button>
    </div>
  </div>

  <div class="auth-consents" data-testid="registration-consents">
    <div class="auth-consent">
      <%= f.check_box :terms_accepted, required: true, class: "auth-consent-input" %>
      <label for="user_terms_accepted" class="auth-consent-copy">
        <span><%= t("auth.consents.terms_prefix") %></span>
        <%= link_to t("auth.consents.terms_link"), "/terminos-y-condiciones",
                    target: "_blank", rel: "noopener" %>
      </label>
    </div>

    <div class="auth-consent">
      <%= f.check_box :privacy_accepted, required: true, class: "auth-consent-input" %>
      <label for="user_privacy_accepted" class="auth-consent-copy">
        <span><%= t("auth.consents.privacy_prefix") %></span>
        <%= link_to t("auth.consents.privacy_link"), "/privacidad",
                    target: "_blank", rel: "noopener" %>
        <span><%= t("auth.consents.privacy_suffix") %></span>
      </label>
    </div>

    <div class="auth-consent">
      <%= f.check_box :marketing_consent, class: "auth-consent-input" %>
      <label for="user_marketing_consent" class="auth-consent-copy">
        <span><%= t("auth.consents.marketing_label") %></span>
        <span class="auth-consent-optional"><%= t("auth.consents.optional") %></span>
      </label>
    </div>
  </div>

  <button type="submit" class="auth-submit">
    <span><%= t("auth.sign_up") %></span>
    <i class="ti ti-arrow-right" aria-hidden="true"></i>
  </button>
<% end %>

<div class="auth-privacy">
  <i class="ti ti-shield-check" aria-hidden="true"></i>
  <span><%= t("auth.privacy") %></span>
</div>

<div class="auth-divider"></div>

<p class="auth-footer-link">
  <%= t("auth.sign_in_prompt") %>
  <%= link_to t("auth.log_in"), new_session_path(resource_name) %>
</p>

<div class="auth-links">
  <%= render "devise/shared/secondary_links" %>
</div>
