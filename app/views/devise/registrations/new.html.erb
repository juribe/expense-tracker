<div class="row justify-content-center">
  <div class="col-12 col-md-6 col-lg-4">
    <div class="card shadow-sm my-5">
      <div class="card-body p-4 p-md-5">
        <h1 class="h3 mb-1 text-center fw-bold"><%= t("auth.sign_up") %></h1>
        <p class="text-muted text-center mb-4"><%= t("layout.app_title") %></p>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mb-3">
            <%= f.label :name, class: "form-label" %>
            <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "form-control", placeholder: t("auth.name_placeholder") %>
          </div>

          <div class="mb-3">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, autocomplete: "email", class: "form-control", placeholder: t("auth.email_placeholder") %>
          </div>

          <div class="mb-3">
            <%= f.label :password, class: "form-label" %>
            <% if @minimum_password_length %>
              <span class="text-muted small">(<%= t("auth.minimum_password", count: @minimum_password_length) %>)</span>
            <% end %>
            <div class="position-relative">
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control password-field", placeholder: t("auth.password_placeholder") %>
              <button type="button" class="btn btn-link position-absolute top-50 end-0 translate-middle-y toggle-pw"
                      data-toggle-pw-target="#user_password" aria-label="<%= t('auth.show_password') %>">
                <i class="bi bi-eye"></i>
              </button>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :password_confirmation, class: "form-label" %>
            <div class="position-relative">
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control password-field", placeholder: t("auth.password_repeat_placeholder") %>
              <button type="button" class="btn btn-link position-absolute top-50 end-0 translate-middle-y toggle-pw"
                      data-toggle-pw-target="#user_password_confirmation" aria-label="<%= t('auth.show_password') %>">
                <i class="bi bi-eye"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="btn btn-success btn-lg w-100"><%= t("auth.sign_up") %></button>
        <% end %>

        <p class="text-center mt-3 mb-0">
          <%= t("auth.sign_in_prompt") %> <%= link_to t("auth.sign_in"), new_session_path(resource_name), class: "link-secondary" %>
        </p>
      </div>
    </div>
  </div>
</div>

<%= render "devise/shared/auth_scripts" %>
