<% content_for :title, "#{t("auth.sign_up")} | #{AppName.current}" %>

<div class="auth-heading">
  <h1><%= t("auth.sign_up") %></h1>
  <p><%= t("auth.sign_up_subtitle") %></p>
</div>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="auth-field">
    <%= f.label :name, class: "auth-label" %>
    <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "auth-input", placeholder: t("auth.name_placeholder") %>
  </div>

  <div class="auth-field">
    <%= f.label :email, class: "auth-label" %>
    <%= f.email_field :email, autocomplete: "email", class: "auth-input", placeholder: t("auth.email_placeholder") %>
  </div>

  <div class="auth-field">
    <div class="auth-label-row">
      <%= f.label :password, class: "auth-label" %>
      <% if @minimum_password_length %>
        <span class="auth-hint"><%= t("auth.minimum_password", count: @minimum_password_length) %></span>
      <% end %>
    </div>
    <div class="auth-input-wrap">
      <%= f.password_field :password, autocomplete: "new-password", class: "auth-input auth-input-password", placeholder: t("auth.password_placeholder") %>
      <button type="button" class="auth-toggle" data-toggle-pw-target="#user_password"
              aria-label="<%= t('auth.show_password') %>" title="<%= t('auth.show_password') %>">
        <i class="ti ti-eye"></i>
      </button>
    </div>
  </div>

  <div class="auth-field">
    <%= f.label :password_confirmation, class: "auth-label" %>
    <div class="auth-input-wrap">
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth-input auth-input-password", placeholder: t("auth.password_repeat_placeholder") %>
      <button type="button" class="auth-toggle" data-toggle-pw-target="#user_password_confirmation"
              aria-label="<%= t('auth.show_password') %>" title="<%= t('auth.show_password') %>">
        <i class="ti ti-eye"></i>
      </button>
    </div>
  </div>

  <button type="submit" class="auth-submit">
    <span><%= t("auth.sign_up") %></span>
    <i class="ti ti-arrow-right" aria-hidden="true"></i>
  </button>
<% end %>

<div class="auth-privacy">
  <i class="ti ti-shield-check" aria-hidden="true"></i>
  <span><%= t("auth.privacy") %></span>
</div>

<div class="auth-divider"></div>

<p class="auth-footer-link">
  <%= t("auth.sign_in_prompt") %>
  <%= link_to t("auth.log_in"), new_session_path(resource_name) %>
</p>

<div class="auth-links">
  <%= render "devise/shared/secondary_links" %>
</div>
