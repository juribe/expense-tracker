<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="card shadow-sm my-5">
      <div class="card-body p-4 p-md-5">
        <h1 class="h3 mb-1 text-center fw-bold"><%= t("devise.registrations.edit_title", default: "Editar perfil") %></h1>
        <p class="text-muted text-center mb-4"><%= t("devise.registrations.edit_subtitle", default: "Actualiza la información de tu cuenta") %></p>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mb-3">
            <%= f.label :name, class: "form-label" %>
            <%= f.text_field :name, autocomplete: "name", class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, autocomplete: "email", class: "form-control" %>
          </div>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <div class="alert alert-info py-2"><%= t("auth.account_confirmation_waiting", email: resource.unconfirmed_email) %></div>
          <% end %>

          <div class="mb-3">
            <%= f.label :password, class: "form-label" %>
            <span class="text-muted small"><%= t("auth.password_change_blank") %></span>
            <div class="position-relative">
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control password-field", placeholder: t("auth.new_password_placeholder") %>
              <button type="button" class="btn btn-link position-absolute top-50 end-0 translate-middle-y toggle-pw"
                      data-toggle-pw-target="#user_password" aria-label="<%= t('auth.show_password') %>">
                <i class="bi bi-eye"></i>
              </button>
            </div>
            <% if @minimum_password_length %>
              <div class="form-text"><%= t("auth.minimum_password", count: @minimum_password_length) %></div>
            <% end %>
          </div>

          <div class="mb-3">
            <%= f.label :password_confirmation, class: "form-label" %>
            <div class="position-relative">
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control password-field", placeholder: t("auth.password_repeat_placeholder") %>
              <button type="button" class="btn btn-link position-absolute top-50 end-0 translate-middle-y toggle-pw"
                      data-toggle-pw-target="#user_password_confirmation" aria-label="<%= t('auth.show_password') %>">
                <i class="bi bi-eye"></i>
              </button>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :current_password, class: "form-label" %>
            <span class="text-muted small"><%= t("auth.current_password_required") %></span>
            <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control", placeholder: t("auth.current_password_placeholder") %>
          </div>

          <button type="submit" class="btn btn-primary w-100"><%= t("auth.update") %></button>
        <% end %>

        <hr class="my-4">

        <h2 class="h5 mb-2"><%= t("auth.cancel_account") %></h2>
        <p class="text-muted small"><%= t("devise.registrations.cancel_account_body", default: "Si no estás satisfecho con la aplicación, puedes eliminar tu cuenta permanentemente.") %></p>
        <div>
          <%= button_to t("auth.cancel_account"), registration_path(resource_name),
                data: { confirm: t("auth.cancel_account_prompt"), turbo_confirm: t("auth.cancel_account_prompt") },
                method: :delete, class: "btn btn-outline-danger w-100" %>
        </div>

        <p class="text-center mt-3 mb-0">
          <%= link_to t("auth.back"), :back, class: "link-secondary" %>
        </p>
      </div>
    </div>
  </div>
</div>

<%= render "devise/shared/auth_scripts" %>
