<%# Aggregated budget card for the resolved period. %>
<% if @budgets.any? %>
  <% summary = dashboard_budget_summary(@budgets, @budget_period, spent_by_category: @spending_by_category_id) %>
  <% used_pct = [ summary[:percentage], 100 ].min.round %>
  <section class="card dash-budget" data-testid="dashboard-budget">
    <div class="dash-card-head">
      <div>
        <h5 class="card-title"><%= t("dashboard.budget_cycle", default: "Presupuesto del ciclo") %></h5>
        <p class="dash-card-subtitle"><%= t("dashboard.budget_subtitle", default: "Qué parte de tu presupuesto has utilizado") %></p>
      </div>
      <%= link_to dashboard_budget_path, class: "dash-link" do %>
        <%= t("dashboard.view_budget", default: "Ver presupuesto") %><i class="ti ti-arrow-right" aria-hidden="true"></i>
      <% end %>
    </div>

    <div class="dash-budget-body">
      <div class="dash-budget-top">
        <div>
          <strong><%= t("dashboard.budget_spent", default: "Gasto registrado") %></strong>
          <small><%= t("dashboard.budget_total", default: "Presupuesto total del ciclo") %></small>
        </div>
        <div class="dash-budget-value">
          <%= number_to_currency(summary[:spent]) %>
          <small><%= t("dashboard.budget_of_total", default: "de %{amount}", amount: number_to_currency(summary[:total])) %></small>
        </div>
      </div>

      <div class="progress dash-budget-progress" role="progressbar"
           data-testid="dashboard-budget-progress"
           aria-label="<%= t("dashboard.budget_used_aria", default: "Presupuesto utilizado") %>"
           aria-valuenow="<%= summary[:percentage].round %>" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar <%= dashboard_budget_bar_class(summary[:status]) %> et-w-<%= used_pct %>"></div>
      </div>

      <div class="dash-budget-foot">
        <span><b><%= number_to_percentage(summary[:percentage], precision: 0) %></b> <%= t("dashboard.budget_used", default: "utilizado") %></span>
        <span><%= t("dashboard.budget_available", default: "%{amount} disponibles", amount: number_to_currency(summary[:remaining])) %></span>
      </div>
    </div>
  </section>
<% end %>
