<%# Recent expenses table card. Rows open the shared expense drawer. %>
<section class="card dash-movements-card" data-testid="dashboard-recent-expenses">
  <div class="dash-card-head">
    <div>
      <h5 class="card-title"><%= t("dashboard.recent_expenses", default: "Últimos movimientos") %></h5>
      <p class="dash-card-subtitle"><%= t("dashboard.recent_expenses_subtitle", default: "Actividad reciente de tus cuentas") %></p>
    </div>
    <%= link_to dashboard_expenses_path, class: "dash-link" do %>
      <%= t("dashboard.view_all_expenses", default: "Ver todos los gastos") %><i class="ti ti-arrow-right" aria-hidden="true"></i>
    <% end %>
  </div>

  <% if @expense_summary[:recent_expenses].any? %>
    <div class="table-responsive">
      <table class="table dash-movement-table mb-0">
        <thead>
          <tr>
            <th scope="col"><%= t("common.date") %></th>
            <th scope="col"><%= t("common.category") %></th>
            <th scope="col"><%= t("common.description") %></th>
            <th scope="col"><%= t("dashboard.money_source", default: "Fuente de dinero") %></th>
            <th scope="col" class="text-end"><%= t("common.amount") %></th>
          </tr>
        </thead>
        <tbody>
          <% @expense_summary[:recent_expenses].each do |expense| %>
            <tr class="dash-movement-row"
                tabindex="0" role="button"
                aria-label="<%= t("dashboard.open_expense", default: "Abrir detalle del gasto %{description}", description: expense.description.presence || t("common.uncategorized", default: "Sin categoría")) %>"
                data-expense-drawer
                data-view-url="<%= expense_path(expense) %>"
                data-edit-url="<%= edit_expense_path(expense) %>">
              <td class="dash-movement-date"><%= l(expense.date, format: :long) %></td>
              <td><%= category_badge(expense.category) %></td>
              <td class="dash-movement-name"><%= expense.description.presence || t("expenses.no_description") %></td>
              <td><%= dashboard_money_source_badge(expense.money_source) %></td>
              <td class="text-end dash-movement-amount"><%= number_to_currency(expense.amount.abs) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <% new_expense_cta = link_to(new_expense_path, class: "btn btn-primary btn-sm") do %><i class="ti ti-plus me-1"></i><%= t("expenses.add_expense") %><% end %>
    <%= render "shared/empty_state", icon: "clipboard-x", title: t("dashboard.no_expenses", default: "No se encontraron gastos"),
          text: t("dashboard.add_expense_to_start", default: "Agrega un gasto nuevo para comenzar."),
          cta: new_expense_cta %>
  <% end %>
</section>
