<%# Onboarding setup banner: pending steps only (Dashboard::Onboarding).
    Permanent skips live in OnboardingProgress; the X close is session-only
    (see app/assets/javascripts/onboarding.js). Each card starts an existing
    feature: the financial setup wizard, Gmail import, WhatsApp settings.
    Icon tiles, mini notes and the hero art are decorative (aria-hidden). %>
<% if @onboarding.visible? %>
  <section class="card onboarding-banner mb-4 d-print-none"
           data-testid="onboarding" data-onboarding-banner data-user-id="<%= current_user.id %>">
    <div class="card-body onboarding-hero">

      <div class="onboarding-hero-actions">
        <%= button_to onboarding_skip_all_path, method: :post,
              class: "btn btn-sm btn-link text-secondary text-decoration-none text-underline-hover",
              data: { testid: "onboarding-skip-all" },
              form: { data: { turbo: false } } do %>
          <%= t("onboarding.skip_all") %>
        <% end %>
        <button type="button" class="onboarding-close" data-onboarding-dismiss data-testid="onboarding-dismiss"
                aria-label="<%= t("onboarding.dismiss") %>" title="<%= t("onboarding.dismiss") %>">
          <i class="ti ti-x fs-4"></i>
        </button>
      </div>

      <div class="row align-items-center g-3">
        <div class="col-lg-7">
          <span class="onboarding-eyebrow"><i class="ti ti-sparkles"></i><%= t("onboarding.eyebrow") %></span>
          <h2 class="card-title onboarding-title mb-2"><%= t("onboarding.title") %></h2>
          <p class="onboarding-subtitle mb-0"><%= t("onboarding.subtitle") %></p>
        </div>
        <div class="col-lg-5">
          <div class="onboarding-hero-art d-none d-lg-grid" aria-hidden="true">
            <div class="onboarding-orbit"></div>
            <div class="float-icon"><i class="ti ti-user"></i></div>
            <div class="float-icon doc"><i class="ti ti-notebook"></i></div>
            <div class="onboarding-checklist">
              <div class="checklist-head"><i class="ti ti-settings"></i></div>
              <div class="checkrow"><span class="dot done"><i class="ti ti-check"></i></span><%= t("onboarding.checklist.initial") %></div>
              <div class="checkrow"><span class="dot"></span><%= t("onboarding.checklist.gmail") %></div>
              <div class="checkrow"><span class="dot"></span><%= t("onboarding.checklist.whatsapp") %></div>
            </div>
            <div class="float-icon chart"><i class="ti ti-chart-bar"></i></div>
            <span class="onboarding-pending-badge"><%= t("onboarding.pending", count: @onboarding.pending_count) %></span>
          </div>
          <span class="badge bg-warning-subtle text-warning border rounded-pill px-3 py-2 d-inline-flex d-lg-none align-items-center">
            <span class="rounded-circle bg-warning d-inline-block me-1 et-chip-7"></span>
            <%= t("onboarding.pending", count: @onboarding.pending_count) %>
          </span>
        </div>
      </div>
    </div>

    <div class="card-body pt-0">
      <div class="row g-3">
        <% @onboarding.pending_steps.each_with_index do |step, index| %>
          <div class="col-12 col-lg-4">
            <article class="card h-100 onboarding-card <%= "onboarding-card--initial" if step.key == "initial" %>"
                     data-testid="onboarding-card-<%= step.key %>" data-onboarding-card="<%= step.key %>">
              <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center gap-2 mb-3">
                  <span class="onboarding-card-number"><%= index + 1 %></span>
                  <h3 class="h6 fw-bold mb-0 me-auto"><%= t("onboarding.steps.#{step.key}.title") %></h3>
                  <% if step.key == "initial" %>
                    <span class="pill-recommended"><%= t("onboarding.recommended") %></span>
                  <% else %>
                    <span class="pill-optional"><%= t("onboarding.optional") %></span>
                  <% end %>
                </div>
                <p class="onboarding-card-desc"><%= t("onboarding.steps.#{step.key}.desc") %></p>

                <%# Decorative mini illustration per step %>
                <div class="onboarding-mini" aria-hidden="true">
                  <% if step.key == "initial" %>
                    <div class="illustration-tile"><i class="ti ti-user"></i></div>
                    <div class="illustration-tile purple"><i class="ti ti-notebook"></i></div>
                  <% elsif step.key == "gmail" %>
                    <div class="illustration-tile"><i class="ti ti-mail"></i></div>
                    <div class="mini-note"><strong><%= t("onboarding.steps.gmail.demo_amount") %></strong><br><%= t("onboarding.steps.gmail.demo_label") %></div>
                  <% else %>
                    <div class="illustration-tile green"><i class="ti ti-brand-whatsapp"></i></div>
                    <div class="mini-note"><strong><%= t("onboarding.steps.whatsapp.demo_amount") %></strong><br><%= t("onboarding.steps.whatsapp.demo_label") %></div>
                  <% end %>
                </div>

                <ul class="onboarding-benefits mb-3">
                  <% (1..3).each do |n| %>
                    <li><span class="benefit-tick"><i class="ti ti-check"></i></span><%= t("onboarding.steps.#{step.key}.benefit_#{n}") %></li>
                  <% end %>
                </ul>
                <div class="mt-auto onboarding-card-footer">
                  <%= link_to onboarding_step_path(step.key),
                        class: "btn btn-sm d-grid onboarding-cta #{case step.key when "initial" then "onboarding-cta--primary" when "whatsapp" then "onboarding-cta--green" else "onboarding-cta--outline" end}",
                        data: { testid: "onboarding-cta-#{step.key}" } do %>
                    <% if step.key == "initial" %>
                      <i class="ti ti-settings me-1"></i><%= t("onboarding.steps.#{step.key}.cta") %><i class="ti ti-arrow-right ms-1"></i>
                    <% elsif step.key == "gmail" %>
                      <i class="ti ti-mail me-1"></i><%= t("onboarding.steps.#{step.key}.cta") %><i class="ti ti-arrow-right ms-1"></i>
                    <% else %>
                      <i class="ti ti-brand-whatsapp me-1"></i><%= t("onboarding.steps.#{step.key}.cta") %><i class="ti ti-arrow-right ms-1"></i>
                    <% end %>
                  <% end %>
                  <div class="d-flex justify-content-between align-items-center mt-2">
                    <button type="button"
                            class="btn btn-sm btn-link text-secondary text-decoration-none px-0"
                            data-onboarding-later data-testid="onboarding-later-<%= step.key %>"
                            data-later-message="<%= t("onboarding.later_message.#{step.key}") %>">
                      <i class="ti ti-clock me-1"></i><%= t("onboarding.later") %>
                    </button>
                    <%= button_to onboarding_skip_path(step: step.key), method: :post,
                          class: "btn btn-sm onboarding-skip-btn",
                          data: { testid: "onboarding-skip-#{step.key}" },
                          form: { data: { turbo: false } } do %>
                      <%= t("onboarding.skip") %>
                    <% end %>
                  </div>
                </div>
              </div>
            </article>
          </div>
        <% end %>
      </div>

      <div class="onboarding-note">
        <div class="onboarding-bulb"><i class="ti ti-bulb"></i></div>
        <div>
          <strong><%= t("onboarding.note_title") %></strong>
          <p class="mb-0"><%= t("onboarding.note_body") %></p>
        </div>
      </div>
    </div>
  </section>
<% end %>
