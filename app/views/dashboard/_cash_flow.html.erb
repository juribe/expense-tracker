<%# Cash flow (income vs expense) area chart card. %>
<% has_evolution = @cycle_summary[:evolution].any? { |point| point[:income].positive? || point[:expense].positive? } %>
<section class="card dash-chart-card" data-testid="dashboard-cash-flow">
  <div class="dash-card-head">
    <div>
      <h5 class="card-title"><%= t("dashboard.evolution_title", default: "Evolución de ingresos y gastos") %></h5>
      <p class="dash-card-subtitle"><%= t("dashboard.evolution_subtitle", default: "Movimientos durante tu ciclo financiero") %></p>
    </div>
    <%= link_to dashboard_analysis_path, class: "dash-link" do %>
      <%= t("dashboard.view_analysis", default: "Ver análisis") %><i class="ti ti-arrow-right" aria-hidden="true"></i>
    <% end %>
  </div>

  <div class="dash-chart-summary">
    <div class="dash-chart-legend">
      <span><span class="legend-dot et-dot-income"></span><%= t("dashboard.incomes", default: "Ingresos") %></span>
      <span><span class="legend-dot et-dot-expense"></span><%= t("dashboard.expenses", default: "Gastos") %></span>
    </div>
    <div class="dash-chart-totals">
      <div>
        <small><%= t("dashboard.incomes", default: "Ingresos") %></small>
        <strong class="is-income"><%= number_to_currency(@cycle_summary[:income_total]) %></strong>
      </div>
      <div>
        <small><%= t("dashboard.expenses", default: "Gastos") %></small>
        <strong class="is-expense"><%= number_to_currency(@cycle_summary[:expense_total]) %></strong>
      </div>
      <div>
        <small><%= t("dashboard.accumulated_balance", default: "Balance acumulado") %></small>
        <strong class="<%= dashboard_balance_class(@cycle_summary[:net_total]) %>"><%= dashboard_signed_currency(@cycle_summary[:net_total]) %></strong>
      </div>
    </div>
  </div>

  <% if has_evolution %>
    <div class="dash-chart">
      <%= area_chart [
                       { name: t("dashboard.incomes", default: "Ingresos"), data: @cycle_summary[:evolution].map { |point| [ point[:date], point[:income] ] } },
                       { name: t("dashboard.expenses", default: "Gastos"), data: @cycle_summary[:evolution].map { |point| [ point[:date], point[:expense] ] } }
                     ],
                     **chart_money_options,
                     height: "230px",
                     colors: [ "#12a875", "#f05268" ],
                     legend: false,
                     library: { scales: { x: { ticks: { maxTicksLimit: 7 } } } } %>
    </div>
  <% else %>
    <div class="dash-chart-empty">
      <%= render "shared/empty_state", icon: "chart-line", title: t("dashboard.no_evolution", default: "Sin movimientos en este período") %>
    </div>
  <% end %>
</section>
