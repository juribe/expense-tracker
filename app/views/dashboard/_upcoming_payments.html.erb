<%# Upcoming payments card: period commitments with their real status. %>
<% payments = @cycle_summary[:upcoming_payments] %>
<section class="card dash-payments" data-testid="dashboard-upcoming-payments">
  <div class="dash-card-head">
    <div>
      <h5 class="card-title"><%= t("dashboard.upcoming_payments", default: "Próximos pagos") %></h5>
      <p class="dash-card-subtitle"><%= t("dashboard.upcoming_payments_subtitle", default: "Compromisos por cubrir") %></p>
    </div>
    <%= link_to dashboard_upcoming_payments_path, class: "dash-link" do %>
      <%= t("dashboard.view_all", default: "Ver todos") %><i class="ti ti-arrow-right" aria-hidden="true"></i>
    <% end %>
  </div>

  <div class="dash-pending-summary dash-pending-total">
    <span><%= t("dashboard.total_pending", default: "Total pendiente de pago") %></span>
    <strong><%= number_to_currency(@cycle_summary[:pending_payments_total]) %></strong>
  </div>

  <% if payments.any? %>
    <div class="dash-payment-list">
      <% payments.first(6).each do |payment| %>
        <div class="<%= dashboard_payment_row_class(payment[:status]) %>">
          <span class="dash-payment-icon" aria-hidden="true"><i class="ti ti-repeat"></i></span>
          <div class="dash-payment-copy">
            <span class="dash-payment-name"><%= payment[:label] %></span>
            <span class="dash-payment-date"><%= dashboard_payment_date_label(payment) %></span>
          </div>
          <div class="dash-payment-right">
            <span class="dash-payment-amount"><%= number_to_currency(payment[:amount]) %></span>
            <span class="<%= dashboard_payment_status_class(payment[:status]) %>"><%= dashboard_payment_status_label(payment[:status]) %></span>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state", icon: "calendar-event", title: t("dashboard.no_upcoming_payments", default: "No hay pagos próximos") %>
  <% end %>
</section>
