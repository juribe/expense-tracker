<div class="container mt-4">
  <h1>Dashboard</h1>

  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5>Monthly Summary - <%= @month.strftime("%B %Y") %></h5>
        </div>
        <div class="card-body">
          <p><strong>Total Expenses:</strong> <%= number_to_currency(@summary[:total_amount]) %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5>Expenses by Category</h5>
        </div>
        <div class="card-body">
          <% if @summary[:by_category].any? %>
            <%= pie_chart @summary[:by_category] %>
          <% else %>
            <p>No expenses this month.</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5>Recent Expenses</h5>
        </div>
        <div class="card-body">
          <% if @summary[:recent_expenses].any? %>
            <table class="table">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Description</th>
                  <th>Amount</th>
                </tr>
              </thead>
              <tbody>
                <% @summary[:recent_expenses].each do |expense| %>
                  <tr>
                    <td><%= expense.date.strftime("%m/%d/%Y") %></td>
                    <td><%= expense.description %></td>
                    <td><%= number_to_currency(expense.amount) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p>No recent expenses.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
