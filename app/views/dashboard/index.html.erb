<div class="row g-3 mb-4">
  <div class="col-12 col-md-4">
    <div class="card text-center h-100 shadow-sm">
      <div class="card-body">
        <h5 class="card-title text-muted">Total Balance</h5>
        <p class="summary-value fw-bold text-success mb-1"><%= number_to_currency(@summary[:total_amount]) %></p>
        <i class="bi bi-cash-coin text-success"></i>
        <p class="text-muted small mb-0"><%= @month.strftime("%B %Y") %></p>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-4">
    <div class="card text-center h-100 shadow-sm">
      <div class="card-body">
        <h5 class="card-title text-muted">Expenses This Month</h5>
        <p class="summary-value fw-bold text-danger mb-1"><%= @summary[:recent_expenses].count %></p>
        <i class="bi bi-receipt text-danger"></i>
        <p class="text-muted small mb-0">transactions</p>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-4">
    <div class="card h-100 shadow-sm">
      <div class="card-body">
        <h5 class="card-title text-muted mb-3">Category Breakdown</h5>
        <% if @summary[:by_category].any? %>
          <%= pie_chart @summary[:by_category], height: "200px" %>
        <% else %>
          <div class="text-center text-muted py-4">
            <i class="bi bi-pie-chart display-4 d-block mb-2"></i>
            <span>No expenses this month</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-12 col-lg-8">
    <div class="card shadow-sm h-100">
      <div class="card-header d-flex justify-content-between align-items-center bg-white">
        <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Recent Expenses</h5>
        <%= link_to expenses_path, class: "btn btn-sm btn-outline-primary" do %>
          View all <i class="bi bi-arrow-right ms-1"></i>
        <% end %>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Category</th>
              <th scope="col">Description</th>
              <th scope="col" class="text-end">Amount</th>
            </tr>
          </thead>
          <tbody>
            <% @summary[:recent_expenses].each do |expense| %>
              <tr>
                <td><%= expense.date.strftime("%b %d, %Y") %></td>
                <td><%= category_badge(expense.category) %></td>
                <td><%= expense.description %></td>
                <td class="text-end fw-bold text-danger">-<%= number_to_currency(expense.amount) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @summary[:recent_expenses].empty? %>
        <div class="p-5 text-center">
          <i class="bi bi-clipboard-x display-4 text-muted mb-3 d-block"></i>
          <h4 class="mb-2">No expenses found</h4>
          <p class="text-muted">Add a new expense to get started.</p>
          <%= link_to new_expense_path, class: "btn btn-primary mt-3" do %>
            <i class="bi bi-plus-lg me-1"></i>Add First Expense
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="col-12 col-lg-4">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-success text-white">
        <i class="bi bi-plus-circle me-2"></i>Quick Add Expense
      </div>
      <div class="card-body">
        <%= form_with model: Expense.new, local: true do |f| %>
          <div class="mb-2">
            <%= f.label :amount, class: "form-label small" %>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <%= f.number_field :amount, step: 0.01, class: "form-control", placeholder: "0.00", required: true %>
            </div>
          </div>
          <div class="mb-2">
            <%= f.label :category_id, "Category", class: "form-label small" %>
            <%= f.collection_select :category_id, Category.all, :id, :name, {}, class: "form-select", required: true %>
          </div>
          <div class="mb-2">
            <%= f.label :date, class: "form-label small" %>
            <%= f.date_field :date, class: "form-control", value: Date.today, required: true %>
          </div>
          <div class="mb-3">
            <%= f.label :description, "Description (optional)", class: "form-label small" %>
            <%= f.text_field :description, class: "form-control", placeholder: "e.g., Lunch at cafe" %>
          </div>
          <%= f.hidden_field :frequency, value: "one_time" %>
          <%= f.submit "Add Expense", class: "btn btn-success w-100" do %>
            <i class="bi bi-check-circle me-1"></i>Add Expense
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>