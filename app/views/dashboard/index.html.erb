<%# Finances dashboard — the app's home.
  Answers, in order: how much money do I have / what does this cycle look
  like / what is coming / what needs attention. %>

<%# The cycle banner doubles as the page header on cycle-enabled accounts %>
<% if @cycle %>
  <div class="cycle-banner page-header d-flex align-items-center gap-3 flex-wrap">
    <div>
      <h1 class="page-title"><strong><%= @cycle.label %></strong></h1>
      <span class="page-subtitle"><%= @cycle.range_label %></span>
    </div>
  </div>
<% else %>
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= @period_label %></h1>
      <div class="page-subtitle"><%= dashboard_span_label(@span) %></div>
    </div>
  </div>
<% end %>

<%
  gmail_connected = current_user.gmail_connections.active.exists?
  whatsapp_connected = current_user.whatsapp_connections.active.exists?
  pending_setup_count = [gmail_connected ? 0 : 1, whatsapp_connected ? 0 : 1].sum
%>
<% if pending_setup_count.positive? %>
  <section class="mb-4">
    <div class="d-flex justify-content-between align-items-end gap-3 mb-3">
      <div>
        <h2 class="h5 fw-bold mb-1"><%= t("dashboard.setup_title") %></h2>
        <p class="text-muted small mb-0"><%= t("dashboard.setup_subtitle") %></p>
      </div>
      <span class="badge bg-warning-subtle text-warning border rounded-pill px-3 py-2 fw-bold">
        <span class="rounded-circle bg-warning d-inline-block me-1" style="width: 7px; height: 7px;"></span>
        <%= pending_setup_count %> <%= pending_setup_count == 1 ? t("dashboard.setup_pending_one") : t("dashboard.setup_pending_other") %>
      </span>
    </div>
    <div class="row g-3">
      <% unless gmail_connected %>
        <div class="col-12 col-md-6">
          <div class="card h-100 border-primary-subtle">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-start gap-3 mb-2">
                <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary flex-shrink-0" style="width: 44px; height: 44px;">
                  <i class="ti ti-mail fs-4"></i>
                </span>
                <div class="flex-grow-1">
                  <div class="d-flex align-items-center gap-2 mb-1">
                    <h3 class="h6 fw-bold mb-0"><%= t("dashboard.setup_gmail_title") %></h3>
                    <span class="badge bg-warning-subtle text-warning border"><%= t("dashboard.setup_gmail_pending") %></span>
                  </div>
                  <p class="text-muted small mb-0"><%= t("dashboard.setup_gmail_subtitle") %></p>
                </div>
              </div>
              <p class="small text-muted mb-3 flex-grow-1">
                <%= t("dashboard.setup_gmail_body").html_safe %>
              </p>
              <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="badge bg-light text-muted border"><%= t("dashboard.setup_gmail_benefit_1") %></span>
                <span class="badge bg-light text-muted border"><%= t("dashboard.setup_gmail_benefit_2") %></span>
              </div>
              <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <span class="small text-muted"><%= t("dashboard.setup_gmail_note") %></span>
                <%= link_to gmail_connection_path, class: "btn btn-sm btn-primary" do %>
                  <%= t("dashboard.setup_gmail_cta") %> <i class="ti ti-arrow-right ms-1"></i>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
      <% unless whatsapp_connected %>
        <div class="col-12 col-md-6">
          <div class="card h-100 border-success-subtle">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-start gap-3 mb-2">
                <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-success-subtle text-success flex-shrink-0" style="width: 44px; height: 44px;">
                  <i class="ti ti-brand-whatsapp fs-4"></i>
                </span>
                <div class="flex-grow-1">
                  <div class="d-flex align-items-center gap-2 mb-1">
                    <h3 class="h6 fw-bold mb-0"><%= t("dashboard.setup_whatsapp_title") %></h3>
                    <span class="badge bg-warning-subtle text-warning border"><%= t("dashboard.setup_whatsapp_pending") %></span>
                  </div>
                  <p class="text-muted small mb-0"><%= t("dashboard.setup_whatsapp_subtitle") %></p>
                </div>
              </div>
              <p class="small text-muted mb-3 flex-grow-1">
                <%= t("dashboard.setup_whatsapp_body").html_safe %>
              </p>
              <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="badge bg-light text-muted border"><%= t("dashboard.setup_whatsapp_benefit_1") %></span>
                <span class="badge bg-light text-muted border"><%= t("dashboard.setup_whatsapp_benefit_2") %></span>
                <span class="badge bg-light text-muted border"><%= t("dashboard.setup_whatsapp_benefit_3") %></span>
              </div>
              <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <span class="small text-muted"><%= t("dashboard.setup_whatsapp_note") %></span>
                <%= link_to whatsapp_settings_path, class: "btn btn-sm btn-success" do %>
                  <%= t("dashboard.setup_whatsapp_cta") %> <i class="ti ti-arrow-right ms-1"></i>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<%# --------------------------------------------------------- overview %>
<%
  incomes_meta = capture do %>
    <%= dashboard_delta_badge(@cycle_summary[:income_delta_pct]) %>
    <span class="text-secondary"><%= t("dashboard.vs_previous", default: "vs. ciclo anterior") %></span>
  <% end %>
  <% expenses_meta = capture do %>
    <%= dashboard_delta_badge(@cycle_summary[:expense_delta_pct], good_direction: :down) %>
    <span class="text-secondary"><%= t("dashboard.vs_previous", default: "vs. ciclo anterior") %></span>
  <% end %>
  <% projected_progress = {
       pct: @cycle_summary[:period_progress_pct],
       aria_label: t("dashboard.cycle_progress_aria", default: "Progreso del ciclo"),
       bar_class: @cycle_summary[:on_track] ? "bg-success" : "bg-danger"
     } %>
<section class="page-section">
  <div class="row g-3">
    <div class="col-12 col-sm-6 col-lg-3">
      <%= render "dashboard/metric_card",
            label: t("dashboard.money_in_accounts", default: "Dinero en cuentas"),
            value: number_to_currency(@position[:accounts_balance]),
            description: t("dashboard.money_in_accounts_desc",
                           default: "Saldo disponible en cuentas, tarjetas débito, efectivo y billeteras."),
            icon: "wallet", variant: "accounts",
            href: money_sources_path, testid: "dashboard-kpi-accounts" %>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
      <%= render "dashboard/metric_card",
            label: t("dashboard.incomes", default: "Ingresos"),
            value: number_to_currency(@cycle_summary[:income_total]),
            meta: incomes_meta,
            icon: "trending-up", variant: "income",
            href: incomes_path, testid: "dashboard-kpi-incomes" %>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
      <%= render "dashboard/metric_card",
            label: t("dashboard.expenses", default: "Gastos"),
            value: number_to_currency(@cycle_summary[:expense_total]),
            meta: expenses_meta,
            icon: "receipt", variant: "expense",
            href: expenses_path, testid: "dashboard-kpi-expenses" %>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
      <%= render "dashboard/metric_card",
            label: t("dashboard.projected_spend", default: "Gasto proyectado"),
            value: number_to_currency(@cycle_summary[:projected_spend]),
            meta: t(@cycle_summary[:on_track] ? "dashboard.on_track_title" : "dashboard.off_track_title",
                    default: @cycle_summary[:on_track] ? "Estás en línea con tu meta" : "Vas sobre tu meta de gasto"),
            progress: projected_progress,
            icon: "target", variant: "expense",
            href: reports_budgets_path, testid: "dashboard-kpi-projected" %>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
      <%= render "dashboard/metric_card",
            label: t("dashboard.credit_available", default: "Cupo disponible"),
            value: number_to_currency(@position[:credit_available]),
            description: t("dashboard.credit_available_desc",
                           default: "Saldo disponible en tarjetas de crédito y créditos rotativos."),
            icon: "credit-card", variant: "credit",
            href: reports_credit_cards_path, testid: "dashboard-kpi-credit" %>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
      <%= render "dashboard/metric_card",
            label: t("dashboard.savings", default: "Ahorros"),
            value: number_to_currency(@position[:savings_balance]),
            description: t("dashboard.savings_desc", default: "Total de tus bolsillos de ahorro."),
            icon: "pig-money", variant: "savings",
            href: money_sources_pockets_path, testid: "dashboard-kpi-savings" %>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
      <%= render "dashboard/metric_card",
            label: t("dashboard.card_debt", default: "Deuda tarjetas de crédito"),
            value: number_to_currency(@position[:credit_debt]),
            description: t("dashboard.card_debt_desc",
                           default: "Total que debes en tarjetas de crédito."),
            icon: "credit-card", variant: "debt",
            href: debt_capacity_path, testid: "dashboard-kpi-credit-debt" %>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
      <%= render "dashboard/metric_card",
            label: t("dashboard.normal_debt", default: "Deudas normales"),
            value: number_to_currency(@position[:loan_debt]),
            description: t("dashboard.normal_debt_desc",
                           default: "Total que debes en créditos y préstamos, incluidos los rotativos."),
            icon: "building-bank", variant: "normal-debt",
            href: reports_loans_path, testid: "dashboard-kpi-loan-debt" %>
    </div>
  </div>
</section>

<%# ------------------------------------------------- needs attention %>
<% needs_attention = [] %>
<% needs_attention << { icon: "inbox", tone: "amber", text: t("dashboard.attention_candidates", count: @pending_candidates.size, default: "%{count} gastos por revisar"), path: expense_candidates_path } if @pending_candidates.any? %>
<% if current_user.spending_alerts.unread.any? %>
  <% needs_attention << { icon: "bell", tone: "amber", text: t("dashboard.attention_alerts", default: "%{count} alertas sin leer", count: current_user.spending_alerts.unread.count), path: alerts_path } %>
<% end %>
<% if @budgets.any? %>
  <% attention_counts = budget_summary_counts(@budgets, @budget_period) %>
  <% if attention_counts[:over_budget].positive? %>
    <% needs_attention << { icon: "calculator", tone: "red", text: t("budgets.attention_over", count: attention_counts[:over_budget], default: "%{count} presupuestos excedidos"), path: budgets_path } %>
  <% elsif attention_counts[:near_limit].positive? %>
    <% needs_attention << { icon: "calculator", tone: "amber", text: t("budgets.attention_near", count: attention_counts[:near_limit], default: "%{count} presupuestos cerca del límite"), path: budgets_path } %>
  <% end %>
<% end %>
<% if needs_attention.any? %>
  <section class="page-section">
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <span class="section-title mb-0"><%= t("dashboard.attention", default: "Requiere atención") %></span>
      <% needs_attention.each do |item| %>
        <%= link_to item[:path], class: "filter-chip #{item[:tone] == "red" ? "border-danger text-danger" : "border-warning-subtle text-warning-emphasis"}" do %>
          <i class="ti ti-<%= item[:icon] %>"></i><%= item[:text] %>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>

<div class="row g-3">
  <div class="col-12 col-lg-8">
    <%# ------------------------------------------------- period count %>
    <div class="row g-3">
      <div class="col-12">
        <div class="card page-section">
          <div class="card-body">
            <div class="row g-3 align-items-center">
              <div class="col-12 col-md-4">
                <h5 class="card-title"><%= dashboard_expenses_title(@cycle) %></h5>
                <p class="summary-value mb-0 text-body"><%= @cycle_summary[:expense_count] %></p>
                <div class="small text-secondary"><%= dashboard_delta_badge(@cycle_summary[:expense_delta_pct], good_direction: :down) %> <span class="text-secondary"><%= t("dashboard.vs_previous", default: "vs. ciclo anterior") %></span></div>
              </div>
              <div class="col-12 col-md-8 dashboard-mini-chart">
                <%= column_chart @cycle_summary[:evolution].map { |point| [ point[:date], point[:expense] ] },
                                 **chart_money_options,
                                 height: "120px",
                                 colors: [ "#f2a5b6" ],
                                 legend: false,
                                 library: { plugins: { legend: { display: false } },
                                            scales: { x: { display: false }, y: { display: false } } } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# ------------------------------------------------- cash flow %>
    <div class="card page-section">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title"><%= t("dashboard.evolution_title", default: "Evolución de ingresos y gastos") %></h5>
      </div>
      <div class="card-body">
        <% has_evolution = @cycle_summary[:evolution].any? { |point| point[:income].positive? || point[:expense].positive? } %>
        <% if has_evolution %>
          <div class="d-flex gap-3 mb-2 small text-secondary">
            <span><span class="legend-dot" style="background: var(--et-positive)"></span> <%= t("dashboard.incomes", default: "Ingresos") %></span>
            <span><span class="legend-dot" style="background: var(--et-negative)"></span> <%= t("dashboard.expenses", default: "Gastos") %></span>
          </div>
          <%= area_chart [
                           { name: t("dashboard.incomes", default: "Ingresos"), data: @cycle_summary[:evolution].map { |point| [ point[:date], point[:income] ] } },
                           { name: t("dashboard.expenses", default: "Gastos"), data: @cycle_summary[:evolution].map { |point| [ point[:date], point[:expense] ] } }
                         ],
                         **chart_money_options,
                         height: "240px",
                         colors: [ "#0e9f6e", "#e0254b" ],
                         legend: false,
                         library: { scales: { x: { ticks: { maxTicksLimit: 8 } } } } %>
        <% else %>
          <%= render "shared/empty_state", icon: "chart-line", title: t("dashboard.no_evolution", default: "Sin movimientos en este período") %>
        <% end %>
      </div>
    </div>

    <%# ------------------------------------------------ categories %>
    <div class="row g-3">
      <div class="col-12 col-lg-5">
        <%= render "shared/section", title: t("dashboard.category_breakdown", default: "Distribución por categoría") do %>
          <% if @expense_summary[:by_category].any? %>
            <% ranked_categories = @expense_summary[:by_category].sort_by { |_name, total| -total }
                                                          .first(8)
                                                          .map { |name, total| { name: name, total: total } } %>
            <% palette = dashboard_category_palette(ranked_categories.size) %>
            <div class="donut-wrap position-relative mx-auto">
              <%= pie_chart ranked_categories.map { |category| [ category[:name], category[:total] ] },
                              **chart_money_options,
                              height: "170px",
                              donut: true,
                              legend: false,
                              colors: palette,
                              library: { cutout: "70%" } %>
              <div class="donut-center text-center">
                <span class="d-block fw-bold num"><%= number_to_currency(@cycle_summary[:expense_total]) %></span>
                <span class="text-secondary small"><%= t("dashboard.total_expenses", default: "Total gastos") %></span>
              </div>
            </div>
            <ul class="list-unstyled mb-0 mt-3 donut-legend">
              <% ranked_categories.each_with_index do |category, index| %>
                <li class="d-flex align-items-center gap-2 mb-1">
                  <span class="legend-dot" style="background: <%= palette[index] %>"></span>
                  <span class="small flex-grow-1"><%= category[:name] %></span>
                  <span class="small fw-bold num">
                    <% if @cycle_summary[:expense_total].to_f.positive? %>
                      <%= number_with_precision(category[:total] / @cycle_summary[:expense_total] * 100, precision: 0) %>%
                    <% else %>
                      0%
                    <% end %>
                  </span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <div class="text-center text-secondary py-4">
              <i class="ti ti-chart-pie display-5 d-block mb-2"></i>
              <span><%= dashboard_no_expenses_label(@cycle) %></span>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="col-12 col-lg-7">
        <%= render "shared/section", title: t("dashboard.recent_expenses", default: "Gastos recientes"),
              header: false do %>
          <div class="table-responsive">
            <table class="table table-hover ledger-table mb-0" data-testid="dashboard-recent-expenses">
              <thead>
                <tr>
                  <th scope="col"><%= t("common.date") %></th>
                  <th scope="col"><%= t("common.category") %></th>
                  <th scope="col"><%= t("common.description") %></th>
                  <th scope="col" class="text-end"><%= t("common.amount") %></th>
                </tr>
              </thead>
              <tbody>
                <% @expense_summary[:recent_expenses].each do |expense| %>
                  <tr>
                    <td class="cell-muted small"><%= l(expense.date, format: :long) %></td>
                    <td><%= category_badge(expense.category) %></td>
                    <td class="cell-strong"><%= expense.description %></td>
                    <td class="cell-amount text-danger"><%= number_to_currency(expense.amount.abs) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <% if @expense_summary[:recent_expenses].empty? %>
            <% new_expense_cta = link_to(new_expense_path, class: "btn btn-primary btn-sm") do %><i class="ti ti-plus me-1"></i><%= t("expenses.add_expense") %><% end %>
            <%= render "shared/empty_state", icon: "clipboard-x", title: t("dashboard.no_expenses", default: "No se encontraron gastos"),
                  text: t("dashboard.add_expense_to_start", default: "Agrega un gasto nuevo para comenzar."),
                  cta: new_expense_cta %>
          <% end %>
          <div class="d-flex justify-content-end mt-2">
            <%= link_to expenses_path, class: "btn btn-sm btn-outline-secondary" do %><%= t("dashboard.view_all", default: "Ver todos") %><i class="ti ti-arrow-right ms-1"></i><% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-4">
    <%# ------------------------------------------------ upcoming %>
    <div class="card page-section">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title"><i class="ti ti-calendar-event me-1 text-secondary"></i><%= t("dashboard.upcoming_payments", default: "Próximos pagos") %></h5>
        <%= link_to monthly_expenses_path, class: "small text-decoration-none text-secondary" do %><%= t("dashboard.view_all", default: "Ver todos") %><i class="ti ti-arrow-right"></i><% end %>
      </div>
      <div class="card-body pt-0">
        <% if @cycle_summary[:upcoming_payments].any? %>
          <% @cycle_summary[:upcoming_payments].each do |payment| %>
            <div class="upcoming-payment d-flex align-items-center gap-2 py-2 border-bottom">
              <span class="icon-chip icon-chip-gray icon-chip-sm"><i class="ti ti-repeat"></i></span>
              <div class="flex-grow-1">
                <span class="small fw-semibold d-block cell-strong"><%= payment[:label] %></span>
                <span class="text-secondary small"><%= l(payment[:next_date], format: "%e %b").squeeze(" ") %></span>
              </div>
              <div class="text-end">
                <span class="small fw-bold num d-block"><%= number_to_currency(payment[:amount]) %></span>
                <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger small"><%= t("dashboard.pending", default: "Pendiente") %></span>
              </div>
            </div>
          <% end %>
        <% else %>
          <%= render "shared/empty_state", icon: "calendar-event", title: t("dashboard.no_upcoming_payments", default: "No hay pagos próximos") %>
        <% end %>
      </div>
    </div>

    <%# ------------------------------------------------ budgets %>
    <% if @budgets.any? %>
      <% counts = budget_summary_counts(@budgets, @budget_period) %>
      <div class="card page-section">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="card-title"><i class="ti ti-calculator me-1 text-secondary"></i><%= t("budgets.dashboard_title") %></h5>
          <%= link_to budgets_path, class: "small text-decoration-none text-secondary" do %><%= t("budgets.dashboard_view_all") %><i class="ti ti-arrow-right"></i><% end %>
        </div>
        <div class="card-body">
          <% @budgets.first(4).each do |budget| %>
            <% data = budget_progress_data(budget, @budget_period) %>
            <div class="budget-mini mb-3">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <%= link_to category_badge(budget.category), category_path(budget.category), class: "text-decoration-none" %>
                <span class="fw-bold small budget-amount num"><%= number_to_percentage(data[:percentage], precision: 0) %></span>
              </div>
              <div class="progress dashboard-progress" role="progressbar" aria-label="<%= t("budgets.progress_aria", name: budget.category.name) %>" aria-valuenow="<%= data[:percentage].round %>" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar <%= budget_status_class(data[:status]) %>" style="width: <%= [ data[:percentage], 100 ].min %>%"></div>
              </div>
            </div>
          <% end %>
          <p class="text-secondary small mb-0"><%= t("budgets.summary", count: counts[:total], near_limit: counts[:near_limit], over_budget: counts[:over_budget]) %></p>
        </div>
      </div>
    <% end %>

    <%# ------------------------------------------------ goals %>
    <div class="card page-section">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title"><i class="ti ti-trophy me-1 text-secondary"></i><%= t("dashboard.financial_goals", default: "Metas financieras") %></h5>
        <%= link_to goals_path, class: "small text-decoration-none text-secondary" do %><%= t("dashboard.view_all", default: "Ver todas") %><i class="ti ti-arrow-right"></i><% end %>
      </div>
      <div class="card-body pt-0">
        <% if @goals.any? %>
          <% @goals.each do |goal| %>
            <div class="goal-row py-2 border-bottom">
              <div class="d-flex align-items-center gap-2 mb-1">
                <span class="icon-chip icon-chip-green icon-chip-sm"><i class="ti ti-pig-money"></i></span>
                <span class="small fw-semibold flex-grow-1"><%= link_to goal.name, goals_path, class: "text-decoration-none text-reset" %></span>
                <span class="small fw-bold num"><%= number_to_percentage(goal.progress_percentage, precision: 0) %></span>
              </div>
              <div class="progress dashboard-progress mb-1" role="progressbar"
                   aria-label="<%= t("goals.progress_aria", name: goal.name) %>"
                   aria-valuenow="<%= goal.progress_percentage.round %>" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar bg-primary" style="width: <%= goal.progress_percentage.round %>%"></div>
              </div>
              <span class="text-secondary small num"><%= number_to_currency(goal.saved_amount) %> / <%= number_to_currency(goal.target_amount) %></span>
            </div>
          <% end %>
        <% else %>
          <%= render "shared/empty_state", icon: "pig-money", title: t("dashboard.no_goals", default: "Aún no tienes metas financieras"),
                cta: link_to(new_goal_path, class: "btn btn-sm btn-outline-primary") { "<i class=\"ti ti-plus me-1\"></i>#{t("goals.new", default: "Nueva meta")}".html_safe } %>
        <% end %>
      </div>
    </div>

    <%# ------------------------------------------------ quick add %>
    <div class="card" id="quick-add-expense">
      <div class="card-header">
        <h5 class="card-title"><i class="ti ti-plus me-1 text-secondary"></i><%= t("dashboard.quick_add_expense", default: "Agregar gasto rápido") %></h5>
      </div>
      <div class="card-body">
        <%= form_with model: Expense.new, local: true do |f| %>
          <%= f.hidden_field :date, value: Date.today %>
          <div class="mb-2">
            <%= f.label :amount, t("dashboard.quick_add_amount", default: "Valor"), class: "form-label small" %>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <%= f.text_field :amount,
                               value: money_field_value(f.object.amount&.abs),
                               class: "form-control",
                               placeholder: t("expenses.placeholder_amount"),
                               required: true,
                               inputmode: "decimal",
                               autocomplete: "off",
                               data: { money_input: true } %>
            </div>
          </div>
          <div class="mb-2">
            <%= category_picker f, :category_id, @categories,
                                label: t("common.category"),
                                label_class: "form-label small",
                                required: true,
                                testid: "dashboard-expense-category-picker" %>
          </div>
          <div class="mb-0 small text-secondary">
            <%= f.label :money_source_id, t("expenses.source"), class: "form-label small" %>
            <%= f.collection_select :money_source_id, @money_sources, :id, :display_name,
                                    { include_blank: t("common.none") }, class: "form-select" %>
          </div>
          <button type="submit" class="btn btn-success w-100 mt-3">
            <i class="ti ti-plus me-1"></i><%= t("expenses.add_expense") %>
          </button>
        <% end %>
      </div>
    </div>
  </div>
</div>
