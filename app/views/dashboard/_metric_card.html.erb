<%# KPI metric card for the dashboard overview: icon chip, optional status
  badge, title, amount and supporting copy. Rendered as a link when href is
  present — the whole card is the target, so no nested anchors.
  Locals: label, value, icon (Tabler name), variant (accounts | income |
  expense | projection), href (nil allowed), testid.
  Optional: description (String), badge (html String). %>
<%
  description = local_assigns[:description]
  badge = local_assigns[:badge]
  tag = href.present? ? :a : :div
  card_options = {
    class: class_names("card", "metric-card", "metric-card--#{variant}", "text-decoration-none", "text-reset"),
    data: { testid: testid }
  }
  card_options[:href] = href if href.present?
%>
<%= content_tag(tag, card_options) do %>
  <div class="dash-metric-top">
    <span class="icon-chip icon-chip-lg dash-metric-icon" aria-hidden="true"><i class="ti ti-<%= icon %>"></i></span>
    <% if badge.present? %>
      <span class="dash-metric-badge"><%= badge %></span>
    <% end %>
  </div>
  <p class="card-title metric-card-title dash-metric-label"><%= label %></p>
  <p class="stat-value dash-metric-value"><%= value %></p>
  <% if description.present? %>
    <p class="dash-metric-foot"><%= description %></p>
  <% end %>
<% end %>
