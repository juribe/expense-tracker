<%= maglev_section.wrapper_tag.section class: "section", id: "funciones" do %>
  <div class="container" id="funciones">
    <div class="section-head">
      <%= maglev_section.setting_tag :kicker, html_tag: "div", class: "kicker" %>
      <h2>
        <%= maglev_section.setting_tag :title, html_tag: "span" %><span class="gradient-text"><%= maglev_section.setting_tag :gradient_text, html_tag: "span" %></span>
      </h2>
      <%= maglev_section.setting_tag :description, html_tag: "p" %>
    </div>
    <div class="feature-grid">
      <% maglev_section.blocks.each do |maglev_block| %>
        <% next unless maglev_block.type == "item" %>
        <%= maglev_block.wrapper_tag.article class: "feature" do %>
          <div class="feature-icon <%= maglev_block.settings.color %>"><%= maglev_block.settings.icon %></div>
          <%= maglev_block.setting_tag :title, html_tag: "h3" %>
          <%= maglev_block.setting_tag :description, html_tag: "p" %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
