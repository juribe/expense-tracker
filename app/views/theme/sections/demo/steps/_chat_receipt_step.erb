<div class="demo-step s<%= pos %>">
  <span class="step-tag"><%= maglev_block.settings.tag %></span>
  <div class="chat-preview">
    <header>🟢 Yogasto <small>en línea</small></header>
    <div class="receipt-thumb">
      <div><%= maglev_block.settings.receipt_head %></div>
      <b><%= maglev_block.settings.receipt_business %></b>
      <strong><%= maglev_block.settings.receipt_amount %></strong>
      <small><%= maglev_block.settings.receipt_meta %></small>
    </div>
    <div class="chat-bubble user"><%= maglev_block.settings.bubble %></div>
  </div>
  <strong><%= maglev_block.settings.headline %></strong>
</div>
