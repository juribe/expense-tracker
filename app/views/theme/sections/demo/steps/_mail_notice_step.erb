<div class="demo-step s<%= pos %>">
  <span class="step-tag"><%= maglev_block.settings.tag %></span>
  <div class="mail-notice">
    <span class="bank-badge"><%= maglev_block.settings.bank_badge %></span>
    <div>
      <b><%= maglev_block.settings.bank_name %></b>
      <small><%= maglev_block.settings.bank_desc %></small>
