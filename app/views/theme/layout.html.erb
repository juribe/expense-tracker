<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="<%= maglev_page.meta_robots.presence || 'index,follow' %>">
    <title><%= [maglev_page.seo_title.presence, maglev_site.name].compact.first %> | Yogasto</title>

    <meta name="description" content="<%= maglev_page.meta_description %>">
    <meta property="og:title" content="<%= maglev_page.og_title.presence || maglev_page.seo_title %>">
    <meta property="og:description" content="<%= maglev_page.og_description.presence || maglev_page.meta_description %>">
    <% if maglev_page.og_image_url.present? %>
      <meta property="og:image" content="<%= maglev_page.og_image_url %>">
    <% end %>
    <meta property="og:type" content="<%= help_center_article_page?(maglev_page) ? "article" : "website" %>">
    <% if help_center_article_page?(maglev_page) %>
      <% article = help_center_article_index(maglev_page) %>
      <% if article&.published_at.present? %>
        <meta property="article:published_time" content="<%= article.published_at.iso8601 %>">
        <meta property="article:modified_time" content="<%= article.published_at.iso8601 %>">
      <% end %>
    <% end %>

    <%= canonical_and_og_url_tags(maglev_page) %>

    <%= render_maglev_alternate_links %>

    <% if help_center_page?(maglev_page) %>
      <%= render "theme/help_center/seo", page: maglev_page, site: maglev_site %>
    <% end %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :home, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :institutional, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :security, "data-turbo-track": "reload" if maglev_page.path == "seguridad" %>
    <%= stylesheet_link_tag :help_center, "data-turbo-track": "reload" if help_center_page?(maglev_page) %>
    <%= stylesheet_link_tag :privacy, "data-turbo-track": "reload" if legal_document_page?(maglev_page) %>
    <%= yield :head %>
  </head>
  <body class="<%= "security-page" if maglev_page.path == "seguridad" %>">
    <main data-maglev-dropzone>
      <% if help_center_page?(maglev_page) && (flash[:notice].present? || flash[:alert].present?) %>
        <div class="help-flash-wrap">
          <div class="help-center-container">
            <% if flash[:notice].present? %>
              <p class="help-flash help-flash--notice" role="status"><%= flash[:notice] %></p>
            <% end %>
            <% if flash[:alert].present? %>
              <p class="help-flash help-flash--alert" role="alert"><%= flash[:alert] %></p>
            <% end %>
          </div>
        </div>
      <% end %>
      <%= render_maglev_sections %>
    </main>

    <%= javascript_include_tag "home", defer: true %>
    <%= javascript_include_tag "contact_form", defer: true if maglev_page.path == "contact" %>
    <%= javascript_include_tag "help_center", defer: true if help_center_page?(maglev_page) %>
    <%= javascript_include_tag "privacy", defer: true if legal_document_page?(maglev_page) %>
    <%= javascript_include_tag "flash", defer: true %>
  </body>
</html>
