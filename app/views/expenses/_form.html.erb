<% form_title = @expense.new_record? ? t("expenses.new_title") : t("expenses.edit_title") %>
<% content_for(:title) { "#{form_title} - #{t("expenses.page_title")}" } %>
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <%= form_with model: @expense, local: true do |f| %>
        <div class="card">
          <%= render "shared/form_card_header",
                     title: form_title,
                     subtitle: t("expenses.form_subtitle"),
                     icon: "receipt",
                     tone: "red" %>
          <div class="card-body">
            <% if @expense.errors.any? %>
              <div class="alert alert-danger">
                <h6><%= t("expenses.form_errors_heading", count: @expense.errors.count) %></h6>
                <ul>
                  <% @expense.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :amount, class: "form-label" %>
                <div class="input-group">
                  <span class="input-group-text"><%= t("number.currency.format.unit") %></span>
                  <%= f.text_field :amount,
                                   value: money_field_value(@expense.amount&.abs),
                                   class: "form-control",
                                   placeholder: t("expenses.placeholder_amount"),
                                   inputmode: "decimal",
                                   autocomplete: "off",
                                   data: { money_input: true } %>
                </div>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :date, class: "form-label" %>
                <%= f.date_field :date, class: "form-control" %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :description, class: "form-label" %>
              <%= f.text_area :description, class: "form-control", rows: 2, placeholder: t("expenses.description_placeholder") %>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= category_picker f, :category_id, @categories,
                                    label: t("common.category"),
                                    include_blank: t("common.none"),
                                    testid: "expense-category-picker" %>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :money_source_id, t("expenses.source"), class: "form-label" %>
                <%= f.collection_select :money_source_id, @money_sources, :id, :display_name,
                                        { include_blank: t("expenses.money_source_placeholder", default: "¿Con qué se pagó?") },
                                        { required: true, class: "form-select" } %>
              </div>
            </div>
          </div>

          <%= render "shared/form_actions", cancel_path: expenses_path do %>
            <%= f.submit t("common.save"), class: "btn btn-primary" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
