<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0"><%= @expense.new_record? ? 'New' : 'Edit' %> Expense</h4>
        </div>
        <div class="card-body">
          <%= form_with model: @expense, local: true do |f| %>
            <% if @expense.errors.any? %>
              <div class="alert alert-danger">
                <h6><%= pluralize(@expense.errors.count, "error") %> prohibited this expense from being saved:</h6>
                <ul>
                  <% @expense.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :amount, class: "form-label" %>
                <div class="input-group">
                  <span class="input-group-text">$</span>
                  <%= f.text_field :amount,
                                   value: money_field_value(@expense.amount&.abs),
                                   class: "form-control",
                                   placeholder: "0.00",
                                   inputmode: "decimal",
                                   autocomplete: "off",
                                   data: { money_input: true } %>
                </div>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :date, class: "form-label" %>
                <%= f.date_field :date, class: "form-control" %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :description, class: "form-label" %>
              <%= f.text_area :description, class: "form-control", rows: 2, placeholder: "What did you spend on?" %>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :category_id, "Category", class: "form-label" %>
                <%= f.collection_select :category_id, @categories, :id, :name, {}, class: "form-select" %>
              </div>
            </div>

            <div class="d-grid">
              <%= f.submit class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
