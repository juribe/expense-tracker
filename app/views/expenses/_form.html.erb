<% content_for(:title) { (@expense.new_record? ? t("common.new") : t("common.edit")) + " - " + t("expenses.page_title") } rescue nil %>
<%= render "shared/page_header", title: (@expense.new_record? ? t("common.new") : t("common.edit")) + " " + t("expenses.page_title").downcase %>
<div class="app-container mx-auto" style="max-width: 760px;">
  <div class="card">
    <div class="card-body p-4">
          <%= form_with model: @expense, local: true do |f| %>
            <% if @expense.errors.any? %>
              <div class="alert alert-danger">
                <h6><%= t("expenses.form_errors_heading", count: @expense.errors.count) %></h6>
                <ul>
                  <% @expense.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :amount, class: "form-label" %>
                <div class="input-group">
                  <span class="input-group-text"><%= t("number.currency.format.unit") %></span>
                  <%= f.text_field :amount,
                                   value: money_field_value(@expense.amount&.abs),
                                   class: "form-control",
                                   placeholder: t("expenses.placeholder_amount"),
                                   inputmode: "decimal",
                                   autocomplete: "off",
                                   data: { money_input: true } %>
                </div>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :date, class: "form-label" %>
                <%= f.date_field :date, class: "form-control" %>
              </div>
            </div>

            <div class="mb-3">
                <%= f.label :description, class: "form-label" %>
                <%= f.text_area :description, class: "form-control", rows: 2, placeholder: t("expenses.description_placeholder") %>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= category_picker f, :category_id, @categories,
                                    label: t("common.category"),
                                    include_blank: t("common.none"),
                                    testid: "expense-category-picker" %>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :money_source_id, t("expenses.source"), class: "form-label" %>
                <%= f.collection_select :money_source_id, @money_sources, :id, :display_name, { include_blank: t("common.none") }, class: "form-select" %>
              </div>
            </div>

            <div class="d-flex gap-2">
              <%= f.submit t("common.save"), class: "btn btn-primary" %>
              <%= link_to t("common.cancel", default: "Cancelar"), expenses_path, class: "btn btn-outline-secondary" %>
            </div>
        <% end %>
    </div>
  </div>
</div>
