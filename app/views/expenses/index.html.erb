<% subtitle = capture do %>
  <% if @cycle_filter %>
    <span class="badge bg-light text-dark border" data-testid="cycle-badge">
      <i class="ti ti-calendar-plus me-1"></i><%= @cycle_filter.label %> (<%= @cycle_filter.range_label %>)
    </span>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("expenses.page_title"), subtitle: subtitle do %>
  <div class="d-flex flex-column flex-sm-row gap-2">
    <%= link_to transaction_rules_path, class: "btn btn-outline-secondary" do %>
      <i class="ti ti-wand me-1"></i> <%= t("expenses.automatic_rules") %>
    <% end %>
    <%= link_to monthly_expenses_path, class: "btn btn-outline-secondary" do %>
      <i class="ti ti-arrow-up-circle me-1"></i> <%= t("expenses.monthly") %>
    <% end %>
    <% if @total_count.to_i > 0 %>
      <%= link_to expenses_path(page_params.merge(format: :csv)), class: "btn btn-outline-secondary" do %>
        <i class="ti ti-download me-1"></i><%= t("expenses.export_csv") %>
      <% end %>
    <% else %>
      <button type="button" class="btn btn-outline-secondary" aria-disabled="true" disabled title="<%= t('expenses.nothing_to_export') %>">
        <i class="ti ti-download me-1"></i><%= t("expenses.export_csv") %>
      </button>
    <% end %>
    <%= link_to new_expense_path, class: "btn btn-primary" do %>
      <i class="ti ti-plus me-1"></i> <%= t("expenses.add_expense") %>
    <% end %>
  </div>
<% end %>
  <%= render "expenses/ai_entry", categories: @categories %>

  <!-- Filters -->
  <div class="card expenses-panel filters-panel" id="filterCard" data-testid="filter-card">
    <button type="button" class="filter-toggle" id="filterToggle"
            aria-expanded="false" aria-controls="filterPanel" data-testid="filter-toggle">
      <span class="filter-icon" aria-hidden="true"><i class="ti ti-filter"></i></span>
      <span class="filter-title"><%= t("expenses.filter_heading") %></span>
      <span class="filter-summary" id="filterSummary"><%= expenses_filter_summary %></span>
      <i class="ti ti-chevron-down filter-chevron" aria-hidden="true"></i>
    </button>

    <% if filter_params.any? { |_k, v| v.present? } || params[:money_source_id].present? %>
      <div id="chips" class="expenses-active-filters">
        <% { q: t("expenses.search_label"), category_id: t("common.category"), money_source_id: t("expenses.source_label"), start_date: t("expenses.from"), end_date: t("expenses.to"), min_amount: t("expenses.min_amount_label"), max_amount: t("expenses.max_amount_label") }.each do |key, label| %>
          <% value = params[key] %>
          <% next if value.blank? %>
          <% chip_label = key == :category_id ? @categories.find { |c| c.id.to_s == value.to_s }&.name : key == :money_source_id ? @money_sources.find { |s| s.id.to_s == value.to_s }&.name : value %>
          <%= link_to expenses_path(sort_params.except(key)), class: "chip expenses-chip text-decoration-none", data: { testid: "chip-#{key}" }, aria: { label: t("expenses.remove_filter", label: label) } do %>
            <%= label %>: <%= chip_label %>
            <button type="button" aria-hidden="true" tabindex="-1" class="ms-1">&times;</button>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="filter-panel" id="filterPanel" hidden data-testid="filter-panel">
      <div class="card-body">
        <%= form_with url: expenses_path, method: :get, class: "expenses-filters row g-3", data: { testid: "filter-form" } do |f| %>
        <div class="col-md-4 expenses-field">
          <%= category_picker f, :category_id, @categories,
                              label: t("common.category"),
                              include_blank: t("expenses.all_categories"),
                              placeholder: t("expenses.all_categories"),
                              value: params[:category_id],
                              testid: "expense-filter-category-picker" %>
        </div>
        <div class="col-md-4 expenses-field">
          <%= f.label :money_source_id, t("expenses.source_label"), class: "form-label" %>
          <div class="expenses-control">
            <%= f.collection_select :money_source_id, @money_sources, :id, :display_name, { include_blank: t("expenses.all_sources"), selected: params[:money_source_id] } %>
          </div>
        </div>
        <div class="col-md-4 expenses-field">
          <%= f.label :q, t("expenses.search_label"), class: "form-label" %>
          <div class="expenses-control">
            <%= f.search_field :q,
                               value: params[:q],
                               placeholder: t("expenses.search_placeholder"),
                               class: "form-control",
                               autocomplete: "off",
                               data: { testid: "expense-search" } %>
          </div>
        </div>
        <div class="col-md-2 expenses-field">
          <%= f.label :start_date, t("expenses.from"), class: "form-label" %>
          <div class="expenses-control">
            <%= f.date_field :start_date, value: params[:start_date], class: "form-control#{' is-invalid' if @filter_errors[:start_date]}", aria: ({ invalid: "true" } if @filter_errors[:start_date]) %>
          </div>
          <% if @filter_errors[:start_date] %><div class="invalid-feedback"><%= @filter_errors[:start_date] %></div><% end %>
        </div>
        <div class="col-md-2 expenses-field">
          <%= f.label :end_date, t("expenses.to"), class: "form-label" %>
          <div class="expenses-control">
            <%= f.date_field :end_date, value: params[:end_date], class: "form-control#{' is-invalid' if @filter_errors[:end_date]}", aria: ({ invalid: "true" } if @filter_errors[:end_date]) %>
          </div>
          <% if @filter_errors[:end_date] %><div class="invalid-feedback"><%= @filter_errors[:end_date] %></div><% end %>
        </div>
        <div class="col-md-2 expenses-field">
          <%= f.label :min_amount, class: "form-label" do %>
            <%= t("expenses.min_amount_label") %> <span class="hint"><%= t("expenses.amount_hint") %></span>
          <% end %>
          <div class="input-group expenses-control">
            <span class="prefix"><%= t("number.currency.format.unit") %></span>
          <%= f.text_field :min_amount,
                             value: money_field_value(params[:min_amount]),
                             placeholder: t("expenses.min_placeholder"),
                             class: "form-control#{' is-invalid' if @filter_errors[:min_amount]}",
                             aria: ({ invalid: "true" } if @filter_errors[:min_amount]),
                             inputmode: "decimal",
                             autocomplete: "off",
                             data: { money_input: true } %>
          </div>
          <% if @filter_errors[:min_amount] %><div class="invalid-feedback"><%= @filter_errors[:min_amount] %></div><% end %>
        </div>
        <div class="col-md-2 expenses-field">
          <%= f.label :max_amount, class: "form-label" do %>
            <%= t("expenses.max_amount_label") %> <span class="hint"><%= t("expenses.amount_hint") %></span>
          <% end %>
          <div class="input-group expenses-control">
            <span class="prefix"><%= t("number.currency.format.unit") %></span>
            <%= f.text_field :max_amount,
                             value: money_field_value(params[:max_amount]),
                             placeholder: t("expenses.max_placeholder"),
                             class: "form-control",
                             inputmode: "decimal",
                             autocomplete: "off",
                             data: { money_input: true } %>
          </div>
        </div>
        <div class="col-md-4 d-flex align-items-end">
          <div class="expenses-filter-actions">
            <%= f.submit t("expenses.apply_filters"), class: "btn btn-outline-primary" %>
            <%= link_to t("expenses.clear_filters"), expenses_path, class: "btn btn-outline-secondary" %>
          </div>
        </div>
      <% end %>

      <% if @filter_errors.any? %>
        <div class="alert alert-danger alert-dismissible fade show mt-3 mb-0" role="alert">
          <%= t("expenses.filter_errors_heading") %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('common.close') %>"></button>
        </div>
      <% end %>
      </div>
    </div>
  </div>

  <% if @load_error %>
    <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert" data-testid="error">
      <span><%= t("expenses.load_error") %></span>
      <%= link_to t("expenses.retry"), expenses_path(state_query), class: "btn btn-sm btn-outline-danger" %>
    </div>
  <% end %>

  <div class="d-flex justify-content-between align-items-baseline mb-2 expenses-results-head">
    <p class="results-meta mb-0" id="resultsMeta" aria-live="polite">
      <%= t("expenses.results_meta", count: @total_count, total: number_to_currency(@filtered_total)) %>
    </p>
    <span class="small text-muted d-none d-md-inline"><%= t("expenses.per_page", count: 25) %></span>
  </div>

  <div class="bulk-bar expenses-bulk" id="bulkBar" role="region" aria-label="<%= t('expenses.bulk_actions_label') %>" data-testid="bulk-bar">
    <strong id="bulkCount" aria-live="polite"><%= t("expenses.bulk_selected", count: 0) %></strong>
    <button type="button" class="btn btn-sm btn-outline-primary" id="bulkCategory" data-testid="bulk-category" disabled>
      <i class="ti ti-tags me-1"></i><%= t("expenses.bulk_category_button") %>
    </button>
    <button type="button" class="btn btn-sm btn-outline-primary" id="bulkSource" data-testid="bulk-source" disabled>
      <i class="ti ti-wallet me-1"></i><%= t("expenses.bulk_source_button") %>
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="clearSel" disabled><%= t("common.clear") %></button>
    <button type="button" class="btn btn-sm btn-danger ms-auto" id="bulkDelete" disabled><i class="ti ti-trash me-1"></i><%= t("expenses.delete_selected") %></button>
  </div>

  <div class="card expenses-table-wrap" id="tableCard">
    <% if @load_error %>
    <% elsif @total_count == 0 && !filter_params.any? { |_k, v| v.present? } %>
      <div class="p-5 text-center" data-testid="empty">
        <i class="ti ti-inbox display-4 text-muted mb-3 d-block"></i>
        <h2 class="h4 mb-2"><%= t("expenses.empty_title") %></h2>
        <p class="text-muted mb-0"><%= t("expenses.empty_body") %></p>
        <%= link_to new_expense_path, class: "btn btn-primary mt-3" do %>
          <i class="ti ti-plus me-1"></i> <%= t("expenses.add_expense") %>
        <% end %>
      </div>
    <% elsif @total_count == 0 %>
      <div class="p-5 text-center" data-testid="empty">
        <i class="ti ti-filter display-4 text-muted mb-3 d-block"></i>
        <h2 class="h4 mb-2"><%= t("expenses.no_results_title") %></h2>
        <p class="text-muted mb-0"><%= t("expenses.no_results_body") %></p>
        <%= link_to t("expenses.clear_filters"), expenses_path, class: "btn btn-outline-secondary mt-3" %>
      </div>
    <% else %>
      <div data-testid="table">
        <div class="desktop-table">
          <table class="table table-hover ledger-table align-middle mb-0" id="expenseTable" aria-busy="false">
            <caption class="visually-hidden"><%= t("expenses.table_caption") %></caption>
            <thead class="table-light">
              <tr>
                <th scope="col" class="et-w-2-5rem">
                  <input type="checkbox" class="form-check-input" id="selectAll" aria-label="<%= t('expenses.select_all') %>">
                </th>
                <%= sortable_column_header(t("common.date"), "date", current_sort: @sort, current_dir: @dir) %>
                <%= sortable_column_header(t("common.description"), "description", current_sort: @sort, current_dir: @dir) %>
                <%= sortable_column_header(t("common.category"), "category", current_sort: @sort, current_dir: @dir) %>
                <th scope="col"><%= t("expenses.source") %></th>
                <%= sortable_column_header(t("common.amount"), "amount", current_sort: @sort, current_dir: @dir) %>
                <th scope="col" class="text-end"><span class="visually-hidden"><%= t("common.actions") %></span></th>
              </tr>
            </thead>
            <tbody id="tableBody">
              <% @expenses.each do |expense| %>
                <%- decorated = ExpenseDecorator.new(expense) -%>
                <tr data-id="<%= expense.id %>" tabindex="0" data-testid="row"
                    data-category-id="<%= expense.category_id %>"
                    data-recurring-id="<%= expense.recurring_template_id %>"
                    data-amount="<%= expense.amount.to_d.to_s("F") %>"
                    data-view-url="<%= expense_path(expense) %>"
                    data-edit-url="<%= edit_expense_path(expense, state_query) %>"
                    data-delete-url="<%= expense_path(expense, state_query) %>">
                  <td>
                    <input type="checkbox" class="form-check-input row-check"
                           aria-label="<%= t('expenses.select_expense', date: l(expense.date, format: :short), description: decorated.lowercase_description) %>">
                  </td>
                  <td class="text-nowrap"><%= l(expense.date, format: :short) %></td>
                  <td class="desc-cell" title="<%= expense.description %>">
                    <% if expense.description.present? %>
                      <%= expense.description %>
                    <% else %>
                      <span class="text-muted"><%= t("expenses.no_description") %></span>
                    <% end %>
                  </td>
                  <td><%= category_badge(expense.category) %></td>
                  <td><%= money_source_badge(expense.money_source) %></td>
                  <td class="text-end amount"><%= number_to_currency(expense.amount) %></td>
                  <td class="text-end text-nowrap" data-stop="1">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-open-drawer
                            aria-label="<%= t('expenses.view_expense', description: decorated.lowercase_description) %>">
                      <i class="ti ti-eye"></i>
                    </button>
                    <% if expense.recurring_template_id.nil? %>
                      <button type="button" class="btn btn-sm btn-outline-primary" data-assign-recurring
                              data-testid="row-assign-recurring"
                              aria-label="<%= t('expenses.assign_recurring.row_button_aria', description: decorated.lowercase_description) %>">
                        <i class="ti ti-repeat"></i>
                      </button>
                    <% end %>
                    <%= link_to edit_expense_path(expense, state_query), class: "btn btn-sm btn-outline-primary",
                                aria: { label: t("expenses.edit_expense", description: decorated.lowercase_description) } do %>
                      <i class="ti ti-pencil"></i>
                    <% end %>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-delete
                            data-delete-url="<%= expense_path(expense, state_query) %>"
                            aria-label="<%= t('expenses.delete_expense', description: decorated.lowercase_description) %>">
                      <i class="ti ti-trash"></i>
                    </button>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="mobile-list" id="mobileList">
          <% @expenses.each do |expense| %>
            <%- decorated = ExpenseDecorator.new(expense) -%>
            <div class="mobile-item" data-id="<%= expense.id %>" tabindex="0" data-testid="row"
                 data-category-id="<%= expense.category_id %>"
                 data-recurring-id="<%= expense.recurring_template_id %>"
                 data-amount="<%= expense.amount.to_d.to_s("F") %>"
                 data-view-url="<%= expense_path(expense) %>"
                 data-edit-url="<%= edit_expense_path(expense, state_query) %>"
                 data-delete-url="<%= expense_path(expense, state_query) %>">
              <input type="checkbox" class="form-check-input row-check mt-2"
                     aria-label="<%= t('expenses.select_expense', date: l(expense.date, format: :short), description: decorated.lowercase_description) %>">
              <div>
                <div class="small text-muted"><%= l(expense.date, format: :short) %> · <%= category_badge(expense.category) %> · <%= money_source_badge(expense.money_source) %></div>
                <div class="mt-1">
                  <% if expense.description.present? %>
                    <%= expense.description %>
                  <% else %>
                    <span class="text-muted"><%= t("expenses.no_description") %></span>
                  <% end %>
                </div>
              </div>
              <div class="text-end">
                <div class="amount"><%= number_to_currency(expense.amount) %></div>
                <div class="mobile-actions mt-2" data-stop="1">
                  <button type="button" class="btn btn-outline-secondary" data-open-drawer
                          aria-label="<%= t('expenses.view_expense', description: decorated.lowercase_description) %>">
                    <i class="ti ti-eye"></i>
                  </button>
                  <% if expense.recurring_template_id.nil? %>
                    <button type="button" class="btn btn-outline-primary" data-assign-recurring
                            aria-label="<%= t('expenses.assign_recurring.row_button_aria', description: decorated.lowercase_description) %>">
                      <i class="ti ti-repeat"></i>
                    </button>
                  <% end %>
                  <%= link_to edit_expense_path(expense, state_query), class: "btn btn-outline-primary",
                              aria: { label: t("expenses.edit_expense", description: decorated.lowercase_description) } do %>
                    <i class="ti ti-pencil"></i>
                  <% end %>
                  <button type="button" class="btn btn-outline-danger" data-delete
                            data-delete-url="<%= expense_path(expense, state_query) %>"
                            aria-label="<%= t('expenses.delete_expense', description: decorated.lowercase_description) %>">
                    <i class="ti ti-trash"></i>
                  </button>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top small text-muted">
          <span id="pageFoot">
            <%= t("expenses.page_info", offset: @expenses.offset_value + 1, last: @expenses.offset_value + @expenses.length, total: @total_count, page_subtotal: number_to_currency(@page_subtotal), filtered_total: number_to_currency(@filtered_total)) %>
          </span>
        </div>
        <%= will_paginate @expenses, renderer: WillPaginate::ActionView::BootstrapLinkRenderer, previous_label: t("common.previous"), next_label: t("common.next") if @expenses.total_pages > 1 %>
      </div>
    <% end %>
  </div>

<!-- Skeleton de carga mostrado mientras Turbo carga la siguiente página de gastos -->
<div id="loadingState" class="d-none" aria-busy="true" data-testid="loading">
  <div class="card p-3">
    <div class="skel mb-3"></div>
    <div class="skel mb-3 et-skel-90"></div>
    <div class="skel mb-3 et-skel-80"></div>
    <div class="skel mb-3"></div>
    <div class="skel mb-3 et-skel-70"></div>
    <div class="skel mb-3"></div>
    <div class="skel et-skel-85"></div>
  </div>
</div>

<!-- Panel de detalle del gasto -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="detailDrawer" aria-labelledby="drawerTitle">
  <div class="offcanvas-header expense-drawer-header border-bottom">
    <div class="d-flex align-items-center gap-3">
      <span class="drawer-heading-icon"><i class="ti ti-receipt-2"></i></span>
      <div>
        <h2 class="offcanvas-title drawer-title mb-0" id="drawerTitle">Detalle del gasto</h2>
        <div class="drawer-subtitle">Información del movimiento registrado</div>
      </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
  </div>
  <div class="offcanvas-body" id="drawerBody"></div>
  <div class="offcanvas-footer expense-drawer-footer border-top d-flex flex-wrap">
    <a href="#" class="btn btn-drawer-edit" id="drawerEdit"><i class="ti ti-pencil me-1"></i>Editar</a>
    <button type="button" class="btn btn-drawer-delete" id="drawerDelete"><i class="ti ti-trash me-1"></i>Eliminar</button>
    <button type="button" class="btn btn-drawer-close ms-auto" data-bs-dismiss="offcanvas">Cerrar</button>
  </div>
</div>

<%= form_with url: "#", method: :delete, id: "deleteForm", class: "d-none" do %>
  <input type="hidden" name="ids" id="deleteIds">
<% end %>

<!-- Modal de confirmación de actualización en lote (Cambiar Categoría / Cambiar Fuente de Dinero / ambos) -->
<%= form_with url: bulk_update_expenses_path, method: :patch, id: "bulkEditForm", data: { testid: "bulk-update-form" } do |f| %>
  <div class="modal fade" id="bulkEditModal" tabindex="-1" aria-labelledby="bulkEditTitle" aria-hidden="true" data-testid="bulk-update-modal">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title h5" id="bulkEditTitle">Editar gastos</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <%= hidden_field_tag :expense_ids, nil, id: "bulkExpenseIds" %>
          <p class="text-muted" id="bulkEditSummary">Actualiza los gastos seleccionados.</p>
          <div class="mb-3">
            <%= category_picker f, :category_id, @categories,
                                label: "Nueva Categoría",
                                include_blank: "Sin cambios",
                                id: "bulkCategorySelect",
                                testid: "bulk-category-picker" %>
            <div class="invalid-feedback" id="bulkCategoryFeedback">Elige una categoría y/o una fuente de dinero para actualizar.</div>
          </div>
          <div class="mb-3">
            <label for="bulkSourceSelect" class="form-label">Nueva Fuente de Dinero</label>
            <select id="bulkSourceSelect" name="money_source_id" class="form-select" data-testid="bulk-source-select">
              <option value="">Sin cambios</option>
              <% @money_sources.each do |source| %>
                <option value="<%= source.id %>"><%= source.display_name %></option>
              <% end %>
            </select>
            <div class="invalid-feedback" id="bulkSourceFeedback">Elige una categoría y/o una fuente de dinero para actualizar.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="confirmBulkEdit" data-testid="confirm-bulk-update" disabled>
            <i class="ti ti-check me-1"></i>Actualizar gastos
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%= render "shared/process_recurring_modal",
           modal_id: "expenseProcessModal",
           title_id: "expenseProcessTitle",
           title: "Confirmar Pago",
           form_id: "expenseProcessForm",
           category_id: "expenseProcessCategory",
           description_id: "expenseProcessDescription",
           configured_amount_id: "expenseProcessConfiguredAmount",
           date_input_id: "expenseProcessDate",
           amount_input_id: "expenseProcessAmount",
           confirm_id: "expenseProcessConfirm",
           confirm_testid: "confirm-expense-process",
           confirm_label: "Confirmar Pago",
           back_label: "Volver",
           amount_hint: nil,
           testid: "expense-process-modal" %>

<!-- Modal: aplicar un gasto existente a una plantilla recurrente -->
<%= form_with url: assign_recurring_expenses_path, method: :post, id: "bulkRecurringForm", data: { testid: "assign-recurring-form" } do %>
  <div class="modal fade" id="bulkRecurringModal" tabindex="-1" aria-labelledby="bulkRecurringTitle" aria-hidden="true" data-testid="assign-recurring-modal">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title h5" id="bulkRecurringTitle"><%= t("expenses.assign_recurring.modal_title", default: "Aplicar a gasto recurrente") %></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <%= hidden_field_tag :expense_id, nil, id: "recurringExpenseId" %>
          <p class="text-muted mb-3"><%= t("expenses.assign_recurring.modal_hint", default: "El gasto seleccionado queda registrado como el pago del gasto recurrente para su mes (la plantilla pasará a \"Pagado\").") %></p>
          <div class="mb-0">
            <label for="bulkRecurringSelect" class="form-label"><%= t("expenses.assign_recurring.template_label", default: "Gasto recurrente") %></label>
            <select id="bulkRecurringSelect" name="recurring_template_id" class="form-select" required>
              <option value=""><%= t("expenses.assign_recurring.choose_template", default: "Selecciona una plantilla...") %></option>
              <% @recurring_templates.each do |template| %>
                <% paid = @paid_template_ids.include?(template.id) %>
                <% paid_total = @recurring_template_paid_totals[template.id].to_d %>
                <% remaining = [template.amount.to_d - paid_total, BigDecimal("0")].max %>
                <option value="<%= template.id %>"
                        data-category-id="<%= template.category_id %>"
                        data-amount="<%= template.amount.to_d.to_s("F") %>"
                        data-paid="<%= paid_total.to_s("F") %>"
                        data-expected-label="<%= number_to_currency(template.amount) %>"
                        data-paid-label="<%= number_to_currency(paid_total) %>"
                        data-remaining-label="<%= number_to_currency(remaining) %>"
                        <%= "disabled" if paid %>>
                  <%= recurring_template_option_label(template) %><%= t("expenses.assign_recurring.paid_suffix") if paid %>
                </option>
              <% end %>
            </select>
          </div>

          <div id="recurringTemplateDetails" class="border rounded p-3 mt-3 d-none" data-testid="recurring-template-details">
            <div class="d-flex justify-content-between small mb-1">
              <span class="text-muted"><%= t("expenses.assign_recurring.expected_amount", default: "Monto esperado") %></span>
              <strong id="recurringExpectedAmount"></strong>
            </div>
            <div class="d-flex justify-content-between small mb-1">
              <span class="text-muted"><%= t("expenses.assign_recurring.already_registered", default: "Ya registrado este período") %></span>
              <span id="recurringPaidAmount"></span>
            </div>
            <div class="d-flex justify-content-between small mb-2">
              <span class="text-muted"><%= t("expenses.assign_recurring.remaining", default: "Restante") %></span>
              <span id="recurringRemainingAmount"></span>
            </div>
            <%= hidden_field_tag :completed, "0", id: "recurringCompletedHidden" %>
            <div class="form-check mb-0">
              <input class="form-check-input" type="checkbox" id="recurringCompleted" name="completed" value="1" checked>
              <label class="form-check-label small" for="recurringCompleted">
                <%= t("expenses.assign_recurring.completed_label", default: "Este gasto completa el período") %>
              </label>
              <div class="form-text small"><%= t("expenses.assign_recurring.completed_hint", default: "Desmárcalo para un pago parcial y asignar más gastos al mismo período.") %></div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t("common.cancel") %></button>
          <button type="submit" class="btn btn-primary" id="confirmBulkRecurring" data-testid="confirm-assign-recurring" disabled>
            <i class="ti ti-check me-1"></i><%= t("expenses.assign_recurring.apply_button", default: "Aplicar") %>
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%= tag.div class: "d-none", data: { expenses_table_payload: {
      bulk_update_url: bulk_update_expenses_path,
      assign_recurring_url: assign_recurring_expenses_path,
      bulk_destroy_url: bulk_destroy_expenses_path,
      same_category_group_label: t("expenses.assign_recurring.same_category_group", default: "Misma categoría"),
      today: Date.current.strftime("%F")
} } %>
<%= javascript_include_tag "expenses_table", defer: true %>
<%= javascript_include_tag "expenses_filters", defer: true %>

