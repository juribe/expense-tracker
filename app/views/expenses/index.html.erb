<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="mb-0"><i class="bi bi-receipt me-2"></i><%= t("expenses.page_title") %></h1>
    <div class="d-flex gap-2 header-actions flex-column flex-sm-row">
      <%= link_to transaction_rules_path, class: "btn btn-outline-primary" do %>
        <i class="bi bi-magic me-1"></i> <%= t("expenses.automatic_rules") %>
      <% end %>
      <%= link_to monthly_expenses_path, class: "btn btn-outline-primary" do %>
        <i class="bi bi-arrow-up-circle me-1"></i> <%= t("expenses.monthly") %>
      <% end %>
      <% if @total_count.to_i > 0 %>
        <%= link_to expenses_path(page_params.merge(format: :csv)), class: "btn btn-outline-secondary" do %>
          <i class="bi bi-download me-1"></i><%= t("expenses.export_csv") %>
        <% end %>
      <% else %>
        <button type="button" class="btn btn-outline-secondary" aria-disabled="true" disabled title="<%= t('expenses.nothing_to_export') %>">
          <i class="bi bi-download me-1"></i><%= t("expenses.export_csv") %>
        </button>
      <% end %>
      <%= link_to new_expense_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg me-1"></i> <%= t("expenses.add_expense") %>
      <% end %>
    </div>
  </div>

  <%= render "expenses/ai_entry", categories: @categories %>

  <!-- Filters -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <%= form_with url: expenses_path, method: :get, class: "row g-3", data: { testid: "filter-form" } do |f| %>
        <div class="col-12 col-md-4 col-lg-2">
          <%= category_picker f, :category_id, @categories,
                              label: t("common.category"),
                              include_blank: t("expenses.all_categories"),
                              placeholder: t("expenses.all_categories"),
                              value: params[:category_id],
                              testid: "expense-filter-category-picker" %>
        </div>
        <div class="col-12 col-md-4 col-lg-2">
          <%= f.label :money_source_id, t("expenses.source"), class: "form-label" %>
          <%= f.collection_select :money_source_id, @money_sources, :id, :display_name, { include_blank: t("expenses.all_sources") }, class: "form-select" %>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <%= f.label :start_date, t("expenses.from"), class: "form-label" %>
          <%= f.date_field :start_date, value: params[:start_date], class: "form-control#{' is-invalid' if @filter_errors[:start_date]}", aria: ({ invalid: "true" } if @filter_errors[:start_date]) %>
          <% if @filter_errors[:start_date] %><div class="invalid-feedback"><%= @filter_errors[:start_date] %></div><% end %>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <%= f.label :end_date, t("expenses.to"), class: "form-label" %>
          <%= f.date_field :end_date, value: params[:end_date], class: "form-control#{' is-invalid' if @filter_errors[:end_date]}", aria: ({ invalid: "true" } if @filter_errors[:end_date]) %>
          <% if @filter_errors[:end_date] %><div class="invalid-feedback"><%= @filter_errors[:end_date] %></div><% end %>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <%= f.label :min_amount, t("expenses.min_amount_label"), class: "form-label" %>
          <div class="input-group">
            <span class="input-group-text"><%= t("number.currency.format.unit") %></span>
          <%= f.text_field :min_amount,
                             value: money_field_value(params[:min_amount]),
                             placeholder: t("expenses.placeholder_amount"),
                             class: "form-control#{' is-invalid' if @filter_errors[:min_amount]}",
                             aria: ({ invalid: "true" } if @filter_errors[:min_amount]),
                             inputmode: "decimal",
                             autocomplete: "off",
                             data: { money_input: true } %>
          </div>
          <% if @filter_errors[:min_amount] %><div class="invalid-feedback"><%= @filter_errors[:min_amount] %></div><% end %>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <%= f.label :max_amount, t("expenses.max_amount_label"), class: "form-label" %>
          <div class="input-group">
            <span class="input-group-text"><%= t("number.currency.format.unit") %></span>
            <%= f.text_field :max_amount,
                             value: money_field_value(params[:max_amount]),
                             placeholder: t("expenses.placeholder_amount"),
                             class: "form-control",
                             inputmode: "decimal",
                             autocomplete: "off",
                             data: { money_input: true } %>
          </div>
        </div>
        <div class="col-12 d-flex gap-2">
          <%= f.submit t("common.filter"), class: "btn btn-outline-primary" %>
          <%= link_to t("common.clear"), expenses_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>

      <% if @filter_errors.any? %>
        <div class="alert alert-danger alert-dismissible fade show mt-3 mb-0" role="alert">
          <%= t("expenses.filter_errors_heading") %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('common.close') %>"></button>
        </div>
      <% end %>

      <% if filter_params.any? { |_k, v| v.present? } %>
        <div id="chips" class="mt-3">
          <% { category_id: t("common.category"), money_source_id: t("expenses.source"), start_date: t("expenses.from"), end_date: t("expenses.to"), min_amount: t("expenses.min_amount_label"), max_amount: t("expenses.max_amount_label") }.each do |key, label| %>
            <% value = params[key] %>
            <% next if value.blank? %>
            <% chip_label = key == :category_id ? @categories.find { |c| c.id.to_s == value.to_s }&.name : key == :money_source_id ? @money_sources.find { |s| s.id.to_s == value.to_s }&.name : value %>
            <%= link_to expenses_path(sort_params.except(key)), class: "chip text-decoration-none", data: { testid: "chip-#{key}" }, aria: { label: t("expenses.remove_filter", label: label) } do %>
              <%= label %>: <%= chip_label %>
              <button type="button" aria-hidden="true" tabindex="-1" class="ms-1">&times;</button>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <% if @load_error %>
    <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert" data-testid="error">
      <span><%= t("expenses.load_error") %></span>
      <%= link_to t("expenses.retry"), expenses_path(state_query), class: "btn btn-sm btn-outline-danger" %>
    </div>
  <% end %>

  <div class="d-flex justify-content-between align-items-baseline mb-2">
    <p class="results-meta mb-0" id="resultsMeta" aria-live="polite">
      <%= t("expenses.results_meta", count: @total_count, total: number_to_currency(@filtered_total)) %>
    </p>
    <span class="small text-muted d-none d-md-inline"><%= t("expenses.per_page", count: 25) %></span>
  </div>

  <div class="bulk-bar" id="bulkBar" role="region" aria-label="<%= t('expenses.bulk_actions_label') %>" data-testid="bulk-bar">
    <strong id="bulkCount" aria-live="polite"><%= t("expenses.bulk_selected", count: 0) %></strong>
    <button type="button" class="btn btn-sm btn-outline-primary" id="bulkCategory" data-testid="bulk-category" disabled>
      <i class="bi bi-tags me-1"></i><%= t("expenses.bulk_category_button") %>
    </button>
    <button type="button" class="btn btn-sm btn-outline-primary" id="bulkSource" data-testid="bulk-source" disabled>
      <i class="bi bi-wallet2 me-1"></i><%= t("expenses.bulk_source_button") %>
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="clearSel" disabled><%= t("common.clear") %></button>
    <button type="button" class="btn btn-sm btn-danger ms-auto" id="bulkDelete" disabled><i class="bi bi-trash me-1"></i><%= t("expenses.delete_selected") %></button>
  </div>

  <div class="card shadow-sm" id="tableCard">
    <% if @load_error %>
    <% elsif @total_count == 0 && !filter_params.any? { |_k, v| v.present? } %>
      <div class="p-5 text-center" data-testid="empty">
        <i class="bi bi-inbox display-4 text-muted mb-3 d-block"></i>
        <h2 class="h4 mb-2"><%= t("expenses.empty_title") %></h2>
        <p class="text-muted mb-0"><%= t("expenses.empty_body") %></p>
        <%= link_to new_expense_path, class: "btn btn-primary mt-3" do %>
          <i class="bi bi-plus-lg me-1"></i> <%= t("expenses.add_expense") %>
        <% end %>
      </div>
    <% elsif @total_count == 0 %>
      <div class="p-5 text-center" data-testid="empty">
        <i class="bi bi-funnel display-4 text-muted mb-3 d-block"></i>
        <h2 class="h4 mb-2"><%= t("expenses.no_results_title") %></h2>
        <p class="text-muted mb-0"><%= t("expenses.no_results_body") %></p>
        <%= link_to t("expenses.clear_filters"), expenses_path, class: "btn btn-outline-secondary mt-3" %>
      </div>
    <% else %>
      <div data-testid="table">
        <div class="table-responsive desktop-table">
          <table class="table table-hover align-middle mb-0" id="expenseTable" aria-busy="false">
            <caption class="visually-hidden"><%= t("expenses.table_caption") %></caption>
            <thead class="table-light">
              <tr>
                <th scope="col" style="width:2.5rem">
                  <input type="checkbox" class="form-check-input" id="selectAll" aria-label="<%= t('expenses.select_all') %>">
                </th>
                <%= sortable_column_header(t("common.date"), "date", current_sort: @sort, current_dir: @dir) %>
                <%= sortable_column_header(t("common.description"), "description", current_sort: @sort, current_dir: @dir) %>
                <%= sortable_column_header(t("common.category"), "category", current_sort: @sort, current_dir: @dir) %>
                <th scope="col"><%= t("expenses.source") %></th>
                <%= sortable_column_header(t("common.amount"), "amount", current_sort: @sort, current_dir: @dir) %>
                <th scope="col" class="text-end"><span class="visually-hidden"><%= t("common.actions") %></span></th>
              </tr>
            </thead>
            <tbody id="tableBody">
              <% @expenses.each do |expense| %>
                <%- decorated = ExpenseDecorator.new(expense) -%>
                <tr data-id="<%= expense.id %>" tabindex="0" data-testid="row"
                    data-category-id="<%= expense.category_id %>"
                    data-recurring-id="<%= expense.recurring_template_id %>"
                    data-view-url="<%= expense_path(expense) %>"
                    data-edit-url="<%= edit_expense_path(expense, state_query) %>"
                    data-delete-url="<%= expense_path(expense, state_query) %>">
                  <td>
                    <input type="checkbox" class="form-check-input row-check"
                           aria-label="<%= t('expenses.select_expense', date: l(expense.date, format: :short), description: decorated.lowercase_description) %>">
                  </td>
                  <td class="text-nowrap"><%= l(expense.date, format: :short) %></td>
                  <td class="desc-cell" title="<%= expense.description %>">
                    <% if expense.description.present? %>
                      <%= expense.description %>
                    <% else %>
                      <span class="text-muted"><%= t("expenses.no_description") %></span>
                    <% end %>
                  </td>
                  <td><%= category_badge(expense.category) %></td>
                  <td><%= money_source_badge(expense.money_source) %></td>
                  <td class="text-end amount"><%= number_to_currency(expense.amount) %></td>
                  <td class="text-end text-nowrap" data-stop="1">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-open-drawer
                            aria-label="<%= t('expenses.view_expense', description: decorated.lowercase_description) %>">
                      <i class="bi bi-eye"></i>
                    </button>
                    <% if expense.recurring_template_id.nil? %>
                      <button type="button" class="btn btn-sm btn-outline-primary" data-assign-recurring
                              data-testid="row-assign-recurring"
                              aria-label="<%= t('expenses.assign_recurring.row_button_aria', description: decorated.lowercase_description) %>">
                        <i class="bi bi-arrow-repeat"></i>
                      </button>
                    <% end %>
                    <%= link_to edit_expense_path(expense, state_query), class: "btn btn-sm btn-outline-primary",
                                aria: { label: t("expenses.edit_expense", description: decorated.lowercase_description) } do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-delete
                            data-delete-url="<%= expense_path(expense, state_query) %>"
                            aria-label="<%= t('expenses.delete_expense', description: decorated.lowercase_description) %>">
                      <i class="bi bi-trash"></i>
                    </button>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="mobile-list" id="mobileList">
          <% @expenses.each do |expense| %>
            <%- decorated = ExpenseDecorator.new(expense) -%>
            <div class="mobile-item" data-id="<%= expense.id %>" tabindex="0" data-testid="row"
                 data-category-id="<%= expense.category_id %>"
                 data-recurring-id="<%= expense.recurring_template_id %>"
                 data-view-url="<%= expense_path(expense) %>"
                 data-edit-url="<%= edit_expense_path(expense, state_query) %>"
                 data-delete-url="<%= expense_path(expense, state_query) %>">
              <input type="checkbox" class="form-check-input row-check mt-2"
                     aria-label="<%= t('expenses.select_expense', date: l(expense.date, format: :short), description: decorated.lowercase_description) %>">
              <div>
                <div class="small text-muted"><%= l(expense.date, format: :short) %> · <%= category_badge(expense.category) %> · <%= money_source_badge(expense.money_source) %></div>
                <div class="mt-1">
                  <% if expense.description.present? %>
                    <%= expense.description %>
                  <% else %>
                    <span class="text-muted"><%= t("expenses.no_description") %></span>
                  <% end %>
                </div>
              </div>
              <div class="text-end">
                <div class="amount"><%= number_to_currency(expense.amount) %></div>
                <div class="mobile-actions mt-2" data-stop="1">
                  <button type="button" class="btn btn-outline-secondary" data-open-drawer
                          aria-label="<%= t('expenses.view_expense', description: decorated.lowercase_description) %>">
                    <i class="bi bi-eye"></i>
                  </button>
                  <% if expense.recurring_template_id.nil? %>
                    <button type="button" class="btn btn-outline-primary" data-assign-recurring
                            aria-label="<%= t('expenses.assign_recurring.row_button_aria', description: decorated.lowercase_description) %>">
                      <i class="bi bi-arrow-repeat"></i>
                    </button>
                  <% end %>
                  <%= link_to edit_expense_path(expense, state_query), class: "btn btn-outline-primary",
                              aria: { label: t("expenses.edit_expense", description: decorated.lowercase_description) } do %>
                    <i class="bi bi-pencil"></i>
                  <% end %>
                  <button type="button" class="btn btn-outline-danger" data-delete
                            data-delete-url="<%= expense_path(expense, state_query) %>"
                            aria-label="<%= t('expenses.delete_expense', description: decorated.lowercase_description) %>">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top small text-muted">
          <span id="pageFoot">
            <%= t("expenses.page_info", offset: @expenses.offset_value + 1, last: @expenses.offset_value + @expenses.length, total: @total_count, page_subtotal: number_to_currency(@page_subtotal), filtered_total: number_to_currency(@filtered_total)) %>
          </span>
        </div>
        <%= will_paginate @expenses, renderer: WillPaginate::ActionView::BootstrapLinkRenderer, previous_label: t("common.previous"), next_label: t("common.next") if @expenses.total_pages > 1 %>
      </div>
    <% end %>
  </div>
</div>

<!-- Skeleton de carga mostrado mientras Turbo carga la siguiente página de gastos -->
<div id="loadingState" class="d-none" aria-busy="true" data-testid="loading">
  <div class="card shadow-sm p-3">
    <div class="skel mb-3"></div>
    <div class="skel mb-3" style="width:90%"></div>
    <div class="skel mb-3" style="width:80%"></div>
    <div class="skel mb-3"></div>
    <div class="skel mb-3" style="width:70%"></div>
    <div class="skel mb-3"></div>
    <div class="skel" style="width:85%"></div>
  </div>
</div>

<!-- Panel de detalle del gasto -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="detailDrawer" aria-labelledby="drawerTitle">
  <div class="offcanvas-header border-bottom">
    <h2 class="offcanvas-title h5" id="drawerTitle">Gasto</h2>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
  </div>
  <div class="offcanvas-body" id="drawerBody"></div>
  <div class="offcanvas-footer border-top p-3 d-flex gap-2">
    <a href="#" class="btn btn-outline-primary" id="drawerEdit"><i class="bi bi-pencil me-1"></i>Editar</a>
    <button type="button" class="btn btn-outline-danger" id="drawerDelete"><i class="bi bi-trash me-1"></i>Eliminar</button>
    <button type="button" class="btn btn-outline-secondary ms-auto" data-bs-dismiss="offcanvas">Cerrar</button>
  </div>
</div>

<!-- Modal de confirmación de eliminación (individual o en lote) -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title h5" id="deleteTitle">¿Eliminar gasto?</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body" id="deleteBody">Esta acción no se puede deshacer.</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" id="confirmDelete">Eliminar</button>
      </div>
    </div>
  </div>
</div>

<%= form_with url: "#", method: :delete, id: "deleteForm", class: "d-none" do %>
  <input type="hidden" name="ids" id="deleteIds">
<% end %>

<!-- Modal de confirmación de actualización en lote (Cambiar Categoría / Cambiar Fuente de Dinero / ambos) -->
<%= form_with url: bulk_update_expenses_path, method: :patch, id: "bulkEditForm", data: { testid: "bulk-update-form" } do |f| %>
  <div class="modal fade" id="bulkEditModal" tabindex="-1" aria-labelledby="bulkEditTitle" aria-hidden="true" data-testid="bulk-update-modal">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title h5" id="bulkEditTitle">Editar gastos</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <%= hidden_field_tag :expense_ids, nil, id: "bulkExpenseIds" %>
          <p class="text-muted" id="bulkEditSummary">Actualiza los gastos seleccionados.</p>
          <div class="mb-3">
            <%= category_picker f, :category_id, @categories,
                                label: "Nueva Categoría",
                                include_blank: "Sin cambios",
                                id: "bulkCategorySelect",
                                testid: "bulk-category-picker" %>
            <div class="invalid-feedback" id="bulkCategoryFeedback">Elige una categoría y/o una fuente de dinero para actualizar.</div>
          </div>
          <div class="mb-3">
            <label for="bulkSourceSelect" class="form-label">Nueva Fuente de Dinero</label>
            <select id="bulkSourceSelect" name="money_source_id" class="form-select" data-testid="bulk-source-select">
              <option value="">Sin cambios</option>
              <% @money_sources.each do |source| %>
                <option value="<%= source.id %>"><%= source.display_name %></option>
              <% end %>
            </select>
            <div class="invalid-feedback" id="bulkSourceFeedback">Elige una categoría y/o una fuente de dinero para actualizar.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="confirmBulkEdit" data-testid="confirm-bulk-update" disabled>
            <i class="bi bi-check-lg me-1"></i>Actualizar gastos
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%= render "shared/process_recurring_modal",
           modal_id: "expenseProcessModal",
           title_id: "expenseProcessTitle",
           title: "Confirmar Pago",
           form_id: "expenseProcessForm",
           category_id: "expenseProcessCategory",
           description_id: "expenseProcessDescription",
           configured_amount_id: "expenseProcessConfiguredAmount",
           date_input_id: "expenseProcessDate",
           amount_input_id: "expenseProcessAmount",
           confirm_id: "expenseProcessConfirm",
           confirm_testid: "confirm-expense-process",
           confirm_label: "Confirmar Pago",
           back_label: "Volver",
           amount_hint: "Puedes ajustar el monto para este gasto específico.",
           testid: "expense-process-modal" %>

<!-- Modal: aplicar un gasto existente a una plantilla recurrente -->
<%= form_with url: assign_recurring_expenses_path, method: :post, id: "bulkRecurringForm", data: { testid: "assign-recurring-form" } do %>
  <div class="modal fade" id="bulkRecurringModal" tabindex="-1" aria-labelledby="bulkRecurringTitle" aria-hidden="true" data-testid="assign-recurring-modal">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title h5" id="bulkRecurringTitle"><%= t("expenses.assign_recurring.modal_title", default: "Aplicar a gasto recurrente") %></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <%= hidden_field_tag :expense_id, nil, id: "recurringExpenseId" %>
          <p class="text-muted mb-3"><%= t("expenses.assign_recurring.modal_hint", default: "El gasto seleccionado queda registrado como el pago del gasto recurrente para su mes (la plantilla pasará a \"Pagado\").") %></p>
          <div class="mb-0">
            <label for="bulkRecurringSelect" class="form-label"><%= t("expenses.assign_recurring.template_label", default: "Gasto recurrente") %></label>
            <select id="bulkRecurringSelect" name="recurring_template_id" class="form-select" required>
              <option value=""><%= t("expenses.assign_recurring.choose_template", default: "Selecciona una plantilla...") %></option>
              <% @recurring_templates.each do |template| %>
                <% paid = @paid_template_ids.include?(template.id) %>
                <option value="<%= template.id %>"
                        data-category-id="<%= template.category_id %>"
                        <%= "disabled" if paid %>>
                  <%= recurring_template_option_label(template) %><%= t("expenses.assign_recurring.paid_suffix") if paid %>
                </option>
              <% end %>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t("common.cancel") %></button>
          <button type="submit" class="btn btn-primary" id="confirmBulkRecurring" data-testid="confirm-assign-recurring" disabled>
            <i class="bi bi-check-lg me-1"></i><%= t("expenses.assign_recurring.apply_button", default: "Aplicar") %>
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>

<script>
(function () {
  if (window.__expensesTableInit) return;
  window.__expensesTableInit = true;

  var $ = function (sel) { return document.querySelector(sel); };
  var $$ = function (sel) { return Array.prototype.slice.call(document.querySelectorAll(sel)); };

  function stateQuery() {
    var q = new URLSearchParams(location.search);
    var keys = ["category_id", "money_source_id", "start_date", "end_date", "min_amount", "max_amount", "sort", "dir", "page"];
    var out = [];
    keys.forEach(function (k) {
      var v = q.get(k);
      if (v) out.push(encodeURIComponent(k) + "=" + encodeURIComponent(v));
    });
    return out.length ? "?" + out.join("&") : "";
  }

  function urlWithState(path) {
    var sep = path.indexOf("?") === -1 ? "?" : "&";
    return path + sep + stateQuery().replace(/^\?/, "");
  }

  function updateBulk() {
    var checks = $$(".row-check");
    var n = selectedIds().length;
    var has = n > 0;
    $("#bulkCount").textContent = n + " seleccionados";
    var all = $("#selectAll");
    if (all) all.checked = checks.length > 0 && $$(".row-check").filter(function (c) { return c.checked; }).length === checks.length;
    ["bulkCategory", "bulkSource", "clearSel", "bulkDelete"].forEach(function (id) {
      var el = $("#" + id);
      if (el) el.disabled = !has;
    });
  }

  function selectedIds() {
    var seen = {};
    $$("tr[data-id], .mobile-item[data-id]")
      .filter(function (el) { return el.querySelector(".row-check") && el.querySelector(".row-check").checked; })
      .forEach(function (el) { seen[el.dataset.id] = true; });
    return Object.keys(seen);
  }

  function updateBulkEdit() {
    var n = ($("#bulkExpenseIds").value || "").split(",").filter(Boolean).length;
    var hasValue = !!$("#bulkCategorySelect").value || !!$("#bulkSourceSelect").value;
    var btn = $("#confirmBulkEdit");
    btn.disabled = !hasValue;
    var word = n === 1 ? "gasto" : "gastos";
    btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Actualizar ' + n + " " + word;
    if (hasValue) {
      CategoryPicker.setInvalid($("#bulkCategorySelect"), false);
      $("#bulkSourceSelect").classList.remove("is-invalid");
    }
  }

  var bulkEditFocus = "category";

  function openBulkEdit(field) {
    var ids = selectedIds();
    if (!ids.length) return;
    var n = ids.length;
    var word = n === 1 ? "gasto" : "gastos";
    bulkEditFocus = field;
    $("#bulkExpenseIds").value = ids.join(",");
    $("#bulkEditForm").action = urlWithState("<%= bulk_update_expenses_path %>");
    if (field === "category") {
      $("#bulkEditTitle").textContent = "Cambiar categoría de " + n + " " + word;
      $("#bulkEditSummary").innerHTML =
        "Estás a punto de cambiar la categoría de <strong>" + n + "</strong> " + word + " seleccionados.";
    } else {
      $("#bulkEditTitle").textContent = "Cambiar fuente de dinero de " + n + " " + word;
      $("#bulkEditSummary").innerHTML =
        "Estás a punto de cambiar la fuente de dinero de <strong>" + n + "</strong> " + word + " seleccionados.";
    }
    CategoryPicker.setValue($("#bulkCategorySelect"), "");
    $("#bulkSourceSelect").value = "";
    CategoryPicker.setInvalid($("#bulkCategorySelect"), false);
    $("#bulkSourceSelect").classList.remove("is-invalid");
    updateBulkEdit();
    bootstrap.Modal.getOrCreateInstance("#bulkEditModal").show();
  }

  function openBulkRecurring(row) {
    if (!row) return;

    // Same-category templates first: clone matching options into a top
    // optgroup so the likely selection is one tap away.
    var category = row.dataset.categoryId || "";
    var select = $("#bulkRecurringSelect");
    var oldGroup = $("#sameCategoryGroup");
    if (oldGroup) oldGroup.remove();
    var matching = Array.prototype.slice.call(select.options)
                                      .filter(function (o) {
                                        return o.value && o.dataset.categoryId === category;
                                      });
    if (matching.length) {
      var group = document.createElement("optgroup");
      group.label = "<%= t("expenses.assign_recurring.same_category_group", default: "Misma categoría") %>";
      group.id = "sameCategoryGroup";
      matching.reverse().forEach(function (option) { group.appendChild(option.cloneNode(true)); });
      select.insertBefore(group, select.options[1]);
    }

    select.value = "";
    $("#recurringExpenseId").value = row.dataset.id;
    $("#bulkRecurringForm").action = urlWithState("<%= assign_recurring_expenses_path %>");
    $("#confirmBulkRecurring").disabled = true;
    bootstrap.Modal.getOrCreateInstance("#bulkRecurringModal").show();
  }

  function openDrawer(url, editUrl, deleteUrl) {
    var body = $("#drawerBody");
    body.innerHTML = '<div class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden">Cargando&hellip;</span></div></div>';
    fetch(url, { headers: { "Accept": "text/html" } })
      .then(function (r) { return r.text(); })
      .then(function (html) {
        body.innerHTML = html;
        $("#drawerEdit").href = editUrl;
        $("#drawerDelete").setAttribute("data-delete-url", deleteUrl);
        var offcanvas = bootstrap.Offcanvas.getOrCreateInstance("#detailDrawer");
        offcanvas.show();
      });
  }

  function openDelete(url, count) {
    $("#deleteTitle").textContent = count > 1 ? "¿Eliminar " + count + " gastos?" : "¿Eliminar gasto?";
    $("#deleteBody").textContent = count > 1 ? "¿Eliminar " + count + " gastos? Esta acción no se puede deshacer." : "Esta acción no se puede deshacer.";
    $("#deleteForm").action = url;
    bootstrap.Modal.getOrCreateInstance("#deleteModal").show();
  }

  function openProcessModal(button) {
    var form = $("#expenseProcessForm");
    var amount = button.dataset.processAmount || "";
    form.action = button.dataset.processUrl;
    $("#expenseProcessTitle").textContent = button.dataset.processTitle || "Confirmar Pago";
    $("#expenseProcessCategory").textContent = button.dataset.processCategory || "";
    $("#expenseProcessDescription").textContent = button.dataset.processDescription || "Sin descripción";
    $("#expenseProcessConfiguredAmount").textContent = "$" + Number(amount).toFixed(2);
    $("#expenseProcessDate").value = "<%= Date.current %>";
    $("#expenseProcessAmount").value = Number(amount).toFixed(2);
    if (window.MoneyInputs) window.MoneyInputs.formatField($("#expenseProcessAmount"), true);
    bootstrap.Modal.getOrCreateInstance("#expenseProcessModal").show();
  }

  document.addEventListener("change", function (e) {
    if (e.target.matches(".row-check, #selectAll")) {
      if (e.target.id === "selectAll") {
        $$(".row-check").forEach(function (c) { c.checked = e.target.checked; });
      }
      updateBulk();
    }
    if (e.target.matches("#bulkCategorySelect, #bulkSourceSelect")) {
      updateBulkEdit();
    }
    if (e.target.matches("#bulkRecurringSelect")) {
      $("#confirmBulkRecurring").disabled = !e.target.value;
    }
  });

  document.addEventListener("click", function (e) {
    // The drawer opens ONLY from the eye button — a whole-row click no
    // longer opens it (rows host interactive buttons on every column).
    var viewBtn = e.target.closest("[data-open-drawer]");
    if (viewBtn) {
      var row = viewBtn.closest("tr[data-id], .mobile-item[data-id]");
      openDrawer(row.dataset.viewUrl, row.dataset.editUrl, row.dataset.deleteUrl);
      return;
    }
    var delBtn = e.target.closest("[data-delete]");
    if (delBtn) {
      openDelete(delBtn.dataset.deleteUrl || delBtn.closest("[data-delete-url]").dataset.deleteUrl, 1);
      return;
    }
    var processBtn = e.target.closest("[data-process-expense]");
    if (processBtn) {
      openProcessModal(processBtn);
      return;
    }
    var applyRecBtn = e.target.closest("[data-assign-recurring]");
    if (applyRecBtn) {
      openBulkRecurring(applyRecBtn.closest("tr[data-id], .mobile-item[data-id]"));
      return;
    }
    if (e.target.id === "clearSel") {
      $$(".row-check").forEach(function (c) { c.checked = false; });
      updateBulk();
    }
    if (e.target.id === "bulkCategory" || e.target.id === "bulkSource") {
      openBulkEdit(e.target.id === "bulkCategory" ? "category" : "source");
    }
    if (e.target.id === "bulkDelete") {
      var ids = selectedIds();
      if (ids.length) {
        $("#deleteIds").value = ids.join(",");
        openDelete("<%= bulk_destroy_expenses_path %>" + stateQuery(), ids.length);
      }
    }
    if (e.target.id === "confirmDelete") {
      var form = $("#deleteForm");
      var action = form.action || "";
      if (action === "" || action === location.href.split("#")[0]) return;
      var methodInput = form.querySelector("input[name=_method]");
      if (!methodInput) {
        methodInput = document.createElement("input");
        methodInput.type = "hidden";
        methodInput.name = "_method";
        methodInput.value = "delete";
        form.appendChild(methodInput);
      }
      form.innerHTML =
      '<input type="hidden" name="_method" value="delete">' +
      '<input type="hidden" name="authenticity_token" value="' +
      (document.querySelector('meta[name="csrf-token"]') || {}).content + '">' +
      '<input type="hidden" name="ids" value="' + form.querySelector("#deleteIds").value + '">';
      bootstrap.Modal.getInstance("#deleteModal").hide();
      bootstrap.Offcanvas.getInstance("#detailDrawer") && bootstrap.Offcanvas.getInstance("#detailDrawer").hide();
      form.requestSubmit();
    }
  });

  $("#bulkEditForm").addEventListener("submit", function (e) {
    if (!$("#bulkCategorySelect").value && !$("#bulkSourceSelect").value) {
      e.preventDefault();
      CategoryPicker.setInvalid($("#bulkCategorySelect"), true);
      $("#bulkSourceSelect").classList.add("is-invalid");
      return;
    }
    var btn = $("#confirmBulkEdit");
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Actualizando&hellip;';
  });

  $("#bulkEditModal").addEventListener("shown.bs.modal", function () {
    if (bulkEditFocus === "source") {
      $("#bulkSourceSelect").focus();
    } else {
      CategoryPicker.focus($("#bulkCategorySelect"));
    }
  });

  document.addEventListener("keydown", function (e) {
    if (e.key === "Enter") {
      var row = e.target.closest("tr[data-id], .mobile-item[data-id]");
      if (row && !e.target.closest("[data-stop], input, button, a")) {
        openDrawer(row.dataset.viewUrl, row.dataset.editUrl, row.dataset.deleteUrl);
      }
    }
  });

  document.addEventListener("turbo:before-fetch-request", function (e) {
    if (!e.target.url || e.target.url.indexOf("/expenses") === -1) return;
    if (e.target.url.indexOf(".csv") !== -1) return;
    if (e.target.fetchOptions && (e.target.fetchOptions.method || "get").toLowerCase() !== "get") return;
    var tableCard = $("#tableCard");
    if (tableCard) tableCard.classList.add("d-none");
    var loading = $("#loadingState");
    if (loading) loading.classList.remove("d-none");
  });

  document.addEventListener("turbo:render", function () {
    var loading = $("#loadingState");
    if (loading && location.pathname === "/expenses") loading.classList.add("d-none");
  });
})();
</script>
