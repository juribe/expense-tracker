<div class="card mb-4" data-testid="ai-entry-card">
  <div class="card-body">
    <h5 class="card-title mb-3"><i class="ti ti-stars me-2 text-secondary" aria-hidden="true"></i><%= t("expenses.ai_what_did_you_spend") %></h5>
    <form id="aiParseForm" data-testid="ai-form" data-turbo="false"
          data-parse-url="<%= parse_expenses_path(format: :json) %>"
          data-bulk-create-url="<%= bulk_create_expenses_path(format: :json) %>"
          data-today="<%= Date.current.iso8601 %>">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <label class="form-label visually-hidden" for="aiExpenseText"><%= t("expenses.ai_describe") %></label>
      <textarea id="aiExpenseText" name="text" class="form-control" rows="2"
                placeholder="<%= t('expenses.ai_placeholder') %>"
                data-testid="ai-text-input"></textarea>

      <div class="d-flex gap-2 mt-2 align-items-center flex-wrap">
        <button type="button" class="btn btn-outline-secondary" id="aiMicButton" data-testid="ai-mic-button"
                aria-label="<%= t('expenses.ai_record_voice') %>" title="<%= t('expenses.ai_record_voice') %>">
          <i class="ti ti-microphone" aria-hidden="true"></i> <%= t("expenses.ai_dictate") %>
        </button>
        <button type="submit" class="btn btn-primary" id="aiParseButton" data-testid="ai-parse-button">
          <i class="ti ti-bolt me-1" aria-hidden="true"></i><%= t("expenses.ai_detect") %>
        </button>
        <span id="aiStatus" class="small text-secondary ms-1" role="status" aria-live="polite"></span>
      </div>

      <div id="aiTranscriptionWrap" class="alert alert-info mt-3 mb-0 d-none" data-testid="ai-transcription">
        <i class="ti ti-wave-sine me-1" aria-hidden="true"></i><strong><%= t("expenses.ai_transcription") %></strong>
        <span id="aiTranscriptionText"></span>
      </div>
    </form>
  </div>
</div>

<!-- Modal de vista previa / confirmación -->
<div class="modal fade" id="aiPreviewModal" tabindex="-1" aria-labelledby="aiPreviewTitle" aria-hidden="true"
     data-testid="ai-preview-modal">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="aiPreviewTitle"><%= t("expenses.ai_detected_title") %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close') %>"></button>
      </div>
      <div class="modal-body">
        <div id="aiPreviewError" class="alert alert-danger d-none" role="alert"></div>
        <div id="aiPreviewRows"></div>
      </div>
      <div class="modal-footer justify-content-between align-items-center flex-wrap gap-2">
        <button type="button" class="btn btn-outline-primary btn-sm" id="aiAddRow" data-testid="ai-add-row">
          <i class="ti ti-plus me-1" aria-hidden="true"></i><%= t("expenses.ai_add_expense") %>
        </button>
        <div class="d-flex align-items-center gap-3">
          <strong id="aiPreviewTotal" data-testid="ai-total"><%= t("common.total") %>: 0</strong>
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t("common.cancel") %></button>
          <button type="button" class="btn btn-success" id="aiSaveAll" data-testid="ai-save-all">
            <i class="ti ti-check me-1" aria-hidden="true"></i><%= t("expenses.save_expenses") %>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<%= tag.div class: "d-none", data: { ai_entry_payload: {
  categories: (@categories || []).map { |c| { id: c.id, name: c.name } },
  money_sources: (@money_sources || []).map { |s| { id: s.id, name: s.display_name } },
  texts: {
    detected_count_one: t("expenses.ai_detected_count", count: 1),
    detected_count_many: t("expenses.ai_detected_count", count: 2),
    write_first: t("expenses.ai_write_first"),
    detecting: t("expenses.ai_detecting"),
    no_expenses: t("expenses.ai_no_expenses_detected"),
    detect_failed: t("expenses.ai_detect_failed"),
    new_category: t("expenses.ai_new_category", name: "__NAME__"),
    uncertain: t("expenses.ai_uncertain"),
    expenses_path: expenses_path,
    common_category: t("common.category"),
    common_none: t("common.none"),
    common_description: t("common.description"),
    common_amount: t("common.amount"),
    common_date: t("common.date"),
    ai_source: t("expenses.ai_source")
  }
} } %>
<%= javascript_include_tag "ai_entry", defer: true %>

