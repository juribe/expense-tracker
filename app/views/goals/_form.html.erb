<div class="container py-4" style="max-width: 640px;">
  <%= form_with(model: goal, local: true) do |form| %>
    <div class="card shadow-sm border-0">
      <div class="card-header bg-primary text-white">
        <h4 class="mb-0">
          <i class="bi bi-bullseye me-2"></i><%= goal.new_record? ? t("goals.form.create_title", default: "Nueva meta") : t("goals.form.edit_title", default: "Editar meta") %>
        </h4>
      </div>

      <div class="card-body">
        <div class="mb-3">
          <%= form.label :name, class: "form-label" %>
          <%= form.text_field :name,
                              class: "form-control #{field_class(goal, :name)}",
                              required: true %>
          <% if goal.errors[:name].any? %>
            <div class="invalid-feedback d-block"><%= field_error(goal, :name) %></div>
          <% end %>
        </div>

        <div class="mb-3">
          <%= form.label :target_amount, class: "form-label" do %>
            <%= Goal.human_attribute_name(:target_amount) %> <span class="text-danger">*</span>
          <% end %>
          <div class="input-group">
            <span class="input-group-text">$</span>
            <%= form.text_field :target_amount,
                                 value: money_field_value(goal.target_amount&.abs),
                                 class: "form-control #{field_class(goal, :target_amount)}",
                                 required: true,
                                 inputmode: "decimal",
                                 autocomplete: "off",
                                 data: { money_input: true } %>
          </div>
          <% if goal.errors[:target_amount].any? %>
            <div class="invalid-feedback d-block"><%= field_error(goal, :target_amount) %></div>
          <% end %>
        </div>

        <div class="mb-3">
          <%= form.label :pocket, class: "form-label" do %>
            <%= Goal.human_attribute_name(:pocket) %> <span class="text-danger">*</span>
          <% end %>
          <% if @pockets&.any? %>
            <%= form.collection_select :pocket_id, @pockets, :id, :name,
                { prompt: t("goals.form.pocket_prompt", default: "Selecciona un bolsillo") },
                class: "form-select #{field_class(goal, :pocket_id)}" %>
          <% else %>
            <div class="alert alert-warning mb-2">
              <i class="bi bi-piggy-bank me-1"></i>
              <%= t("goals.form.no_pockets", default: "Aún no tienes bolsillos. Crea uno para empezar a asignar dinero a esta meta.") %>
            </div>
            <%= link_to new_money_source_path(kind: "pocket"), class: "btn btn-outline-primary btn-sm" do %>
              <i class="bi bi-plus-lg me-1"></i><%= t("goals.form.create_pocket", default: "Crear bolsillo") %>
            <% end %>
          <% end %>
          <div class="form-text"><%= t("goals.form.pocket_hint", default: "Lo ahorrado se calcula con el saldo del bolsillo; no se ingresa manualmente.") %></div>
          <% if goal.errors[:pocket].any? %>
            <div class="invalid-feedback d-block"><%= field_error(goal, :pocket) %></div>
          <% end %>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <%= form.label :priority, class: "form-label" %>
            <%= form.select :priority,
                options_for_select(goal_priority_options, goal.priority || Goal::PRIORITIES[:medium]),
                {},
                class: "form-select" %>
          </div>
          <div class="col-md-6 mb-3">
            <%= form.label :category, class: "form-label" %>
            <%= form.select :category,
                options_for_select(goal_category_options, goal.category),
                { include_blank: t("goals.form.category_blank", default: "Sin categoría") },
                class: "form-select" %>
          </div>
        </div>

        <div class="mb-3">
          <%= form.label :target_date, class: "form-label" %>
          <%= form.date_field :target_date, class: "form-control" %>
          <div class="form-text"><%= t("goals.form.target_date_hint", default: "Opcional: con fecha se calcula el aporte mensual sugerido y el estado de la meta.") %></div>
        </div>

        <% unless goal.new_record? %>
          <div class="mb-3">
            <%= form.label :status, class: "form-label" %>
            <%= form.select :status,
                options_for_select(goal_status_options, goal.status || "active"),
                {},
                class: "form-select" %>
          </div>
        <% end %>
      </div>

      <div class="card-footer d-flex justify-content-end gap-2 d-print-none">
        <%= link_to goals_path, class: "btn btn-outline-secondary" do %>
          <i class="bi bi-x-lg me-1"></i><%= t("common.cancel") %>
        <% end %>
        <%= form.submit goal.new_record? ? t("goals.form.submit_create", default: "Crear meta") : t("goals.form.submit_update", default: "Guardar cambios"), class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>
