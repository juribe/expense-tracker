<div class="modal fade" id="goal-contribution-modal" tabindex="-1"
     aria-labelledby="goal-contribution-modal-title" aria-hidden="true"
     data-today="<%= Date.current.iso8601 %>">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <%= form_with url: goal_allocations_path, scope: :goal_allocations, method: :post, local: true do |form| %>
        <div class="modal-header">
          <h5 class="modal-title" id="goal-contribution-modal-title">
            <i class="ti ti-pig-money me-2"></i><span id="goal-contribution-title-text"><%= t("goals.contribution.title_add", default: "Agregar dinero a mi meta") %></span>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("common.close", default: "Cerrar") %>"></button>
        </div>
        <div class="modal-body">
          <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <div>
              <div class="text-secondary small"><%= t("goals.contribution.goal", default: "Meta") %></div>
              <div class="h5 mb-0" id="goal-contribution-name"></div>
            </div>
            <div class="text-end">
              <div class="text-secondary small"><%= t("goals.contribution.saved", default: "Ahorrado") %></div>
              <div class="fw-bold" id="goal-contribution-saved"></div>
            </div>
          </div>

          <%= hidden_field_tag "goal_allocations[financial_goal_id]", nil, id: "goal_contribution_goal_id" %>
          <%= hidden_field_tag "goal_allocations[idempotency_key]", nil, id: "goal_contribution_idempotency_key" %>

          <div class="mb-3">
            <%= form.label :amount, t("goals.contribution.amount_add", default: "¿Cuánto quieres agregar?"),
                           class: "form-label", id: "goal-contribution-amount-label" %>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <%= form.text_field :amount, class: "form-control", inputmode: "decimal",
                                  autocomplete: "off", required: true, data: { money_input: true },
                                  id: "goal_contribution_amount" %>
            </div>
          </div>

          <div class="mb-3">
            <%= form.label :date, t("common.date"), class: "form-label" %>
            <%= form.date_field :date, value: Date.current, class: "form-control", id: "goal_contribution_date" %>
          </div>

          <div class="mb-0">
            <%= form.label :note, t("transfers.new.note", default: "Nota"), class: "form-label" %>
            <%= form.text_field :note, class: "form-control", id: "goal_contribution_note",
                                placeholder: t("goal_allocations.note_placeholder", default: "Opcional") %>
          </div>

          <div class="form-text mt-2">
            <%= t("goals.contribution.hint", default: "Este dinero pertenece a la meta. No se registra como ingreso, gasto ni transferencia.") %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <%= t("common.cancel") %>
          </button>
          <button type="submit" name="goal_allocations[direction]" value="withdraw"
                  class="btn btn-outline-primary d-none" id="goal-contribution-withdraw-button"
                  data-testid="goal-contribution-withdraw">
            <i class="ti ti-minus me-1" aria-hidden="true"></i><%= t("goals.withdraw_money", default: "Retirar dinero") %>
          </button>
          <button type="submit" name="goal_allocations[direction]" value="deposit"
                  class="btn btn-primary d-none" id="goal-contribution-deposit-button"
                  data-testid="goal-contribution-deposit">
            <i class="ti ti-plus me-1" aria-hidden="true"></i><%= t("goals.add_money", default: "Agregar dinero") %>
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
