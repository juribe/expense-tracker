<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
  <h1><i class="bi bi-bullseye me-2"></i><%= t("goals.title", default: "Metas financieras") %></h1>
  <%= link_to new_goal_path, class: "btn btn-primary" do %>
    <i class="bi bi-plus-lg me-1"></i><%= t("goals.new", default: "Nueva meta") %>
  <% end %>
</div>

<% if @goals.any? %>
  <div class="row g-3">
    <% @goals.each do |goal| %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <h5 class="mb-0"><i class="bi bi-bag-heart me-2 text-primary"></i><%= goal.name %></h5>
              <% if goal.completed? %>
                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i><%= t("goals.completed", default: "Cumplida") %></span>
              <% end %>
            </div>
            <p class="summary-value fw-bold mb-1"><%= number_to_currency(goal.saved_amount) %></p>
            <p class="text-muted small mb-2">
              <%= t("goals.of_target", default: "de %{amount}", amount: number_to_currency(goal.target_amount)) %>
            </p>
            <div class="progress mb-2" role="progressbar"
                 aria-label="<%= t("goals.progress_aria", name: goal.name) %>"
                 aria-valuenow="<%= goal.progress_percentage.round %>" aria-valuemin="0" aria-valuemax="100">
              <div class="progress-bar bg-primary" style="width: <%= goal.progress_percentage.round %>%"></div>
            </div>
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-bold small"><%= number_to_percentage(goal.progress_percentage, precision: 0) %></span>
              <% if goal.target_date %>
                <span class="badge bg-light text-dark"><i class="bi bi-calendar-event me-1"></i><%= l(goal.target_date, format: :long) %></span>
              <% end %>
            </div>
          </div>
          <div class="card-footer bg-white d-flex justify-content-end">
            <div class="btn-group btn-group-sm">
              <%= link_to edit_goal_path(goal), class: "btn btn-outline-primary" do %>
                <i class="bi bi-pencil"></i>
              <% end %>
              <%= button_to goal_path(goal), method: :delete, form: { data: { turbo: true } },
                            class: "btn btn-outline-danger", data: { confirm: t("common.confirm_delete", default: "Are you sure?") } do %>
                <i class="bi bi-trash"></i>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="card shadow-sm">
    <div class="p-5 text-center">
      <i class="bi bi-bullseye display-4 text-muted mb-3 d-block"></i>
      <h4 class="mb-2"><%= t("goals.empty_title", default: "Aún no tienes metas") %></h4>
      <p class="text-muted"><%= t("goals.empty_body", default: "Crea una meta para empezar a ahorrar.") %></p>
      <%= link_to new_goal_path, class: "btn btn-primary mt-3" do %>
        <i class="bi bi-plus-lg me-1"></i><%= t("goals.new", default: "Nueva meta") %>
      <% end %>
    </div>
  </div>
<% end %>
