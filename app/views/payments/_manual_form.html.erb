<%= form_with url: create_manual_money_source_payments_path(@money_source), method: :post,
      scope: :payment,
      html: { data: { payment_distribution_form: true,
                      manual_payment_form: true,
                      manual_failed: t("payments.manual.failed"),
                      manual_busy_label: t("payments.manual.processing"),
                      payment_warning_empty: t("payments.form.total_empty"),
                      payment_warning_short: t("payments.form.total_short", missing: "__MISSING__"),
                      payment_warning_over: t("payments.form.total_over", extra: "__EXTRA__") } } do |f| %>
  <div class="alert alert-danger d-none" role="alert" data-manual-error data-testid="manual-payment-error"></div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <label class="form-label" for="manual_amount"><%= t("payments.manual.amount") %></label>
      <div class="input-group">
        <span class="input-group-text">$</span>
        <input type="text" class="form-control" id="manual_amount" name="payment[amount]"
               inputmode="decimal" autocomplete="off" required
               data-money-input="true" data-payment-target-input="true"
               data-testid="manual-payment-amount">
      </div>
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label" for="manual_date"><%= t("payments.manual.date") %></label>
      <input type="date" class="form-control" id="manual_date" name="payment[date]"
             value="<%= Date.current %>">
    </div>
    <div class="col-12 mb-3">
      <label class="form-label" for="manual_description"><%= t("payments.manual.description") %></label>
      <input type="text" class="form-control" id="manual_description" name="payment[description]"
             placeholder="<%= t("payments.description_fallback") %>">
    </div>
    <div class="col-md-6 mb-3">
      <%= category_picker f, :category_id, @categories,
                          label: t("common.category"),
                          include_blank: t("payments.manual.category_placeholder"),
                          required: true,
                          id: "manual_category",
                          testid: "manual-payment-category-picker" %>
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label" for="manual_funding"><%= t("payments.manual.funding") %></label>
      <select class="form-select" id="manual_funding" name="payment[funding_money_source_id]">
        <option value=""><%= t("payments.manual.funding_placeholder") %></option>
        <% @funding_sources.each do |source| %>
          <option value="<%= source.id %>"><%= source.display_name %></option>
        <% end %>
      </select>
    </div>
  </div>

  <h6 class="mb-2"><%= t("payments.form.distribution") %></h6>
  <div class="row">
    <% { principal_amount: :principal, interest_amount: :interest,
        insurance_amount: :insurance, other_amount: :other }.each do |field, label_key| %>
      <div class="col-md-6 mb-3">
        <label class="form-label" for="manual_<%= field %>"><%= t("payments.form.#{label_key}") %></label>
        <div class="input-group">
          <span class="input-group-text">$</span>
          <input type="text" class="form-control" id="manual_<%= field %>" name="payment[<%= field %>]"
                 inputmode="decimal" autocomplete="off"
                 data-money-input="true" data-payment-component="true">
        </div>
      </div>
    <% end %>
  </div>

  <div class="d-flex justify-content-between border-top pt-3 mb-3">
    <div>
      <div class="small text-muted"><%= t("payments.form.total") %></div>
      <div class="fs-5 fw-bold" data-payment-total-display>$0</div>
    </div>
  </div>
  <div class="alert alert-warning d-none py-2 small mb-3" data-payment-warning>
    <i class="ti ti-alert-triangle me-1"></i>
    <span data-payment-warning-text></span>
  </div>

  <div class="d-flex gap-2 justify-content-end">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
      <%= t("common.cancel") %>
    </button>
    <button type="submit" class="btn btn-primary" data-manual-submit data-testid="manual-payment-submit">
      <span class="spinner-border spinner-border-sm d-none me-2" data-manual-spinner role="status" aria-hidden="true"></span>
      <span data-manual-submit-label><%= t("payments.manual.submit") %></span>
    </button>
  </div>
<% end %>
