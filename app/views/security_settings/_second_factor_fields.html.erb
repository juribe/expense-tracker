<% prefix = local_assigns[:prefix].to_s %>
<div class="security-action-fields">
  <div class="mb-2">
    <%= label_tag "#{prefix}totp_code", t("security.second_factor.code_label"), class: "form-label" %>
    <%= text_field_tag :totp_code, nil, id: "#{prefix}totp_code", class: "form-control",
          inputmode: "numeric", autocomplete: "one-time-code" %>
  </div>
  <div class="mb-2">
    <%= label_tag "#{prefix}recovery_code", t("security.second_factor.recovery_label"), class: "form-label" %>
    <%= text_field_tag :recovery_code, nil, id: "#{prefix}recovery_code", class: "form-control", autocomplete: "off" %>
  </div>
</div>
