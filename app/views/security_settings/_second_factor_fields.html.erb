<div class="security-action-fields">
  <div class="mb-2">
    <%= label_tag :totp_code, t("security.second_factor.code_label"), class: "form-label" %>
    <%= text_field_tag :totp_code, nil, class: "form-control",
          inputmode: "numeric", autocomplete: "one-time-code" %>
  </div>
  <div class="mb-2">
    <%= label_tag :recovery_code, t("security.second_factor.recovery_label"), class: "form-label" %>
    <%= text_field_tag :recovery_code, nil, class: "form-control", autocomplete: "off" %>
  </div>
</div>
