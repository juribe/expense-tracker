<div class="app-container category-form mx-auto et-maxw-960" data-new-record="<%= category.new_record? %>">
  <%= form_with(model: category, local: true, html: { novalidate: false }) do |form| %>
    <div class="card">
      <%= render "shared/form_card_header",
                 title: category.new_record? ? t("categories.create_category") : t("categories.edit_category"),
                 subtitle: t("categories.form_subtitle"),
                 icon: "tags",
                 tone: "blue" %>

      <div class="card-body">
        <!-- Error Summary -->
        <div class="alert alert-danger <%= category.errors.any? ? "" : "d-none" %>" role="alert" id="error-summary">
          <h6 class="alert-heading">
            <i class="ti ti-alert-circle me-1"></i><%= t("categories.form_errors") %>
          </h6>
          <ul class="mb-0" id="error-summary-list">
            <% category.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>

        <div class="row g-3">
          <!-- Category Type -->
          <div class="col-12 col-md-6">
            <div class="mb-3">
              <%= form.label :category_type, Category.human_attribute_name(:category_type), class: "form-label" %>
              <%= form.select :category_type,
                    [[t("types.expense"), "expense"], [t("types.income"), "income"]],
                     { prompt: t("categories.select_type") },
                     class: "form-select #{field_class(category, :category_type)}",
                     aria_describedby: "typeHelp",
                     disabled: category.persisted? %>
              <div id="typeHelp" class="form-text"><%= t(category.persisted? ? "categories.type_help_locked" : "categories.type_help") %></div>
              <% if category.errors[:category_type].any? %>
                <div class="invalid-feedback d-block"><i class="ti ti-alert-circle me-1"></i><%= field_error(category, :category_type) %></div>
              <% end %>
            </div>
          </div>

          <!-- Category Name -->
          <div class="col-12 col-md-6">
            <div class="mb-3">
              <%= form.label :name, class: "form-label" do %>
                <%= Category.human_attribute_name(:name) %> <span class="text-danger">*</span>
              <% end %>
              <%= form.text_field :name, class: "form-control #{field_class(category, :name)}", placeholder: t("categories.name_placeholder"), autocomplete: "off", aria_describedby: "nameHelp" %>
              <div id="nameHelp" class="form-text"><%= t("categories.name_help") %></div>
              <% if category.errors[:name].any? %>
                <div class="invalid-feedback d-block"><i class="ti ti-alert-circle me-1"></i><%= field_error(category, :name) %></div>
              <% else %>
                <div class="valid-feedback"><i class="ti ti-circle-check me-1"></i><%= t("categories.name_valid") %></div>
              <% end %>
            </div>
          </div>

          <!-- Parent Category -->
          <div class="col-12 col-md-6">
            <div class="mb-3">
              <%= category_picker form, :parent_id, @parent_categories,
                                  label: Category.human_attribute_name(:parent_id),
                                  prompt: t("categories.parent_none"),
                                  class: field_class(category, :parent_id),
                                  aria_describedby: "parentHelp",
                                  testid: "category-parent-picker" %>
              <div id="parentHelp" class="form-text"><%= t("categories.parent_help") %></div>
              <% if category.errors[:parent_id].any? %>
                <div class="invalid-feedback d-block"><i class="ti ti-alert-circle me-1"></i><%= field_error(category, :parent_id) %></div>
              <% end %>
            </div>
          </div>

          <!-- Status Toggle -->
          <div class="col-12 col-md-6">
            <div class="mb-3 pt-4 d-print-none">
              <div class="form-check form-switch">
                <%= form.check_box :active, class: "form-check-input", role: "switch", aria_describedby: "activeHelp" %>
                <%= form.label :active, Category.human_attribute_name(:active), class: "form-check-label" %>
              </div>
              <div id="activeHelp" class="form-text ms-2"><%= t("categories.active_help") %></div>
            </div>
          </div>

          <!-- Description -->
          <div class="col-12">
            <div class="mb-3">
              <%= form.label :description, class: "form-label" %>
              <%= form.text_area :description, class: "form-control #{field_class(category, :description)}", rows: 3, placeholder: t("categories.description_placeholder"), aria_describedby: "descriptionHelp", autocomplete: "off" %>
              <div id="descriptionHelp" class="form-text"><%= t("common.optional") %></div>
              <% if category.errors[:description].any? %>
                <div class="invalid-feedback d-block"><i class="ti ti-alert-circle me-1"></i><%= field_error(category, :description) %></div>
              <% end %>
            </div>
          </div>

        </div>
      </div>

      <%= render "shared/form_actions", cancel_path: categories_path do %>
        <%= form.submit t("categories.save"), class: "btn btn-primary", id: "save-category-btn" %>
      <% end %>
    </div>


  <% end %>
</div>