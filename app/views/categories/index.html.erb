<% if flash[:success] %>
  <div class="toast align-items-center text-bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true" id="success-toast" data-bs-delay="3000">
    <div class="d-flex">
      <div class="toast-body">
        <i class="ti ti-circle-check me-1"></i><%= flash[:success] %>
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="<%= t('common.close') %>"></button>
    </div>
  </div>
  <%= javascript_include_tag "toasts", defer: true %>
<% end %>

<%= render "shared/page_header", title: t("categories.title"), subtitle: t("categories.index_subtitle"), class: "category-page-header" do %>
  <%= link_to new_category_path(type: @category_type), class: "btn btn-primary" do %>
    <i class="ti ti-plus me-1"></i><%= t("categories.new") %>
  <% end %>
<% end %>

<nav class="category-tabs" aria-label="<%= t("categories.title") %>">
  <ul class="nav nav-tabs">
    <li class="nav-item">
      <%= link_to categories_path(type: "expense"), class: "nav-link #{@category_type == 'expense' ? 'active' : ''}" do %>
        <i class="ti ti-arrow-up-circle me-1"></i><%= t("types.expense_plural") %>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to categories_path(type: "income"), class: "nav-link #{@category_type == 'income' ? 'active' : ''}" do %>
        <i class="ti ti-arrow-down-circle me-1"></i><%= t("types.income_plural") %>
      <% end %>
    </li>
  </ul>
</nav>

<div class="category-toolbar">
  <div class="category-search">
    <i class="ti ti-search" aria-hidden="true"></i>
    <%= search_field_tag :category_search, nil,
                         id: "category-search",
                         class: "form-control",
                         placeholder: t("categories.search_placeholder"),
                         autocomplete: "off",
                         aria: { label: t("categories.search_placeholder") },
                         data: { category_search: true } %>
  </div>

  <div class="category-filters" role="group" aria-label="<%= t("categories.title") %>">
    <button type="button" class="filter-chip active" data-category-filter="all" aria-pressed="true">
      <%= t("categories.filter_all") %>
    </button>
    <button type="button" class="filter-chip" data-category-filter="default" aria-pressed="false">
      <%= t("categories.filter_default") %>
    </button>
    <button type="button" class="filter-chip" data-category-filter="custom" aria-pressed="false">
      <%= t("categories.filter_custom") %>
    </button>
  </div>
</div>

<% if @default_categories.empty? && @custom_categories.empty? %>
  <div class="card">
    <div class="p-5 text-center">
      <i class="ti ti-tags display-4 text-muted mb-3 d-block"></i>
      <h4 class="mb-2"><%= t("categories.empty_title") %></h4>
      <p class="text-muted"><%= t("categories.empty_body") %></p>
      <%= link_to new_category_path(type: @category_type), class: "btn btn-primary mt-3" do %>
        <i class="ti ti-plus me-1"></i><%= t("categories.new") %>
      <% end %>
    </div>
  </div>
<% else %>
  <% if @default_categories.any? %>
    <section class="category-group" data-category-group="default">
      <div class="category-group__header">
        <h2 class="section-title"><%= t("categories.default_section") %></h2>
        <span class="category-group__count">· <span data-category-count><%= @default_categories.size %></span></span>
      </div>
      <div class="category-grid">
        <%= render partial: "category_card", collection: @default_categories, as: :category %>
      </div>
    </section>
  <% end %>

  <section class="category-group" data-category-group="custom">
    <div class="category-group__header">
      <h2 class="section-title"><%= t("categories.custom_section") %></h2>
      <span class="category-group__count">· <span data-category-count><%= @custom_categories.size %></span></span>
    </div>
    <% if @custom_categories.any? %>
      <div class="category-grid">
        <%= render partial: "category_card", collection: @custom_categories, as: :category %>
      </div>
    <% else %>
      <div class="category-empty" data-category-empty>
        <i class="ti ti-tag" aria-hidden="true"></i>
        <span><%= t("categories.custom_empty") %></span>
      </div>
    <% end %>
  </section>
<% end %>

<div class="empty-state category-no-results" data-category-no-results hidden>
  <i class="ti ti-search" aria-hidden="true"></i>
  <p class="mb-0"><%= t("categories.no_results") %></p>
</div>

<aside class="category-note">
  <i class="ti ti-info-circle" aria-hidden="true"></i>
  <div>
    <strong><%= t("categories.note_title") %></strong>
    <p class="mb-0"><%= t("categories.note_body") %></p>
  </div>
</aside>

<%= javascript_include_tag "categories_index", defer: true %>
