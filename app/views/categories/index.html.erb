<% if flash[:success] %>
  <div class="toast align-items-center text-bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true" id="success-toast" data-bs-delay="3000">
    <div class="d-flex">
      <div class="toast-body">
        <i class="ti ti-circle-check me-1"></i><%= flash[:success] %>
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="<%= t('common.close') %>"></button>
    </div>
  </div>
  <script>
    (function () {
      var toastEl = document.getElementById("success-toast");
      if (toastEl && window.bootstrap) {
        var toast = new bootstrap.Toast(toastEl, { delay: 3000, autohide: true });
        toast.show();
      }
    })();
  </script>
<% end %>

<%= render "shared/page_header", title: t("categories.title") do %>
  <%= link_to new_category_path, class: "btn btn-primary" do %>
    <i class="ti ti-plus me-1"></i><%= t("categories.new") %>
  <% end %>
<% end %>

<% if @default_categories.any? %>
  <h5 class="section-title"><i class="ti ti-shield-lock me-1"></i><%= t("categories.default_section") %></h5>
  <div class="row g-3 mb-4">
    <% @default_categories.each do |category| %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100 card-hover">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <%= link_to category_badge(category), category_path(category), class: "text-decoration-none" %>
              <span class="badge bg-secondary" title="<%= t('categories.default_title') %>"><i class="ti ti-lock"></i></span>
            </div>
            <p class="text-secondary fs-7 mb-0"><%= category.description %></p>
            <small class="text-secondary d-block">
              <%= category_type_label(category.category_type) %>
            </small>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<% if @custom_categories.any? %>
  <h5 class="section-title"><i class="ti ti-user me-1"></i><%= t("categories.custom_section") %></h5>
  <div class="row g-3">
    <% @custom_categories.each do |category| %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100 card-hover">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <%= link_to category_badge(category), category_path(category), class: "text-decoration-none" %>
              <div class="btn-group btn-group-sm d-print-none">
                <%= link_to edit_category_path(category), class: "btn btn-outline-primary", title: t("common.edit"), aria: { label: t("categories.edit_aria", name: category.name) } do %>
                  <i class="ti ti-pencil"></i>
                <% end %>
                <%= button_to category_path(category), method: :delete, class: "btn btn-outline-danger", title: t("common.delete"), aria: { label: t("categories.delete_aria", name: category.name) }, data: { confirm: t("common.confirm") }, form: { style: "display: inline-block" } do %>
                  <i class="ti ti-trash"></i>
                <% end %>
              </div>
            </div>
            <p class="text-secondary fs-7 mb-0"><%= category.description %></p>
            <small class="text-secondary d-block">
              <i class="ti ti-sitemap me-1"></i><%= category.parent&.name || t("categories.root") %>
            </small>
            <small class="text-secondary">
              <%= t("categories.expenses_count", count: category.expenses_count) %>
            </small>
            <small class="text-secondary d-block">
              <%= category_type_label(category.category_type) %>
            </small>
            <% unless category.active %>
              <span class="badge bg-secondary ms-1"><%= t("categories.inactive") %></span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<% if @default_categories.empty? && @custom_categories.empty? %>
  <div class="card">
    <div class="p-5 text-center">
      <i class="ti ti-tags display-4 text-muted mb-3 d-block"></i>
      <h4 class="mb-2"><%= t("categories.empty_title") %></h4>
      <p class="text-muted"><%= t("categories.empty_body") %></p>
      <%= link_to new_category_path, class: "btn btn-primary mt-3" do %>
        <i class="ti ti-plus me-1"></i><%= t("categories.new") %>
      <% end %>
    </div>
  </div>
<% end %>
