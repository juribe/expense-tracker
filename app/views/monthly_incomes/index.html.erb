<% page_attrs = @open_form_modal ? { data: { auto_open_form_modal: (@recurring_template.persisted? ? "edit" : "create") } } : {} %>
<div data-testid="monthly-incomes-page"<%= tag.attributes(page_attrs) %>>
<%= tag.div class: "d-none", data: { monthly_incomes_ui_payload: {
  create_url: monthly_incomes_path,
  confirm_receive: t("recurring.confirm_receive", default: "Confirmar Recibo"),
  receive: t("monthly_incomes.receive", default: "Recibir"),
  delete_title: t("monthly_incomes.delete_confirmation_title"),
  delete_body: t("monthly_incomes.delete_confirmation_body")
} } %>
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-3">
      <li class="breadcrumb-item"><%= link_to t("nav.dashboard"), dashboard_path %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= t("monthly_incomes.title") %></li>
    </ol>
  </nav>

  <%= render "shared/page_header",
             title: t("monthly_incomes.title"),
             subtitle: t("monthly_incomes.subtitle") do %>
    <%= link_to new_import_path, class: "btn btn-outline-secondary", data: { turbo: false } do %>
      <i class="ti ti-upload me-1"></i><%= t("monthly_incomes.import_templates") %>
    <% end %>
    <button type="button" class="btn btn-primary" data-testid="add-recurring"
            data-rt-action="create">
      <i class="ti ti-plus me-1"></i><%= t("monthly_incomes.add_income") %>
    </button>
  <% end %>

  <% next_income = @recurring_summary[:next_income] %>
  <div class="row g-3 mb-4 recurring-summary" data-testid="monthly-incomes-summary">
    <div class="col-6 col-lg-3">
      <div class="card h-100 recurring-summary-card" data-testid="summary-monthly-expected">
        <div class="card-body">
          <%= render "shared/stat",
                     label: t("monthly_incomes.summary.monthly_expected"),
                     value: number_to_currency(@recurring_summary[:monthly_expected]),
                     icon: "cash", icon_tone: "blue", tone: :balance,
                     delta: t("monthly_incomes.summary.active_count", count: @recurring_summary[:active_count]) %>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card h-100 recurring-summary-card" data-testid="summary-pending">
        <div class="card-body">
          <%= render "shared/stat",
                     label: t("monthly_incomes.summary.pending"),
                     value: number_to_currency(@recurring_summary[:pending_total]),
                     icon: "clock", icon_tone: "amber", tone: :attention,
                     delta: t("monthly_incomes.summary.pending_count", count: @recurring_summary[:pending_count]) %>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card h-100 recurring-summary-card" data-testid="summary-received">
        <div class="card-body">
          <%= render "shared/stat",
                     label: t("monthly_incomes.summary.received"),
                     value: number_to_currency(@recurring_summary[:received_total]),
                     icon: "circle-check", icon_tone: "green", tone: :positive,
                     delta: t("monthly_incomes.summary.received_progress",
                              received: @recurring_summary[:received_count],
                              expected: @recurring_summary[:expected_count]) %>
          <div class="progress mt-2 recurring-summary-progress" role="progressbar"
               aria-label="<%= t("monthly_incomes.summary.received_progress",
                                 received: @recurring_summary[:received_count],
                                 expected: @recurring_summary[:expected_count]) %>"
               aria-valuenow="<%= @recurring_summary[:completion_percentage] %>"
               aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar bg-success et-w-<%= @recurring_summary[:completion_percentage] %>"></div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card h-100 recurring-summary-card" data-testid="summary-next-income">
        <div class="card-body">
          <%= render "shared/stat",
                     label: t("monthly_incomes.summary.next_income"),
                     value: next_income ? l(next_income[:date], format: "%d %b") : t("monthly_incomes.summary.none"),
                     icon: "calendar-event", icon_tone: "blue", tone: :balance,
                     delta: if next_income
                              "#{next_income[:description]} · #{number_to_currency(next_income[:amount])}"
                            else
                              t("monthly_incomes.summary.no_pending")
                            end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter -->
  <div class="card mb-4">
    <div class="card-body py-3">
      <%= form_with url: monthly_incomes_path, method: :get, class: "row g-2 align-items-end", data: { testid: "filter-form" } do |f| %>
        <div class="col-12 col-sm-6 col-lg-3">
          <%= f.label :status, t("common.status"), class: "form-label" %>
          <%= f.select :status, options_for_select([[t("common.all"), "all"], [t("monthly_incomes.filter.paid"), "completed"], [t("statuses.pending"), "pending"]], @status_filter), {}, class: "form-select" %>
        </div>
        <div class="col-12 col-sm-6 col-lg-4 d-flex flex-column flex-sm-row gap-2">
          <%= f.submit t("common.filter"), class: "btn btn-primary" %>
          <%= link_to t("common.clear"), monthly_incomes_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div>
      <h2 class="h5 mb-1"><%= t("monthly_incomes.list_title") %></h2>
      <p class="results-meta mb-0" data-testid="results-meta">
        <%= t("monthly_incomes.results_count", count: @total_count, amount: number_to_currency(@filtered_total)) %>
      </p>
    </div>
  </div>

  <div class="card" data-testid="recurring-card">
    <% if @recurring_templates.empty? %>
      <div class="text-center py-5" data-testid="empty-state">
        <i class="ti ti-arrow-down-circle display-4 text-muted d-block mb-3"></i>
        <% if @status_filter != "all" %>
          <h5><%= t("monthly_incomes.empty.no_matching") %></h5>
          <p class="text-secondary"><%= t("monthly_incomes.empty.filter_hint") %></p>
        <% else %>
          <h5><%= t("monthly_incomes.empty.title") %></h5>
          <p class="text-secondary"><%= t("monthly_incomes.empty.body") %></p>
          <button type="button" class="btn btn-outline-primary" data-rt-action="create">
            <%= t("monthly_incomes.empty.add_first") %>
          </button>
        <% end %>
      </div>
    <% else %>
      <div class="table-responsive recurring-table-wrap">
        <table class="table table-hover ledger-table align-middle mb-0 recurring-table recurring-table--income"
               data-testid="recurring-table">
          <thead>
            <tr>
              <th scope="col"><%= t("common.category") %></th>
              <th scope="col"><%= t("common.description") %></th>
              <th scope="col" class="text-end"><%= t("monthly_incomes.columns.monthly_amount") %></th>
              <th scope="col" class="d-none d-md-table-cell"><%= t("activerecord.attributes.recurring_template.payment_day") %></th>
              <th scope="col" class="d-none d-md-table-cell"><%= t("recurring.last_received") %></th>
              <th scope="col"><%= t("common.status") %></th>
              <th scope="col" class="text-end"><%= t("common.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @recurring_templates.each do |rt| %>
              <% status = rt.status_for(@current_period) %>
              <% expected_date = recurring_expected_date(rt, @current_period) %>
              <% last_received = rt.last_occurrence %>
              <tr data-testid="recurring-row"
                  data-id="<%= rt.id %>"
                  data-category-id="<%= rt.category_id %>"
                  data-category-name="<%= rt.category&.name %>"
                  data-description="<%= rt.description %>"
                  data-amount="<%= rt.amount %>"
                  data-paid-amount="<%= rt.paid_amount_for_period(@current_period) %>"
                  data-money-source-id="<%= rt.money_source_id %>"
                  data-payment-day="<%= rt.payment_day %>"
                  data-active="<%= rt.active? %>"
                  data-status="<%= status %>"
                  data-type="<%= rt.kind %>"
                  data-edit-url="<%= monthly_income_path(rt) %>"
                  data-delete-url="<%= monthly_income_path(rt) %>"
                  data-toggle-url="<%= toggle_active_monthly_income_path(rt) %>"
                  data-process-url="<%= process_transaction_monthly_income_path(rt) %>">
                <td class="recurring-cat"><%= category_badge(rt.category) %></td>
                <td class="recurring-desc">
                  <span class="cell-strong"><%= rt.description.presence || content_tag(:span, t("recurring.no_description"), class: "text-muted") %></span>
                  <small class="cell-muted d-block"><%= t("monthly_incomes.list_hint") %></small>
                </td>
                <td class="text-end cell-amount recurring-amount"><%= number_to_currency(rt.signed_amount) %></td>
                <td class="recurring-day d-none d-md-table-cell">
                  <span class="fw-semibold num"><%= t("monthly_incomes.columns.payment_day_value", day: rt.payment_day) %></span>
                  <% if expected_date %>
                    <small class="cell-muted d-block">
                      <%= t("monthly_incomes.columns.expected_date", date: l(expected_date, format: "%d %b")) %>
                    </small>
                  <% end %>
                </td>
                <td class="recurring-last d-none d-md-table-cell">
                  <% if last_received %>
                    <span class="fw-semibold num"><%= l(last_received.date, format: "%d %b %Y") %></span>
                    <small class="cell-muted d-block"><%= number_to_currency(last_received.amount.abs) %></small>
                  <% else %>
                    <span class="cell-muted"><%= t("monthly_incomes.columns.no_income") %></span>
                  <% end %>
                </td>
                <td data-testid="status" class="recurring-status-cell">
                  <%= recurring_status_badge(status, completed_label: t("monthly_incomes.received")) %>
                </td>
                <td class="text-end recurring-actions-cell">
                  <div class="recurring-row-actions">
                    <% if status == :pending %>
                      <button type="button" class="btn btn-primary btn-sm" data-testid="process"
                              aria-label="<%= t("monthly_incomes.receive") %>"
                              title="<%= t("monthly_incomes.receive") %>"
                              data-rt-action="process">
                        <i class="ti ti-coin me-1"></i><%= t("monthly_incomes.receive") %>
                      </button>
                    <% end %>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-testid="edit"
                            aria-label="<%= t("recurring.edit_action", name: rt.description.presence || t("nav.recurring_incomes")) %>"
                            title="<%= t("common.edit") %>"
                            data-rt-action="edit">
                      <i class="ti ti-pencil"></i>
                    </button>
                    <div class="dropdown">
                      <button type="button" class="btn btn-outline-secondary btn-sm recurring-actions-toggle"
                              data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false"
                              data-testid="row-actions"
                              aria-label="<%= t("monthly_incomes.row_actions") %>"
                              title="<%= t("monthly_incomes.row_actions") %>">
                        <i class="ti ti-dots"></i>
                      </button>
                      <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                          <button type="button" class="dropdown-item d-flex align-items-center gap-2"
                                  data-testid="deactivate" data-rt-action="toggle">
                            <i class="ti ti-power"></i>
                            <%= rt.active? ? t("recurring.deactivate") : t("recurring.activate") %>
                          </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                          <button type="button" class="dropdown-item d-flex align-items-center gap-2 text-danger"
                                  data-testid="delete" data-rt-action="delete">
                            <i class="ti ti-trash"></i><%= t("common.delete") %>
                          </button>
                        </li>
                      </ul>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>

<!-- Create / Edit modal -->
<div class="modal fade" id="recurringFormModal" tabindex="-1" aria-labelledby="recurringFormTitle" aria-hidden="true"
     data-testid="form-modal">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <%= form_with model: @recurring_template, local: true, id: "recurringForm" do |f| %>
        <div class="modal-header">
          <h5 class="modal-title" id="recurringFormTitle"><%= t("monthly_incomes.form.add_title") %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("common.close") %>"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <%= category_picker f, :category_id, @categories,
                                  label: t("common.category"),
                                  prompt: t("recurring.select_category"),
                                  required: true,
                                  class: field_class(@recurring_template, :category_id),
                                  testid: "recurring-template-category-picker" %>
              <div class="invalid-feedback"><%= field_error(@recurring_template, :category_id) %></div>
            </div>
            <div class="col-md-6">
              <%= f.label :description, t("common.description"), class: "form-label" %>
              <%= f.text_field :description, class: "form-control #{field_class(@recurring_template, :description)}",
                               maxlength: 255, placeholder: "e.g. Freelance Job" %>
              <div class="invalid-feedback"><%= field_error(@recurring_template, :description) %></div>
            </div>
            <div class="col-md-6">
              <%= f.label :amount, t("monthly_incomes.columns.monthly_amount"), class: "form-label" %>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <%= f.text_field :amount,
                                 value: money_field_value(@recurring_template.amount),
                                 class: "form-control #{field_class(@recurring_template, :amount)}",
                                 required: true,
                                 placeholder: t("expenses.placeholder_amount"),
                                 inputmode: "decimal",
                                 autocomplete: "off",
                                 data: { money_input: true } %>
              </div>
              <div class="invalid-feedback"><%= field_error(@recurring_template, :amount) %></div>
            </div>
            <div class="col-md-6">
              <%= f.label :payment_day, t("recurring.expected_payment_day"), class: "form-label" %>
              <%= f.number_field :payment_day, class: "form-control #{field_class(@recurring_template, :payment_day)}",
                                 min: 1, max: 31, required: true, placeholder: "1-31" %>
              <div class="invalid-feedback"><%= field_error(@recurring_template, :payment_day) %></div>
            </div>
            <div class="col-md-6 d-flex align-items-end">
              <div class="form-check form-switch">
                <%= f.check_box :active, class: "form-check-input", role: "switch", id: "recurring_active_switch" %>
                <%= f.label :active, "Active", class: "form-check-label", for: "recurring_active_switch" %>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("common.cancel") %></button>
          <%= f.submit t("common.save"), class: "btn btn-primary", data: { testid: "save-recurring" } %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Receive confirmation modal -->
<div class="modal fade" id="processModal" tabindex="-1" aria-labelledby="processTitle" aria-hidden="true"
     data-testid="process-modal">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="processForm" method="post" data-turbo="false">
        <div class="modal-header">
          <h5 class="modal-title" id="processTitle"><%= t("recurring.confirm_receive", default: "Confirmar Recibo") %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="row g-2 mb-1">
            <div class="col-md-6">
              <label class="form-label text-muted small mb-0"><%= t("common.category") %></label>
              <p class="form-control-plaintext fw-bold" id="processCategory"></p>
            </div>
            <div class="col-md-6">
              <label class="form-label text-muted small mb-0"><%= t("common.description") %></label>
              <p class="form-control-plaintext" id="processDescription"></p>
            </div>
          </div>
          <div class="mb-1">
            <label class="form-label text-muted small mb-0"><%= t("recurring.configured_amount") %></label>
            <p class="form-control-plaintext" id="processConfiguredAmount"></p>
          </div>
          <div class="mb-1">
            <label for="processMoneySource" class="form-label"><%= t("recurring.process_money_source") %></label>
            <select class="form-select" id="processMoneySource" name="money_source_id">
              <option value=""><%= t("recurring.process_money_source_default") %></option>
              <% @payment_sources.each do |source| %>
                <option value="<%= source.id %>"><%= source.display_name %></option>
              <% end %>
            </select>
            <div class="form-text"><%= t("recurring.process_money_source_hint") %></div>
            <div class="invalid-feedback"><%= t("recurring.invalid_payment_source") %></div>
          </div>
          <div class="mb-1">
            <label for="processDate" class="form-label"><%= t("recurring.transaction_date") %></label>
            <input type="date" class="form-control" id="processDate" name="date" value="<%= Date.current %>" required>
          </div>
          <div class="mb-1">
            <label for="processAmount" class="form-label"><%= t("common.amount") %></label>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <input type="text" class="form-control" id="processAmount" name="amount"
                     inputmode="decimal" autocomplete="off" data-money-input="true" required>
            </div>
            <div class="form-text"><%= t("recurring.amount_hint") %></div>
          </div>
          <div class="mb-1">
            <label class="form-label text-muted small mb-0"><%= t("recurring.paid_so_far", default: "Recibido hasta ahora") %></label>
            <p class="form-control-plaintext" id="processPaidSoFar">$0</p>
          </div>
          <div class="form-check mb-1">
            <input class="form-check-input" type="checkbox" id="processMarkAsPaid" name="mark_as_paid" value="1">
            <label class="form-check-label small" for="processMarkAsPaid"><%= t("recurring.mark_as_paid", default: "Marcar como recibido") %></label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t("recurring.back") %></button>
          <button type="submit" class="btn btn-primary" id="processConfirm" data-testid="confirm-process"><%= t("monthly_incomes.receive") %></button>
        </div>
      </form>
    </div>
  </div>
</div>


<% if @open_form_modal %>
  <% end %>

<%= javascript_include_tag "monthly_incomes_ui", defer: true %>

