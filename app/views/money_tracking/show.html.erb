<% content_for :title, "Seguimiento de dinero" %>

<% current_mode = current_user.money_tracking_detailed? ? "detailed" : "simple" %>
<% current_name = current_mode == "detailed" ? "Completo" : "Simple" %>
<% current_tag = current_mode == "detailed" ? "Todas tus cuentas y movimientos" : "Ingresos, gastos y presupuestos" %>
<% current_status = current_mode == "detailed" ? "Tu modalidad actual es Seguimiento completo." : "Tu modalidad actual es Seguimiento simple." %>

<div class="money-tracking-page" data-testid="money-tracking-settings">
  <header class="mt-page-heading">
    <div class="mt-heading-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="29" height="29" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19V11h4v8M10 19V5h4v14M16 19V8h4v11"/>
      </svg>
    </div>
    <div>
      <h1>Seguimiento de dinero</h1>
      <p class="mt-subtitle">Elige cómo quieres administrar tus finanzas. Esta opción es independiente de tu plan.</p>
    </div>
  </header>

  <section class="mt-card mt-current-card" aria-label="Modalidad actual">
    <div class="mt-current-left">
      <div class="mt-current-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M6 4v16M12 4v16M18 4v16"/>
          <circle cx="6" cy="9" r="2" fill="white"/>
          <circle cx="12" cy="15" r="2" fill="white"/>
          <circle cx="18" cy="7" r="2" fill="white"/>
        </svg>
      </div>
      <div>
        <div class="mt-eyebrow">Modalidad actual</div>
        <div class="mt-current-name" data-testid="money-tracking-current-mode"><%= current_name %></div>
      </div>
    </div>
    <span class="mt-current-tag" data-testid="money-tracking-current-tag"><%= current_tag %></span>
  </section>

  <section class="mt-card mt-chooser">
    <div class="mt-section-heading">
      <div class="mt-section-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7.5"/>
          <path d="m16.5 16.5 4 4M11 7v4l3 2"/>
          <path d="M18.5 5.5 21 3"/>
        </svg>
      </div>
      <div>
        <h2>Elige tu tipo de seguimiento</h2>
        <p class="mt-section-copy">Puedes cambiar cuando quieras. Tus movimientos, categorías y presupuestos se conservan.</p>
      </div>
    </div>

    <%= form_with url: money_tracking_path, method: :patch, local: true,
                  data: { money_tracking_form: true, current_mode: current_mode } do |form| %>
      <fieldset class="mt-options">
        <legend class="visually-hidden">Tipo de seguimiento</legend>
        <%= render "money_tracking/mode_cards", selected_mode: current_mode %>
      </fieldset>

      <div class="mt-actions">
        <div class="mt-status" data-money-tracking-status data-testid="money-tracking-status">
          <%= current_status %>
        </div>
        <button type="submit" class="mt-button" disabled data-testid="money-tracking-submit">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m5 12 4 4L19 6"/>
          </svg>
          Actualizar modalidad
        </button>
      </div>
    <% end %>
  </section>

  <% if money_tracking_detailed? %>
    <section class="mt-card mt-default-source" data-testid="money-tracking-default-source">
      <h2>Fuente predeterminada</h2>
      <p class="mt-section-copy mb-3">
        Se usa cuando registras un movimiento sin indicar una cuenta o tarjeta. Si no eliges una,
        las importaciones sin fuente identificada quedarán para revisión.
      </p>

      <%= form_with url: money_tracking_default_source_path, method: :patch, local: true do |form| %>
        <div class="row g-3 align-items-end">
          <div class="col-12 col-md-8">
            <%= form.label :default_money_source_id, "Fuente predeterminada", class: "form-label" %>
            <%= form.select :default_money_source_id,
                            options_from_collection_for_select(@default_source_options, :id, :display_name,
                                                              current_user.default_money_source_id),
                            { include_blank: "Ninguna" },
                            class: "form-select" %>
          </div>
          <div class="col-12 col-md-4">
            <%= form.submit "Guardar fuente", class: "btn btn-outline-primary w-100" %>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>
</div>

<%= javascript_include_tag "money_tracking", defer: true %>
