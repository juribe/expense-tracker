<%= render "shared/page_header",
           title: t("admin.users.title"),
           subtitle: t("admin.users.subtitle") %>

<%= render "shared/section", title: t("admin.users.list_title"), icon: "users" do %>
  <% if @users.any? %>
    <%= form_with url: bulk_destroy_admin_users_path,
                  method: :delete,
                  html: { id: "adminUsersBulkForm", class: "d-none" },
                  data: { turbo_confirm: t("admin.users.bulk.delete_confirm") } do %>
    <% end %>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <span class="text-muted small">
        <span data-admin-users-selected-count>0</span> <%= t("admin.users.bulk.selected") %>
      </span>
      <button type="submit" form="adminUsersBulkForm" class="btn btn-sm btn-outline-danger"
              data-admin-users-bulk-submit disabled>
        <i class="ti ti-trash me-1" aria-hidden="true"></i><%= t("admin.users.bulk.delete_selected") %>
      </button>
    </div>

    <div class="table-responsive overflow-y-hidden">
      <table class="table table-hover ledger-table align-middle mb-0" data-testid="admin-users-table">
        <caption class="visually-hidden"><%= t("admin.users.caption") %></caption>
        <thead class="table-light">
          <tr>
            <th scope="col">
              <input type="checkbox" class="form-check-input" data-admin-users-select-all
                     aria-label="<%= t("admin.users.bulk.select_all") %>">
            </th>
            <th scope="col"><%= t("admin.users.columns.user") %></th>
            <th scope="col"><%= t("admin.users.columns.verified") %></th>
            <th scope="col" class="d-none d-md-table-cell"><%= t("admin.users.columns.created_at") %></th>
            <th scope="col" class="text-end"><%= t("admin.users.columns.accounts") %></th>
            <th scope="col" class="text-end"><%= t("admin.users.columns.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr data-testid="admin-user-row" data-user-id="<%= user.id %>">
              <td>
                <%= check_box_tag "user_ids[]", user.id, false,
                                  id: "admin_user_#{user.id}",
                                  form: "adminUsersBulkForm",
                                  class: "form-check-input",
                                  disabled: user == current_user,
                                  data: { admin_users_checkbox: true },
                                  aria: { label: t("admin.users.bulk.select_user", email: user.email) } %>
              </td>
              <td data-testid="user-email">
                <div class="fw-semibold"><%= user.email %></div>
                <div class="small text-muted"><%= user.name.presence || "—" %></div>
              </td>
              <td>
                <% if user.confirmed? %>
                  <span class="badge bg-success-subtle text-success border rounded-pill" data-testid="user-verified">
                    <%= t("admin.users.verified") %>
                  </span>
                <% else %>
                  <span class="badge bg-warning-subtle text-warning border rounded-pill" data-testid="user-pending">
                    <%= t("admin.users.pending") %>
                  </span>
                <% end %>
              </td>
              <td class="d-none d-md-table-cell text-nowrap" data-testid="user-created-at">
                <%= l(user.created_at, format: :short) %>
              </td>
              <td class="text-end cell-strong" data-testid="user-accounts-count">
                <%= user.money_sources_count.to_i %>
              </td>
              <td class="text-end">
                <%= button_to admin_user_path(user),
                              method: :delete,
                              class: "btn btn-sm btn-outline-danger",
                              title: t("admin.users.delete"),
                              aria: { label: t("admin.users.delete_aria", email: user.email) },
                              form: { class: "d-inline-block", data: { turbo_confirm: t("admin.users.delete_confirm", email: user.email) } } do %>
                  <i class="ti ti-trash" aria-hidden="true"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @users.total_pages > 1 %>
      <div class="mt-3">
        <%= will_paginate @users, renderer: WillPaginate::ActionView::BootstrapLinkRenderer,
                                  previous_label: t("common.previous"), next_label: t("common.next") %>
      </div>
    <% end %>
  <% else %>
    <%= render "shared/empty_state",
               icon: "users",
               title: t("admin.users.empty") %>
  <% end %>
<% end %>
