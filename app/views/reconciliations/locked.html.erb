<% content_for :title, t("reconciliation.premium_lock.title") %>

<div class="reconciliation-page">
  <section class="rec-premium-locked" data-testid="premium-locked">
    <div class="rec-lock-card">
      <div class="rec-lock-icon" aria-hidden="true">
        <i class="ti ti-lock"></i>
      </div>

      <span class="rec-lock-pill">
        <i class="ti ti-sparkles" aria-hidden="true"></i>
        <%= t("reconciliation.premium_lock.eyebrow") %>
      </span>

      <h2><%= t("reconciliation.premium_lock.title") %></h2>
      <p class="rec-lock-description">
        <%= t("reconciliation.premium_lock.description", app_name: AppName.current) %>
      </p>

      <%= link_to plans_path, class: "rec-lock-primary" do %>
        <%= t("reconciliation.premium_lock.cta") %>
        <i class="ti ti-arrow-right" aria-hidden="true"></i>
      <% end %>

      <%= link_to t("reconciliation.premium_lock.back", app_name: AppName.current),
                  dashboard_path,
                  class: "rec-lock-back" %>

      <p class="rec-lock-note">
        <%= t("reconciliation.premium_lock.note", app_name: AppName.current) %>
      </p>
    </div>
  </section>
</div>
