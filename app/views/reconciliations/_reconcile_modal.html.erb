<%# Conciliar / Movimientos modal — populated by app/assets/javascripts/reconciliation.js
    from the data-* attributes of the clicked row action. A discrepancy is
    NEVER auto-converted into a "Descuadre" expense; crear gasto/ingreso
    reuse the standard forms. %>
<div class="modal fade" id="reconcileModal" tabindex="-1" aria-hidden="true"
     data-balance-url="<%= reconciliation_actual_balance_path("SOURCE_ID") %>"
     data-leave-url="<%= reconciliation_leave_pending_path("SOURCE_ID") %>"
     data-movements-url="<%= reconciliation_search_movements_path %>"
     data-create-expense-url="<%= new_expense_path %>"
     data-create-income-url="<%= new_income_path %>"
     data-period="<%= @period %>"
     data-account-modal-title="<%= t("reconciliation.reconcile.title") %>"
     data-debt-modal-title="<%= t("reconciliation.reconcile.debt_title") %>"
     data-movements-modal-title="<%= t("reconciliation.reconcile.movements_title_mode") %>"
     data-account-balance-label="<%= t("reconciliation.balances.app_balance", app_name: AppName.current) %>"
     data-debt-balance-label="<%= t("reconciliation.balances.debt_balance", app_name: AppName.current) %>"
     data-account-movements-title="<%= t("reconciliation.reconcile.movements_title") %>"
     data-debt-movements-title="<%= t("reconciliation.reconcile.debt_movements_title") %>"
     data-difference-hint="<%= t("reconciliation.reconcile.difference_hint") %>"
     data-difference-zero="<%= t("reconciliation.reconcile.difference_zero") %>"
     data-difference-positive="<%= t("reconciliation.reconcile.difference_positive", app_name: AppName.current) %>"
     data-difference-negative="<%= t("reconciliation.reconcile.difference_negative", app_name: AppName.current) %>"
     data-invalid-balance="<%= t("reconciliation.reconcile.invalid_balance") %>"
     data-no-movements="<%= t("reconciliation.reconcile.no_movements") %>"
     data-movement-error="<%= t("reconciliation.reconcile.movement_error") %>"
     data-loading="<%= t("reconciliation.reconcile.loading") %>"
     data-load-more="<%= t("reconciliation.reconcile.load_more") %>"
     data-no-more="<%= t("reconciliation.reconcile.no_more") %>"
     data-count-one="<%= t("reconciliation.movements.count_one", count: "%{count}") %>"
     data-count-other="<%= t("reconciliation.movements.count_other", count: "%{count}") %>"
     data-open-label="<%= t("reconciliation.reconcile.open") %>">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable rec-reconcile-modal">
    <div class="modal-content">
      <div class="modal-header rec-modal-header">
        <div>
          <h5 class="modal-title">
            <span class="js-modal-title"><%= t("reconciliation.reconcile.title") %></span>
            <span class="rec-title-sep" aria-hidden="true">·</span>
            <span class="js-source-name">—</span>
          </h5>
          <p class="rec-modal-subtitle js-source-meta">—</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("common.close", default: "Cerrar") %>"></button>
      </div>

      <div class="modal-body rec-reconcile-body">
        <div class="rec-balance-grid">
          <div class="rec-balance-cell">
            <label class="js-balance-label"><%= t("reconciliation.reconcile.app_balance", app_name: AppName.current) %></label>
            <strong class="js-app-balance">—</strong>
          </div>
          <div class="rec-balance-cell">
            <label for="reconcileActualBalance"><%= t("reconciliation.reconcile.actual_balance") %></label>
            <input type="text"
                   id="reconcileActualBalance"
                   class="form-control rec-money-input"
                   inputmode="decimal"
                   autocomplete="off"
                   data-money-input="true"
                   placeholder="<%= t("reconciliation.reconcile.actual_balance_placeholder") %>">
            <div class="invalid-feedback" id="reconcileBalanceError"></div>
          </div>
          <div class="rec-balance-cell">
            <label><%= t("reconciliation.reconcile.difference") %></label>
            <div class="rec-difference js-difference">—</div>
            <div class="rec-difference-hint js-difference-hint"><%= t("reconciliation.reconcile.difference_hint") %></div>
          </div>
        </div>

        <div class="rec-reason-row">
          <%= label_tag :reconcileNote, t("reconciliation.reconcile.note_label"), class: "rec-field-label" %>
          <input type="text"
                 id="reconcileNote"
                 class="form-control rec-reason-input"
                 maxlength="140"
                 autocomplete="off"
                 placeholder="<%= t("reconciliation.reconcile.note_placeholder") %>">
        </div>

        <div class="rec-movement-tools">
          <div class="rec-movement-head">
            <h4 class="js-movements-title"><%= t("reconciliation.reconcile.movements_title") %></h4>
            <span class="rec-movement-count js-movement-count"></span>
          </div>
          <div class="rec-search-row">
            <input type="search"
                   id="reconcileSearchInput"
                   class="form-control rec-search-input"
                   placeholder="<%= t("reconciliation.reconcile.search_placeholder") %>"
                   autocomplete="off"
                   aria-label="<%= t("reconciliation.reconcile.search_placeholder") %>">
          </div>
          <div id="reconcileSearchResults"
               class="rec-movement-list"
               role="list"
               aria-live="polite"
               data-hint="<%= t("reconciliation.reconcile.search_hint") %>">
            <div class="rec-movement-empty js-search-empty"><%= t("reconciliation.reconcile.search_hint") %></div>
          </div>
          <div class="rec-load-more-wrap">
            <button type="button" id="reconcileLoadMore" class="btn rec-btn-soft d-none">
              <%= t("reconciliation.reconcile.load_more") %> <i class="ti ti-arrow-down" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <div class="rec-create-actions">
          <span><%= t("reconciliation.reconcile.create_hint") %></span>
          <%= link_to "#", id: "reconcileCreateExpense", target: "_blank", rel: "noopener", class: "rec-link" do %>
            <%= t("reconciliation.reconcile.create_expense") %>
          <% end %>
          <%= link_to "#", id: "reconcileCreateIncome", target: "_blank", rel: "noopener", class: "rec-link" do %>
            <%= t("reconciliation.reconcile.create_income") %>
          <% end %>
        </div>
      </div>

      <div class="rec-modal-footer">
        <button type="button" id="reconcileLeavePending" class="btn rec-btn-pending">
          <%= t("reconciliation.reconcile.leave_pending") %>
        </button>
        <div class="rec-footer-actions">
          <button type="button" id="reconcileAllGood" class="btn rec-btn-good">
            <i class="ti ti-checks me-1" aria-hidden="true"></i><%= t("reconciliation.reconcile.all_good") %>
          </button>
          <button type="button" id="reconcileAdjust" class="btn rec-btn-primary">
            <%= t("reconciliation.reconcile.save_balance") %>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
