<%# Asignar pago modal — populated by app/assets/javascripts/reconciliation.js
    from the data-* attributes of the clicked "Asignar pago" button. %>
<div class="modal fade" id="assignPaymentModal" tabindex="-1" aria-hidden="true"
     data-search-url="<%= reconciliation_search_expenses_path %>"
     data-assign-url="<%= reconciliation_assign_payment_path("TEMPLATE_ID") %>"
     data-create-expense-url="<%= new_expense_path %>"
     data-period="<%= @period %>"
     data-error-label="<%= t("reconciliation.assign.error") %>"
     data-loading-label="<%= t("reconciliation.assign.loading") %>"
     data-select-hint="<%= t("reconciliation.assign.select_hint") %>"
     data-open-label="<%= t("reconciliation.assign.open") %>"
     data-selected-label="<%= t("reconciliation.assign.selected", description: "%{description}", amount: "%{amount}") %>">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable rec-payment-modal">
    <div class="modal-content">
      <div class="modal-header rec-modal-header">
        <div>
          <h5 class="modal-title"><%= t("reconciliation.assign.title") %></h5>
          <p class="rec-modal-subtitle"><%= t("reconciliation.assign.subtitle") %></p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("common.close", default: "Cerrar") %>"></button>
      </div>

      <div class="modal-body rec-payment-body">
        <div class="rec-payment-summary">
          <div>
            <h4 class="js-payment-name">—</h4>
            <p>
              <span><%= t("reconciliation.assign.due") %>: <span class="js-payment-due">—</span></span>
              · <span><%= t("reconciliation.assign.category") %>: <span class="js-payment-category">—</span></span>
            </p>
          </div>
          <div class="rec-payment-amount js-payment-amount">—</div>
        </div>

        <label class="rec-field-label" for="assignExpenseSearch">
          <%= t("reconciliation.assign.search_label") %>
        </label>
        <input type="search"
               id="assignExpenseSearch"
               class="form-control rec-search-input"
               placeholder="<%= t("reconciliation.assign.search_placeholder") %>"
               autocomplete="off">
        <div id="assignExpenseResults"
             class="rec-payment-results"
             role="list"
             aria-live="polite"
             data-hint="<%= t("reconciliation.assign.search_hint") %>"
             data-empty-label="<%= t("reconciliation.assign.no_results", category: "%{category}") %>"
             data-empty-generic="<%= t("reconciliation.assign.no_results_generic") %>">
          <div class="rec-payment-empty js-search-empty"><%= t("reconciliation.assign.search_hint") %></div>
        </div>

        <div class="rec-payment-create">
          <span><%= t("reconciliation.assign.create_hint") %></span>
          <%= link_to "#",
                      id: "assignCreateExpenseLink",
                      target: "_blank",
                      rel: "noopener" do %>
            <i class="ti ti-plus" aria-hidden="true"></i><%= t("reconciliation.assign.create_expense") %>
          <% end %>
        </div>
      </div>

      <div class="rec-payment-footer">
        <span class="rec-payment-note" id="assignSelectedLabel"><%= t("reconciliation.assign.select_hint") %></span>
        <div class="rec-payment-actions">
          <button type="button" class="btn rec-btn-soft" data-bs-dismiss="modal">
            <%= t("reconciliation.assign.cancel") %>
          </button>
          <button type="button" id="assignPaymentSubmit" class="btn rec-btn-primary" disabled>
            <i class="ti ti-check me-1" aria-hidden="true"></i><%= t("reconciliation.assign.submit") %>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
