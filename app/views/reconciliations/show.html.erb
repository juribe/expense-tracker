<% content_for :title, t("reconciliation.title") %>

<div class="reconciliation-page">
  <nav class="breadcrumb rec-breadcrumb" aria-label="<%= t("reconciliation.breadcrumb") %>">
    <span><%= t("reconciliation.breadcrumb") %></span>
    <span aria-hidden="true">›</span>
    <strong><%= t("reconciliation.title") %></strong>
  </nav>

  <div class="rec-page-head">
    <div>
      <h1 class="rec-page-title"><%= t("reconciliation.title") %> <span aria-hidden="true">✦</span></h1>
      <p class="rec-page-subtitle"><%= t("reconciliation.subtitle") %></p>
    </div>
    <div class="rec-period" data-testid="cycle-badge">
      <i class="ti ti-calendar-plus" aria-hidden="true"></i>
      <span><%= @period_label %><%= " (#{@cycle.range_label})" if @cycle %></span>
    </div>
  </div>

  <section class="rec-hero">
    <div class="rec-hero-copy">
      <div class="rec-hero-kicker"><i class="ti ti-sparkles" aria-hidden="true"></i><%= t("reconciliation.hero.kicker") %></div>
      <h2><%= t("reconciliation.hero.title") %></h2>
      <p><%= t("reconciliation.hero.body") %></p>
      <div class="rec-hero-actions">
        <%= link_to "#rec-accounts", class: "btn rec-btn-white" do %>
          <%= t("reconciliation.hero.continue") %> <i class="ti ti-arrow-right" aria-hidden="true"></i>
        <% end %>
        <button type="button" class="btn rec-btn-glass" data-bs-toggle="modal" data-bs-target="#reconciliationGuideModal">
          <%= t("reconciliation.hero.how_it_works") %>
        </button>
      </div>
      <div class="rec-hero-status">
        <% if @state.reconciled? %>
          <%= reconciliation_status_badge("reconciled", t("reconciliation.status.all_set")) %>
          <span><%= t("reconciliation.status.all_set_subtitle") %></span>
        <% elsif @state.pending_payments_count.positive? %>
          <%= reconciliation_status_badge("pending", t("reconciliation.status.pending_count", count: @state.pending_payments_count)) %>
          <span><%= t("reconciliation.status.unverified_count", count: @state.unverified_count) %></span>
        <% elsif @state.unverified_count.positive? %>
          <%= reconciliation_status_badge("todo", t("reconciliation.status.unverified_count", count: @state.unverified_count)) %>
        <% else %>
          <%= reconciliation_status_badge("warning", t("reconciliation.status.differences_count", count: @state.discrepancies_count)) %>
        <% end %>
        <% checked_label = reconciliation_checked_at_label(@state.checked_at&.iso8601) %>
        <% if checked_label %>
          <span class="rec-checked-at"><i class="ti ti-history" aria-hidden="true"></i><%= checked_label %></span>
        <% end %>
      </div>
    </div>

    <div class="rec-hero-progress">
      <div class="rec-progress-top">
        <span><%= t("reconciliation.hero.progress_title") %></span>
        <strong><%= t("reconciliation.hero.progress_count", verified: @state.verified_sources_count, total: @state.total_sources_count) %></strong>
      </div>
      <div class="progress rec-progress-track">
        <div class="progress-bar rec-progress-fill" data-progress="<%= @state.progress_percentage %>"></div>
      </div>
      <div class="rec-progress-foot">
        <span><%= reconciliation_progress_caption(@state) %></span>
        <span><%= t("reconciliation.hero.progress_percent", percent: @state.progress_percentage) %></span>
      </div>
    </div>
  </section>

  <section class="rec-metrics" aria-label="<%= t("reconciliation.title") %>">
    <div class="rec-metric">
      <div class="rec-metric-head">
        <span><%= t("reconciliation.metrics.accounts_title") %></span>
        <span class="rec-metric-icon rec-icon-blue"><i class="ti ti-wallet" aria-hidden="true"></i></span>
      </div>
      <div class="rec-metric-value">
        <%= @state.unverified_accounts_count %> <span>/ <%= @accounts.size %></span>
      </div>
      <div class="rec-metric-foot">
        <% if @accounts.empty? %>
          <%= t("reconciliation.metrics.accounts_empty") %>
        <% elsif @state.unverified_accounts_count.zero? %>
          <%= t("reconciliation.metrics.accounts_done") %>
        <% elsif @state.unverified_accounts_count == @accounts.size %>
          <%= t("reconciliation.metrics.accounts_pending") %>
        <% else %>
          <%= t("reconciliation.metrics.accounts_partial") %>
        <% end %>
      </div>
    </div>

    <div class="rec-metric">
      <div class="rec-metric-head">
        <span><%= t("reconciliation.metrics.payments_title") %></span>
        <span class="rec-metric-icon rec-icon-purple"><i class="ti ti-list-check" aria-hidden="true"></i></span>
      </div>
      <div class="rec-metric-value"><%= @state.pending_payments_count %></div>
      <div class="rec-metric-foot">
        <span class="<%= @state.pending_payments_count.positive? ? "warn" : "good" %>">
          <%= @state.pending_payments_count.positive? ? t("reconciliation.metrics.payments_pending") : t("reconciliation.metrics.payments_done") %>
        </span>
      </div>
    </div>

    <div class="rec-metric">
      <div class="rec-metric-head">
        <span><%= t("reconciliation.metrics.debts_title") %></span>
        <span class="rec-metric-icon rec-icon-green"><i class="ti ti-credit-card" aria-hidden="true"></i></span>
      </div>
      <div class="rec-metric-value">
        <%= @state.unverified_debts_count %> <span>/ <%= @debts.size %></span>
      </div>
      <div class="rec-metric-foot">
        <% if @debts.empty? %>
          <%= t("reconciliation.metrics.debts_empty") %>
        <% elsif @state.unverified_debts_count.zero? %>
          <%= t("reconciliation.metrics.debts_done") %>
        <% else %>
          <%= t("reconciliation.metrics.debts_pending") %>
        <% end %>
      </div>
    </div>
  </section>

  <div class="rec-section-head" id="rec-accounts">
    <div>
      <h2><%= t("reconciliation.sections.accounts_title") %></h2>
      <p><%= t("reconciliation.sections.accounts_subtitle", app_name: AppName.current) %></p>
    </div>
    <%= link_to money_sources_cash_path, class: "rec-link" do %>
      <%= t("reconciliation.sections.accounts_link") %> <i class="ti ti-arrow-right" aria-hidden="true"></i>
    <% end %>
  </div>

  <div class="rec-content-grid">
    <section class="rec-panel">
      <div class="rec-panel-head">
        <div>
          <h3><%= t("reconciliation.balances.title") %></h3>
          <p><%= t("reconciliation.balances.subtitle") %></p>
        </div>
        <span class="rec-count"><%= t("reconciliation.status.verify_count", count: @state.unverified_accounts_count) %></span>
      </div>

      <% if @accounts.empty? %>
        <%= render "shared/empty_state",
                   icon: "wallet",
                   title: t("reconciliation.balances.empty_title"),
                   text: t("reconciliation.balances.empty"),
                   cta: link_to(t("reconciliation.sections.accounts_link"), money_sources_cash_path, class: "btn btn-primary btn-sm") %>
      <% else %>
        <ul class="list-group list-group-flush rec-list">
          <% @accounts.each do |balance| %>
            <%= render "reconciliations/balance_row", balance: balance %>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="rec-panel">
      <div class="rec-panel-head">
        <div>
          <h3><%= t("reconciliation.payments.title") %></h3>
          <p><%= t("reconciliation.payments.subtitle") %></p>
        </div>
        <span class="rec-count"><%= t("reconciliation.status.pending_count", count: @state.pending_payments_count) %></span>
      </div>

      <% if @pending_payments.empty? %>
        <%= render "shared/empty_state",
                   icon: "circle-check",
                   title: t("reconciliation.payments.empty_title"),
                   text: t("reconciliation.payments.empty") %>
      <% else %>
        <ul class="list-group list-group-flush rec-list">
          <% @pending_payments.each do |payment| %>
            <%= render "reconciliations/payment_row", payment: payment %>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>

  <div class="rec-tip">
    <span class="rec-tip-icon" aria-hidden="true">💡</span>
    <div>
      <b><%= t("reconciliation.tip.title") %></b>
      <p><%= t("reconciliation.tip.body") %></p>
    </div>
  </div>

  <div class="rec-section-head" id="rec-debts">
    <div>
      <h2><%= t("reconciliation.sections.debts_title") %></h2>
      <p><%= t("reconciliation.sections.debts_subtitle") %></p>
    </div>
    <%= link_to money_sources_loans_path, class: "rec-link" do %>
      <%= t("reconciliation.sections.debts_link") %> <i class="ti ti-arrow-right" aria-hidden="true"></i>
    <% end %>
  </div>

  <section class="rec-panel">
    <div class="rec-panel-head">
      <div>
        <h3><%= t("reconciliation.debts.title") %></h3>
        <p><%= t("reconciliation.debts.subtitle") %></p>
      </div>
      <span class="rec-count"><%= t("reconciliation.status.verify_count", count: @state.unverified_debts_count) %></span>
    </div>

    <% if @debts.empty? %>
      <%= render "shared/empty_state",
                 icon: "credit-card",
                 title: t("reconciliation.debts.empty_title"),
                 text: t("reconciliation.debts.empty"),
                 cta: link_to(t("reconciliation.sections.debts_link"), money_sources_loans_path, class: "btn btn-primary btn-sm") %>
    <% else %>
      <ul class="list-group list-group-flush rec-list">
        <% @debts.each do |balance| %>
          <%= render "reconciliations/balance_row", balance: balance %>
        <% end %>
      </ul>
    <% end %>
  </section>

  <%= render "reconciliations/assign_modal" %>
  <%= render "reconciliations/reconcile_modal" %>
  <%= render "reconciliations/guide_modal" %>
</div>
